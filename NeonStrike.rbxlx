      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">Achievements</string>
          <string name="Source"><![CDATA[-- Every achievement is "Stat reaches Goal". Stats are tracked by AchievementService.
-- Category is used for the tabs in the achievements menu.
local Achievements = {}

local list = {
	-- Combat
	{ Id = "FirstKill", Name = "Fresh Meat", Desc = "Get your first elimination", Stat = "Kills", Goal = 1, Reward = 100, Icon = "🎯", Category = "Combat" },
	{ Id = "Kills50", Name = "Sharpshooter", Desc = "Get 50 eliminations", Stat = "Kills", Goal = 50, Reward = 500, Icon = "🎯", Category = "Combat" },
	{ Id = "Kills250", Name = "Veteran", Desc = "Get 250 eliminations", Stat = "Kills", Goal = 250, Reward = 1500, Icon = "🎖️", Category = "Combat" },
	{ Id = "Kills1000", Name = "War Machine", Desc = "Get 1,000 eliminations", Stat = "Kills", Goal = 1000, Reward = 5000, Icon = "🤖", Category = "Combat" },
	{ Id = "Kills5000", Name = "Living Legend", Desc = "Get 5,000 eliminations", Stat = "Kills", Goal = 5000, Reward = 20000, Icon = "👑", Category = "Combat" },
	{ Id = "Head10", Name = "Head Hunter", Desc = "Land 10 headshot kills", Stat = "Headshots", Goal = 10, Reward = 300, Icon = "💀", Category = "Combat" },
	{ Id = "Head100", Name = "Brain Surgeon", Desc = "Land 100 headshot kills", Stat = "Headshots", Goal = 100, Reward = 2000, Icon = "🧠", Category = "Combat" },
	{ Id = "Head500", Name = "Deadeye", Desc = "Land 500 headshot kills", Stat = "Headshots", Goal = 500, Reward = 8000, Icon = "👁️", Category = "Combat" },
	{ Id = "Assist25", Name = "Team Player", Desc = "Earn 25 assists", Stat = "Assists", Goal = 25, Reward = 400, Icon = "🤝", Category = "Combat" },
	{ Id = "Damage50k", Name = "Damage Dealer", Desc = "Deal 50,000 total damage", Stat = "Damage", Goal = 50000, Reward = 3000, Icon = "💥", Category = "Combat" },

	-- Streaks & multi kills
	{ Id = "Streak5", Name = "Killing Spree", Desc = "Get a 5 kill streak", Stat = "BestStreak", Goal = 5, Reward = 300, Icon = "🔥", Category = "Streaks" },
	{ Id = "Streak10", Name = "Dominating", Desc = "Get a 10 kill streak", Stat = "BestStreak", Goal = 10, Reward = 1000, Icon = "🔥", Category = "Streaks" },
	{ Id = "Streak15", Name = "Nuclear Option", Desc = "Get a 15 kill streak", Stat = "BestStreak", Goal = 15, Reward = 3000, Icon = "☢️", Category = "Streaks" },
	{ Id = "Streak25", Name = "Untouchable", Desc = "Get a 25 kill streak", Stat = "BestStreak", Goal = 25, Reward = 10000, Icon = "😇", Category = "Streaks" },
	{ Id = "Double", Name = "Double Trouble", Desc = "Get a Double Kill", Stat = "DoubleKills", Goal = 1, Reward = 150, Icon = "✌️", Category = "Streaks" },
	{ Id = "Triple", Name = "Hat Trick", Desc = "Get a Triple Kill", Stat = "TripleKills", Goal = 1, Reward = 400, Icon = "🎩", Category = "Streaks" },
	{ Id = "Quad", Name = "Fourth Horseman", Desc = "Get a Quad Kill", Stat = "QuadKills", Goal = 1, Reward = 1000, Icon = "🐎", Category = "Streaks" },
	{ Id = "Rampage", Name = "Rampage", Desc = "Get 5+ kills in rapid succession", Stat = "Rampages", Goal = 1, Reward = 2500, Icon = "🌪️", Category = "Streaks" },
	{ Id = "KO1", Name = "K.O!", Desc = "Get a K.O Streak (5 kills without dying)", Stat = "KOStreaks", Goal = 1, Reward = 300, Icon = "🔥", Category = "Streaks" },
	{ Id = "KO25", Name = "Knockout Artist", Desc = "Get 25 K.O Streaks", Stat = "KOStreaks", Goal = 25, Reward = 3000, Icon = "🥊", Category = "Streaks" },
	{ Id = "Infinite1", Name = "Bottomless Mag", Desc = "Earn Infinite Ammo (15 kills without dying)", Stat = "InfiniteAmmos", Goal = 1, Reward = 2500, Icon = "♾️", Category = "Streaks" },
	{ Id = "UAV1", Name = "Eyes in the Sky", Desc = "Call in a UAV", Stat = "UAVs", Goal = 1, Reward = 200, Icon = "📡", Category = "Streaks" },
	{ Id = "Overdrive1", Name = "Overclocked", Desc = "Activate Overdrive", Stat = "Overdrives", Goal = 1, Reward = 300, Icon = "⚡", Category = "Streaks" },
	{ Id = "Airstrike1", Name = "Danger Close", Desc = "Call in an Airstrike", Stat = "Airstrikes", Goal = 1, Reward = 500, Icon = "✈️", Category = "Streaks" },
	{ Id = "AirstrikeKills", Name = "Carpet Bomber", Desc = "Get 25 Airstrike kills", Stat = "AirstrikeKills", Goal = 25, Reward = 2500, Icon = "💣", Category = "Streaks" },
	{ Id = "Nuke1", Name = "Mutually Assured", Desc = "Drop a Tactical Nuke (20 kill streak)", Stat = "Nukes", Goal = 1, Reward = 5000, Icon = "☢️", Category = "Streaks" },

	-- Style (the stuff that makes Neon Strike different)
	{ Id = "Slide1", Name = "Slippery", Desc = "Get a kill while sliding", Stat = "SlideKills", Goal = 1, Reward = 200, Icon = "🛝", Category = "Style" },
	{ Id = "Slide50", Name = "Ice Skater", Desc = "Get 50 sliding kills", Stat = "SlideKills", Goal = 50, Reward = 2000, Icon = "⛸️", Category = "Style" },
	{ Id = "Air1", Name = "Sky High", Desc = "Get a kill while airborne", Stat = "AirKills", Goal = 1, Reward = 200, Icon = "🪂", Category = "Style" },
	{ Id = "Air100", Name = "Air Superiority", Desc = "Get 100 airborne kills", Stat = "AirKills", Goal = 100, Reward = 3000, Icon = "🦅", Category = "Style" },
	{ Id = "Dash1", Name = "Blink Strike", Desc = "Get a kill right after dashing", Stat = "DashKills", Goal = 1, Reward = 200, Icon = "💨", Category = "Style" },
	{ Id = "Dash50", Name = "Phase Shifter", Desc = "Get 50 dash kills", Stat = "DashKills", Goal = 50, Reward = 2000, Icon = "🌀", Category = "Style" },
	{ Id = "Slam1", Name = "Meteor", Desc = "Eliminate someone with a Ground Slam", Stat = "SlamKills", Goal = 1, Reward = 400, Icon = "☄️", Category = "Style" },
	{ Id = "Slam25", Name = "Earthshaker", Desc = "Get 25 Ground Slam kills", Stat = "SlamKills", Goal = 25, Reward = 3000, Icon = "🌋", Category = "Style" },
	{ Id = "Knife1", Name = "Up Close & Personal", Desc = "Get a knife kill", Stat = "KnifeKills", Goal = 1, Reward = 200, Icon = "🔪", Category = "Style" },
	{ Id = "Knife100", Name = "Butcher", Desc = "Get 100 knife kills", Stat = "KnifeKills", Goal = 100, Reward = 4000, Icon = "🗡️", Category = "Style" },
	{ Id = "Nade1", Name = "Fire in the Hole", Desc = "Get a grenade kill", Stat = "GrenadeKills", Goal = 1, Reward = 200, Icon = "💣", Category = "Style" },
	{ Id = "Nade50", Name = "Demolitionist", Desc = "Get 50 grenade kills", Stat = "GrenadeKills", Goal = 50, Reward = 2500, Icon = "🧨", Category = "Style" },
	{ Id = "LongShot", Name = "Long Distance Call", Desc = "Kill someone from 150+ studs", Stat = "LongShots", Goal = 1, Reward = 300, Icon = "🔭", Category = "Style" },
	{ Id = "LongShot50", Name = "Ghost Sniper", Desc = "Get 50 long shot kills", Stat = "LongShots", Goal = 50, Reward = 3000, Icon = "👻", Category = "Style" },
	{ Id = "NoScope", Name = "No Scope", Desc = "Get a sniper kill without aiming", Stat = "NoScopes", Goal = 1, Reward = 500, Icon = "🙈", Category = "Style" },
	{ Id = "NoScope25", Name = "Trickshot Artist", Desc = "Get 25 no-scope kills", Stat = "NoScopes", Goal = 25, Reward = 5000, Icon = "🎪", Category = "Style" },
	{ Id = "PointBlank", Name = "In Your Face", Desc = "Get a point-blank kill", Stat = "PointBlanks", Goal = 1, Reward = 150, Icon = "👊", Category = "Style" },
	{ Id = "Collateral", Name = "Two Birds", Desc = "Kill 2 enemies with one bullet", Stat = "Collaterals", Goal = 1, Reward = 1000, Icon = "🐦", Category = "Style" },
	{ Id = "Grave", Name = "From the Grave", Desc = "Get a kill after you've died", Stat = "GraveKills", Goal = 1, Reward = 750, Icon = "⚰️", Category = "Style" },
	{ Id = "Clutch", Name = "Clutch Factor", Desc = "Get a kill with 20 HP or less", Stat = "ClutchKills", Goal = 1, Reward = 250, Icon = "❤️‍🩹", Category = "Style" },
	{ Id = "Clutch50", Name = "Cockroach", Desc = "Get 50 clutch kills", Stat = "ClutchKills", Goal = 50, Reward = 3000, Icon = "🪳", Category = "Style" },
	{ Id = "Roadkill", Name = "Hit and Run", Desc = "Run someone over with a car", Stat = "Roadkills", Goal = 1, Reward = 300, Icon = "🚗", Category = "Vehicles" },
	{ Id = "Roadkill25", Name = "Road Rage", Desc = "Get 25 roadkills", Stat = "Roadkills", Goal = 25, Reward = 3000, Icon = "🏎️", Category = "Vehicles" },
	{ Id = "CarBoom", Name = "Car Bomb", Desc = "Blow up a vehicle", Stat = "CarsDestroyed", Goal = 1, Reward = 300, Icon = "💥", Category = "Vehicles" },
	{ Id = "CarBoom25", Name = "Scrapyard", Desc = "Blow up 25 vehicles", Stat = "CarsDestroyed", Goal = 25, Reward = 3000, Icon = "🔥", Category = "Vehicles" },
	{ Id = "Drive1", Name = "Learner's Permit", Desc = "Get behind the wheel", Stat = "Drives", Goal = 1, Reward = 100, Icon = "🔑", Category = "Vehicles" },
	{ Id = "Drive50", Name = "Getaway Driver", Desc = "Drive 50 times", Stat = "Drives", Goal = 50, Reward = 2000, Icon = "🚙", Category = "Vehicles" },
	{ Id = "Explosive50", Name = "Boom Squad", Desc = "Get 50 explosive kills", Stat = "ExplosiveKills", Goal = 50, Reward = 3000, Icon = "🧨", Category = "Vehicles" },
	{ Id = "JumpPad", Name = "Frequent Flyer", Desc = "Use jump pads 100 times", Stat = "JumpPads", Goal = 100, Reward = 500, Icon = "🚀", Category = "Style" },

	-- Rivalry
	{ Id = "Revive1", Name = "Combat Medic", Desc = "Revive a downed teammate", Stat = "Revives", Goal = 1, Reward = 300, Icon = "✚", Category = "Rivalry" },
	{ Id = "Revive50", Name = "Guardian Angel", Desc = "Revive 50 teammates", Stat = "Revives", Goal = 50, Reward = 4000, Icon = "😇", Category = "Rivalry" },
	{ Id = "Knock25", Name = "Knockout Puncher", Desc = "Knock down 25 enemies on a streak", Stat = "Knockdowns", Goal = 25, Reward = 2000, Icon = "⬇️", Category = "Rivalry" },
	{ Id = "SelfRevive", Name = "Not Today", Desc = "Self-revive while downed", Stat = "SelfRevives", Goal = 1, Reward = 400, Icon = "💪", Category = "Rivalry" },
	{ Id = "Revenge", Name = "Payback", Desc = "Kill the player who last killed you", Stat = "Revenges", Goal = 1, Reward = 150, Icon = "😤", Category = "Rivalry" },
	{ Id = "Revenge50", Name = "Grudge Holder", Desc = "Get 50 revenge kills", Stat = "Revenges", Goal = 50, Reward = 2000, Icon = "📒", Category = "Rivalry" },
	{ Id = "Bounty", Name = "Bounty Hunter", Desc = "End an enemy's 5+ kill streak", Stat = "Bounties", Goal = 1, Reward = 300, Icon = "💰", Category = "Rivalry" },
	{ Id = "Bounty25", Name = "Most Wanted", Desc = "Claim 25 bounties", Stat = "Bounties", Goal = 25, Reward = 3000, Icon = "🤠", Category = "Rivalry" },
	{ Id = "FirstBlood", Name = "First Blood", Desc = "Get the first kill of a match", Stat = "FirstBloods", Goal = 1, Reward = 250, Icon = "🩸", Category = "Rivalry" },
	{ Id = "Comeback", Name = "Comeback Kid", Desc = "Get a kill after dying 3 times in a row", Stat = "Comebacks", Goal = 1, Reward = 200, Icon = "🔄", Category = "Rivalry" },

	-- Arsenal (weapon mastery achievements are generated below)
	{ Id = "Buy1", Name = "Window Shopper", Desc = "Buy a weapon from the Armory", Stat = "WeaponsBought", Goal = 1, Reward = 100, Icon = "🛒", Category = "Arsenal" },
	{ Id = "Own8", Name = "Collector", Desc = "Own 8 weapons", Stat = "WeaponsOwned", Goal = 8, Reward = 3000, Icon = "🗃️", Category = "Arsenal" },
	{ Id = "Own16", Name = "Arms Dealer", Desc = "Own 16 weapons", Stat = "WeaponsOwned", Goal = 16, Reward = 10000, Icon = "🏪", Category = "Arsenal" },

	-- Career
	{ Id = "Win1", Name = "Winner Winner", Desc = "Win a match", Stat = "Wins", Goal = 1, Reward = 500, Icon = "🏆", Category = "Career" },
	{ Id = "Win10", Name = "Champion", Desc = "Win 10 matches", Stat = "Wins", Goal = 10, Reward = 2500, Icon = "🏆", Category = "Career" },
	{ Id = "Win50", Name = "Dynasty", Desc = "Win 50 matches", Stat = "Wins", Goal = 50, Reward = 10000, Icon = "🏛️", Category = "Career" },
	{ Id = "Top3", Name = "On the Podium", Desc = "Finish top 3 in 10 matches", Stat = "Top3", Goal = 10, Reward = 1500, Icon = "🥉", Category = "Career" },
	{ Id = "Match1", Name = "Reporting for Duty", Desc = "Finish a match", Stat = "Matches", Goal = 1, Reward = 100, Icon = "🪖", Category = "Career" },
	{ Id = "Match100", Name = "Lifer", Desc = "Finish 100 matches", Stat = "Matches", Goal = 100, Reward = 5000, Icon = "📅", Category = "Career" },
	{ Id = "Level10", Name = "Rising Star", Desc = "Reach level 10", Stat = "Level", Goal = 10, Reward = 1000, Icon = "⭐", Category = "Career" },
	{ Id = "Level25", Name = "Elite", Desc = "Reach level 25", Stat = "Level", Goal = 25, Reward = 3000, Icon = "🌟", Category = "Career" },
	{ Id = "Level50", Name = "Commander", Desc = "Reach level 50", Stat = "Level", Goal = 50, Reward = 8000, Icon = "💫", Category = "Career" },
	{ Id = "Level100", Name = "Prestige Master", Desc = "Reach level 100", Stat = "Level", Goal = 100, Reward = 25000, Icon = "💎", Category = "Career" },
	{ Id = "Play60", Name = "Dedicated", Desc = "Play for 60 minutes", Stat = "Minutes", Goal = 60, Reward = 500, Icon = "⏱️", Category = "Career" },
	{ Id = "Play600", Name = "No Life", Desc = "Play for 10 hours", Stat = "Minutes", Goal = 600, Reward = 5000, Icon = "🛌", Category = "Career" },
	{ Id = "Daily7", Name = "Loyal Soldier", Desc = "Claim a 7-day login streak", Stat = "BestDaily", Goal = 7, Reward = 2000, Icon = "📆", Category = "Career" },
	{ Id = "Supporter", Name = "Supporter", Desc = "Buy anything from the Store", Stat = "RobuxPurchases", Goal = 1, Reward = 1000, Icon = "💚", Category = "Career" },
}

-- one mastery achievement per weapon + one "conquer" achievement per map
local Weapons = require(script.Parent.Weapons)
for _, id in Weapons.Order do
	local def = Weapons.Get(id)
	table.insert(list, {
		Id = "M" .. id, Name = def.Name .. " Mastery", Desc = "Get 100 kills with the " .. def.Name,
		Stat = "Kills_" .. id, Goal = 100, Reward = 1000 + (def.Level or 1) * 50, Icon = "🔫", Category = "Arsenal",
	})
end
for _, m in { { "Downtown", "🏙️" }, { "Harbor", "⚓" }, { "Timberline", "🌲" }, { "Arena", "⚡" } } do
	table.insert(list, {
		Id = "Win" .. m[1], Name = "Conquer " .. m[1], Desc = "Win a match on " .. m[1],
		Stat = "Wins_" .. m[1], Goal = 1, Reward = 750, Icon = m[2], Category = "Career",
	})
end

Achievements.List = list
Achievements.ById = {}
Achievements.ByStat = {}
Achievements.Categories = { "Combat", "Streaks", "Style", "Vehicles", "Rivalry", "Arsenal", "Career" }

for _, a in list do
	Achievements.ById[a.Id] = a
	Achievements.ByStat[a.Stat] = Achievements.ByStat[a.Stat] or {}
	table.insert(Achievements.ByStat[a.Stat], a)
end

return Achievements
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">CarBuilder</string>
          <string name="Source"><![CDATA[-- Builds detailed, drivable cars out of parts. Styles: Sedan, Sports, Jeep, Truck.
-- Front of the car is the -Z side. The model pivot is on the ground under the car.
-- Physics: 4 invisible low-friction balls carry the car (they ride up curbs);
-- the driver's client sets the velocity directly (see VehicleController).
local CarBuilder = {}

local rgb = Color3.fromRGB
local M = Enum.Material

local BLACK = rgb(22, 22, 24)
local TRIM = rgb(36, 37, 40)
local CHROME = rgb(196, 198, 204)
local TIRE = rgb(26, 26, 27)
local GLASS = rgb(70, 92, 110)
local INTERIOR = rgb(40, 38, 36)

CarBuilder.Styles = {
	Sedan = {
		W = 7.2, L = 15, Wheel = 2.9, Clear = 0.9, Belt = 3.6, HoodFront = 3.05, Roof = 5.7,
		WsBase = -1.9, RoofFront = 0.2, RoofRear = 3.1, RearBase = 4.6, TrunkTop = 3.6,
		Speed = 80, Health = 450, Colors = { rgb(30, 60, 140), rgb(200, 200, 205), rgb(25, 25, 28), rgb(140, 22, 32), rgb(90, 100, 110) },
	},
	Sports = {
		W = 7.6, L = 14.6, Wheel = 2.7, Clear = 0.55, Belt = 2.95, HoodFront = 2.8, Roof = 4.5,
		WsBase = -1.4, RoofFront = 0.9, RoofRear = 2.1, RearBase = 5.4, TrunkTop = 3.0,
		Speed = 105, Health = 350, Spoiler = true, Colors = { rgb(220, 30, 30), rgb(255, 190, 20), rgb(20, 190, 120), rgb(240, 240, 240), rgb(20, 20, 24) },
	},
	Jeep = {
		W = 7.6, L = 13.2, Wheel = 3.7, Clear = 1.7, Belt = 4.5, HoodFront = 4.5, Roof = 7.6,
		WsBase = -0.9, RoofFront = -0.6, RoofRear = 4.6, RearBase = 6.6, TrunkTop = 4.5,
		Speed = 75, Health = 600, Open = true, Colors = { rgb(80, 100, 60), rgb(150, 128, 86), rgb(60, 80, 100), rgb(30, 32, 30) },
	},
	Truck = {
		W = 8, L = 18.5, Wheel = 3.5, Clear = 1.5, Belt = 4.6, HoodFront = 4.4, Roof = 7.4,
		WsBase = -3.0, RoofFront = -1.6, RoofRear = 1.4, RearBase = 1.9, TrunkTop = 4.6,
		Speed = 65, Health = 800, Bed = true, Colors = { rgb(160, 50, 36), rgb(232, 232, 228), rgb(40, 70, 120), rgb(30, 30, 32) },
	},
}

function CarBuilder.Build(style: string, color: Color3?, anchored: boolean?)
	local s = CarBuilder.Styles[style] or CarBuilder.Styles.Sedan
	local paint = color or s.Colors[math.random(1, #s.Colors)]
	local W, L, D = s.W, s.L, s.Wheel
	local r = D / 2
	local zF = -L / 2 + D * 1.02
	local zR = L / 2 - D * 1.1
	local Wc = W - 0.7 -- cabin width

	local model = Instance.new("Model")
	model.Name = style
	model:SetAttribute("Vehicle", style)
	model:SetAttribute("MaxHealth", s.Health)
	model:SetAttribute("Health", s.Health)
	model:SetAttribute("Speed", s.Speed)

	local function part(name, size, cf, col, material, collide, class)
		local p = Instance.new(class or "Part")
		p.Name = name
		p.Size = Vector3.new(math.max(size.X, 0.05), math.max(size.Y, 0.05), math.max(size.Z, 0.05))
		p.CFrame = cf
		p.Color = col
		p.Material = material or M.SmoothPlastic
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.CanCollide = collide == true
		p.Parent = model
		return p
	end
	local function painted(name, size, cf, collide)
		local p = part(name, size, cf, paint, M.SmoothPlastic, collide)
		p.Reflectance = 0.12
		return p
	end
	local function cylX(name, length, diameter, pos, col, material)
		local p = part(name, Vector3.new(length, diameter, diameter), CFrame.new(pos), col, material)
		p.Shape = Enum.PartType.Cylinder
		return p
	end
	local function beam(name, a, b, thick, col, material)
		local len = (b - a).Magnitude
		return part(name, Vector3.new(thick, thick, len), CFrame.lookAt((a + b) / 2, b), col, material or M.SmoothPlastic)
	end
	local function glass(name, size, cf, class)
		local g = part(name, size, cf, GLASS, M.Glass, true, class)
		g.Transparency = 0.45
		g.Reflectance = 0.25
		g.CanQuery = false -- bullets pass through windows and hit the people inside
		return g
	end

	-- CHASSIS (physics root) -------------------------------------------------------
	local chassisY = s.Clear + 0.5
	local chassis = part("Chassis", Vector3.new(W - 0.6, 1, L - 1), CFrame.new(0, chassisY, 0), BLACK, M.Metal, true)
	chassis.PivotOffset = CFrame.new(0, -chassisY, 0)
	model.PrimaryPart = chassis

	-- LOWER BODY in segments so the wheel wells are open ----------------------------
	local archF0, archF1 = zF - r - 0.25, zF + r + 0.25
	local archR0, archR1 = zR - r - 0.25, zR + r + 0.25
	local bottom = s.Clear + 0.2
	local archBottom = math.max(D + 0.12, bottom)
	local frontTop = s.HoodFront
	local segments = {
		{ "FrontOverhang", -L / 2, archF0, bottom, frontTop },
		{ "FrontFender", archF0, archF1, archBottom, frontTop },
		{ "Rocker", archF1, archR0, bottom, s.Belt },
		{ "RearFender", archR0, archR1, archBottom, s.Bed and s.Belt or s.TrunkTop },
		{ "RearOverhang", archR1, L / 2, bottom, s.Bed and s.Belt or s.TrunkTop },
	}
	for _, seg in segments do
		local z0, z1, y0, y1 = seg[2], seg[3], seg[4], seg[5]
		-- the front-of-cabin area between the hood and windshield sits at belt height
		painted(seg[1], Vector3.new(W, y1 - y0, z1 - z0), CFrame.new(0, (y0 + y1) / 2, (z0 + z1) / 2), true)
	end
	-- hood: rises from the nose to the windshield base (wedge = high side at +Z)
	if s.Belt > frontTop + 0.05 then
		local hz0, hz1 = -L / 2, s.WsBase
		local wedge = part("Hood", Vector3.new(W, s.Belt - frontTop, hz1 - hz0), CFrame.new(0, frontTop + (s.Belt - frontTop) / 2, (hz0 + hz1) / 2), paint, M.SmoothPlastic, true, "WedgePart")
		wedge.Reflectance = 0.12
	end
	-- cowl between the hood and the cabin
	painted("Cowl", Vector3.new(W, s.Belt - frontTop + 0.01, math.max(0.1, archF1 - s.WsBase)), CFrame.new(0, (frontTop + s.Belt) / 2, s.WsBase + math.max(0.1, archF1 - s.WsBase) / 2), true)

	-- hood details
	beam("HoodLine", Vector3.new(-W * 0.22, frontTop + 0.02, -L / 2 + 0.3), Vector3.new(-W * 0.22, s.Belt + 0.02, s.WsBase - 0.1), 0.05, paint:Lerp(BLACK, 0.4))
	beam("HoodLine2", Vector3.new(W * 0.22, frontTop + 0.02, -L / 2 + 0.3), Vector3.new(W * 0.22, s.Belt + 0.02, s.WsBase - 0.1), 0.05, paint:Lerp(BLACK, 0.4))
	if s.Spoiler then
		for _, x in { -1.1, 1.1 } do
			part("HoodVent", Vector3.new(1.1, 0.06, 1.0), CFrame.new(x, s.Belt - 0.05, s.WsBase - 1.4) * CFrame.Angles(math.rad(-4), 0, 0), BLACK)
		end
	end

	-- GREENHOUSE ----------------------------------------------------------------------
	local cabinH = s.Roof - s.Belt
	if s.Open then
		-- jeep: upright windshield frame + roll cage
		local wsTop = s.Belt + 2.6
		glass("Windshield", Vector3.new(Wc, 2.4, 0.15), CFrame.new(0, s.Belt + 1.3, s.WsBase) * CFrame.Angles(math.rad(-10), 0, 0))
		part("WindshieldFrame", Vector3.new(Wc + 0.2, 0.2, 0.25), CFrame.new(0, wsTop, s.WsBase + 0.22), TRIM, M.Metal)
		for _, x in { -Wc / 2, Wc / 2 } do
			part("WindshieldPost", Vector3.new(0.2, 2.6, 0.25), CFrame.new(x, s.Belt + 1.3, s.WsBase + 0.1) * CFrame.Angles(math.rad(-10), 0, 0), TRIM, M.Metal)
			beam("CageSide", Vector3.new(x, wsTop, s.WsBase + 0.25), Vector3.new(x, s.Roof, 1.6), 0.24, TRIM, M.Metal)
			beam("CageTop", Vector3.new(x, s.Roof, 1.6), Vector3.new(x, s.Roof, s.RoofRear), 0.24, TRIM, M.Metal)
			beam("CageRear", Vector3.new(x, s.Roof, s.RoofRear), Vector3.new(x, s.Belt, s.RoofRear + 0.3), 0.24, TRIM, M.Metal)
			beam("CageMid", Vector3.new(x, s.Roof, 1.6), Vector3.new(x, s.Belt, 1.6), 0.24, TRIM, M.Metal)
		end
		beam("CageCross", Vector3.new(-Wc / 2, s.Roof, 1.6), Vector3.new(Wc / 2, s.Roof, 1.6), 0.24, TRIM, M.Metal)
		beam("CageCross2", Vector3.new(-Wc / 2, s.Roof, s.RoofRear), Vector3.new(Wc / 2, s.Roof, s.RoofRear), 0.24, TRIM, M.Metal)
		local bar = part("LightBar", Vector3.new(Wc * 0.8, 0.3, 0.4), CFrame.new(0, s.Roof + 0.25, 1.6), BLACK, M.Metal)
		for i = -2, 2 do
			part("RoofLight", Vector3.new(0.5, 0.22, 0.05), CFrame.new(i * 1.1, s.Roof + 0.25, 1.38), rgb(255, 250, 230), M.Neon)
		end
		bar.Name = "LightBar"
	else
		-- windshield: glass wedge from the cowl up to the roof (sides become the front side windows)
		local wsLen = s.RoofFront - s.WsBase
		glass("Windshield", Vector3.new(Wc, cabinH, wsLen), CFrame.new(0, s.Belt + cabinH / 2, s.WsBase + wsLen / 2), "WedgePart")
		local midLen = s.RoofRear - s.RoofFront
		glass("SideGlass", Vector3.new(Wc, cabinH, midLen), CFrame.new(0, s.Belt + cabinH / 2, s.RoofFront + midLen / 2))
		local rearLen = s.RearBase - s.RoofRear
		local rearDrop = s.Roof - (s.Bed and s.Belt or s.TrunkTop)
		glass("RearWindow", Vector3.new(Wc, rearDrop, rearLen), CFrame.new(0, s.Roof - rearDrop / 2, s.RoofRear + rearLen / 2) * CFrame.Angles(0, math.rad(180), 0), "WedgePart")
		painted("Roof", Vector3.new(Wc + 0.12, 0.25, midLen + 0.4), CFrame.new(0, s.Roof + 0.1, s.RoofFront + midLen / 2), true)
		-- pillars
		for _, x in { -Wc / 2, Wc / 2 } do
			beam("APillar", Vector3.new(x, s.Belt, s.WsBase), Vector3.new(x, s.Roof, s.RoofFront), 0.24, paint)
			beam("CPillar", Vector3.new(x, s.Roof, s.RoofRear), Vector3.new(x, s.Bed and s.Belt or s.TrunkTop, s.RearBase), 0.3, paint)
			part("BPillar", Vector3.new(0.22, cabinH, 0.4), CFrame.new(x, s.Belt + cabinH / 2, s.RoofFront + midLen * 0.45), TRIM)
			-- rounded roof edge
			local rail = part("RoofRail", Vector3.new(midLen + 0.3, 0.32, 0.32), CFrame.new(x, s.Roof + 0.02, s.RoofFront + midLen / 2) * CFrame.Angles(0, math.rad(90), 0), paint)
			rail.Shape = Enum.PartType.Cylinder
			rail.Reflectance = 0.12
		end
		-- wipers
		for _, x in { -1.3, 1.0 } do
			beam("Wiper", Vector3.new(x, s.Belt + 0.05, s.WsBase + 0.15), Vector3.new(x - 1.3, s.Belt + 0.35, s.WsBase + 0.5), 0.06, BLACK)
		end
	end
	-- trunk lid / fastback deck
	if not s.Bed and not s.Open then
		local deckZ0 = s.RearBase
		if L / 2 - deckZ0 > 0.2 then
			painted("TrunkLid", Vector3.new(W, 0.15, L / 2 - deckZ0), CFrame.new(0, s.TrunkTop + 0.07, (deckZ0 + L / 2) / 2), false)
		end
	end
	-- side mirrors
	for _, sx in { -1, 1 } do
		local base = Vector3.new(sx * (W / 2 + 0.05), s.Belt + 0.3, s.WsBase + 0.6)
		part("MirrorArm", Vector3.new(0.5, 0.12, 0.2), CFrame.new(base + Vector3.new(sx * 0.2, 0, 0)), TRIM)
		painted("Mirror", Vector3.new(0.25, 0.5, 0.75), CFrame.new(base + Vector3.new(sx * 0.5, 0.15, 0)), false)
		part("MirrorGlass", Vector3.new(0.27, 0.4, 0.05), CFrame.new(base + Vector3.new(sx * 0.5, 0.15, 0.39)), rgb(160, 190, 210), M.Glass)
	end

	-- SIDES: door seams, handles, skirts ---------------------------------------------
	local doorFront = s.Open and s.WsBase - 0.2 or s.WsBase + 0.3
	local doorSplit = s.Open and 1.4 or s.RoofFront + (s.RoofRear - s.RoofFront) * 0.45
	local doorRear = s.Bed and s.RoofRear + 0.3 or math.min(archR0 - 0.2, s.RoofRear + 0.6)
	for _, sx in { -1, 1 } do
		local x = sx * (W / 2 + 0.02)
		local seamH = s.Belt - bottom - 0.2
		for _, z in { doorFront, doorSplit, doorRear } do
			part("DoorSeam", Vector3.new(0.05, seamH, 0.06), CFrame.new(x, bottom + 0.1 + seamH / 2, z), BLACK)
		end
		for _, z in { doorSplit - 0.6, doorRear - 0.6 } do
			if not (s.Spoiler and z > doorSplit) then
				part("Handle", Vector3.new(0.08, 0.14, 0.55), CFrame.new(x + sx * 0.03, s.Belt - 0.55, z), CHROME, M.Metal)
			end
		end
		part("BeltTrim", Vector3.new(0.06, 0.1, archR0 - archF1), CFrame.new(x, s.Belt - 0.05, (archF1 + archR0) / 2), s.Open and paint or CHROME, M.Metal)
		part("SideSkirt", Vector3.new(0.12, 0.4, archR0 - archF1), CFrame.new(x, bottom + 0.2, (archF1 + archR0) / 2), TRIM)
		-- fender flares on off-road / sports styles
		if s.Open or s.Bed or s.Spoiler then
			for _, z in { zF, zR } do
				part("FenderFlare", Vector3.new(0.35, 0.35, D + 0.8), CFrame.new(sx * (W / 2 + 0.15), archBottom + 0.12, z), s.Spoiler and paint or TRIM)
			end
		end
	end

	-- FRONT --------------------------------------------------------------------------
	local nose = -L / 2
	part("Grille", Vector3.new(W * 0.48, frontTop - bottom - 0.7, 0.12), CFrame.new(0, bottom + 0.45 + (frontTop - bottom - 0.7) / 2, nose - 0.04), BLACK, M.Metal)
	for i = 1, 3 do
		part("GrilleBar", Vector3.new(W * 0.48, 0.07, 0.06), CFrame.new(0, bottom + 0.45 + i * (frontTop - bottom - 0.7) / 4, nose - 0.1), s.Spoiler and BLACK or CHROME, M.Metal)
	end
	part("BumperF", Vector3.new(W + 0.15, 0.7, 0.45), CFrame.new(0, bottom + 0.35, nose - 0.12), s.Open and BLACK or paint:Lerp(BLACK, 0.15), M.SmoothPlastic, true)
	-- rounded bumper face + rounded body corners (so the car isn't a box)
	local bumperCol = s.Open and BLACK or paint:Lerp(BLACK, 0.15)
	cylX("BumperFRound", W - 0.2, 0.7, Vector3.new(0, bottom + 0.35, nose - 0.32), bumperCol, M.SmoothPlastic)
	for _, sx in { -1, 1 } do
		local h = frontTop - bottom
		local corner = part("CornerF", Vector3.new(h, 0.8, 0.8), CFrame.new(sx * (W / 2 - 0.3), bottom + h / 2, nose + 0.1) * CFrame.Angles(0, 0, math.rad(90)), paint)
		corner.Shape = Enum.PartType.Cylinder
		corner.Reflectance = 0.12
	end
	part("PlateF", Vector3.new(1.6, 0.5, 0.05), CFrame.new(0, bottom + 0.4, nose - 0.36), rgb(240, 240, 240))
	for _, sx in { -1, 1 } do
		local hx = sx * (W / 2 - 0.95)
		local hy = frontTop - 0.42
		if s.Open then
			cylX("HeadlightRing", 0.2, 0.95, Vector3.new(0, 0, 0), CHROME, M.Metal).CFrame = CFrame.new(hx, hy, nose - 0.08) * CFrame.Angles(0, math.rad(90), 0)
			cylX("Headlight", 0.22, 0.75, Vector3.new(0, 0, 0), rgb(255, 250, 230), M.Neon).CFrame = CFrame.new(hx, hy, nose - 0.1) * CFrame.Angles(0, math.rad(90), 0)
		else
			part("HeadlightHousing", Vector3.new(1.5, 0.55, 0.22), CFrame.new(hx, hy, nose - 0.06), rgb(200, 210, 220), M.Glass).Transparency = 0.3
			part("Headlight", Vector3.new(0.6, 0.32, 0.12), CFrame.new(hx - sx * 0.3, hy, nose - 0.02), rgb(255, 250, 230), M.Neon)
			part("DRL", Vector3.new(1.3, 0.07, 0.1), CFrame.new(hx, hy - 0.22, nose - 0.05), rgb(255, 255, 255), M.Neon)
		end
		part("FogLight", Vector3.new(0.4, 0.22, 0.08), CFrame.new(sx * (W / 2 - 1.1), bottom + 0.35, nose - 0.36), rgb(255, 240, 200), M.Neon)
	end
	local lightPart = model:FindFirstChild("Headlight")
	if lightPart then
		local spot = Instance.new("SpotLight")
		spot.Range = 50
		spot.Brightness = 3
		spot.Angle = 60
		spot.Face = s.Open and Enum.NormalId.Right or Enum.NormalId.Front
		spot.Parent = lightPart
	end
	if s.Open or s.Bed then
		-- bull bar
		for _, sx in { -1.4, 1.4 } do
			part("BullBarPost", Vector3.new(0.2, 1.8, 0.2), CFrame.new(sx, bottom + 1.1, nose - 0.6), BLACK, M.Metal)
		end
		part("BullBar", Vector3.new(3.4, 0.2, 0.2), CFrame.new(0, bottom + 2, nose - 0.6), BLACK, M.Metal)
	end

	-- REAR -----------------------------------------------------------------------------
	local tail = L / 2
	local tailTop = s.Bed and s.Belt or s.TrunkTop
	part("BumperR", Vector3.new(W + 0.15, 0.7, 0.45), CFrame.new(0, bottom + 0.35, tail + 0.12), s.Open and BLACK or paint:Lerp(BLACK, 0.15), M.SmoothPlastic, true)
	cylX("BumperRRound", W - 0.2, 0.7, Vector3.new(0, bottom + 0.35, tail + 0.32), s.Open and BLACK or paint:Lerp(BLACK, 0.15), M.SmoothPlastic)
	for _, sx in { -1, 1 } do
		local h = tailTop - bottom
		local corner = part("CornerR", Vector3.new(h, 0.8, 0.8), CFrame.new(sx * (W / 2 - 0.3), bottom + h / 2, tail - 0.1) * CFrame.Angles(0, 0, math.rad(90)), paint)
		corner.Shape = Enum.PartType.Cylinder
		corner.Reflectance = 0.12
	end
	part("PlateR", Vector3.new(1.6, 0.5, 0.05), CFrame.new(0, bottom + 1.0, tail + 0.03), rgb(240, 240, 240))
	part("PlateStripe", Vector3.new(1.6, 0.1, 0.06), CFrame.new(0, bottom + 1.2, tail + 0.04), rgb(30, 60, 150))
	for _, sx in { -1, 1 } do
		local tx = sx * (W / 2 - 0.8)
		part("Taillight", Vector3.new(1.4, 0.5, 0.1), CFrame.new(tx, tailTop - 0.45, tail + 0.03), rgb(255, 30, 30), M.Neon)
		part("ReverseLight", Vector3.new(0.4, 0.2, 0.1), CFrame.new(tx - sx * 0.4, tailTop - 0.85, tail + 0.03), rgb(240, 240, 240), M.Neon)
		cylX("Exhaust", 0.6, 0.32, Vector3.new(0, 0, 0), CHROME, M.Metal).CFrame = CFrame.new(sx * (W / 2 - 1.6), bottom + 0.1, tail + 0.25) * CFrame.Angles(0, math.rad(90), 0)
	end
	if s.Spoiler then
		painted("Spoiler", Vector3.new(W - 0.6, 0.2, 1.3), CFrame.new(0, tailTop + 1.1, tail - 0.8), false)
		for _, x in { -2.3, 2.3 } do
			part("SpoilerLeg", Vector3.new(0.25, 1.0, 0.4), CFrame.new(x, tailTop + 0.55, tail - 0.8), BLACK)
		end
		for x = -2, 2 do
			part("Diffuser", Vector3.new(0.08, 0.35, 0.8), CFrame.new(x * 0.8, bottom + 0.1, tail - 0.1), BLACK)
		end
		part("Stripe", Vector3.new(0.7, 0.03, L * 0.62), CFrame.new(-0.55, s.Belt + 0.02, -L * 0.18), rgb(245, 245, 245))
		part("Stripe2", Vector3.new(0.7, 0.03, L * 0.62), CFrame.new(0.55, s.Belt + 0.02, -L * 0.18), rgb(245, 245, 245))
	end
	if s.Open then
		-- spare wheel on the tailgate
		cylX("Spare", 1.0, D * 0.9, Vector3.new(0, 0, 0), TIRE, M.Rubber).CFrame = CFrame.new(0, s.Belt - 0.3, tail + 0.55) * CFrame.Angles(0, math.rad(90), 0)
		cylX("SpareRim", 1.04, D * 0.5, Vector3.new(0, 0, 0), CHROME, M.Metal).CFrame = CFrame.new(0, s.Belt - 0.3, tail + 0.56) * CFrame.Angles(0, math.rad(90), 0)
		-- snorkel
		local sx = W / 2 + 0.2
		part("Snorkel", Vector3.new(0.35, 2.6, 0.35), CFrame.new(sx, s.Belt + 1.1, s.WsBase + 0.1), BLACK)
	end

	-- PICKUP BED -----------------------------------------------------------------------
	if s.Bed then
		local z0 = s.RearBase + 0.2
		local len = L / 2 - z0
		part("BedFloor", Vector3.new(W - 0.6, 0.2, len), CFrame.new(0, s.Belt - 1.6, z0 + len / 2), rgb(40, 40, 42), M.DiamondPlate)
		for _, sx in { -1, 1 } do
			part("BedRail", Vector3.new(0.18, 0.12, len), CFrame.new(sx * (W / 2 - 0.1), s.Belt + 0.08, z0 + len / 2), CHROME, M.Metal)
		end
		painted("Tailgate", Vector3.new(W, 1.7, 0.25), CFrame.new(0, s.Belt - 0.85, L / 2 - 0.12), true)
		part("TowHitch", Vector3.new(0.4, 0.4, 0.9), CFrame.new(0, bottom + 0.1, tail + 0.6), BLACK, M.Metal)
		for i = -2, 2 do
			part("CabLight", Vector3.new(0.4, 0.15, 0.25), CFrame.new(i * 0.9, s.Roof + 0.28, s.RoofFront + 0.2), rgb(255, 170, 30), M.Neon)
		end
	end

	-- INTERIOR -------------------------------------------------------------------------
	local seatZ = (s.Open and 1.6 or s.RoofFront + (s.RoofRear - s.RoofFront) * 0.55)
	local seatY = s.Belt - 1.55
	part("Dashboard", Vector3.new(Wc - 0.2, 0.9, 1.1), CFrame.new(0, s.Belt - 0.25, s.WsBase + 0.75), INTERIOR)
	part("Floor", Vector3.new(Wc - 0.2, 0.2, (s.RearBase - s.WsBase) * 0.8), CFrame.new(0, s.Clear + 1.05, (s.WsBase + s.RearBase) / 2), INTERIOR)
	for _, sx in { -1, 1 } do
		part("SeatBack", Vector3.new(1.7, 2.2, 0.4), CFrame.new(sx * Wc * 0.24, seatY + 1.3, seatZ + 1.0) * CFrame.Angles(math.rad(-12), 0, 0), INTERIOR, M.Fabric)
		part("Headrest", Vector3.new(1.0, 0.6, 0.35), CFrame.new(sx * Wc * 0.24, seatY + 2.65, seatZ + 1.25), INTERIOR, M.Fabric)
	end
	local wheel = part("SteeringWheel", Vector3.new(0.12, 1.1, 1.1), CFrame.new(-Wc * 0.24, s.Belt + 0.15, s.WsBase + 1.45) * CFrame.Angles(math.rad(-25), math.rad(90), 0), BLACK)
	wheel.Shape = Enum.PartType.Cylinder

	-- WHEELS ---------------------------------------------------------------------------
	local tireW = s.Open and 1.5 or (s.Bed and 1.4 or 1.25)
	for _, sx in { -1, 1 } do
		for _, z in { zF, zR } do
			local cx = sx * (W / 2 - tireW / 2 + 0.25)
			local center = Vector3.new(cx, r, z)
			cylX("Tire", tireW, D, center, TIRE, M.Rubber)
			cylX("Sidewall", tireW + 0.02, D * 0.8, center, rgb(36, 36, 38), M.Rubber)
			cylX("Rim", tireW + 0.04, D * 0.62, center, s.Spoiler and rgb(40, 40, 44) or (s.Open and rgb(70, 70, 74) or CHROME), M.Metal)
			cylX("Hub", tireW + 0.1, D * 0.18, center, rgb(60, 60, 64), M.Metal)
			local face = cx + sx * (tireW / 2 + 0.04)
			for k = 0, 4 do
				part("Spoke", Vector3.new(0.06, D * 0.24, 0.16), CFrame.new(face, r, z) * CFrame.Angles(math.rad(k * 72), 0, 0) * CFrame.new(0, D * 0.17, 0), s.Spoiler and rgb(25, 25, 28) or rgb(150, 152, 158), M.Metal)
			end
			if s.Spoiler then
				part("Caliper", Vector3.new(0.1, D * 0.2, D * 0.18), CFrame.new(face - sx * 0.05, r + D * 0.18, z - D * 0.12), rgb(220, 30, 30))
			end
			-- physics support (invisible)
			local ball = part("Support", Vector3.new(2.4, 2.4, 2.4), CFrame.new(sx * W * 0.32, 1.2, z), BLACK, M.SmoothPlastic, true)
			ball.Shape = Enum.PartType.Ball
			ball.Transparency = 1
			ball.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.02, 0, 100, 1)
		end
		-- wheel well liners (dark, behind the tires)
		for _, z in { zF, zR } do
			part("WellLiner", Vector3.new(0.1, 0.5, D + 0.4), CFrame.new(sx * (W / 2 - tireW - 0.1), archBottom - 0.1, z), BLACK)
		end
	end

	-- SEATS (functional) -----------------------------------------------------------
	local seat = Instance.new("VehicleSeat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(1.7, 0.5, 1.8)
	seat.CFrame = CFrame.new(-Wc * 0.24, seatY, seatZ)
	seat.Color = INTERIOR
	seat.Material = M.Fabric
	seat.HeadsUpDisplay = false
	seat.MaxSpeed = 0
	seat.Parent = model
	local passenger = Instance.new("Seat")
	passenger.Name = "PassengerSeat"
	passenger.Size = Vector3.new(1.7, 0.5, 1.8)
	passenger.CFrame = CFrame.new(Wc * 0.24, seatY, seatZ)
	passenger.Color = INTERIOR
	passenger.Material = M.Fabric
	passenger.Parent = model

	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = anchored == true
			if p ~= chassis then
				p.Massless = not p.CanCollide
				local w = Instance.new("WeldConstraint")
				w.Part0 = chassis
				w.Part1 = p
				w.Parent = p
			end
		end
	end
	return model
end

return CarBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Global game tuning. Change numbers here to rebalance the whole game.
local Config = {}

Config.GameName = "NEON STRIKE"
Config.ModeName = "TEAM DEATHMATCH" -- default; the live mode is ReplicatedStorage.Mode

-- Match flow
Config.IntermissionLength = 20 -- warmup before each match (seconds)
Config.MatchLength = 300 -- 5 minute matches
Config.ResultsLength = 10 -- podium / match summary
Config.VoteLength = 5 -- pre-match map + mode vote (seconds)
Config.KillsToWin = 30 -- (unused in team mode)
Config.TeamKillsToWin = 75 -- first team to this many kills wins
Config.MaxPlayers = 30 -- set the same number in Game Settings > Places

-- Bots fill the server up to this many combatants so it is never empty
Config.BotFill = 12 -- bots keep both teams filled up to this many fighters total
Config.BotDamageMultiplier = 0.45
Config.BotAccuracy = 0.38

-- Teams (spawns are at opposite ends of every map)
Config.Teams = {
	A = { Name = "ALPHA", Color = Color3.fromRGB(40, 140, 255), Brick = "Bright blue" },
	B = { Name = "BRAVO", Color = Color3.fromRGB(255, 70, 70), Brick = "Bright red" },
	C = { Name = "CHARLIE", Color = Color3.fromRGB(70, 220, 90), Brick = "Lime green" },
}

-- Game modes (players vote for the next mode on the results screen)
Config.Modes = {
	FFA = { Name = "FREE FOR ALL", Short = "FFA", Teams = {}, KillsToWin = 30, Desc = "Everyone for themselves. Spawns all over the map." },
	TDM = { Name = "TEAM DEATHMATCH", Short = "TDM", Teams = { "A", "B" }, KillsToWin = 75, Desc = "Alpha vs Bravo. Spawns at opposite ends." },
	TTDM = { Name = "TRIPLE TEAM DEATHMATCH", Short = "3TDM", Teams = { "A", "B", "C" }, KillsToWin = 60, Desc = "Alpha vs Bravo vs Charlie. Three bases." },
}
Config.ModeOrder = { "TDM", "FFA", "TTDM" }

-- Downed / revive: only players on a 5+ kill streak get knocked down instead of dying
Config.DownStreak = 5
Config.DownedHealth = 60 -- downed players bleed this much HP
Config.BleedRate = 3 -- HP per second (about 20 seconds to bleed out)
Config.ReviveTime = 2.5 -- seconds a teammate holds E
Config.SelfReviveTime = 4 -- seconds to hold F for a self revive (once per down)
Config.ReviveHealth = 0.5 -- share of max HP after a revive

-- Players
Config.BaseHealth = 100
Config.BaseWalkSpeed = 16
Config.SprintSpeed = 24
Config.AimWalkSpeed = 11
Config.RespawnTime = 4
Config.InstantRespawnTime = 0.5
Config.SpawnProtection = 2
Config.RegenDelay = 5
Config.RegenRate = 14 -- hp per second once regen starts

-- Movement abilities
Config.DashCooldown = 3
Config.DashSpeed = 95
Config.DashDuration = 0.18
Config.SlideDuration = 0.9
Config.SlideCooldown = 1.1
Config.SlideSpeed = 58
Config.AirJumps = 1 -- double jump for everyone, Triple Jump pass adds one
Config.AirJumpPower = 48
Config.SlamCooldown = 6
Config.SlamRadius = 14
Config.SlamDamage = 75
Config.SlamMinHeight = 8

-- Equipment
Config.Grenades = 2
Config.GrenadeRegen = 20 -- seconds per grenade
Config.GrenadeFuse = 2.2
Config.GrenadeRadius = 18
Config.GrenadeDamage = 120
Config.KnifeDamage = 100
Config.KnifeRange = 8
Config.KnifeCooldown = 0.7

-- Rewards
Config.KillScore = 100
Config.KillCash = 25
Config.KillXP = 100
Config.AssistScore = 50
Config.AssistCash = 10
Config.AssistXP = 40
Config.WinCash = 250
Config.WinXP = 1000
Config.Top3Cash = 100
Config.MatchPlayXP = 250
Config.MultiKillWindow = 4
Config.StartingCash = 500
Config.MaxLevel = 100
Config.DailyRewards = { 100, 150, 250, 400, 600, 900, 1500 }

function Config.XPForLevel(level: number): number
	return 500 + level * 250
end

-- Killstreaks are awarded automatically when the streak is reached.
Config.Killstreaks = {
	{ Id = "UAV", Kills = 3, Name = "UAV RADAR", Icon = "📡", Duration = 20 },
	{ Id = "Overdrive", Kills = 5, Name = "OVERDRIVE", Icon = "⚡", Duration = 15 },
	{ Id = "Airstrike", Kills = 7, Name = "AIRSTRIKE", Icon = "✈️" },
	{ Id = "InfiniteAmmo", Kills = 15, Name = "INFINITE AMMO", Icon = "♾️" },
	{ Id = "Nuke", Kills = 20, Name = "TACTICAL NUKE", Icon = "☢️" },
}
Config.AirstrikeRadius = 16
Config.AirstrikeDamage = 160
Config.NukeCountdown = 10

-- Map info for menus (the maps themselves live in ServerScriptService.Server.Maps)
Config.Maps = {
	Downtown = { Name = "DOWNTOWN", Icon = "🏙️", Desc = "City streets & rooftops" },
	Harbor = { Name = "HARBOR", Icon = "⚓", Desc = "Containers, cranes & a cargo ship" },
	Timberline = { Name = "TIMBERLINE", Icon = "🌲", Desc = "Forest river valley" },
	Arena = { Name = "NEON ARENA", Icon = "⚡", Desc = "Fast close-quarters arena" },
}

-- Set true to pretend you own every game pass while testing in Studio.
Config.StudioGrantAllPasses = false

Config.Colors = {
	Accent = Color3.fromRGB(255, 198, 26),
	Accent2 = Color3.fromRGB(0, 204, 255),
	Red = Color3.fromRGB(255, 64, 72),
	Green = Color3.fromRGB(70, 230, 120),
	Gold = Color3.fromRGB(255, 205, 60),
	Purple = Color3.fromRGB(170, 90, 255),
	Robux = Color3.fromRGB(0, 178, 110),
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">GunBuilder</string>
          <string name="Source"><![CDATA[-- Builds detailed gun models out of parts, modeled after real-world firearm
-- designs (plus a few sci-fi ones). No uploaded meshes needed.
--
-- Conventions: the Handle (receiver/frame) sits at the origin, the barrel points
-- down -Z, +Y is up and +X is the right-hand (ejection) side.
-- Attachments on the Handle: Muzzle, Sight, GripPoint, ForePoint, Eject.
-- Moving parts carry an "Anim" attribute that WeaponController animates:
--   Slide / Bolt   - snap back on every shot
--   Pump           - racks back after a shot (pump shotguns)
--   BoltAction     - lifts & pulls back after a shot (bolt-action rifles)
--   Recoil         - recoiling barrel (Barrett)
--   Cylinder       - rotates one chamber per shot around the model's CylinderPivot
--   Barrels        - spins continuously while firing around BarrelsPivot (minigun)
--   Break          - tips open around BreakPivot while reloading (double-barrel)
--   Mag            - drops out & returns while reloading
--   Payload        - hidden while the weapon is empty (RPG warhead)
--   Trigger / Hammer - small movement while firing
--   Glow           - flashes bright on each shot (sci-fi)
local Weapons = require(script.Parent.Weapons)

local GunBuilder = {}

local rgb = Color3.fromRGB
local M = Enum.Material
local GOLD = rgb(255, 196, 40)
local STEEL = rgb(78, 81, 88)
local DARK = rgb(44, 46, 50)
local BLACK = rgb(30, 31, 34)
local POLY = rgb(58, 60, 64)
local WOOD = rgb(128, 78, 42)
local WOOD_DARK = rgb(96, 58, 32)
local TAN = rgb(176, 150, 108)
local OD = rgb(84, 92, 62)
local CHROME = rgb(196, 198, 204)
local BRASS = rgb(200, 160, 70)
local ALONG_Z = CFrame.Angles(0, math.rad(90), 0) -- cylinders run along X; rotate onto Z

local STYLES = {
	Striker = "M4", Vanguard = "AK", Viper = "MP5", Tempest = "PDW", Hornet = "FAMAS", Warden = "SCAR",
	Ranger = "SVD", Inferno = "M249", Longbow = "AWM", Titan = "Barrett", Brute = "Pump", Razor = "AA12",
	Duke = "Double", Reaper = "Minigun", Havoc = "RPG", Thumper = "M32", Railgun = "Railgun",
	Sidekick = "Pistol", Stinger = "Uzi", HandCannon = "Deagle", Judge = "Revolver", Arc = "Energy",
	RayGun = "RayGun", PlasmaRifle = "Plasma", VoidCannon = "Void",
}

function GunBuilder.Build(weaponId: string, golden: boolean?)
	local def = Weapons.Get(weaponId)
	local look = def.Look
	local style = STYLES[weaponId] or "M4"
	local L = look.Length
	local accent = look.Accent
	local accentMat = look.Neon and M.Neon or M.SmoothPlastic

	local model = Instance.new("Model")
	model.Name = weaponId
	local parts = {}

	local function make(name, size, cf, color, material, shape, anim)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = Vector3.new(math.max(size.X, 0.03), math.max(size.Y, 0.03), math.max(size.Z, 0.03))
		p.CFrame = cf
		p.Color = color or STEEL
		p.Material = material or M.Metal
		if shape then
			p.Shape = shape
		end
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.CastShadow = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		if anim then
			p:SetAttribute("Anim", anim)
		end
		p.Parent = model
		table.insert(parts, p)
		return p
	end
	local function at(x, y, z)
		return CFrame.new(x, y, z)
	end
	-- Grips, stocks, handguards and mags get rounded edges: a rounded-rectangle
	-- prism (two crossed boxes + a cylinder on each long edge) instead of a plain box.
	local ROUNDED = {
		Grip = true, GripBack = true, Stock = true, StockTop = true, StockToe = true, StockButt = true, StockComb = true,
		StockBottom = true, Handguard = true, HandguardTip = true, Mag = true, Mag2 = true, Foregrip = true, Pistol = true,
	}
	local function box(name, size, cf, color, material, anim)
		if not ROUNDED[name] then
			return make(name, size, cf, color, material, nil, anim)
		end
		local dims = { size.X, size.Y, size.Z }
		local long = 1
		for i = 2, 3 do
			if dims[i] > dims[long] then
				long = i
			end
		end
		local a, b = (long % 3) + 1, ((long + 1) % 3) + 1 -- the two cross-section axes
		local r = math.min(dims[a], dims[b]) * 0.3
		if r < 0.035 then
			return make(name, size, cf, color, material, nil, anim)
		end
		local function vec(t)
			return Vector3.new(t[1], t[2], t[3])
		end
		local sa, sb = table.clone(dims), table.clone(dims)
		sa[a] -= 2 * r
		sb[b] -= 2 * r
		local main = make(name, vec(sa), cf, color, material, nil, anim)
		make(name .. "R", vec(sb), cf, color, material, nil, anim)
		-- cylinders run along X by default; rotate them onto the long axis
		local rot = long == 1 and CFrame.identity or (long == 2 and CFrame.Angles(0, 0, math.rad(90)) or CFrame.Angles(0, math.rad(90), 0))
		for _, ua in { -1, 1 } do
			for _, ub in { -1, 1 } do
				local off = { 0, 0, 0 }
				off[a] = ua * (dims[a] / 2 - r)
				off[b] = ub * (dims[b] / 2 - r)
				make(name .. "Edge", Vector3.new(dims[long], 2 * r, 2 * r), cf * CFrame.new(vec(off)) * rot, color, material, Enum.PartType.Cylinder, anim)
			end
		end
		return main
	end
	-- cylinder along the gun's Z axis
	local function cyl(name, length, d, cf, color, material, anim)
		return make(name, Vector3.new(length, d, d), cf * ALONG_Z, color, material, Enum.PartType.Cylinder, anim)
	end
	-- cylinder along the gun's X axis (sideways drums, knobs)
	local function cylX(name, length, d, cf, color, material, anim)
		return make(name, Vector3.new(length, d, d), cf, color, material, Enum.PartType.Cylinder, anim)
	end
	local function ball(name, d, cf, color, material, anim)
		return make(name, Vector3.new(d, d, d), cf, color, material, Enum.PartType.Ball, anim)
	end

	local handle = make("Handle", Vector3.new(0.3, 0.38, L * 0.34), at(0, 0, 0), STEEL, M.Metal)
	table.remove(parts) -- the handle is not welded to itself
	model.PrimaryPart = handle

	local info = {
		Grip = Vector3.new(0, -0.45, 0.3), Fore = Vector3.new(0, -0.2, -0.9),
		Muzzle = Vector3.new(0, 0.05, -L / 2 - look.Barrel), Sight = 0.42,
		Eject = Vector3.new(0.17, 0.06, 0), Shell = "Brass",
	}

	-------------------------------------------------------------- shared parts
	local function rail(z0, z1, y, x, sideways)
		local len = z1 - z0
		if sideways then
			box("SideRail", Vector3.new(0.05, 0.12, len), at(x, y, (z0 + z1) / 2), BLACK)
			return
		end
		box("Rail", Vector3.new(0.2, 0.06, len), at(x or 0, y, (z0 + z1) / 2), BLACK)
		local count = math.min(14, math.floor(len / 0.11))
		for i = 0, count - 1 do
			box("RailSlot", Vector3.new(0.23, 0.04, 0.04), at(x or 0, y + 0.04, z0 + 0.06 + i * (len / count)), BLACK)
		end
	end
	local function barrel(z0, length, d, y)
		cyl("Barrel", length, d, at(0, y, z0 - length / 2), DARK)
		info.Muzzle = Vector3.new(0, y, z0 - length)
	end
	local function birdcage(d)
		local z, y = info.Muzzle.Z, info.Muzzle.Y
		cyl("FlashHider", 0.26, d, at(0, y, z - 0.13), BLACK)
		for i = 1, 4 do
			local a = i / 4 * math.pi * 2
			box("FlashSlot", Vector3.new(0.03, 0.03, 0.18), at(math.cos(a) * d / 2, y + math.sin(a) * d / 2, z - 0.15), rgb(15, 15, 16))
		end
		info.Muzzle = Vector3.new(0, y, z - 0.26)
	end
	local function brake(d, len, wide)
		local z, y = info.Muzzle.Z, info.Muzzle.Y
		if wide then
			box("Brake", Vector3.new(d * 1.6, d, len), at(0, y, z - len / 2), BLACK)
			for i = 1, 2 do
				box("BrakePort", Vector3.new(d * 1.62, d * 0.55, len * 0.18), at(0, y, z - len * (i / 3)), rgb(12, 12, 12))
			end
		else
			cyl("Brake", len, d, at(0, y, z - len / 2), BLACK)
			for i = 1, 3 do
				box("BrakePort", Vector3.new(d + 0.03, 0.04, 0.05), at(0, y, z - len * (i / 4)), rgb(12, 12, 12))
			end
		end
		info.Muzzle = Vector3.new(0, y, z - len)
	end
	local function grip(z, angle, color, material)
		local a = math.rad(angle or -18)
		box("Grip", Vector3.new(0.22, 0.6, 0.3), at(0, -0.46, z) * CFrame.Angles(a, 0, 0), color or POLY, material or M.SmoothPlastic)
		box("GripBack", Vector3.new(0.2, 0.42, 0.06), at(0, -0.44, z + 0.17) * CFrame.Angles(a, 0, 0), color or POLY, material or M.SmoothPlastic)
		box("GripCap", Vector3.new(0.23, 0.05, 0.32), at(0, -0.77, z + 0.1) * CFrame.Angles(a, 0, 0), BLACK)
		info.Grip = Vector3.new(0, -0.46, z)
	end
	local function trigger(z)
		box("TriggerGuard", Vector3.new(0.05, 0.05, 0.45), at(0, -0.37, z - 0.2), BLACK)
		box("TriggerGuardFront", Vector3.new(0.05, 0.17, 0.05), at(0, -0.29, z - 0.42), BLACK)
		box("Trigger", Vector3.new(0.04, 0.16, 0.05), at(0, -0.27, z - 0.18) * CFrame.Angles(math.rad(14), 0, 0), CHROME, M.Metal, "Trigger")
	end
	local function ejectionPort(z, y)
		y = y or 0.06
		box("EjectionPort", Vector3.new(0.03, 0.12, 0.3), at(0.155, y, z), rgb(18, 18, 20))
		box("BoltCarrier", Vector3.new(0.03, 0.08, 0.24), at(0.165, y, z), CHROME, M.Metal, "Bolt")
		info.Eject = Vector3.new(0.18, y, z)
	end
	local function stanag(z, curve, steel)
		local c = steel and rgb(70, 70, 66) or POLY
		box("Magwell", Vector3.new(0.27, 0.2, 0.42), at(0, -0.29, z), STEEL)
		box("Mag", Vector3.new(0.19, 0.48, 0.33), at(0, -0.56, z - 0.04) * CFrame.Angles(math.rad(8 * curve), 0, 0), c, M.Metal, "Mag")
		box("Mag2", Vector3.new(0.19, 0.44, 0.32), at(0, -0.93, z - 0.04 - 0.1 * curve) * CFrame.Angles(math.rad(22 * curve), 0, 0), c, M.Metal, "Mag")
		if steel then
			for i = 1, 3 do
				box("MagRib", Vector3.new(0.2, 0.04, 0.24), at(0, -0.5 - i * 0.18, z - 0.02 - i * 0.04 * curve) * CFrame.Angles(math.rad(14 * curve), 0, 0), rgb(50, 50, 48), M.Metal, "Mag")
			end
		end
		box("MagBase", Vector3.new(0.22, 0.05, 0.35), at(0, -1.15, z - 0.06 - 0.22 * curve) * CFrame.Angles(math.rad(26 * curve), 0, 0), BLACK, M.Metal, "Mag")
	end
	local function straightMag(z, length, width, color)
		box("Magwell", Vector3.new(0.27, 0.2, 0.42), at(0, -0.29, z), STEEL)
		box("Mag", Vector3.new(width or 0.2, length, 0.34), at(0, -0.32 - length / 2, z - 0.03) * CFrame.Angles(math.rad(5), 0, 0), color or POLY, M.SmoothPlastic, "Mag")
		box("MagBase", Vector3.new((width or 0.2) + 0.03, 0.05, 0.36), at(0, -0.34 - length, z - 0.06) * CFrame.Angles(math.rad(5), 0, 0), BLACK, M.Metal, "Mag")
	end
	local function m4Stock(zRear, color)
		cyl("BufferTube", 0.62, 0.17, at(0, 0.02, zRear + 0.31), BLACK)
		box("Stock", Vector3.new(0.23, 0.36, 0.55), at(0, -0.05, zRear + 0.72), color or POLY, M.SmoothPlastic)
		box("StockTop", Vector3.new(0.21, 0.14, 0.5), at(0, 0.15, zRear + 0.7), color or POLY, M.SmoothPlastic)
		box("StockLatch", Vector3.new(0.1, 0.12, 0.2), at(0, -0.24, zRear + 0.58), BLACK)
		box("ButtPad", Vector3.new(0.25, 0.5, 0.07), at(0, -0.03, zRear + 1.01), BLACK, M.Rubber)
		box("SlingLoop", Vector3.new(0.05, 0.12, 0.12), at(0, -0.27, zRear + 0.95), BLACK)
	end
	local function fixedStock(zRear, length, color, material)
		box("Stock", Vector3.new(0.24, 0.34, length), at(0, -0.06, zRear + length / 2) * CFrame.Angles(math.rad(5), 0, 0), color, material)
		box("StockToe", Vector3.new(0.23, 0.3, length * 0.55), at(0, -0.27, zRear + length * 0.7) * CFrame.Angles(math.rad(-8), 0, 0), color, material)
		box("ButtPad", Vector3.new(0.26, 0.6, 0.07), at(0, -0.16, zRear + length + 0.02), BLACK, M.Rubber)
	end
	local function optic(kind, z, y)
		if kind == "RedDot" then
			box("OpticMount", Vector3.new(0.17, 0.08, 0.26), at(0, y + 0.08, z), BLACK)
			cyl("Optic", 0.34, 0.26, at(0, y + 0.27, z), BLACK)
			cylX("OpticKnob", 0.08, 0.1, at(0.15, y + 0.27, z), BLACK)
			local lens = cyl("Lens", 0.02, 0.2, at(0, y + 0.27, z - 0.17), rgb(120, 200, 255), M.Glass)
			lens.Transparency = 0.4
			box("Dot", Vector3.new(0.03, 0.03, 0.02), at(0, y + 0.27, z + 0.1), rgb(255, 40, 40), M.Neon)
			info.Sight = y + 0.27
		elseif kind == "Holo" then
			box("HoloBase", Vector3.new(0.24, 0.1, 0.44), at(0, y + 0.09, z), BLACK)
			box("HoloHood", Vector3.new(0.26, 0.04, 0.34), at(0, y + 0.43, z - 0.04), BLACK)
			box("HoloSideL", Vector3.new(0.03, 0.32, 0.3), at(-0.12, y + 0.27, z - 0.04), BLACK)
			box("HoloSideR", Vector3.new(0.03, 0.32, 0.3), at(0.12, y + 0.27, z - 0.04), BLACK)
			box("HoloButtons", Vector3.new(0.18, 0.06, 0.08), at(0, y + 0.16, z + 0.2), DARK)
			local g = box("HoloGlass", Vector3.new(0.2, 0.22, 0.02), at(0, y + 0.27, z - 0.16), rgb(150, 220, 255), M.Glass)
			g.Transparency = 0.5
			box("Reticle", Vector3.new(0.03, 0.03, 0.01), at(0, y + 0.27, z - 0.15), rgb(255, 60, 60), M.Neon)
			info.Sight = y + 0.27
		elseif kind == "PSO" then -- side-mounted scope (SVD)
			box("PSOMount", Vector3.new(0.12, 0.3, 0.5), at(-0.2, y - 0.05, z), BLACK)
			local sy = y + 0.2
			cyl("ScopeTube", 0.9, 0.17, at(-0.12, sy, z), BLACK)
			cyl("ScopeBell", 0.3, 0.26, at(-0.12, sy, z - 0.55), BLACK)
			cyl("EyeCup", 0.25, 0.24, at(-0.12, sy, z + 0.55), rgb(25, 25, 25), M.Rubber)
			box("Turret", Vector3.new(0.12, 0.12, 0.12), at(-0.12, sy + 0.13, z), BLACK)
			info.Sight = sy
		else -- "Scope"
			for _, dz in { -0.22, 0.22 } do
				box("ScopeRing", Vector3.new(0.08, 0.2, 0.08), at(0, y + 0.12, z + dz), BLACK)
			end
			local sy = y + 0.3
			cyl("ScopeTube", 0.95, 0.18, at(0, sy, z), BLACK)
			cyl("ScopeBellFront", 0.32, 0.3, at(0, sy, z - 0.6), BLACK)
			cyl("ScopeBellRear", 0.22, 0.26, at(0, sy, z + 0.55), BLACK)
			local lens = cyl("ScopeLens", 0.02, 0.26, at(0, sy, z - 0.77), rgb(80, 140, 200), M.Glass)
			lens.Transparency = 0.2
			box("TurretTop", Vector3.new(0.14, 0.12, 0.14), at(0, sy + 0.13, z), BLACK)
			box("TurretSide", Vector3.new(0.12, 0.14, 0.14), at(0.13, sy, z), BLACK)
			cylX("ParallaxKnob", 0.08, 0.12, at(-0.13, sy, z), BLACK)
			box("ScopeAccent", Vector3.new(0.19, 0.02, 0.04), at(0, sy, z - 0.42), accent, accentMat)
			info.Sight = sy
		end
	end
	local function bipod(z, y, folded)
		box("BipodMount", Vector3.new(0.16, 0.1, 0.16), at(0, y - 0.07, z), BLACK)
		for _, sx in { -1, 1 } do
			if folded then
				box("BipodLeg", Vector3.new(0.05, 0.05, 0.6), at(sx * 0.1, y - 0.12, z + 0.32), BLACK)
			else
				box("BipodLeg", Vector3.new(0.05, 0.55, 0.05), at(sx * 0.1, y - 0.36, z + 0.1) * CFrame.Angles(math.rad(-55), 0, math.rad(sx * 8)), BLACK)
				box("BipodFoot", Vector3.new(0.08, 0.05, 0.1), at(sx * 0.13, y - 0.55, z + 0.32), rgb(20, 20, 20), M.Rubber)
			end
		end
	end
	local function frontSightTower(z, y)
		box("FSBase", Vector3.new(0.16, 0.12, 0.14), at(0, y, z), BLACK)
		box("FSPostL", Vector3.new(0.03, 0.22, 0.06), at(-0.06, y + 0.15, z), BLACK)
		box("FSPostR", Vector3.new(0.03, 0.22, 0.06), at(0.06, y + 0.15, z), BLACK)
		box("FSPost", Vector3.new(0.025, 0.16, 0.025), at(0, y + 0.14, z), accent, accentMat)
	end

	-------------------------------------------------------------- styles
	local h = L * 0.17 -- half receiver length
	if style == "M4" then
		handle.Size = Vector3.new(0.3, 0.38, L * 0.34)
		box("LowerReceiver", Vector3.new(0.28, 0.2, L * 0.31), at(0, -0.26, 0.02), STEEL)
		box("MagRelease", Vector3.new(0.05, 0.06, 0.06), at(0.16, -0.24, -0.05), BLACK)
		box("Selector", Vector3.new(0.04, 0.05, 0.14), at(-0.16, -0.2, 0.22), accent, accentMat)
		box("BoltCatch", Vector3.new(0.04, 0.12, 0.08), at(-0.16, -0.16, -0.08), BLACK)
		box("ForwardAssist", Vector3.new(0.09, 0.09, 0.12), at(0.17, 0.1, h - 0.12), BLACK)
		box("DustCover", Vector3.new(0.02, 0.12, 0.3), at(0.2, -0.02, -0.02) * CFrame.Angles(0, 0, math.rad(-40)), STEEL)
		box("ChargingHandle", Vector3.new(0.24, 0.05, 0.12), at(0, 0.21, h - 0.04), BLACK)
		local hg = L * 0.32
