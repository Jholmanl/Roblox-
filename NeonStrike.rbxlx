      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">AchievementService</string>
          <string name="Source"><![CDATA[-- Tracks stats and unlocks achievements (with a toast + cash reward).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Achievements = require(Shared.Achievements)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)

local AchievementService = {}

local pendingSync = {}

local function scheduleSync(player: Player)
	-- batch several stat changes into a single DataSync
	if pendingSync[player] then
		return
	end
	pendingSync[player] = true
	task.delay(1, function()
		pendingSync[player] = nil
		if player.Parent then
			DataService.Sync(player)
		end
	end)
end

local function check(player: Player, data, stat: string)
	local list = Achievements.ByStat[stat]
	if not list then
		return
	end
	local value = data.Stats[stat] or 0
	for _, a in list do
		if not data.Achievements[a.Id] and value >= a.Goal then
			data.Achievements[a.Id] = os.time()
			DataService.AddCash(player, a.Reward, false)
			Remotes.Notify:FireClient(player, "Achievement", {
				Id = a.Id, Name = a.Name, Desc = a.Desc, Reward = a.Reward, Icon = a.Icon,
			})
		end
	end
end

function AchievementService.Add(player: Player?, stat: string, amount: number?)
	if not player or not player:IsA("Player") then
		return
	end
	local data = DataService.Get(player)
	if not data then
		return
	end
	data.Stats[stat] = (data.Stats[stat] or 0) + (amount or 1)
	check(player, data, stat)
	scheduleSync(player)
end

function AchievementService.SetMax(player: Player?, stat: string, value: number)
	if not player or not player:IsA("Player") then
		return
	end
	local data = DataService.Get(player)
	if not data then
		return
	end
	if value > (data.Stats[stat] or 0) then
		data.Stats[stat] = value
		check(player, data, stat)
		scheduleSync(player)
	end
end

function AchievementService.CheckAll(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	data.Stats.Level = data.Level
	local owned = 0
	for _ in data.Owned do
		owned += 1
	end
	data.Stats.WeaponsOwned = owned
	for stat in Achievements.ByStat do
		check(player, data, stat)
	end
end

function AchievementService.Init()
	DataService.OnLevelUp = function(player, level)
		AchievementService.SetMax(player, "Level", level)
	end
	-- play time tracker
	task.spawn(function()
		while true do
			task.wait(60)
			for _, player in Players:GetPlayers() do
				AchievementService.Add(player, "Minutes", 1)
			end
		end
	end)
end

return AchievementService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">BotService</string>
          <string name="Source"><![CDATA[-- AI bots that fill empty servers so there's always someone to fight.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Weapons = require(Shared.Weapons)
local GunBuilder = require(Shared.GunBuilder)
local Util = require(Shared.Util)
local Combat = require(script.Parent.CombatService)
local MapService = require(script.Parent.MapService)
local TeamService = require(script.Parent.TeamService)

local BotService = {}
BotService.Bots = {} -- list of records

local NAMES = { "Vortex", "Nyx", "Blitz", "Rogue", "Havoc", "Echo", "Spectre", "Raptor", "Jinx", "Talon", "Onyx", "Zephyr", "Kilo", "Nova", "Wraith", "Ember" }
local BOT_WEAPONS = { "Striker", "Viper", "Brute", "Hornet", "Striker", "Viper", "Inferno", "HandCannon" }
local PREFERRED_RANGE = { SMG = 25, Shotgun = 10, LMG = 50, Revolver = 35, ["Assault Rifle"] = 45, ["Burst Rifle"] = 55 }
local SKIN = { Color3.fromRGB(255, 204, 153), Color3.fromRGB(234, 184, 146), Color3.fromRGB(198, 134, 66), Color3.fromRGB(141, 85, 36), Color3.fromRGB(90, 60, 40) }
local OUTFIT = { Color3.fromRGB(40, 40, 46), Color3.fromRGB(60, 70, 50), Color3.fromRGB(30, 50, 90), Color3.fromRGB(90, 30, 30), Color3.fromRGB(80, 80, 90) }
local ANIMS = { Idle = "rbxassetid://507766388", Run = "rbxassetid://913376220", Hold = "rbxassetid://507768375" }

local holdersFolder = Instance.new("Folder")
holdersFolder.Name = "BotStats"
holdersFolder.Parent = ReplicatedStorage

local botsFolder = Instance.new("Folder")
botsFolder.Name = "Bots"
botsFolder.Parent = workspace

local function pick(t)
	return t[math.random(1, #t)]
end

local function freeName(): string
	local used = {}
	for _, r in BotService.Bots do
		used[r.Name] = true
	end
	for _ = 1, 50 do
		local n = pick(NAMES)
		if not used[n] then
			return n
		end
	end
	return "Bot" .. math.random(100, 999)
end

local function hasLineOfSight(fromPos: Vector3, target, exclude): boolean
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = exclude
	local toPos = target.Root.Position + Vector3.new(0, 1.5, 0)
	local result = workspace:Raycast(fromPos, toPos - fromPos, params)
	if not result then
		return true
	end
	local _, model = Util.HumanoidFromPart(result.Instance)
	return model == target.Character
end

local function runAI(record, model: Model)
	local entity = record.Entity
	local humanoid = entity.Humanoid
	local root = entity.Root
	local head = model:FindFirstChild("Head") or root
	local def = Weapons.Get(record.Weapon)
	local preferred = PREFERRED_RANGE[def.Class] or 40

	local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
	local tracks = {}
	for name, id in ANIMS do
		local anim = Instance.new("Animation")
		anim.AnimationId = id
		local ok, track = pcall(animator.LoadAnimation, animator, anim)
		if ok then
			tracks[name] = track
		end
	end
	if tracks.Hold then
		tracks.Hold.Priority = Enum.AnimationPriority.Action
		tracks.Hold:Play()
	end

	local strafe = 1
	local nextStrafe = 0
	local nextShot = os.clock() + 1
	local shotsInMag = def.Mag
	local wander = MapService.RandomPoint()
	local nextWander = 0
	local currentTarget = nil
	local reactionUntil = 0

	while Combat.IsAlive(entity) and model.Parent do
		task.wait(0.1)
		if not Combat.IsAlive(entity) then
			break
		end
		local now = os.clock()
		local myPos = root.Position

		-- pick the closest visible enemy, otherwise head for the closest one
		local best, bestDist, bestVisible = nil, math.huge, false
		for _, other in Combat.Entities do
			if other ~= entity and TeamService.Enemies(entity, other) and Combat.IsAlive(other) then
				local d = (other.Root.Position - myPos).Magnitude
				if d < 260 then
					local visible = hasLineOfSight(head.Position, other, { model, workspace:FindFirstChild("Effects") })
					if (visible and not bestVisible) or (visible == bestVisible and d < bestDist) then
						best, bestDist, bestVisible = other, d, visible
					end
				end
			end
		end
		if best ~= currentTarget then
			currentTarget = best
			reactionUntil = now + 0.35 + math.random() * 0.3 -- human-ish reaction time
		end

		local move = Vector3.zero
		if best then
			local offset = best.Root.Position - myPos
			local flat = Vector3.new(offset.X, 0, offset.Z)
			local toward = flat.Magnitude > 0.1 and flat.Unit or Vector3.zAxis
			if now > nextStrafe then
				strafe = -strafe
				nextStrafe = now + 0.8 + math.random() * 1.4
			end
			local side = Vector3.new(-toward.Z, 0, toward.X) * strafe
			if not bestVisible then
				move = toward
			elseif bestDist > preferred + 10 then
				move = toward + side * 0.6
			elseif bestDist < preferred - 8 then
				move = -toward + side * 0.6
			else
				move = side
			end
			root.CFrame = CFrame.lookAt(myPos, myPos + toward)

			if bestVisible and now >= nextShot and now >= reactionUntil then
				if shotsInMag <= 0 then
					shotsInMag = def.Mag
					nextShot = now + def.Reload
				else
					local accuracy = Config.BotAccuracy * math.clamp(1 - bestDist / 350, 0.35, 1)
					local aimPart = math.random() < 0.15 and best.Character:FindFirstChild("Head") or best.Character:FindFirstChild("UpperTorso") or best.Root
					local rays = def.Pellets or def.Burst or 1
					local dirs = {}
					for i = 1, rays do
						local aim = aimPart.Position
						if math.random() > accuracy then
							aim += Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * (4 + bestDist * 0.08)
						elseif def.Pellets then
							aim += Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * (bestDist * 0.1)
						end
						dirs[i] = (aim - head.Position).Unit
					end
					Combat.Shoot(entity, record.Weapon, head.Position, dirs, {})
					shotsInMag -= def.Burst or 1
					local interval = 1 / def.FireRate
					nextShot = now + (def.Auto and interval * 1.3 or interval * 1.6 + math.random() * 0.3)
				end
			end
		else
			if now > nextWander or (wander - myPos).Magnitude < 8 then
				wander = MapService.RandomPoint()
				nextWander = now + 6
			end
			local flat = Vector3.new(wander.X - myPos.X, 0, wander.Z - myPos.Z)
			move = flat.Magnitude > 0.1 and flat.Unit or Vector3.zero
		end

		humanoid:Move(move.Magnitude > 0 and move.Unit or Vector3.zero, false)
		-- hop when stuck or randomly like a real player
		local speed = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude
		if (move.Magnitude > 0 and speed < 2) or math.random() < 0.02 then
			humanoid.Jump = true
		end
		if tracks.Run and tracks.Idle then
			if speed > 2 then
				if not tracks.Run.IsPlaying then
					tracks.Idle:Stop()
					tracks.Run:Play()
				end
			elseif not tracks.Idle.IsPlaying then
				tracks.Run:Stop()
				tracks.Idle:Play()
			end
		end
	end
end

local function spawnBot(record)
	if record.Model then
		record.Model:Destroy()
		record.Model = nil
	end
	local desc = Instance.new("HumanoidDescription")
	local skin = pick(SKIN)
	desc.HeadColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.TorsoColor = pick(OUTFIT)
	local legs = pick(OUTFIT)
	desc.LeftLegColor = legs
	desc.RightLegColor = legs
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		warn("[BotService] Could not create bot rig: " .. tostring(model))
		return
	end
	model.Name = record.Name
	model:SetAttribute("BotName", record.Name)
	local animate = model:FindFirstChild("Animate")
	if animate then
		animate:Destroy()
	end
	record.Weapon = pick(BOT_WEAPONS)
	local tool = GunBuilder.BuildTool(record.Weapon, false)
	model:PivotTo(MapService.PickSpawn(record.Entity))
	model.Parent = botsFolder
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.WalkSpeed = Config.BaseWalkSpeed
	humanoid.AutoRotate = false
	tool.Parent = model -- parenting a Tool to a character equips it
	local root = model:FindFirstChild("HumanoidRootPart")
	if root then
		root:SetNetworkOwner(nil)
	end
	record.Model = model
	Combat.AttachCharacter(record.Entity, model, { record.Weapon })
	task.spawn(runAI, record, model)
end

local function addBot()
	local name = freeName()
	local holder = Instance.new("Configuration")
	holder.Name = name
	holder:SetAttribute("IsBot", true)
	for _, attr in { "Kills", "Deaths", "Score", "Streak" } do
		holder:SetAttribute(attr, 0)
	end
	holder.Parent = holdersFolder
	local record = { Name = name, Holder = holder }
	record.Entity = Combat.NewEntity(name, holder, nil)
	record.Entity.Bot = record
	table.insert(BotService.Bots, record)
	spawnBot(record)
end

local function removeBot()
	-- take a bot off the biggest team so teams stay even
	local largest = TeamService.Largest()
	local index = #BotService.Bots
	for i = #BotService.Bots, 1, -1 do
		if BotService.Bots[i].Entity.Team == largest then
			index = i
			break
		end
	end
	local record = table.remove(BotService.Bots, index)
	if not record then
		return
	end
	record.Removed = true
	Combat.RemoveEntity(record.Entity)
	if record.Model then
		record.Model:Destroy()
	end
	record.Holder:Destroy()
end

function BotService.OnDied(entity)
	local record = entity.Bot
	if not record then
		return
	end
	task.delay(Config.RespawnTime, function()
		if not record.Removed and entity.Dead then
			spawnBot(record)
		end
	end)
end

function BotService.RespawnAll()
	for _, record in BotService.Bots do
		task.spawn(spawnBot, record)
	end
end

function BotService.Holders()
	local list = {}
	for _, record in BotService.Bots do
		table.insert(list, { Holder = record.Holder, Name = record.Name, IsBot = true })
	end
	return list
end

function BotService.Start()
	task.spawn(function()
		while true do
			local want = math.max(0, Config.BotFill - #Players:GetPlayers())
			if #Players:GetPlayers() == 0 then
				want = 0
			end
			if #BotService.Bots < want then
				addBot()
			elseif #BotService.Bots > want then
				removeBot()
			end
			task.wait(#BotService.Bots == want and 3 or 0.5)
		end
	end)
end

return BotService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[-- Server-authoritative combat: hitscan validation, damage, kills, medals,
-- grenades, knife, ground slam, health regen and pickups.
--
-- An "entity" is anything that can fight: a real player or a bot.
--   entity.Holder is an Instance whose attributes (Kills, Deaths, Score, Streak)
--   drive the scoreboard. For players it's the Player, for bots a Configuration.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Weapons = require(Shared.Weapons)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)
local GunBuilder = require(Shared.GunBuilder)
local DataService = require(script.Parent.DataService)
local AchievementService = require(script.Parent.AchievementService)
local TeamService = require(script.Parent.TeamService)

local Combat = {}
Combat.Entities = {} -- [character Model] = entity (alive or recently dead)
Combat.ByPlayer = {} -- [Player] = entity
Combat.Hooks = {
	Round = nil, -- RoundService (IsCounting, TakeFirstBlood, OnKill, OnDeath)
	Killstreaks = nil, -- KillstreakService (OnStreak)
	Vehicles = nil, -- VehicleService (CarFromPart, DamageCar, AreaDamage)
}

-- HELPERS --------------------------------------------------------------------
local function hasPass(entity, passKey: string): boolean
	return entity.Player ~= nil and entity.Player:GetAttribute("Pass_" .. passKey) == true
end
Combat.HasPass = hasPass

local function addAttr(holder: Instance, name: string, amount: number)
	holder:SetAttribute(name, (holder:GetAttribute(name) or 0) + amount)
end

local function counting(): boolean
	return Combat.Hooks.Round ~= nil and Combat.Hooks.Round.IsCounting()
end

local function notify(entity, kind, payload)
	if entity and entity.Player then
		Remotes.Notify:FireClient(entity.Player, kind, payload)
	end
end

function Combat.IsAlive(entity): boolean
	return entity ~= nil
		and not entity.Dead
		and entity.Humanoid ~= nil
		and entity.Root ~= nil
		and entity.Humanoid.Health > 0
		and entity.Character ~= nil
		and entity.Character.Parent ~= nil
end

function Combat.MaxHealth(entity): number
	local hp = Config.BaseHealth
	if hasPass(entity, "VIP") then
		hp += 10
	end
	if hasPass(entity, "Juggernaut") then
		hp += 35
	end
	return hp
end

function Combat.MaxGrenades(entity): number
	return Config.Grenades + (hasPass(entity, "Grenadier") and 2 or 0)
end

local function grenadeInterval(entity): number
	return Config.GrenadeRegen / (hasPass(entity, "Grenadier") and 2 or 1)
end

local function setGrenades(entity, count: number)
	entity.Grenades = count
	if entity.Player then
		entity.Player:SetAttribute("Grenades", count)
	end
end

function Combat.NewEntity(name: string, holder: Instance, player: Player?)
	local entity = {
		Name = name,
		Holder = holder,
		Player = player,
		IsBot = player == nil,
		Dead = true,
		Streak = 0,
		DeathsSinceKill = 0,
		LastKiller = nil,
		Multi = 0,
		LastKillTime = 0,
		Ammo = {},
		Reload = {},
		LastFire = {},
		Grenades = 0,
		NextGrenade = 0,
		LastGrenade = 0,
		LastKnife = 0,
		LastSlam = 0,
		LastDamaged = 0,
		DamageLog = {},
		OverdriveUntil = 0,
	}
	if player then
		Combat.ByPlayer[player] = entity
	end
	TeamService.Register(entity)
	return entity
end

function Combat.RemoveEntity(entity)
	if entity.Character then
		Combat.Entities[entity.Character] = nil
	end
	if entity.Player then
		Combat.ByPlayer[entity.Player] = nil
	end
	TeamService.Unregister(entity)
	entity.Dead = true
end

function Combat.ResetAmmo(entity, weaponId: string)
	local def = Weapons.Get(weaponId)
	if not def then
		return
	end
	local ext = hasPass(entity, "ExtendedMags")
	entity.Ammo[weaponId] = { Mag = Weapons.MagSize(def, ext), Reserve = Weapons.ReserveSize(def, ext) }
	entity.Reload[weaponId] = nil
end

-- Registers a freshly spawned character for an entity.
function Combat.AttachCharacter(entity, character: Model, weaponIds: { string })
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	local root = character:WaitForChild("HumanoidRootPart") :: BasePart
	entity.Character = character
	entity.Humanoid = humanoid
	entity.Root = root
	entity.Dead = false
	entity.InfiniteAmmo = false
	entity.Downed = false
	entity.DownedBy = nil
	character:SetAttribute("Team", entity.Team)
	character:SetAttribute("Downed", false)
	if entity.Player then
		entity.Player:SetAttribute("InfiniteAmmo", false)
		entity.Player:SetAttribute("Downed", false)
		entity.Player:SetAttribute("SelfReviveUsed", false)
	end
	entity.DamageLog = {}
	entity.LastDamaged = 0
	entity.Ammo = {}
	entity.Reload = {}
	entity.LastFire = {}
	for _, id in weaponIds do
		Combat.ResetAmmo(entity, id)
	end
	setGrenades(entity, Combat.MaxGrenades(entity))
	entity.NextGrenade = os.clock() + grenadeInterval(entity)

	local maxHp = Combat.MaxHealth(entity)
	humanoid.MaxHealth = maxHp
	humanoid.Health = maxHp
	humanoid.BreakJointsOnDeath = true
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None

	local ff = Instance.new("ForceField")
	ff.Visible = true
	ff.Parent = character
	Debris:AddItem(ff, Config.SpawnProtection)

	Combat.Entities[character] = entity
	humanoid.Died:Connect(function()
		if not entity.Dead and entity.Character == character then
			entity.Dead = true
			Combat.HandleDeath(nil, entity, { Weapon = "Environment", WeaponName = "THE VOID" })
		end
	end)
	character.AncestryChanged:Connect(function(_, parent)
		if parent == nil and Combat.Entities[character] == entity then
			Combat.Entities[character] = nil
		end
	end)
end

-- Gives a player their loadout as Tools.
function Combat.GiveLoadout(player: Player, loadout)
	local entity = Combat.ByPlayer[player]
	local character = player.Character
	if not entity or not character then
		return
	end
	local backpack = player:WaitForChild("Backpack")
	backpack:ClearAllChildren()
	local golden = hasPass(entity, "GoldenArsenal")
	local first
	for _, slot in { "Primary", "Secondary" } do
		local id = loadout[slot]
		if id and Weapons.Get(id) then
			local tool = GunBuilder.BuildTool(id, golden)
			tool.Parent = backpack
			first = first or tool
		end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if first and humanoid then
		humanoid:EquipTool(first)
	end
end

local function removeSpawnProtection(entity)
	if entity.Character then
		local ff = entity.Character:FindFirstChildOfClass("ForceField")
		if ff then
			ff:Destroy()
		end
	end
end

-- DAMAGE -----------------------------------------------------------------------
function Combat.Damage(attacker, victim, amount: number, info): boolean
	if not Combat.IsAlive(victim) then
		return false
	end
	if attacker == victim then
		return false
	end
	if attacker and not TeamService.Enemies(attacker, victim) then
		return false -- no friendly fire
	end
	if Combat.Hooks.Round and (Combat.Hooks.Round.State == "Results" or Combat.Hooks.Round.State == "Voting") then
		return false
	end
	if victim.Character:FindFirstChildOfClass("ForceField") then
		return false
	end
	if info.Explosive and hasPass(victim, "Juggernaut") then
		amount *= 0.9
	end
	amount = math.max(1, math.floor(amount + 0.5))

	local humanoid = victim.Humanoid
	local before = humanoid.Health
	local after = math.max(0, before - amount)
	local dealt = before - after
	victim.LastDamaged = os.clock()

	if attacker then
		victim.DamageLog[attacker] = (victim.DamageLog[attacker] or 0) + dealt
		if attacker.Player then
			AchievementService.Add(attacker.Player, "Damage", dealt)
			Remotes.HitConfirm:FireClient(attacker.Player, {
				Damage = dealt,
				Headshot = info.Headshot == true,
				Killed = after <= 0,
				Position = info.Position or victim.Root.Position,
			})
		end
	end
	if victim.Player then
		local from = attacker and attacker.Root and attacker.Root.Position or nil
		Remotes.Damaged:FireClient(victim.Player, from, dealt)
	end

	if after <= 0 then
		-- players on a big streak get knocked down instead of dying
		if victim.Player and not victim.Downed and victim.Streak >= Config.DownStreak and info.Kind ~= "Nuke" then
			Combat.Down(attacker, victim, info)
			return false
		end
		if victim.Downed and not attacker then
			attacker = victim.DownedBy -- bled out: credit whoever knocked them
			info = victim.DownedInfo or info
		end
		victim.Dead = true -- set before Health so the Died handler doesn't double count
		humanoid.Health = 0
		Combat.HandleDeath(attacker, victim, info)
		return true
	end
	humanoid.Health = after
	return false
end

-- DOWNED / REVIVE -----------------------------------------------------------------
local function clearDowned(entity)
	entity.Downed = false
	entity.DownedBy = nil
	entity.DownedInfo = nil
	if entity.Character then
		entity.Character:SetAttribute("Downed", false)
		local root = entity.Character:FindFirstChild("HumanoidRootPart")
		local prompt = root and root:FindFirstChild("RevivePrompt")
		if prompt then
			prompt:Destroy()
		end
	end
	if entity.Player then
		entity.Player:SetAttribute("Downed", false)
	end
end
Combat.ClearDowned = clearDowned

function Combat.Down(attacker, victim, info)
	victim.Downed = true
	victim.DownedBy = attacker
	victim.DownedInfo = info
	victim.DownedAt = os.clock()
	victim.Humanoid.Health = Config.DownedHealth
	victim.Character:SetAttribute("Downed", true)
	victim.Player:SetAttribute("Downed", true)
	-- teammates hold E on the downed player to revive them
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "RevivePrompt"
	prompt.ActionText = "Revive"
	prompt.ObjectText = victim.Name
	prompt.HoldDuration = Config.ReviveTime
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt:SetAttribute("Team", victim.Team)
	prompt.Enabled = victim.Team ~= nil
	prompt.Parent = victim.Root
	prompt.Triggered:Connect(function(player)
		local reviver = Combat.ByPlayer[player]
		if reviver and reviver ~= victim and reviver.Team ~= nil and reviver.Team == victim.Team and Combat.IsAlive(reviver) and not reviver.Downed and victim.Downed and Combat.IsAlive(victim) then
			Combat.Revive(victim, reviver)
		end
	end)
	if attacker then
		AchievementService.Add(attacker.Player, "Knockdowns", 1)
		notify(attacker, "Medal", { Medals = { { Text = "KNOCKED DOWN", Bonus = 50 } } })
		if counting() then
			addAttr(attacker.Holder, "Score", 50)
		end
	end
	Remotes.KillFeed:FireAllClients({
		Killer = attacker and attacker.Name, KillerTeam = attacker and attacker.Team,
		Victim = victim.Name, VictimTeam = victim.Team, Weapon = info.WeaponName or "?", Knock = true,
	})
	notify(victim, "Downed", { By = attacker and attacker.Name or "?", Bleed = Config.DownedHealth / Config.BleedRate })
end

function Combat.Revive(victim, reviver)
	if not victim.Downed then
		return
	end
	clearDowned(victim)
	victim.Humanoid.Health = victim.Humanoid.MaxHealth * Config.ReviveHealth
	victim.LastDamaged = os.clock()
	notify(victim, "Revived", { By = reviver and reviver.Name or nil })
	if reviver then
		AchievementService.Add(reviver.Player, "Revives", 1)
		notify(reviver, "Medal", { Medals = { { Text = "REVIVE", Bonus = 100 } } })
		if counting() then
			addAttr(reviver.Holder, "Score", 100)
		end
		if reviver.Player then
			DataService.AddCash(reviver.Player, 25, true)
			DataService.AddXP(reviver.Player, 100)
		end
	else
		AchievementService.Add(victim.Player, "SelfRevives", 1)
	end
end

Remotes.SelfRevive.OnServerEvent:Connect(function(player)
	local entity = Combat.ByPlayer[player]
	if not entity or not entity.Downed or not Combat.IsAlive(entity) then
		return
	end
	if player:GetAttribute("SelfReviveUsed") then
		return
	end
	if os.clock() - (entity.DownedAt or 0) < Config.SelfReviveTime - 0.3 then
		return
	end
	player:SetAttribute("SelfReviveUsed", true)
	Combat.Revive(entity, nil)
end)

local MULTI_NAMES = { [2] = "DOUBLE KILL", [3] = "TRIPLE KILL", [4] = "QUAD KILL", [5] = "RAMPAGE" }
local MULTI_STATS = { [2] = "DoubleKills", [3] = "TripleKills", [4] = "QuadKills", [5] = "Rampages" }
local STREAK_NAMES = { [5] = "K.O STREAK 🔥", [10] = "DOMINATING", [15] = "UNSTOPPABLE", [20] = "GODLIKE", [25] = "LEGENDARY" }

function Combat.HandleDeath(killer, victim, info)
	local round = Combat.Hooks.Round
	local victimStreak = victim.Streak
	clearDowned(victim)
	victim.Streak = 0
	victim.InfiniteAmmo = false
	if victim.Player then
		victim.Player:SetAttribute("InfiniteAmmo", false)
	end
	victim.DeathsSinceKill += 1
	victim.Holder:SetAttribute("Streak", 0)
	if counting() then
		addAttr(victim.Holder, "Deaths", 1)
	end
	AchievementService.Add(victim.Player, "Deaths", 1)
	local damageLog = victim.DamageLog
	victim.DamageLog = {}

	local weaponName = info.WeaponName or "?"

	if not killer or killer == victim then
		Remotes.KillFeed:FireAllClients({ Victim = victim.Name, VictimTeam = victim.Team, Weapon = weaponName })
		if victim.Player then
			Remotes.KillInfo:FireClient(victim.Player, { Killer = nil, Weapon = weaponName })
		end
		if round then
			round.OnDeath(victim)
		end
		return
	end

	victim.LastKiller = killer.Name
	local kp = killer.Player
	local medals = {}
	local bonus = 0
	local function medal(text: string, points: number, stat: string?)
		table.insert(medals, { Text = text, Bonus = points })
		bonus += points
		if stat then
			AchievementService.Add(kp, stat, 1)
		end
	end

	-- streak + multi kill
	killer.Streak += 1
	local now = os.clock()
	if now - killer.LastKillTime <= Config.MultiKillWindow then
		killer.Multi += 1
	else
		killer.Multi = 1
	end
	killer.LastKillTime = now
	local multi = math.min(killer.Multi, 5)
	if killer.Multi >= 2 then
		medal(MULTI_NAMES[multi], 50 * multi, MULTI_STATS[multi])
	end
	if STREAK_NAMES[killer.Streak] then
		medal(STREAK_NAMES[killer.Streak], killer.Streak * 20)
	end
	if killer.Streak == 5 then
		AchievementService.Add(kp, "KOStreaks", 1)
		notify(killer, "KOStreak", { Streak = 5 })
		for _, p in Players:GetPlayers() do
			if p ~= kp then
				Remotes.Notify:FireClient(p, "Message", { Text = killer.Name .. " is on a K.O STREAK 🔥", Color = Color3.fromRGB(255, 120, 40) })
			end
		end
	end

	-- style medals
	if info.Headshot then
		medal("HEADSHOT", 50, "Headshots")
	end
	if round and round.TakeFirstBlood() then
		medal("FIRST BLOOD", 100, "FirstBloods")
	end
	if killer.LastKiller == victim.Name then
		medal("REVENGE", 75, "Revenges")
		killer.LastKiller = nil
	end
	if victimStreak >= 5 then
		medal("BOUNTY CLAIMED", victimStreak * 25, "Bounties")
	elseif victimStreak >= 3 then
		medal("BUZZKILL", 50)
	end
	if killer.DeathsSinceKill >= 3 then
		medal("COMEBACK", 75, "Comebacks")
	end
	killer.DeathsSinceKill = 0

	local distance = info.Distance or 0
	if info.Kind == "Knife" then
		medal("SLICED", 50, "KnifeKills")
	elseif info.Kind == "Grenade" then
		medal("FRAGGED", 50, "GrenadeKills")
	elseif info.Kind == "Slam" then
		medal("METEOR STRIKE", 100, "SlamKills")
	elseif info.Kind == "Airstrike" then
		AchievementService.Add(kp, "AirstrikeKills", 1)
	elseif info.Kind == "Roadkill" then
		medal("ROADKILL", 100)
	elseif info.Kind == "Vehicle" then
		medal("CAR BOMB", 75)
	elseif info.Kind == nil then
		if distance >= 150 then
			medal("LONG SHOT", 75, "LongShots")
		elseif distance <= 5 then
			medal("POINT BLANK", 25, "PointBlanks")
		end
		if info.Class == "Sniper" and not info.Ads then
			medal("NO SCOPE", 150, "NoScopes")
		end
		if info.Weapon then
			AchievementService.Add(kp, "Kills_" .. info.Weapon, 1)
		end
	end
	if info.Slide then
		medal("SLIDE KILL", 50, "SlideKills")
	end
	if info.Air then
		medal("AIRBORNE", 50, "AirKills")
	end
	if info.Dash then
		medal("BLINK KILL", 50, "DashKills")
	end
	if not Combat.IsAlive(killer) then
		medal("FROM THE GRAVE", 150, "GraveKills")
	elseif killer.Humanoid.Health <= 20 then
		medal("CLUTCH", 75, "ClutchKills")
	end

	if info.Explosive then
		AchievementService.Add(kp, "ExplosiveKills", 1)
		if info.Projectile then
			medal(info.Direct and "DIRECT HIT" or "BOOM", info.Direct and 75 or 25)
		end
	end
	AchievementService.Add(kp, "Kills", 1)
	AchievementService.SetMax(kp, "BestStreak", killer.Streak)

	-- score & rewards
	local score = Config.KillScore + bonus
	killer.Holder:SetAttribute("Streak", killer.Streak)
	if counting() then
		addAttr(killer.Holder, "Kills", 1)
		addAttr(killer.Holder, "Score", score)
		TeamService.AddScore(killer.Team, 1)
	end
	if kp then
		DataService.AddCash(kp, Config.KillCash + bonus // 5, true)
		DataService.AddXP(kp, Config.KillXP + bonus)
		if hasPass(killer, "Vampire") and Combat.IsAlive(killer) then
			killer.Humanoid.Health = math.min(killer.Humanoid.MaxHealth, killer.Humanoid.Health + 25)
		end
	end

	-- assists
	for helper, dmg in damageLog do
		if helper ~= killer and dmg >= 25 then
			if counting() then
				addAttr(helper.Holder, "Score", Config.AssistScore)
			end
			if helper.Player then
				DataService.AddCash(helper.Player, Config.AssistCash, true)
				DataService.AddXP(helper.Player, Config.AssistXP)
				AchievementService.Add(helper.Player, "Assists", 1)
				notify(helper, "Medal", { Medals = { { Text = "ASSIST", Bonus = Config.AssistScore } } })
			end
		end
	end

	Remotes.KillFeed:FireAllClients({
		Killer = killer.Name,
		KillerVIP = hasPass(killer, "VIP"),
		KillerTeam = killer.Team,
		Victim = victim.Name,
		VictimVIP = hasPass(victim, "VIP"),
		VictimTeam = victim.Team,
		Weapon = weaponName,
		Headshot = info.Headshot == true,
	})
	notify(killer, "Kill", { Victim = victim.Name, Medals = medals, Score = score, Headshot = info.Headshot == true })
	if victim.Player then
		Remotes.KillInfo:FireClient(victim.Player, {
			Killer = killer.Name,
			Weapon = weaponName,
			Headshot = info.Headshot == true,
			Distance = math.floor(distance),
			KillerHealth = Combat.IsAlive(killer) and math.ceil(killer.Humanoid.Health) or 0,
			KillerMax = killer.Humanoid and killer.Humanoid.MaxHealth or 100,
			KillerCharacter = killer.Character,
		})
	end

	if Combat.Hooks.Killstreaks then
		Combat.Hooks.Killstreaks.OnStreak(killer, killer.Streak)
	end
	if round then
		round.OnDeath(victim)
		round.OnKill(killer)
	end
end

-- Area damage (grenades, slams, airstrikes). Returns number of kills.
function Combat.AreaDamage(attacker, position: Vector3, radius: number, maxDamage: number, info, effect: string?)
	Remotes.Effect:FireAllClients(effect or "Explosion", position, radius)
	if Combat.Hooks.Vehicles and info.Explosive then
		Combat.Hooks.Vehicles.AreaDamage(attacker, position, radius, maxDamage)
	end
	local kills = 0
	local victims = {}
	for _, victim in Combat.Entities do
		table.insert(victims, victim)
	end
	for _, victim in victims do
		if victim ~= attacker and TeamService.Enemies(attacker, victim) and Combat.IsAlive(victim) then
			local d = (victim.Root.Position - position).Magnitude
			if d <= radius then
				local hitInfo = table.clone(info)
				hitInfo.Position = victim.Root.Position
				hitInfo.Distance = (attacker and attacker.Root) and (attacker.Root.Position - victim.Root.Position).Magnitude or 0
				if Combat.Damage(attacker, victim, maxDamage * (1 - (d / radius) * 0.6), hitInfo) then
					kills += 1
				end
			end
		end
	end
	return kills
end

-- GUNFIRE --------------------------------------------------------------------
local function completeReload(entity, weaponId: string)
	local def = Weapons.Get(weaponId)
	local ammo = entity.Ammo[weaponId]
	entity.Reload[weaponId] = nil
	if not def or not ammo then
		return
	end
	local need = Weapons.MagSize(def, hasPass(entity, "ExtendedMags")) - ammo.Mag
	local take = math.min(need, ammo.Reserve)
	ammo.Mag += take
	ammo.Reserve -= take
end

function Combat.ReloadTime(entity, def): number
	return def.Reload * (hasPass(entity, "FastHands") and 0.65 or 1)
end

local function validVector(v): boolean
	return typeof(v) == "Vector3" and v == v and v.Magnitude > 0.01 and v.Magnitude < 1e5
end

-- Fires a set of rays for an entity. Used by players (from the remote) and bots.
-- dirs: list of unit directions (pellets / burst rounds).
function Combat.Shoot(entity, weaponId: string, origin: Vector3, dirs, flags)
	local def = Weapons.Get(weaponId)
	local dmgMult = hasPass(entity, "GoldenArsenal") and 1.1 or 1
	if entity.IsBot then
		dmgMult = Config.BotDamageMultiplier
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local effectsFolder = workspace:FindFirstChild("Effects")

	local totals = {}
	local carTotals = {}
	local vehicles = Combat.Hooks.Vehicles
	local ends = {}
	-- passengers shooting out of a car shouldn't hit their own car
	local ownCar = nil
	local seatPart = entity.Humanoid and entity.Humanoid.SeatPart
	if seatPart and vehicles then
		ownCar = vehicles.CarFromPart(seatPart)
	end
	for i, dir in dirs do
		local exclude = { entity.Character, effectsFolder, ownCar }
		local start = origin
		local remaining = def.Range
		local pierce = def.Penetrate or 0
		local endPos = origin + dir * def.Range
		local guard = 0
		while remaining > 1 and guard < 12 do
			guard += 1
			params.FilterDescendantsInstances = exclude
			local result = workspace:Raycast(start, dir * remaining, params)
			if not result then
				break
			end
			local _, model = Util.HumanoidFromPart(result.Instance)
			local victim = model and Combat.Entities[model]
			local car = (not model and vehicles) and vehicles.CarFromPart(result.Instance) or nil
			if car then
				carTotals[car] = (carTotals[car] or 0) + def.Damage * dmgMult * 0.7
				endPos = result.Position
				break
			end
			if victim and Combat.IsAlive(victim) and not TeamService.Enemies(entity, victim) then
				-- bullets pass through teammates
				table.insert(exclude, model)
				remaining -= (result.Position - start).Magnitude
				start = result.Position
				continue
			end
			if victim and Combat.IsAlive(victim) then
				local hitPart = result.Instance
				local headshot = hitPart.Name == "Head" or (hitPart.Parent ~= nil and hitPart.Parent:IsA("Accessory"))
				local dist = (result.Position - origin).Magnitude
				local falloff = 1
				if dist > def.FalloffStart then
					falloff = math.clamp(1 - (dist - def.FalloffStart) / math.max(1, def.Range - def.FalloffStart) * 0.5, 0.5, 1)
				end
				local acc = totals[victim] or { Damage = 0, Headshot = false, Position = result.Position, Distance = dist }
				acc.Damage += def.Damage * (headshot and def.HeadMult or 1) * falloff * dmgMult
				acc.Headshot = acc.Headshot or headshot
				totals[victim] = acc
				if pierce > 0 then
					pierce -= 1
					table.insert(exclude, model)
					remaining -= (result.Position - start).Magnitude
					start = result.Position
					continue
				end
				endPos = result.Position
				break
			elseif model then
				-- dead body or non-combatant: shoot through it
				table.insert(exclude, model)
				remaining -= (result.Position - start).Magnitude
				start = result.Position
				continue
			end
			endPos = result.Position
			break
		end
		ends[i] = endPos
	end

	local kills = 0
	for victim, acc in totals do
		local killed = Combat.Damage(entity, victim, acc.Damage, {
			Weapon = weaponId,
			WeaponName = def.Name,
			Class = def.Class,
			Headshot = acc.Headshot,
			Position = acc.Position,
			Distance = acc.Distance,
			Ads = flags.Ads == true,
			Slide = flags.Slide == true,
			Air = flags.Air == true,
			Dash = flags.Dash == true,
		})
		if killed then
			kills += 1
		end
	end
	if vehicles then
		for car, dmg in carTotals do
			vehicles.DamageCar(car, entity, dmg)
		end
	end
	if kills >= 2 then
		AchievementService.Add(entity.Player, "Collaterals", 1)
		if counting() then
			addAttr(entity.Holder, "Score", 100)
		end
		notify(entity, "Medal", { Medals = { { Text = "COLLATERAL", Bonus = 100 } } })
	end
	Remotes.Effect:FireAllClients("Shot", entity.Character, weaponId, ends)
end


-- PROJECTILES (rockets, grenade launcher) --------------------------------------
-- Simulated on the server with stepped raycasts; the visual part is moved each frame.
function Combat.FireProjectile(entity, weaponId: string, origin: Vector3, dir: Vector3)
	local def = Weapons.Get(weaponId)
	local spec = def.Projectile
	local effects = workspace:FindFirstChild("Effects") or workspace
	local rocket = Instance.new("Part")
	rocket.Name = "Projectile"
	rocket.Anchored = true
	rocket.CanCollide = false
	rocket.CanQuery = false
	rocket.CanTouch = false
	rocket.Size = Vector3.new(spec.Size, spec.Size, spec.Size * 3)
	rocket.Material = Enum.Material.Neon
	rocket.Color = def.Look.Accent
	rocket.CFrame = CFrame.lookAt(origin + dir * 3, origin + dir * 4)
	local light = Instance.new("PointLight")
	light.Color = def.Look.Accent
	light.Range = 14
	light.Brightness = 3
	light.Parent = rocket
	local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.2, spec.Size * 1.5)
	a1.Position = Vector3.new(0, -0.2, spec.Size * 1.5)
	a0.Parent, a1.Parent = rocket, rocket
	local trail = Instance.new("Trail")
	trail.Attachment0, trail.Attachment1 = a0, a1
	trail.Lifetime = 0.4
	trail.LightEmission = 1
	trail.Color = ColorSequence.new(Color3.fromRGB(255, 200, 120), Color3.fromRGB(120, 120, 120))
	trail.Transparency = NumberSequence.new(0, 1)
	trail.WidthScale = NumberSequence.new(1, 3)
	trail.Parent = rocket
	rocket.Parent = effects
	Remotes.Effect:FireAllClients("Launch", entity.Character, weaponId)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { entity.Character, effects }
	local pos = origin + dir * 2
	local vel = dir * spec.Speed
	local life = 0
	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		life += dt
		local nextVel = vel - Vector3.new(0, spec.Gravity * dt, 0)
		local step = (vel + nextVel) / 2 * dt
		local result = workspace:Raycast(pos, step, params)
		vel = nextVel
		if result or life > 5 then
			conn:Disconnect()
			local hitPos = result and result.Position or pos
			rocket:Destroy()
			local direct = nil
			if result then
				local _, model = Util.HumanoidFromPart(result.Instance)
				direct = model and Combat.Entities[model]
			end
			if direct and Combat.IsAlive(direct) then
				Combat.Damage(entity, direct, spec.Direct, {
					Weapon = weaponId, WeaponName = def.Name, Class = def.Class, Explosive = true, Projectile = true, Direct = true,
					Position = hitPos, Distance = (hitPos - origin).Magnitude,
				})
			end
			Combat.AreaDamage(entity, hitPos, spec.Radius, def.Damage, {
				Weapon = weaponId, WeaponName = def.Name, Class = def.Class, Explosive = true, Projectile = true,
			}, spec.Effect)
			return
		end
		pos += step
		rocket.CFrame = CFrame.lookAt(pos, pos + vel)
	end)
end

Remotes.Fire.OnServerEvent:Connect(function(player, weaponId, origin, dirs, flags)
	local entity = Combat.ByPlayer[player]
	if not Combat.IsAlive(entity) or entity.Downed then
		return
	end
	if typeof(weaponId) ~= "string" or typeof(origin) ~= "Vector3" or typeof(dirs) ~= "table" then
		return
	end
	local def = Weapons.Get(weaponId)
	if not def then
		return
	end
	local tool = entity.Character:FindFirstChildOfClass("Tool")
	if not tool or tool:GetAttribute("WeaponId") ~= weaponId then
		return
	end
	local ammo = entity.Ammo[weaponId]
	if not ammo then
		return
	end
	local now = os.clock()
	local rate = def.FireRate * (entity.OverdriveUntil > now and 1.5 or 1)
	if now - (entity.LastFire[weaponId] or 0) < (1 / rate) * 0.75 then
		return
	end
	local unlimited = entity.InfiniteAmmo == true
	local reloadEnd = entity.Reload[weaponId]
	if reloadEnd and not unlimited then
		if now >= reloadEnd - 0.3 then
			completeReload(entity, weaponId)
		else
			return
		end
	end
	if ammo.Mag <= 0 and not unlimited then
		return
	end

	local maxRays = def.Pellets or def.Burst or 1
	local clean = {}
	for i = 1, math.min(#dirs, maxRays) do
		if validVector(dirs[i]) then
			table.insert(clean, dirs[i].Unit)
		end
	end
	if #clean == 0 then
		return
	end
	local cost = def.Burst and #clean or 1
	if not unlimited then
		ammo.Mag = math.max(0, ammo.Mag - cost)
	end
	entity.LastFire[weaponId] = now
	removeSpawnProtection(entity)

	local head = entity.Character:FindFirstChild("Head")
	if not validVector(origin) or not head or (origin - head.Position).Magnitude > 12 then
		origin = head and head.Position or entity.Root.Position
	end
	if def.Projectile then
		Combat.FireProjectile(entity, weaponId, origin, clean[1])
		return
	end
	Combat.Shoot(entity, weaponId, origin, clean, typeof(flags) == "table" and flags or {})
end)

Remotes.Reload.OnServerEvent:Connect(function(player, weaponId)
	local entity = Combat.ByPlayer[player]
	if not Combat.IsAlive(entity) or typeof(weaponId) ~= "string" then
		return
	end
	local def = Weapons.Get(weaponId)
	local ammo = entity.Ammo[weaponId]
	if not def or not ammo or entity.Reload[weaponId] then
		return
	end
	if ammo.Mag >= Weapons.MagSize(def, hasPass(entity, "ExtendedMags")) or ammo.Reserve <= 0 then
		return
	end
	local t = Combat.ReloadTime(entity, def)
	local finish = os.clock() + t
	entity.Reload[weaponId] = finish
	task.delay(t, function()
		if entity.Reload[weaponId] == finish then
			completeReload(entity, weaponId)
		end
	end)
end)

-- EQUIPMENT ------------------------------------------------------------------
Remotes.Knife.OnServerEvent:Connect(function(player)
	local entity = Combat.ByPlayer[player]
	if not Combat.IsAlive(entity) or entity.Downed then
		return
	end
	local now = os.clock()
	if now - entity.LastKnife < Config.KnifeCooldown then
		return
	end
	entity.LastKnife = now
	removeSpawnProtection(entity)
	Remotes.Effect:FireAllClients("Knife", entity.Character)
	local look = entity.Root.CFrame.LookVector
	local best, bestDist = nil, Config.KnifeRange
	for _, other in Combat.Entities do
		if other ~= entity and TeamService.Enemies(entity, other) and Combat.IsAlive(other) then
			local offset = other.Root.Position - entity.Root.Position
			local d = offset.Magnitude
			if d <= bestDist and d > 0 and look:Dot(offset.Unit) > 0.3 then
				best, bestDist = other, d
			end
		end
	end
	if best then
		Combat.Damage(entity, best, Config.KnifeDamage, {
			Weapon = "Knife", WeaponName = "KNIFE", Kind = "Knife",
			Distance = bestDist, Position = best.Root.Position,
		})
	end
end)

function Combat.ThrowGrenade(entity, position: Vector3, velocity: Vector3)
	local g = Instance.new("Part")
	g.Name = "Grenade"
	g.Shape = Enum.PartType.Ball
	g.Size = Vector3.new(0.9, 0.9, 0.9)
	g.Color = Color3.fromRGB(50, 70, 40)
	g.Material = Enum.Material.Metal
	g.CFrame = CFrame.new(position)
	g.CanCollide = true
	g.CanQuery = false
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 60, 40)
	light.Range = 6
	light.Brightness = 3
	light.Parent = g
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.3, 0)
	a0.Parent = g
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.3, 0)
	a1.Parent = g
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.25
	trail.Color = ColorSequence.new(Color3.fromRGB(255, 140, 60))
	trail.LightEmission = 1
	trail.Parent = g
	g.Parent = workspace:FindFirstChild("Effects") or workspace
	g:SetNetworkOwner(nil)
	g.AssemblyLinearVelocity = velocity
	task.delay(Config.GrenadeFuse, function()
		local pos = g.Position
		g:Destroy()
		Combat.AreaDamage(entity, pos, Config.GrenadeRadius, Config.GrenadeDamage, {
			Weapon = "Grenade", WeaponName = "FRAG GRENADE", Kind = "Grenade", Explosive = true,
		})
	end)
end

Remotes.Grenade.OnServerEvent:Connect(function(player, dir)
	local entity = Combat.ByPlayer[player]
	if not Combat.IsAlive(entity) or entity.Downed or not validVector(dir) then
		return
	end
	local now = os.clock()
	if entity.Grenades <= 0 or now - entity.LastGrenade < 0.8 then
		return
	end
	entity.LastGrenade = now
	setGrenades(entity, entity.Grenades - 1)
	removeSpawnProtection(entity)
	local head = entity.Character:FindFirstChild("Head") or entity.Root
	dir = dir.Unit
	Combat.ThrowGrenade(entity, head.Position + dir * 2.5, dir * 80 + Vector3.new(0, 20, 0))
end)

Remotes.Slam.OnServerEvent:Connect(function(player, position)
	local entity = Combat.ByPlayer[player]
	if not Combat.IsAlive(entity) or entity.Downed or not validVector(position) then
		return
	end
	local now = os.clock()
	if now - entity.LastSlam < Config.SlamCooldown - 0.5 then
		return
	end
	if (position - entity.Root.Position).Magnitude > 15 then
		return
	end
	entity.LastSlam = now
	Combat.AreaDamage(entity, position, Config.SlamRadius, Config.SlamDamage, {
		Weapon = "Slam", WeaponName = "GROUND SLAM", Kind = "Slam",
	}, "Slam")
end)

local lastPad = {}
Remotes.JumpPad.OnServerEvent:Connect(function(player)
	if os.clock() - (lastPad[player] or 0) > 1 then
		lastPad[player] = os.clock()
		AchievementService.Add(player, "JumpPads", 1)
	end
end)
Players.PlayerRemoving:Connect(function(player)
	lastPad[player] = nil
end)

-- PICKUPS --------------------------------------------------------------------
function Combat.SetupPickups(folder: Instance)
	for _, pad in folder:GetDescendants() do
		if pad:IsA("BasePart") and pad:GetAttribute("HealthPack") then
			local ready = true
			pad.Touched:Connect(function(hit)
				if not ready then
					return
				end
				local _, model = Util.HumanoidFromPart(hit)
				local entity = model and Combat.Entities[model]
				if not Combat.IsAlive(entity) or entity.Downed then
					return
				end
				ready = false
				entity.Humanoid.Health = entity.Humanoid.MaxHealth
				for id in entity.Ammo do
					local def = Weapons.Get(id)
					entity.Ammo[id].Reserve = Weapons.ReserveSize(def, hasPass(entity, "ExtendedMags"))
				end
				setGrenades(entity, Combat.MaxGrenades(entity))
				notify(entity, "Message", { Text = "+ HEALTH & AMMO", Color = Config.Colors.Green })
				if entity.Player then
					Remotes.Effect:FireClient(entity.Player, "RefillAmmo")
				end
				pad.Transparency = 0.85
				task.delay(15, function()
					pad.Transparency = 0
					ready = true
				end)
			end)
		end
	end
end

-- REGEN LOOP -----------------------------------------------------------------
local accum = 0
RunService.Heartbeat:Connect(function(dt)
	accum += dt
	if accum < 0.2 then
		return
	end
	local step = accum
	accum = 0
	local now = os.clock()
	for _, entity in Combat.Entities do
		if Combat.IsAlive(entity) and entity.Downed then
			local hum = entity.Humanoid
			local left = hum.Health - Config.BleedRate * step
			if left <= 0.5 then
				Combat.Damage(nil, entity, 9999, entity.DownedInfo or { WeaponName = "BLED OUT" })
			else
				hum.Health = left
			end
		elseif Combat.IsAlive(entity) then
			local hum = entity.Humanoid
			if now - entity.LastDamaged >= Config.RegenDelay and hum.Health < hum.MaxHealth then
				hum.Health = math.min(hum.MaxHealth, hum.Health + Config.RegenRate * step)
			end
			if entity.Grenades < Combat.MaxGrenades(entity) then
				if now >= entity.NextGrenade then
					setGrenades(entity, entity.Grenades + 1)
					entity.NextGrenade = now + grenadeInterval(entity)
				end
			else
				entity.NextGrenade = now + grenadeInterval(entity)
			end
		end
	end
end)

return Combat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Persistent player data (cash, XP, owned guns, stats, achievements...).
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local DataService = {}
DataService.Profiles = {} :: { [Player]: any }
DataService.OnLevelUp = nil :: ((Player, number) -> ())?

local STORE_NAME = "NeonStrike_PlayerData_v1"
local storeOk, store = pcall(function()
	return DataStoreService:GetDataStore(STORE_NAME)
end)
if not storeOk then
	warn("[DataService] DataStores unavailable (enable Studio API access in Game Settings > Security). Data will not save.")
	store = nil
end

local DEFAULT = {
	Cash = Config.StartingCash,
	XP = 0,
	Level = 1,
	Owned = { Striker = true, Sidekick = true },
	Loadout = { Primary = "Striker", Secondary = "Sidekick" },
	Stats = {},
	Achievements = {},
	Daily = { Last = 0, Streak = 0 },
	BoostUntil = 0,
	Tokens = { Airstrike = 0, Nuke = 0 },
	Receipts = {},
	Settings = { FOV = 72, Shake = 1, AdsSens = 0.7, Crosshair = "White" },
}

local function key(player: Player)
	return "u_" .. player.UserId
end

function DataService.Get(player: Player)
	return DataService.Profiles[player]
end

local function applyAttributes(player: Player, data)
	player:SetAttribute("Cash", data.Cash)
	player:SetAttribute("Level", data.Level)
	player:SetAttribute("XP", data.XP)
	player:SetAttribute("XPNeeded", Config.XPForLevel(data.Level))
	player:SetAttribute("BoostUntil", data.BoostUntil)
	player:SetAttribute("AirstrikeTokens", data.Tokens.Airstrike)
	player:SetAttribute("NukeTokens", data.Tokens.Nuke)
end

-- Sends the parts of the profile the UI needs (menus, achievements).
function DataService.Sync(player: Player)
	local data = DataService.Profiles[player]
	if not data then
		return
	end
	applyAttributes(player, data)
	Remotes.DataSync:FireClient(player, {
		Owned = data.Owned,
		Loadout = data.Loadout,
		Stats = data.Stats,
		Achievements = data.Achievements,
		Daily = data.Daily,
		DailyAvailable = DataService.DailyAvailable(player),
		Settings = data.Settings,
	})
end

function DataService.Load(player: Player)
	local data
	if store then
		for attempt = 1, 4 do
			local ok, result = pcall(function()
				return store:GetAsync(key(player))
			end)
			if ok then
				data = result or {}
				break
			end
			warn("[DataService] Load failed (attempt " .. attempt .. "): " .. tostring(result))
			task.wait(attempt)
		end
	end
	local loadedFromStore = data ~= nil
	data = Util.Reconcile(data or {}, DEFAULT)
	data._canSave = loadedFromStore -- never overwrite real data after a failed load
	data._joined = os.time()
	DataService.Profiles[player] = data
	applyAttributes(player, data)
	return data
end

function DataService.Save(player: Player)
	local data = DataService.Profiles[player]
	if not data or not store or not data._canSave then
		return
	end
	local copy = Util.DeepCopy(data)
	copy._canSave = nil
	copy._joined = nil
	local ok, err = pcall(function()
		store:UpdateAsync(key(player), function()
			return copy
		end)
	end)
	if not ok then
		warn("[DataService] Save failed for " .. player.Name .. ": " .. tostring(err))
	end
end

function DataService.Release(player: Player)
	DataService.Save(player)
	DataService.Profiles[player] = nil
end

local function notify(player, kind, payload)
	Remotes.Notify:FireClient(player, kind, payload)
end

function DataService.AddCash(player: Player, amount: number, useMultiplier: boolean?, reason: string?)
	local data = DataService.Profiles[player]
	if not data or amount == 0 then
		return 0
	end
	if useMultiplier and player:GetAttribute("Pass_VIP") then
		amount *= 2
	end
	amount = math.floor(amount)
	data.Cash += amount
	player:SetAttribute("Cash", data.Cash)
	if amount > 0 then
		data.Stats.CashEarned = (data.Stats.CashEarned or 0) + amount
		player:SetAttribute("MatchCash", (player:GetAttribute("MatchCash") or 0) + amount)
		if reason then
			notify(player, "Cash", { Amount = amount, Reason = reason })
		end
	end
	return amount
end

function DataService.SpendCash(player: Player, amount: number): boolean
	local data = DataService.Profiles[player]
	if not data or data.Cash < amount then
		return false
	end
	data.Cash -= amount
	player:SetAttribute("Cash", data.Cash)
	return true
end

function DataService.XPMultiplier(player: Player): number
	local data = DataService.Profiles[player]
	local mult = 1
	if player:GetAttribute("Pass_DoubleXP") then
		mult *= 2
	end
	if data and data.BoostUntil > os.time() then
		mult *= 3
	end
	return mult
end

function DataService.AddXP(player: Player, amount: number)
	local data = DataService.Profiles[player]
	if not data then
		return 0
	end
	amount = math.floor(amount * DataService.XPMultiplier(player))
	data.XP += amount
	player:SetAttribute("MatchXP", (player:GetAttribute("MatchXP") or 0) + amount)
	while data.Level < Config.MaxLevel and data.XP >= Config.XPForLevel(data.Level) do
		data.XP -= Config.XPForLevel(data.Level)
		data.Level += 1
		local reward = data.Level * 50
		DataService.AddCash(player, reward, false)
		notify(player, "LevelUp", { Level = data.Level, Reward = reward })
		if DataService.OnLevelUp then
			DataService.OnLevelUp(player, data.Level)
		end
	end
	player:SetAttribute("Level", data.Level)
	player:SetAttribute("XP", data.XP)
	player:SetAttribute("XPNeeded", Config.XPForLevel(data.Level))
	return amount
end

-- DAILY LOGIN REWARD ---------------------------------------------------------
local DAY = 86400

function DataService.DailyAvailable(player: Player): boolean
	local data = DataService.Profiles[player]
	return data ~= nil and (os.time() // DAY) > (data.Daily.Last // DAY)
end

function DataService.ClaimDaily(player: Player)
	local data = DataService.Profiles[player]
	if not data or not DataService.DailyAvailable(player) then
		return nil
	end
	local today = os.time() // DAY
	local last = data.Daily.Last // DAY
	if today - last == 1 then
		data.Daily.Streak += 1
	else
		data.Daily.Streak = 1
	end
	data.Daily.Last = os.time()
	local index = ((data.Daily.Streak - 1) % #Config.DailyRewards) + 1
	local reward = Config.DailyRewards[index]
	DataService.AddCash(player, reward, true, "DAILY REWARD")
	return data.Daily.Streak, reward
end

-- Autosave every 2 minutes, and save everyone on shutdown.
task.spawn(function()
	while true do
		task.wait(120)
		for _, player in Players:GetPlayers() do
			task.spawn(DataService.Save, player)
		end
	end
end)

game:BindToClose(function()
	local threads = 0
	for _, player in Players:GetPlayers() do
		threads += 1
		task.spawn(function()
			DataService.Save(player)
			threads -= 1
		end)
	end
	local start = os.clock()
	while threads > 0 and os.clock() - start < 25 do
		task.wait(0.1)
	end
end)

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">KillstreakService</string>
          <string name="Source"><![CDATA[-- Killstreak rewards: UAV, Overdrive, Airstrike and the match-ending Tactical Nuke.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Combat = require(script.Parent.CombatService)
local DataService = require(script.Parent.DataService)
local AchievementService = require(script.Parent.AchievementService)
local TeamService = require(script.Parent.TeamService)

local KillstreakService = {}
KillstreakService.Round = nil -- injected RoundService
KillstreakService.NukeActive = false

local function announce(text: string, sub: string, color: Color3, icon: string)
	Remotes.Notify:FireAllClients("Announce", { Text = text, Sub = sub, Color = color, Icon = icon })
end

local function groundBelow(pos: Vector3): Vector3
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	local map = workspace:FindFirstChild("Map")
	params.FilterDescendantsInstances = map and { map } or {}
	local result = workspace:Raycast(pos + Vector3.new(0, 5, 0), Vector3.new(0, -200, 0), params)
	return result and result.Position or pos
end

local function airstrike(entity)
	local targets = {}
	for _, other in Combat.Entities do
		if other ~= entity and TeamService.Enemies(entity, other) and Combat.IsAlive(other) then
			table.insert(targets, groundBelow(other.Root.Position))
		end
	end
	for i = #targets, 2, -1 do
		local j = math.random(1, i)
		targets[i], targets[j] = targets[j], targets[i]
	end
	while #targets > 4 do
		table.remove(targets)
	end
	while #targets < 3 do
		table.insert(targets, groundBelow(Vector3.new(math.random(-90, 90), 50, math.random(-90, 90))))
	end
	local effects = workspace:FindFirstChild("Effects") or workspace
	for _, pos in targets do
		local marker = Instance.new("Part")
		marker.Shape = Enum.PartType.Cylinder
		marker.Size = Vector3.new(0.3, Config.AirstrikeRadius * 2, Config.AirstrikeRadius * 2)
		marker.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
		marker.Anchored = true
		marker.CanCollide = false
		marker.CanQuery = false
		marker.CanTouch = false
		marker.Material = Enum.Material.Neon
		marker.Color = Config.Colors.Red
		marker.Transparency = 0.55
		marker.Parent = effects
		Debris:AddItem(marker, 3)
	end
	Remotes.Effect:FireAllClients("AirstrikeIncoming", targets)
	task.delay(2.5, function()
		for _, pos in targets do
			Combat.AreaDamage(entity, pos, Config.AirstrikeRadius, Config.AirstrikeDamage, {
				Weapon = "Airstrike", WeaponName = "AIRSTRIKE", Kind = "Airstrike", Explosive = true,
			})
			task.wait(0.2)
		end
	end)
end

local function nuke(entity)
	if KillstreakService.NukeActive then
		return false
	end
	KillstreakService.NukeActive = true
	Remotes.Effect:FireAllClients("NukeIncoming", Config.NukeCountdown, entity.Name)
	task.delay(Config.NukeCountdown, function()
		Remotes.Effect:FireAllClients("NukeDetonate")
		local victims = {}
		for _, other in Combat.Entities do
			if other ~= entity and TeamService.Enemies(entity, other) and Combat.IsAlive(other) then
				table.insert(victims, other)
			end
		end
		for _, other in victims do
			local ff = other.Character:FindFirstChildOfClass("ForceField")
			if ff then
				ff:Destroy()
			end
			Combat.Damage(entity, other, 99999, { Weapon = "Nuke", WeaponName = "TACTICAL NUKE", Kind = "Nuke", Explosive = true })
		end
		KillstreakService.NukeActive = false
		local round = KillstreakService.Round
		if round and round.State == "Active" then
			round.NukeEnding = true
			round.EndMatch(entity)
		end
	end)
	return true
end

function KillstreakService.Activate(entity, id: string): boolean
	local player = entity.Player
	local radarPro = Combat.HasPass(entity, "RadarPro")
	if id == "UAV" then
		local duration = 20 * (radarPro and 2 or 1)
		if player then
			Remotes.Killstreak:FireClient(player, "UAV", duration)
		end
		AchievementService.Add(player, "UAVs", 1)
		announce("UAV ONLINE", entity.Name .. " can see everyone", Config.Colors.Accent2, "📡")
	elseif id == "Overdrive" then
		local duration = 15
		entity.OverdriveUntil = os.clock() + duration
		if player then
			player:SetAttribute("OverdriveUntil", workspace:GetServerTimeNow() + duration)
			Remotes.Killstreak:FireClient(player, "Overdrive", duration)
		end
		AchievementService.Add(player, "Overdrives", 1)
		announce("OVERDRIVE", entity.Name .. " is moving and shooting faster", Config.Colors.Accent, "⚡")
	elseif id == "InfiniteAmmo" then
		entity.InfiniteAmmo = true
		for weaponId in entity.Ammo do
			entity.Reload[weaponId] = nil
		end
		if player then
			player:SetAttribute("InfiniteAmmo", true)
			Remotes.Killstreak:FireClient(player, "InfiniteAmmo", 0)
		end
		AchievementService.Add(player, "InfiniteAmmos", 1)
		announce("INFINITE AMMO", entity.Name .. " never has to reload again (until they die)", Config.Colors.Gold, "♾️")
	elseif id == "Airstrike" then
		airstrike(entity)
		AchievementService.Add(player, "Airstrikes", 1)
		announce("AIRSTRIKE INBOUND", "Called in by " .. entity.Name .. " — MOVE!", Config.Colors.Red, "✈️")
	elseif id == "Nuke" then
		if not nuke(entity) then
			return false
		end
		AchievementService.Add(player, "Nukes", 1)
		announce("TACTICAL NUKE INCOMING", entity.Name .. " is ending this match", Config.Colors.Red, "☢️")
	end
	return true
end

function KillstreakService.OnStreak(entity, streak: number)
	if not entity.Player then
		return -- bots don't get killstreaks
	end
	local reduce = Combat.HasPass(entity, "RadarPro") and 1 or 0
	for _, ks in Config.Killstreaks do
		if streak == ks.Kills - reduce then
			KillstreakService.Activate(entity, ks.Id)
		end
	end
end

-- Purchased call-ins (Developer Products) are stored as tokens.
Remotes.UseToken.OnServerEvent:Connect(function(player, kind)
	if kind ~= "Airstrike" and kind ~= "Nuke" then
		return
	end
	local data = DataService.Get(player)
	local entity = Combat.ByPlayer[player]
	if not data or not Combat.IsAlive(entity) or (data.Tokens[kind] or 0) <= 0 then
		return
	end
	if kind == "Nuke" then
		local round = KillstreakService.Round
		if not round or round.State ~= "Active" then
			Remotes.Notify:FireClient(player, "Message", { Text = "NUKES CAN ONLY BE USED DURING A LIVE MATCH", Color = Config.Colors.Red })
			return
		end
	end
	if KillstreakService.Activate(entity, kind) then
		data.Tokens[kind] -= 1
		DataService.Sync(player)
	end
end)

return KillstreakService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="18">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Server entry point: wires all services together and handles players.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Weapons = require(Shared.Weapons)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local AchievementService = require(script.Parent.AchievementService)
local MonetizationService = require(script.Parent.MonetizationService)
local Combat = require(script.Parent.CombatService)
local KillstreakService = require(script.Parent.KillstreakService)
local MapService = require(script.Parent.MapService)
local RoundService = require(script.Parent.RoundService)
local BotService = require(script.Parent.BotService)
local VehicleService = require(script.Parent.VehicleService)

Players.CharacterAutoLoads = false
Players.RespawnTime = Config.RespawnTime

-- WIRING ---------------------------------------------------------------------
Combat.Hooks.Round = RoundService
Combat.Hooks.Killstreaks = KillstreakService
Combat.Hooks.Vehicles = VehicleService
KillstreakService.Round = RoundService
RoundService.Map = MapService
MapService.OnMapLoaded = VehicleService.OnMapLoaded
AchievementService.Init()
MapService.Init()

local deployed = {} :: { [Player]: boolean }

local function playerHolders()
	local list = {}
	for _, player in Players:GetPlayers() do
		if Combat.ByPlayer[player] then
			table.insert(list, { Holder = player, Name = player.Name, IsBot = false, Player = player })
		end
	end
	for _, h in BotService.Holders() do
		table.insert(list, h)
	end
	return list
end

RoundService.GetHolders = playerHolders

RoundService.OnEntityDied = function(entity)
	if entity.Bot then
		BotService.OnDied(entity)
		return
	end
	local player = entity.Player
	if not player then
		return
	end
	local delay = Combat.HasPass(entity, "InstantRespawn") and Config.InstantRespawnTime or Config.RespawnTime
	player:SetAttribute("RespawnAt", workspace:GetServerTimeNow() + delay)
	task.delay(delay, function()
		if player.Parent and deployed[player] and entity.Dead then
			player:LoadCharacter()
		end
	end)
end

RoundService.RespawnAll = function()
	for player in deployed do
		if player.Parent then
			task.spawn(player.LoadCharacter, player)
		end
	end
	BotService.RespawnAll()
end

-- PLAYERS ----------------------------------------------------------------------
local function onCharacter(player: Player, character: Model)
	local entity = Combat.ByPlayer[player]
	local data = DataService.Get(player)
	if not entity or not data then
		return
	end
	local root = character:WaitForChild("HumanoidRootPart")
	if not root:IsDescendantOf(workspace) then
		character.AncestryChanged:Wait()
	end
	-- wait a frame so Roblox's own spawn placement (in the sky when there's no
	-- SpawnLocation) can't override ours, then put the character on the ground
	task.wait()
	local target = MapService.PickSpawn(entity)
	character:PivotTo(target)
	root.AssemblyLinearVelocity = Vector3.zero
	task.delay(0.2, function()
		if root.Parent and (root.Position - target.Position).Magnitude > 25 then
			character:PivotTo(target)
			root.AssemblyLinearVelocity = Vector3.zero
		end
	end)
	Combat.AttachCharacter(entity, character, { data.Loadout.Primary, data.Loadout.Secondary })
	Combat.GiveLoadout(player, data.Loadout)
end

local function onPlayerAdded(player: Player)
	for _, attr in { "Kills", "Deaths", "Score", "Streak", "MatchCash", "MatchXP" } do
		player:SetAttribute(attr, 0)
	end
	local data = DataService.Load(player)
	if not player.Parent then
		return
	end
	Combat.NewEntity(player.Name, player, player)
	MonetizationService.RefreshPasses(player)
	if player:GetAttribute("Pass_Railgun") then
		data.Owned.Railgun = true
	end
	AchievementService.CheckAll(player)
	DataService.Sync(player)
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	player:SetAttribute("Loaded", true)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	deployed[player] = nil
	local entity = Combat.ByPlayer[player]
	if entity then
		Combat.RemoveEntity(entity)
	end
	DataService.Release(player)
end)

MonetizationService.OnPassesChanged = function(player)
	local entity = Combat.ByPlayer[player]
	local data = DataService.Get(player)
	if data and player:GetAttribute("Pass_Railgun") then
		data.Owned.Railgun = true
	end
	if entity and Combat.IsAlive(entity) then
		local max = Combat.MaxHealth(entity)
		entity.Humanoid.MaxHealth = max
		entity.Humanoid.Health = math.min(max, entity.Humanoid.Health + 35)
	end
end

Remotes.Deploy.OnServerEvent:Connect(function(player)
	if deployed[player] or not player:GetAttribute("Loaded") then
		return
	end
	deployed[player] = true
	player:LoadCharacter()
end)

Remotes.GetData.OnServerInvoke = function(player)
	local t = os.clock()
	while not DataService.Get(player) and os.clock() - t < 15 do
		task.wait(0.2)
	end
	DataService.Sync(player)
	return true
end

-- SHOP (in-game cash) -----------------------------------------------------------
Remotes.BuyWeapon.OnServerEvent:Connect(function(player, weaponId)
	local data = DataService.Get(player)
	local def = typeof(weaponId) == "string" and Weapons.Get(weaponId)
	if not data or not def or data.Owned[weaponId] or def.Pass then
		return
	end
	if data.Level < def.Level then
		Remotes.Notify:FireClient(player, "Message", { Text = "REACH LEVEL " .. def.Level .. " TO UNLOCK", Color = Config.Colors.Red })
		return
	end
	if not DataService.SpendCash(player, def.Price) then
		Remotes.Notify:FireClient(player, "Message", { Text = "NOT ENOUGH CASH", Color = Config.Colors.Red, Upsell = true })
		return
	end
	data.Owned[weaponId] = true
	data.Loadout[def.Slot] = weaponId
	AchievementService.Add(player, "WeaponsBought", 1)
	local owned = 0
	for _ in data.Owned do
		owned += 1
	end
	AchievementService.SetMax(player, "WeaponsOwned", owned)
	Remotes.Notify:FireClient(player, "Message", { Text = "UNLOCKED " .. def.Name, Color = Config.Colors.Green })
	DataService.Sync(player)
end)

Remotes.SetLoadout.OnServerEvent:Connect(function(player, slot, weaponId)
	local data = DataService.Get(player)
	local def = typeof(weaponId) == "string" and Weapons.Get(weaponId)
	if not data or not def or def.Slot ~= slot then
		return
	end
	local owned = data.Owned[weaponId] or (def.Pass and player:GetAttribute("Pass_" .. def.Pass))
	if not owned then
		return
	end
	data.Loadout[slot] = weaponId
	DataService.Sync(player)
	-- swap right away if you haven't been in a fight in the last few seconds
	local entity = Combat.ByPlayer[player]
	if Combat.IsAlive(entity) and not entity.Downed and os.clock() - entity.LastDamaged > 4 then
		Combat.ResetAmmo(entity, weaponId)
		Combat.GiveLoadout(player, data.Loadout)
	else
		Remotes.Notify:FireClient(player, "Message", { Text = "LOADOUT APPLIES ON NEXT SPAWN", Color = Config.Colors.Accent })
	end
end)

Remotes.ClaimDaily.OnServerEvent:Connect(function(player)
	local streak, reward = DataService.ClaimDaily(player)
	if streak then
		AchievementService.SetMax(player, "BestDaily", streak)
		Remotes.Notify:FireClient(player, "Message", { Text = "DAY " .. streak .. " REWARD: $" .. reward, Color = Config.Colors.Green })
		DataService.Sync(player)
	end
end)

local CROSSHAIRS = { White = true, Green = true, Cyan = true, Red = true, Yellow = true }
Remotes.SaveSettings.OnServerEvent:Connect(function(player, settings)
	local data = DataService.Get(player)
	if not data or typeof(settings) ~= "table" then
		return
	end
	local s = data.Settings
	local function num(v)
		return typeof(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
	end
	if num(settings.FOV) then
		s.FOV = math.clamp(math.floor(settings.FOV), 60, 100)
	end
	if num(settings.Shake) then
		s.Shake = math.clamp(settings.Shake, 0, 1)
	end
	if num(settings.AdsSens) then
		s.AdsSens = math.clamp(settings.AdsSens, 0.2, 1.5)
	end
	if typeof(settings.Crosshair) == "string" and CROSSHAIRS[settings.Crosshair] then
		s.Crosshair = settings.Crosshair
	end
end)

-- GO ---------------------------------------------------------------------------
RoundService.Start()
BotService.Start()
print("[" .. Config.GameName .. "] server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">MapService</string>
          <string name="Source"><![CDATA[-- Loads maps (with per-map lighting), runs map voting, and picks safe spawns.
-- Map modules live in Server/Maps. To use a hand-built map instead, put a
-- Model named "Map" in Workspace with a "Spawns" folder (it is used as-is).
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Combat = require(script.Parent.CombatService)
local TeamService = require(script.Parent.TeamService)
local Config = require(Shared.Config)

local MapsFolder = script.Parent.Maps
local MapService = {}
MapService.Spawns = {} -- list of { CFrame = CFrame, Team = "A"|"B"|"C"|"FFA"|nil }
MapService.Current = nil
MapService.OnMapLoaded = nil :: ((Instance) -> ())?
MapService.Order = { "Downtown", "Harbor", "Timberline", "Arena" }
MapService.Defs = {}
for _, id in MapService.Order do
	MapService.Defs[id] = require(MapsFolder:WaitForChild(id))
end

local function ensure(class: string, parent: Instance)
	local inst = parent:FindFirstChildOfClass(class) or Instance.new(class)
	inst.Parent = parent
	return inst
end

local function applyLighting(L)
	-- Cinematic "console" grade: Future lighting, soft shadows, filmic contrast,
	-- bloom on lights, sun rays, aerial haze and a touch of depth of field.
	Lighting.ClockTime = L.ClockTime or 14
	Lighting.GeographicLatitude = L.Latitude or 38
	Lighting.Brightness = L.Brightness or 2.5
	Lighting.Ambient = L.Ambient or Color3.fromRGB(70, 70, 80)
	Lighting.OutdoorAmbient = L.OutdoorAmbient or Color3.fromRGB(120, 120, 130)
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.ShadowSoftness = 0.18
	Lighting.ExposureCompensation = L.Exposure or 0
	pcall(function()
		Lighting.Technology = Enum.Technology.Future
	end)
	local sky = ensure("Sky", Lighting)
	sky.SunAngularSize = 12
	sky.MoonAngularSize = 9
	sky.StarCount = 3000
	sky.CelestialBodiesShown = true
	local atmo = ensure("Atmosphere", Lighting)
	local a = L.Atmosphere or {}
	atmo.Density = a.Density or 0.3
	atmo.Offset = a.Offset or 0.2
	atmo.Haze = a.Haze or 1
	atmo.Color = a.Color or Color3.fromRGB(200, 210, 230)
	atmo.Decay = a.Decay or Color3.fromRGB(100, 100, 130)
	atmo.Glare = a.Glare or 0.45
	local bloom = ensure("BloomEffect", Lighting)
	bloom.Intensity = 1
	bloom.Size = 26
	bloom.Threshold = 1.15 -- neon, lamps and lit windows glow; plain surfaces don't
	local cc = ensure("ColorCorrectionEffect", Lighting)
	cc.Saturation = L.Saturation or 0.12
	cc.Contrast = L.Contrast or 0.2
	cc.Brightness = 0.03
	cc.TintColor = L.Tint or Color3.new(1, 1, 1)
	local rays = ensure("SunRaysEffect", Lighting)
	rays.Intensity = L.SunRays or 0.12
	rays.Spread = 0.8
	local dof = ensure("DepthOfFieldEffect", Lighting)
	dof.FarIntensity = 0.18
	dof.FocusDistance = 90
	dof.InFocusRadius = 140
	dof.NearIntensity = 0
	pcall(function()
		local clouds = ensure("Clouds", workspace.Terrain)
		clouds.Cover = L.CloudCover or 0.6
		clouds.Density = 0.7
		clouds.Color = L.CloudColor or Color3.fromRGB(255, 255, 255)
	end)
	pcall(function()
		workspace.Terrain.Decoration = true -- animated grass blades
	end)
	workspace.Terrain.WaterColor = L.WaterColor or Color3.fromRGB(25, 95, 120)
	workspace.Terrain.WaterTransparency = 0.7
	workspace.Terrain.WaterWaveSize = 0.18
	workspace.Terrain.WaterWaveSpeed = 8
	workspace.Terrain.WaterReflectance = 0.85
end

-- Snap spawn markers to whatever surface is under them.
-- Snap a spawn marker onto the floor right under it. The ray starts only a few
-- studs above the marker so it never lands on a roof, canopy, crane or tree.
local function groundSpawn(marker: BasePart): CFrame
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { workspace:FindFirstChild("Effects"), workspace:FindFirstChild("Bots"), workspace:FindFirstChild("Vehicles") }
	local pos = marker.Position
	local result = workspace:Raycast(pos + Vector3.new(0, 6, 0), Vector3.new(0, -40, 0), params)
	if not result then
		-- marker might be buried in a hill: look a little higher, but never more than 14 studs up
		local high = workspace:Raycast(pos + Vector3.new(0, 14, 0), Vector3.new(0, -20, 0), params)
		if high and high.Position.Y < pos.Y + 14 then
			result = high
		end
	end
	local y = result and result.Position.Y + 3.2 or pos.Y
	return CFrame.new(pos.X, y, pos.Z) * marker.CFrame.Rotation
end

function MapService.Load(id: string)
	local def = MapService.Defs[id]
	if not def then
		warn("[MapService] unknown map " .. tostring(id))
		return
	end
	local old = workspace:FindFirstChild("Map")
	if old then
		old:Destroy()
	end
	local effects = workspace:FindFirstChild("Effects")
	if effects then
		effects:ClearAllChildren()
	else
		effects = Instance.new("Folder")
		effects.Name = "Effects"
		effects.Parent = workspace
	end
	workspace.Terrain:Clear()

	local kit = def.Build()
	local map = kit.Model
	map.Parent = workspace
	MapService.Current = def
	applyLighting(def.Lighting or {})

	MapService.CollectSpawns(map)
	Combat.SetupPickups(map)
	ReplicatedStorage:SetAttribute("MapId", def.Id)
	ReplicatedStorage:SetAttribute("MapName", def.Name)
	if MapService.OnMapLoaded then
		MapService.OnMapLoaded(map)
	end
	Remotes.Notify:FireAllClients("Announce", { Text = def.Name, Sub = def.Desc, Color = Color3.fromRGB(255, 198, 26), Icon = def.Icon })
end

function MapService.CollectSpawns(map: Instance)
	MapService.Spawns = {}
	local folder = map:FindFirstChild("Spawns")
	for _, s in folder and folder:GetChildren() or {} do
		if s:IsA("BasePart") then
			table.insert(MapService.Spawns, { CFrame = groundSpawn(s), Team = s:GetAttribute("Team") })
		end
	end
	if #MapService.Spawns == 0 then
		table.insert(MapService.Spawns, { CFrame = CFrame.new(0, 30, 0) })
	end
end

-- VOTING -----------------------------------------------------------------------
local votes = {} :: { [Player]: string }
local modeVotes = {} :: { [Player]: string }
local voteCursor = 0
local options = {} :: { string }

local function publishVotes()
	for _, id in MapService.Order do
		ReplicatedStorage:SetAttribute("Votes_" .. id, 0)
	end
	for _, id in Config.ModeOrder do
		ReplicatedStorage:SetAttribute("Votes_" .. id, 0)
	end
	for _, list in { votes, modeVotes } do
		for _, id in list do
			ReplicatedStorage:SetAttribute("Votes_" .. id, (ReplicatedStorage:GetAttribute("Votes_" .. id) or 0) + 1)
		end
	end
end

function MapService.StartVote()
	votes = {}
	modeVotes = {}
	options = {}
	-- 3 maps per vote, sliding through the map list so every round offers a new set
	local n = #MapService.Order
	for i = 0, math.min(3, n) - 1 do
		table.insert(options, MapService.Order[(voteCursor + i) % n + 1])
	end
	voteCursor = (voteCursor + math.min(3, n)) % n
	ReplicatedStorage:SetAttribute("VoteOptions", table.concat(options, ","))
	publishVotes()
end

local function winner(list, choices, fallback)
	local counts = {}
	for _, id in list do
		counts[id] = (counts[id] or 0) + 1
	end
	local best, bestCount = fallback, -1
	for _, id in choices do
		local c = (counts[id] or 0) + math.random() * 0.5 -- random tie-break
		if c > bestCount then
			best, bestCount = id, c
		end
	end
	return best
end

-- Returns the winning map id and game mode id.
function MapService.EndVote(): (string, string)
	local map = winner(votes, options, options[1] or MapService.Order[1])
	-- no mode votes: rotate to the next mode so every mode gets played
	local mode
	if next(modeVotes) == nil then
		local i = table.find(Config.ModeOrder, TeamService.Mode) or 0
		mode = Config.ModeOrder[i % #Config.ModeOrder + 1]
	else
		mode = winner(modeVotes, Config.ModeOrder, TeamService.Mode)
	end
	ReplicatedStorage:SetAttribute("VoteOptions", "")
	return map, mode
end

Remotes.Vote.OnServerEvent:Connect(function(player, id)
	if typeof(id) ~= "string" then
		return
	end
	if table.find(options, id) then
		votes[player] = id
		publishVotes()
	elseif Config.Modes[id] then
		modeVotes[player] = id
		publishVotes()
	end
end)
Players.PlayerRemoving:Connect(function(player)
	votes[player] = nil
	modeVotes[player] = nil
end)

function MapService.Init()
	local existing = workspace:FindFirstChild("Map")
	if existing and existing:FindFirstChild("Spawns") then
		-- hand-made map in the place file
		MapService.CollectSpawns(existing)
		Combat.SetupPickups(existing)
		applyLighting({})
		if MapService.OnMapLoaded then
			MapService.OnMapLoaded(existing)
		end
		return
	end
	MapService.Load(MapService.Order[1])
end

-- Spawn for this fighter in the current mode (team base, or anywhere in FFA),
-- picking the point farthest from living enemies (with a bit of randomness).
function MapService.PickSpawn(forEntity): CFrame
	local want = (forEntity and forEntity.Team) or (TeamService.IsTeamMode() and nil or "FFA")
	local candidates = {}
	for _, sp in MapService.Spawns do
		if sp.Team == want then
			table.insert(candidates, sp)
		end
	end
	if #candidates == 0 then
		-- maps without FFA points fall back to every spawn
		candidates = MapService.Spawns
	end
	local scored = {}
	for _, sp in candidates do
		local cf = sp.CFrame
		local nearest = math.huge
		for _, other in Combat.Entities do
			if other ~= forEntity and TeamService.Enemies(forEntity, other) and Combat.IsAlive(other) then
				nearest = math.min(nearest, (other.Root.Position - cf.Position).Magnitude)
			end
		end
		table.insert(scored, { cf = cf, score = math.min(nearest, 400) + math.random() * 25 })
	end
	table.sort(scored, function(a, b)
		return a.score > b.score
	end)
	return scored[1].cf
end

-- Any spawn point (bots use these as places to wander to)
function MapService.RandomPoint(): Vector3
	local sp = MapService.Spawns[math.random(1, #MapService.Spawns)]
	return sp.CFrame.Position
end

return MapService
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="20">
        <Properties>
          <string name="Name">Maps</string>
        </Properties>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Arena</string>
            <string name="Source"><![CDATA[-- NEON ARENA: the original symmetrical arena (fast, close-quarters).
local MapKit = require(script.Parent.MapKit)
local M = Enum.Material
local rgb = Color3.fromRGB

local Map = {
	Id = "Arena",
	Name = "NEON ARENA",
	Desc = "Compact neon arena with jump pads. Pure gunplay.",
	Icon = "⚡",
	Lighting = {
		ClockTime = 15.5, Brightness = 2.5,
		Ambient = rgb(70, 70, 85), OutdoorAmbient = rgb(120, 120, 140),
		Atmosphere = { Density = 0.3, Haze = 1.2, Color = rgb(200, 210, 255), Decay = rgb(110, 90, 160) },
		Tint = rgb(250, 250, 255), Saturation = 0.18, Contrast = 0.26, SunRays = 0.08,
	},
}

local ACCENT = rgb(255, 198, 26)
local ACCENT2 = rgb(0, 204, 255)
local DARK = rgb(40, 44, 54)
local MID = rgb(72, 78, 94)
local LIGHT = rgb(110, 118, 136)
local CRATE = rgb(176, 128, 66)

function Map.Build()
	local kit = MapKit.new(3)
	local HALF = 125
	local holes = kit:Tunnel({
		Axis = "Z", Cross = 0, From = -118, To = 118, Floor = -14, Width = 14, Height = 9, Style = "Subway",
		Entrances = { { At = -104, Dir = 1 }, { At = 104, Dir = -1 } },
	})
	-- a deeper cross tunnel passes under the first one
	local crossHoles = kit:Tunnel({
		Axis = "X", Cross = 0, From = -118, To = 118, Floor = -26, Width = 14, Height = 9, Style = "Sewer",
		Entrances = { { At = -110, Dir = 1 }, { At = 110, Dir = -1 } },
	})
	for _, h in crossHoles do
		table.insert(holes, h)
	end
	kit:Ground(0, -HALF - 5, HALF + 5, -HALF - 5, HALF + 5, 2, holes, DARK, M.Concrete)
	for i = -HALF + 25, HALF - 25, 25 do
		kit:Neon(Vector3.new(0.25, 0.05, HALF * 2), CFrame.new(i, 0.03, 0), ACCENT2).Transparency = 0.75
		kit:Neon(Vector3.new(HALF * 2, 0.05, 0.25), CFrame.new(0, 0.03, i), ACCENT2).Transparency = 0.75
	end
	for _, side in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
		local x, z = side[1], side[2]
		local size = x ~= 0 and Vector3.new(4, 40, HALF * 2 + 8) or Vector3.new(HALF * 2 + 8, 40, 4)
		local cf = CFrame.new(x * (HALF + 2), 20, z * (HALF + 2))
		kit:Part(size, cf, MID, M.Metal)
		kit:Neon(Vector3.new(size.X + 0.2, 0.6, size.Z + 0.2), cf * CFrame.new(0, -14, 0), ACCENT2)
		kit:Neon(Vector3.new(size.X + 0.2, 0.6, size.Z + 0.2), cf * CFrame.new(0, 20, 0), ACCENT)
	end

	-- wall panel ribs with light strips + corner floodlight towers
	for _, side in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
		for a = -HALF + 12, HALF - 12, 16 do
			local x = side[1] ~= 0 and side[1] * (HALF - 0.2) or a
			local z = side[2] ~= 0 and side[2] * (HALF - 0.2) or a
			local size = side[1] ~= 0 and Vector3.new(0.8, 34, 2) or Vector3.new(2, 34, 0.8)
			kit:Part(size, CFrame.new(x, 17, z), DARK, M.Metal)
			local strip = side[1] ~= 0 and Vector3.new(0.9, 10, 0.3) or Vector3.new(0.3, 10, 0.9)
			kit:Neon(strip, CFrame.new(x, 12, z), (math.floor(a / 16) % 2 == 0) and ACCENT2 or ACCENT).Transparency = 0.2
		end
	end
	for _, c in { { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } } do
		local p = Vector3.new(c[1] * (HALF - 2), 42, c[2] * (HALF - 2))
		kit:Pillar(Vector3.new(p.X, 0, p.Z), 42, 1.6, DARK, M.Metal)
		kit:Floodlight(p + Vector3.new(0, 1.5, 0), Vector3.new(0, 0, 0))
	end
	kit:Part(Vector3.new(20, 10, 20), CFrame.new(0, 5, 0), MID, M.Metal)
	kit:Neon(Vector3.new(20.4, 0.4, 20.4), CFrame.new(0, 10, 0), ACCENT)
	for _, dir in { Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1) } do
		kit:Ramp(dir * 34, dir * 10 + Vector3.new(0, 10, 0), 8, LIGHT, M.DiamondPlate)
		local side = Vector3.new(dir.Z, 0, dir.X)
		for _, s in { 1, -1 } do
			kit:Part(Vector3.new(1, 3.5, 1) + side:Abs() * 5, CFrame.new(dir * 9.5 + side * 7 * s + Vector3.new(0, 11.75, 0)), LIGHT, M.Metal)
		end
	end
	local beacon = kit:Neon(Vector3.new(2, 2, 2), CFrame.new(0, 13, 0), ACCENT)
	kit:Light(beacon, "PointLight", ACCENT, 40, 2)

	local crates = {
		{ 22, 40, Vector3.new(6, 6, 6) }, { 40, 22, Vector3.new(6, 6, 6) }, { 30, 30, Vector3.new(4, 12, 4) },
		{ 60, 45, Vector3.new(12, 6, 3) }, { 45, 60, Vector3.new(3, 6, 12) }, { 100, 40, Vector3.new(6, 6, 6) },
		{ 40, 100, Vector3.new(6, 6, 6) }, { 75, 55, Vector3.new(6, 4, 6) }, { 55, 75, Vector3.new(6, 4, 6) },
		{ 108, 15, Vector3.new(10, 5, 3) }, { 15, 108, Vector3.new(3, 5, 10) },
	}
	for _, sx in { 1, -1 } do
		for _, sz in { 1, -1 } do
			local trim = (sx * sz > 0) and ACCENT or ACCENT2
			for i, c in crates do
				local size = c[3]
				local cf = CFrame.new(c[1] * sx, size.Y / 2, c[2] * sz)
				local isCrate = size.X == size.Z
				kit:Part(size, cf, isCrate and CRATE or MID, isCrate and M.WoodPlanks or M.Metal)
				if not isCrate or i % 2 == 0 then
					kit:Neon(Vector3.new(size.X + 0.1, 0.25, size.Z + 0.1), cf * CFrame.new(0, size.Y / 2, 0), trim)
				end
			end
			local base = Vector3.new(88 * sx, 0, 88 * sz)
			kit:Part(Vector3.new(36, 8, 36), CFrame.new(base + Vector3.new(0, 4, 0)), MID, M.Metal)
			kit:Neon(Vector3.new(36.4, 0.4, 36.4), CFrame.new(base + Vector3.new(0, 8, 0)), trim)
			kit:Ramp(Vector3.new(54 * sx, 0, 88 * sz), Vector3.new(70 * sx, 8, 88 * sz), 8, LIGHT, M.DiamondPlate)
			kit:Ramp(Vector3.new(88 * sx, 0, 54 * sz), Vector3.new(88 * sx, 8, 70 * sz), 8, LIGHT, M.DiamondPlate)
			kit:Part(Vector3.new(10, 4, 1.5), CFrame.new(base + Vector3.new(-8 * sx, 10, -15 * sz)), LIGHT, M.Metal)
			kit:Part(Vector3.new(1.5, 4, 10), CFrame.new(base + Vector3.new(-15 * sx, 10, -8 * sz)), LIGHT, M.Metal)
			kit:HealthPack(Vector3.new(52 * sx, 0, 52 * sz))
		end
	end
	for _, pos in { Vector3.new(70, 0, 0), Vector3.new(-70, 0, 0), Vector3.new(0, 0, 70), Vector3.new(0, 0, -70) } do
		kit:JumpPad(pos, 115)
	end
	-- ladders up the corner bases + sandbag cover in the lanes
	for _, sx in { 1, -1 } do
		for _, sz in { 1, -1 } do
			kit:Ladder(Vector3.new(88 * sx - 19 * sx, 0, 88 * sz + 8 * sz), 12)
		end
	end
	for _, s in { { 40, 0, 0 }, { -40, 0, 0 }, { 0, 40, 90 }, { 0, -40, 90 } } do
		kit:Sandbags(CFrame.new(s[1], 0, s[2]) * CFrame.Angles(0, math.rad(s[3]), 0), 10, 3)
	end
	-- FREE FOR ALL spawns around the edges + TRIPLE TEAM base on the west side
	local ffa = {}
	for _, along in { -60, 0, 60 } do
		for _, edge in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
			table.insert(ffa, edge[1] ~= 0 and Vector3.new(edge[1] * 115, 0, along + 20) or Vector3.new(along + 20, 0, edge[2] * 115))
		end
	end
	for _, p in { { 30, 75 }, { -75, 30 }, { -30, -75 }, { 75, -30 }, { 0, 52 }, { 0, -52 } } do
		table.insert(ffa, Vector3.new(p[1], 0, p[2]))
	end
	kit:FFASpawns(ffa, 40)
	-- MORE COVER: neon walls, pillars and crate stacks break up the open lanes
	kit:CoverField({ { -20, 66 }, { 20, -66 }, { 76, 26 }, { -76, -26 }, { -6, -60 }, { 6, 60 }, { 40, -84 }, { -40, 84 }, { -18, 20 }, { -20, -18 }, { 18, 20 }, { 20, -18 }, { 42, 40 }, { 40, -42 }, { -40, -42 }, { -40, 42 }, { 106, 56 }, { -62, 62 }, { -62, -62 }, { 62, 62 }, { 62, -62 }, { 108, -60 }, { 96, -26 }, { 54, -20 } }, "Arena")
	kit:SpawnBase(Vector3.new(-114, 0, 0), Vector3.new(0, 0, 0), "C", 100)
	kit:Mountains(HALF + 10, HALF + 10, { Margin = 70, GroundY = -0.5 })
	-- TEAM SPAWNS at both ends
	kit:SpawnBase(Vector3.new(0, 0, -114), Vector3.new(0, 0, 0), "A", 110)
	kit:SpawnBase(Vector3.new(0, 0, 114), Vector3.new(0, 0, 0), "B", 110)
	kit:Boundary(HALF + 4, HALF + 4, 260)
	return kit
end

return Map
]]></string>
          </Properties>
