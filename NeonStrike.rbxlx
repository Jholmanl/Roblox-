        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Downtown</string>
            <string name="Source"><![CDATA[-- DOWNTOWN: city blocks, subway tunnel, fire escapes, open-window buildings,
-- barricaded intersections. Team ALPHA spawns south, BRAVO north.
local MapKit = require(script.Parent.MapKit)
local M = Enum.Material
local P = MapKit.Palette
local rgb = Color3.fromRGB

local Map = {
	Id = "Downtown",
	Name = "DOWNTOWN",
	Desc = "City streets, rooftops and a subway under the avenue.",
	Icon = "🏙️",
	Lighting = {
		ClockTime = 18.1, Brightness = 2, Exposure = 0.15,
		Ambient = rgb(90, 80, 90), OutdoorAmbient = rgb(140, 120, 120),
		Atmosphere = { Density = 0.32, Haze = 1.6, Color = rgb(255, 200, 170), Decay = rgb(120, 90, 110) },
		Tint = rgb(255, 236, 222), Saturation = 0.14, Contrast = 0.24, SunRays = 0.16, CloudColor = rgb(255, 205, 185),
	},
}

local HALF = 160
local ROADS = { -100, 0, 100 }
local ROAD_W = 24

function Map.Build()
	local kit = MapKit.new(7)
	local rng = kit.Rng

	-- SUBWAY under the main avenue (x = 0), entrances at both spawns + mid-blocks
	local holes = kit:Tunnel({
		Axis = "Z", Cross = 0, From = -152, To = 152, Floor = -14, Width = 14, Height = 9, Style = "Subway",
		Entrances = {
			{ At = -150, Dir = 1 }, { At = -80, Dir = 1 }, { At = -20, Dir = -1 },
			{ At = 20, Dir = 1 }, { At = 80, Dir = -1 }, { At = 150, Dir = -1 },
		},
	})

	-- ground (the asphalt IS the road surface; blocks are raised sidewalks)
	kit:Ground(0, -HALF - 20, HALF + 20, -HALF - 20, HALF + 20, 2, holes, P.Asphalt, M.Asphalt)
	for _, c in ROADS do
		kit:Road("X", Vector3.new(0, 0, c), HALF * 2, ROAD_W, ROADS, true)
		kit:Road("Z", Vector3.new(c, 0, 0), HALF * 2, ROAD_W, ROADS, true)
	end
	for _, x in ROADS do
		for _, z in ROADS do
			kit:Crosswalk(Vector3.new(x, 0, z - ROAD_W / 2 - 3), "Z", ROAD_W)
			kit:Crosswalk(Vector3.new(x, 0, z + ROAD_W / 2 + 3), "Z", ROAD_W)
			kit:Crosswalk(Vector3.new(x - ROAD_W / 2 - 3, 0, z), "X", ROAD_W)
			kit:Crosswalk(Vector3.new(x + ROAD_W / 2 + 3, 0, z), "X", ROAD_W)
			kit:TrafficLight(Vector3.new(x + 14, 0.8, z + 14), Vector3.new(-1, 0, 0))
			kit:TrafficLight(Vector3.new(x - 14, 0.8, z - 14), Vector3.new(1, 0, 0))
			kit:StreetSign(Vector3.new(x - 14, 0.8, z + 14), math.rad(45))
			kit:Manhole(Vector3.new(x + 5, 0, z - 5))
			-- barricaded intersection: sandbag nests on two corners
			if not (x == 0 and math.abs(z) > 50) then
				kit:Sandbags(CFrame.new(x - 6, 0, z + 6) * CFrame.Angles(0, math.rad(45), 0), 8, 3)
				kit:Sandbags(CFrame.new(x + 6, 0, z - 6) * CFrame.Angles(0, math.rad(45), 0), 8, 3)
			end
		end
	end

	-- city blocks between roads: inner (±50) and edge strips (±136)
	local spans = { { -88, -12 }, { 12, 88 }, { -160, -112 }, { 112, 160 } }
	for _, sx in spans do
		for _, sz in spans do
			local cx, cz = (sx[1] + sx[2]) / 2, (sz[1] + sz[2]) / 2
			kit:Sidewalk(Vector3.new(cx, 0, cz), sx[2] - sx[1], sz[2] - sz[1])
			local edge = math.abs(cx) > 100 or math.abs(cz) > 100
			if not edge then
				for d = sx[1] + 8, sx[2] - 8, 30 do
					kit:StreetLight(Vector3.new(d, 0.8, sz[1] + 1.5), Vector3.new(0, 0, -1))
					kit:StreetLight(Vector3.new(d, 0.8, sz[2] - 1.5), Vector3.new(0, 0, 1))
				end
				-- street furniture along the curbs
				kit:Hydrant(Vector3.new(sx[1] + 3, 0.8, sz[1] + 22))
				kit:TrashCan(Vector3.new(sx[2] - 3, 0.8, sz[1] + 30))
				kit:TrashCan(Vector3.new(sx[1] + 3, 0.8, sz[2] - 30))
				kit:NewsBox(CFrame.new(sx[2] - 2.5, 0.8, sz[2] - 20) * CFrame.Angles(0, math.rad(-90), 0))
				kit:Planter(Vector3.new(sx[1] + 22, 0.8, sz[2] - 3))
				kit:Planter(Vector3.new(sx[2] - 22, 0.8, sz[1] + 3))
				kit:PowerBox(CFrame.new(sx[2] - 3, 0.8, (sz[1] + sz[2]) / 2) * CFrame.Angles(0, math.rad(90), 0))
			end
		end
	end
	kit:BusStop(CFrame.new(-14.5, 0.8, -50) * CFrame.Angles(0, math.rad(-90), 0))
	kit:BusStop(CFrame.new(14.5, 0.8, 50) * CFrame.Angles(0, math.rad(90), 0))

	-- SKYLINE: towers on the east/west edge strips (the north/south ends are spawns)
	for _, sx in spans do
		for _, sz in spans do
			local cx, cz = (sx[1] + sx[2]) / 2, (sz[1] + sz[2]) / 2
			local spawnStrip = (math.abs(cz) > 100 and math.abs(cx) < 100) or (cx < -100 and math.abs(cz) < 100)
			if (math.abs(cx) > 100 or math.abs(cz) > 100) and not spawnStrip then
				local w, d = sx[2] - sx[1] - 8, sz[2] - sz[1] - 8
				local cols = w > 50 and 2 or 1
				local rows = d > 50 and 2 or 1
				for i = 1, cols do
					for j = 1, rows do
						local tx = sx[1] + 4 + (i - 0.5) * w / cols
						local tz = sz[1] + 4 + (j - 0.5) * d / rows
						local h = rng:NextNumber(40, 80)
						local tint = ({ rgb(120, 124, 130), rgb(150, 140, 120), rgb(90, 96, 110), rgb(170, 160, 150) })[rng:NextInteger(1, 4)]
						kit:Tower(CFrame.new(tx, 0.8, tz), w / cols - 4, d / rows - 4, h, tint, M.Concrete)
					end
				end
			end
		end
	end

	-- TEAM SPAWNS at both ends
	kit:SpawnBase(Vector3.new(0, 0, -138), Vector3.new(0, 0, 0), "A", 150)
	kit:SpawnBase(Vector3.new(0, 0, 138), Vector3.new(0, 0, 0), "B", 150)
	for _, c in { -100, 100 } do
		for _, s in { -1, 1 } do
			kit:Barrier(CFrame.new(c - 6, 0, s * 152))
			kit:Barrier(CFrame.new(c + 6, 0, s * 152))
		end
	end
	for _, s in { -1, 1 } do
		for _, c in ROADS do
			kit:Barrier(CFrame.new(s * 150, 0, c - 6) * CFrame.Angles(0, math.rad(90), 0))
			kit:Barrier(CFrame.new(s * 150, 0, c + 6) * CFrame.Angles(0, math.rad(90), 0))
		end
	end

	-- BLOCK A (+,+): CENTRAL PARK with grass, pond, trees and hiding bushes
	kit:Fill(M.Grass, CFrame.new(50, 0, 50), Vector3.new(72, 1.6, 72))
	kit:Fill(M.Mud, CFrame.new(62, -1.2, 62), Vector3.new(26, 2, 20))
	kit:Water(CFrame.new(62, -0.2, 62), Vector3.new(24, 1.6, 18))
	for _, path in { { Vector3.new(50, 0.9, 50), Vector3.new(72, 0.2, 5) }, { Vector3.new(50, 0.9, 50), Vector3.new(5, 0.2, 72) } } do
		kit:Part(path[2], CFrame.new(path[1]), P.Sidewalk, M.Pavement)
	end
	kit:Cylinder(1.6, 16, CFrame.new(50, 1.6, 50) * CFrame.Angles(0, 0, math.rad(90)), P.Concrete, M.Marble)
	local pool = kit:Cylinder(0.3, 14, CFrame.new(50, 2.45, 50) * CFrame.Angles(0, 0, math.rad(90)), rgb(60, 140, 200), M.Glass)
	pool.Transparency = 0.3
	kit:Pillar(Vector3.new(50, 2.4, 50), 5, 1.6, P.Concrete, M.Marble)
	kit:Ball(3, Vector3.new(50, 8, 50), P.Concrete, M.Marble)
	for _, t in { { 24, 24 }, { 24, 76 }, { 34, 64 }, { 40, 30 }, { 76, 26 }, { 82, 40 }, { 30, 44 }, { 66, 36 }, { 44, 80 }, { 80, 80 }, { 20, 58 } } do
		kit:Tree(Vector3.new(t[1], 0.8, t[2]), rng:NextNumber(0.9, 1.3), "Oak")
	end
	for _, b in { { 40, 56 }, { 60, 44 }, { 44, 40 } } do
		kit:Bench(CFrame.new(b[1], 0.8, b[2]))
	end
	for _, b in { { 22, 34 }, { 34, 22 }, { 78, 70 }, { 70, 82 }, { 26, 70 }, { 82, 26 } } do
		kit:HideBush(Vector3.new(b[1], 0.8, b[2]), 1)
	end
	kit:Sandbags(CFrame.new(50, 0.8, 30), 10, 3)

	-- BLOCK B (-,+): apartments with fire escape, hotel, diner + alley
	kit:Building({ Name = "Apartments", Origin = CFrame.new(-66, 0.8, 32), W = 36, D = 28, Floors = 3, Color = P.Brick, Material = M.Brick, Trim = rgb(200, 190, 170), Doors = { Front = true, Back = true }, Awning = rgb(30, 90, 140), FireEscape = "Right", OpenWindows = 0.35, Balconies = true })
	kit:Building({ Name = "Hotel", Origin = CFrame.new(-66, 0.8, 72), W = 36, D = 22, Floors = 3, FloorH = 11, Color = P.Plaster, Material = M.SmoothPlastic, Trim = P.BrickDark, Doors = { Front = true, Back = true }, Awning = rgb(150, 30, 40), Ladder = "Back", OpenWindows = 0.3 })
	kit:Building({ Name = "Diner", Origin = CFrame.new(-26, 0.8, 54) * CFrame.Angles(0, math.rad(90), 0), W = 26, D = 20, Floors = 1, Color = rgb(200, 70, 60), Material = M.SmoothPlastic, Trim = P.White, Doors = { Front = true, Back = true }, Awning = P.White, Storefront = rgb(220, 40, 40), Ladder = "Back" })
	kit:Dumpster(CFrame.new(-40, 0.8, 18))
	kit:Dumpster(CFrame.new(-42, 0.8, 86) * CFrame.Angles(0, math.rad(90), 0))
	kit:HideBush(Vector3.new(-44, 0.8, 50), 0.8)
	for i = 1, 4 do
		kit:Crate(Vector3.new(-32 + i * 2, 0.8, 80 - i * 3), 3.5, i)
	end
	kit:Sandbags(CFrame.new(-40, 0.8, 34) * CFrame.Angles(0, math.rad(90), 0), 8, 4)

	-- BLOCK C (-,-): parking lot + gas station + corner store
	kit:Part(Vector3.new(70, 0.1, 70), CFrame.new(-50, 0.85, -50), P.Asphalt, M.Asphalt)
	for i = 0, 6 do
		kit:Deco(Vector3.new(0.4, 0.05, 12), CFrame.new(-82 + i * 10, 0.93, -26), P.White, M.SmoothPlastic)
		kit:Deco(Vector3.new(0.4, 0.05, 12), CFrame.new(-82 + i * 10, 0.93, -74), P.White, M.SmoothPlastic)
	end
	for _, x in { -64, -36 } do
		for _, z in { -58, -42 } do
			kit:Pillar(Vector3.new(x, 0.8, z), 12, 1.4, P.White, M.SmoothPlastic)
		end
	end
	kit:Part(Vector3.new(34, 1.6, 22), CFrame.new(-50, 13.6, -50), P.White, M.SmoothPlastic)
	kit:Neon(Vector3.new(34.2, 0.6, 22.2), CFrame.new(-50, 12.9, -50), rgb(220, 40, 40))
	kit:Ladder(Vector3.new(-66.5, 0.8, -50), 14, nil)
	for _, x in { -56, -44 } do
		kit:Part(Vector3.new(2, 5, 3), CFrame.new(x, 3.3, -50), rgb(220, 40, 40), M.SmoothPlastic)
	end
	kit:Building({ Name = "Store", Origin = CFrame.new(-50, 0.8, -80) * CFrame.Angles(0, math.rad(180), 0), W = 30, D = 12, Floors = 1, Color = rgb(230, 230, 220), Material = M.SmoothPlastic, Trim = rgb(220, 40, 40), Doors = { Front = true }, Awning = rgb(220, 40, 40), Storefront = rgb(30, 120, 200), Props = false })
	kit:Sandbags(CFrame.new(-30, 0.8, -30) * CFrame.Angles(0, math.rad(45), 0), 10, 3)

	-- BLOCK D (+,-): office tower + pharmacy + plaza
	kit:Building({ Name = "Office", Origin = CFrame.new(62, 0.8, -60), W = 36, D = 36, Floors = 4, Color = rgb(170, 180, 190), Material = M.Concrete, Trim = rgb(60, 70, 90), Doors = { Front = true, Left = true }, Awning = rgb(60, 70, 90), FireEscape = "Right", OpenWindows = 0.2 })
	kit:Building({ Name = "Pharmacy", Origin = CFrame.new(28, 0.8, -78) * CFrame.Angles(0, math.rad(180), 0), W = 22, D = 16, Floors = 1, Color = rgb(235, 235, 235), Material = M.SmoothPlastic, Trim = rgb(30, 150, 80), Doors = { Front = true }, Awning = rgb(30, 150, 80), Storefront = rgb(30, 160, 90), Ladder = "Left", Props = false })
	for i = 1, 3 do
		kit:Barrier(CFrame.new(20 + i * 9, 0.8, -22) * CFrame.Angles(0, rng:NextNumber(-0.2, 0.2), 0))
	end
	kit:Tree(Vector3.new(22, 0.8, -40), 1, "Oak")
	kit:HideBush(Vector3.new(36, 0.8, -40), 0.9)

	-- street cover: wrecked / parked cars, barriers, cones
	local parked = {
		{ -100, 40, 0, "Sedan" }, { -96, -60, 180, "Truck" }, { 6, 62, 0, "Sedan" }, { -6, -62, 180, "Sports" },
		{ 100, -30, 0, "Sedan" }, { 60, 4, 90, "Truck" }, { -60, -4, 270, "Sedan" }, { 40, 104, 90, "Sedan" }, { -40, -104, 270, "Truck" },
	}
	for _, c in parked do
		local spot = kit:VehicleSpot(CFrame.new(c[1], 0, c[2]) * CFrame.Angles(0, math.rad(c[3]), 0), c[4])
		spot:SetAttribute("Parked", true)
	end
	for _, b in { { -30, 0, 80 }, { 100, 60, -10 }, { 30, -100, 95 }, { -100, -30, 5 }, { 70, 100, 85 } } do
		kit:Barrier(CFrame.new(b[1], 0, b[2]) * CFrame.Angles(0, math.rad(b[3]), 0))
	end
	for _, c in { { 96, 8 }, { 92, 10 }, { -96, -8 }, { 8, 96 }, { -8, -96 } } do
		kit:Cone(Vector3.new(c[1], 0, c[2]))
	end
	for _, c in { { -94, 70, 0, "Sports" }, { 94, 40, 0, "Jeep" }, { -40, 96, 90, "Sedan" }, { 40, -96, 270, "Truck" } } do
		kit:VehicleSpot(CFrame.new(c[1], 0, c[2]) * CFrame.Angles(0, math.rad(c[3]), 0), c[4])
	end

	for _, p in { Vector3.new(20, 0.8, 20), Vector3.new(-20, 0.8, -20), Vector3.new(-20, 0.8, 20), Vector3.new(20, 0.8, -20) } do
		kit:HealthPack(p)
	end
	-- TRIPLE TEAM base (west road end) + FREE FOR ALL spawns all over the city
	kit:SpawnBase(Vector3.new(-138, 0.8, 0), Vector3.new(0, 0, 0), "C", 150)
	-- CHARLIE plaza on the west strip: lamps, planters and cover instead of towers
	for _, z in { -80, -50, -20, 20, 50, 80 } do
		kit:StreetLight(Vector3.new(-113.5, 0.8, z), Vector3.new(1, 0, 0))
	end
	for _, p in { { -126, -70 }, { -150, -40 }, { -126, 40 }, { -150, 72 } } do
		kit:CoverCluster(Vector3.new(p[1], 0.8, p[2]), "City", "Planter")
	end
	kit:CoverCluster(Vector3.new(-128, 0.8, -28), "City", "BrokenWall")
	kit:CoverCluster(Vector3.new(-128, 0.8, 28), "City", "Crates")
	-- MORE COVER: open lots + both sides of every street (driving lanes stay clear)
	kit:CoverField({ { -51, -31 }, { 67, -27 }, { 29, -57 }, { -25, -65 }, { -51, -61 }, { -29, 29 }, { -77, -35 }, { -77, -73 } }, "City")
	for _, c in ROADS do
		-- keep the avenue's subway stairs and the spawn ends clear
		local ends = c == 0 and { -100, 0, 100, -138, 138, -80, -20, 20, 80 } or { -100, 0, 100 }
		kit:RoadCover("X", c, -146, 146, 30, 8, "City", c == 0 and { -100, 0, 100, -138 } or { -100, 0, 100 })
		kit:RoadCover("Z", c, -146, 146, 30, 8, "City", ends)
	end
	local ffa = {}
	for _, x in ROADS do
		for _, z in { -50, 50 } do
			table.insert(ffa, Vector3.new(x, 0, z))
		end
	end
	for _, z in ROADS do
		for _, x in { -40, 40 } do
			table.insert(ffa, Vector3.new(x, 0, z))
		end
	end
	for _, p in { { 0, -118 }, { 0, 118 }, { -40, -135 }, { 40, -135 }, { -40, 135 }, { 40, 135 }, { 60, 72 }, { -84, -40 }, { 84, 30 } } do
		table.insert(ffa, Vector3.new(p[1], 0, p[2]))
	end
	kit:FFASpawns(ffa)

	-- mountains all around (beyond the boundary, can't be reached)
	kit:Mountains(HALF, HALF, { Margin = 60, GroundY = -0.5 })
	kit:Boundary(HALF - 2, HALF - 2, 260)
	return kit
end

return Map
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Harbor</string>
            <string name="Source"><![CDATA[-- HARBOR: container maze, cranes, warehouses, a boardable cargo ship and a
-- storm-drain tunnel. Team ALPHA spawns west, BRAVO east.
local MapKit = require(script.Parent.MapKit)
local M = Enum.Material
local P = MapKit.Palette
local rgb = Color3.fromRGB

local Map = {
	Id = "Harbor",
	Name = "HARBOR",
	Desc = "Shipping docks at sunset. Container maze, cranes and a storm drain.",
	Icon = "⚓",
	Lighting = {
		ClockTime = 17.4, Brightness = 2.4,
		Ambient = rgb(100, 80, 80), OutdoorAmbient = rgb(150, 120, 110),
		Atmosphere = { Density = 0.3, Haze = 2, Color = rgb(255, 190, 150), Decay = rgb(150, 90, 100) },
		Tint = rgb(255, 232, 212), Saturation = 0.16, Contrast = 0.22, SunRays = 0.2, CloudColor = rgb(255, 210, 180), WaterColor = rgb(20, 80, 110),
	},
}

local HALF = 150

function Map.Build()
	local kit = MapKit.new(33)
	local rng = kit.Rng

	-- STORM DRAIN under the crane lane, spawn to spawn
	local holes = kit:Tunnel({
		Axis = "X", Cross = -74, From = -146, To = 146, Floor = -14, Width = 14, Height = 9, Style = "Sewer",
		Entrances = { { At = -142, Dir = 1 }, { At = -30, Dir = -1 }, { At = 30, Dir = 1 }, { At = 142, Dir = -1 } },
	})

	-- land + sea
	kit:Ground(0, -HALF - 10, HALF + 10, -HALF - 10, 40, 4, holes, P.ConcreteDark, M.Concrete)
	kit:Part(Vector3.new(HALF * 2 + 20, 0.3, 1.5), CFrame.new(0, 0.15, 39.2), P.Yellow, M.SmoothPlastic)
	kit:Part(Vector3.new(HALF * 2 + 20, 6, 2), CFrame.new(0, -3, 40.5), P.ConcreteDark, M.Concrete)
	kit:Fill(M.Sand, CFrame.new(0, -14, 330), Vector3.new(HALF * 2 + 900, 6, 600))
	kit:Water(CFrame.new(0, -6, 330), Vector3.new(HALF * 2 + 900, 10, 600))
	-- distant islands on the sea side
	for _, isl in { { -260, 420, 70 }, { 40, 520, 110 }, { 320, 380, 80 }, { -480, 300, 90 }, { 520, 470, 120 } } do
		kit:FillBall(M.Rock, Vector3.new(isl[1], -isl[3] * 0.45, isl[2]), isl[3])
		kit:FillBall(M.Grass, Vector3.new(isl[1], -isl[3] * 0.6, isl[2]), isl[3] * 0.98)
	end
	for x = -HALF + 10, HALF - 10, 20 do
		kit:Pillar(Vector3.new(x, 0, 37.5), 1.5, 1.4, rgb(40, 40, 44), M.Metal)
	end
	kit:Road("X", Vector3.new(0, 0, 20), HALF * 2, 20, {})
	for x = -120, 120, 40 do
		kit:Manhole(Vector3.new(x + 7, 0.3, 14))
	end

	-- CONTAINER YARD (west-middle) with the crane lane through the middle
	local cols = { -112, -100, -88, -64, -52, -40 }
	local rows = { -136, -112, -94, -54, -32, -10 }
	for ci, x in cols do
		for ri, z in rows do
			if rng:NextNumber() > 0.14 then
				local stack = rng:NextInteger(1, 3)
				for level = 0, stack - 1 do
					kit:Container(CFrame.new(x, level * 8.5, z), nil, level == 0 and rng:NextNumber() < 0.3)
				end
				-- ladder up the tall stacks so you can fight on top
				if stack >= 2 and (ci + ri) % 3 == 0 then
					kit:Ladder(Vector3.new(x + 5, 0, z + 6), stack * 8.5 + 3)
				end
			end
		end
	end
	kit:Crane(CFrame.new(-76, 0, -74), 76, 40)
	kit:Ladder(Vector3.new(-76 - 38 + 2, 0, -74 - 8), 42)
	kit:Crane(CFrame.new(50, 0, 30) * CFrame.Angles(0, math.rad(90), 0), 34, 50)

	-- WAREHOUSES (east)
	kit:Building({
		Name = "Warehouse", Origin = CFrame.new(70, 0, -112), W = 56, D = 40, Floors = 1, FloorH = 18,
		Color = rgb(90, 110, 130), Material = M.CorrodedMetal, Trim = rgb(50, 60, 70), Floor = rgb(110, 110, 110),
		Doors = { Front = true, Back = true, Left = true, Right = true }, Awning = rgb(240, 180, 30),
		OpenWindows = 0.5, Ladder = "Back", Pilasters = false,
	})
	kit:Building({
		Name = "PortOffice", Origin = CFrame.new(70, 0, -42), W = 46, D = 26, Floors = 2, FloorH = 12,
		Color = rgb(220, 214, 200), Material = M.Concrete, Trim = rgb(40, 90, 140),
		Doors = { Front = true, Back = true }, Awning = rgb(40, 90, 140),
		OpenWindows = 0.4, FireEscape = "Right",
	})
	-- fuel tanks (south)
	for _, x in { -10, 22 } do
		kit:Pillar(Vector3.new(x, 0, -132), 24, 22, rgb(225, 225, 220), M.Metal)
		kit:Cylinder(0.8, 22.5, CFrame.new(x, 17, -132) * CFrame.Angles(0, 0, math.rad(90)), rgb(200, 60, 50), M.Metal)
	end
	kit:Ladder(Vector3.new(-10, 0, -120), 26)

	-- CARGO SHIP + gangway + stern ladder
	kit:Ship(CFrame.new(0, 0, 77) * CFrame.Angles(0, math.rad(90), 0), 130, -20)
	kit:Ramp(Vector3.new(-20, 0, 36), Vector3.new(-20, 12.6, 62.5), 6, P.MetalDark, M.DiamondPlate)

	-- PIERS + boats
	for _, x in { -112, 112 } do
		kit:Pier(Vector3.new(x, 0, 41), Vector3.new(x, 0, 120), 10, 0.6)
		for _, side in { -1, 1 } do
			local bx, bz = x + side * 12, 90 + side * 10
			kit:Part(Vector3.new(8, 4, 20), CFrame.new(bx, -1.5, bz), side > 0 and P.White or rgb(40, 80, 140), M.SmoothPlastic)
			kit:Wedge(Vector3.new(8, 4, 6), CFrame.new(bx, -1.5, bz - 13), side > 0 and P.White or rgb(40, 80, 140), M.SmoothPlastic)
			kit:Part(Vector3.new(6, 4, 7), CFrame.new(bx, 2.5, bz + 3), P.White, M.SmoothPlastic)
			kit:Glass(Vector3.new(6.2, 1.5, 7.2), CFrame.new(bx, 3.2, bz + 3))
		end
		kit:Sandbags(CFrame.new(x, 0.6, 70), 8, 3)
	end

	-- LIGHTHOUSE island
	kit:FillBall(M.Rock, Vector3.new(118, -16, 130), 22)
	kit:Pillar(Vector3.new(118, 4, 130), 34, 8, P.White, M.SmoothPlastic)
	for y = 10, 34, 10 do
		kit:Cylinder(3, 8.2, CFrame.new(118, y, 130) * CFrame.Angles(0, 0, math.rad(90)), P.Red, M.SmoothPlastic)
	end
	local lamp = kit:Neon(Vector3.new(5, 5, 5), CFrame.new(118, 40.5, 130), rgb(255, 240, 180))
	kit:Light(lamp, "PointLight", rgb(255, 230, 170), 60, 3)

	-- dockside dressing
	for x = -136, 136, 34 do
		kit:Tree(Vector3.new(x, 0, 30), rng:NextNumber(0.9, 1.2), "Palm")
		kit:StreetLight(Vector3.new(x + 17, 0, 30), Vector3.new(0, 0, -1))
	end
	for i = 1, 16 do
		local x, z = rng:NextNumber(-25, 30), rng:NextNumber(-115, 5)
		if i % 2 == 0 then
			kit:Crate(Vector3.new(x, 0, z), 4, rng:NextNumber(0, 1))
			kit:Crate(Vector3.new(x + 4.2, 0, z), 4, rng:NextNumber(0, 1))
			kit:Crate(Vector3.new(x + 2, 4, z), 4, rng:NextNumber(0, 1))
		else
			for b = 0, 2 do
				kit:Pillar(Vector3.new(x + b * 2.3, 0, z), 3.6, 2.2, ({ rgb(30, 80, 160), rgb(200, 60, 40), rgb(60, 140, 70) })[b + 1], M.Metal)
			end
		end
	end
	-- sandbag lines across the open ground
	for _, s in { { -8, -50, 0 }, { 20, -90, 0 }, { 0, -20, 90 }, { 34, 0, 0 }, { -24, -110, 90 }, { 104, -74, 90 }, { -28, 4, 0 } } do
		kit:Sandbags(CFrame.new(s[1], 0, s[2]) * CFrame.Angles(0, math.rad(s[3]), 0), 10, 3)
	end
	for _, b in { { 10, -60, 0 }, { 40, -10, 60 }, { -10, -140, 30 } } do
		kit:Barrier(CFrame.new(b[1], 0, b[2]) * CFrame.Angles(0, math.rad(b[3]), 0))
	end

	-- pickups, vehicles
	for _, p in { Vector3.new(-76, 0, -74), Vector3.new(30, 0, -74), Vector3.new(0, 0, 10), Vector3.new(40, 0, -128) } do
		kit:HealthPack(p)
	end
	kit:VehicleSpot(CFrame.new(-90, 0.5, 20) * CFrame.Angles(0, math.rad(-90), 0), "Truck")
	kit:VehicleSpot(CFrame.new(70, 0.5, 16) * CFrame.Angles(0, math.rad(90), 0), "Sedan")
	kit:VehicleSpot(CFrame.new(120, 0.5, -10), "Jeep")
	kit:VehicleSpot(CFrame.new(-120, 0.5, -10), "Jeep")
	local parked = kit:VehicleSpot(CFrame.new(0, 0.5, -100), "Truck")
	parked:SetAttribute("Parked", true)

	-- TEAM SPAWNS at both ends
	kit:SpawnBase(Vector3.new(-138, 0, -74), Vector3.new(0, 0, -74), "A", 130)
	kit:SpawnBase(Vector3.new(138, 0, -74), Vector3.new(0, 0, -74), "B", 130)
	-- TRIPLE TEAM base (on the quay) + FREE FOR ALL spawns everywhere
	kit:SpawnBase(Vector3.new(0, 0, 22), Vector3.new(0, 0, -60), "C", 100)
	local ffa = {}
	for _, p in { { -130, -110 }, { -130, -35 }, { 130, -130 }, { 130, -20 }, { -20, -60 }, { 10, -30 }, { -60, 10 }, { 100, 8 }, { -100, 8 }, { 40, -145 }, { -25, -118 }, { 110, -60 }, { 60, 0 }, { -76, -40 } } do
		table.insert(ffa, Vector3.new(p[1], 0, p[2]))
	end
	kit:FFASpawns(ffa)
	-- MORE COVER in the open yards + along the quay road
	kit:CoverField({ { 79, -73 }, { -19, -23 }, { 83, -13 }, { 109, -37 }, { 15, -7 }, { -81, -115 }, { 111, -97 }, { 35, -25 }, { 29, -109 }, { -95, -75 }, { 9, -49 }, { 111, -133 }, { -61, -73 }, { 87, -121 } }, "Harbor")
	kit:RoadCover("X", 20, -140, -64, 26, 6.5, "Harbor", { -90 })
	kit:RoadCover("X", 20, 64, 140, 26, 6.5, "Harbor", { 70 })
	kit:Mountains(HALF, HALF, { Margin = 50, SkipSide = "N", GroundY = -0.5 })
	kit:Boundary(HALF, HALF, 260)
	return kit
end

return Map
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">MapKit</string>
            <string name="Source"><![CDATA[-- MapKit: procedural building blocks for maps.
-- Everything is made of plain parts + Terrain, so maps need zero uploaded assets.
-- A map module calls kit:Building{...}, kit:Tree(...), kit:Road(...), etc.
local MapKit = {}
MapKit.__index = MapKit

local M = Enum.Material
local rgb = Color3.fromRGB

MapKit.Palette = {
	Asphalt = rgb(48, 50, 56),
	Concrete = rgb(150, 150, 146),
	ConcreteDark = rgb(105, 106, 108),
	Sidewalk = rgb(170, 168, 160),
	Brick = rgb(150, 80, 60),
	BrickDark = rgb(110, 60, 48),
	Plaster = rgb(214, 204, 186),
	Wood = rgb(124, 86, 54),
	WoodDark = rgb(84, 58, 38),
	WoodLight = rgb(170, 128, 84),
	Metal = rgb(92, 98, 108),
	MetalDark = rgb(52, 56, 64),
	Leaf = rgb(62, 124, 58),
	LeafDark = rgb(40, 92, 48),
	Pine = rgb(34, 86, 56),
	Trunk = rgb(96, 68, 44),
	Rock = rgb(118, 116, 112),
	Glass = rgb(150, 200, 230),
	Yellow = rgb(245, 200, 40),
	White = rgb(236, 236, 236),
	Red = rgb(200, 50, 50),
	Neon = rgb(0, 204, 255),
	NeonWarm = rgb(255, 198, 26),
}
local P = MapKit.Palette

function MapKit.new(seed: number?)
	local self = setmetatable({}, MapKit)
	local model = Instance.new("Model")
	model.Name = "Map"
	self.Model = model
	local function folder(name)
		local f = Instance.new("Folder")
		f.Name = name
		f.Parent = model
		return f
	end
	self.Geo = folder("Geometry")
	self.Props = folder("Props")
	self.Spawns = folder("Spawns")
	self.VehicleSpots = folder("VehicleSpots")
	self.Terrain = workspace.Terrain
	self.Rng = Random.new(seed or 1)
	return self
end

-- PRIMITIVES ---------------------------------------------------------------------
function MapKit:Part(size: Vector3, cf: CFrame, color: Color3, material, parent, class)
	local p = Instance.new(class or "Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent or self.Geo
	return p
end

-- Decorative part: no collisions, bullets pass through.
function MapKit:Deco(size, cf, color, material, parent)
	local p = self:Part(size, cf, color, material, parent or self.Props)
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end

function MapKit:Neon(size, cf, color, parent)
	local p = self:Deco(size, cf, color, M.Neon, parent)
	p.CastShadow = false
	return p
end

function MapKit:Wedge(size, cf, color, material, parent)
	return self:Part(size, cf, color, material, parent, "WedgePart")
end

-- Cylinder whose axis runs along the CFrame's X axis.
function MapKit:Cylinder(length: number, diameter: number, cf: CFrame, color, material, parent)
	local p = self:Part(Vector3.new(length, diameter, diameter), cf, color, material, parent)
	p.Shape = Enum.PartType.Cylinder
	return p
end

-- Vertical cylinder standing on `base` (bottom center).
function MapKit:Pillar(base: Vector3, height: number, diameter: number, color, material, parent)
	return self:Cylinder(height, diameter, CFrame.new(base + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), color, material, parent)
end

function MapKit:Ball(diameter: number, pos: Vector3, color, material, parent)
	local p = self:Part(Vector3.new(diameter, diameter, diameter), CFrame.new(pos), color, material, parent)
	p.Shape = Enum.PartType.Ball
	return p
end

-- See-through glass that stops players but lets bullets through.
function MapKit:Glass(size, cf, parent)
	local p = self:Part(size, cf, P.Glass, M.Glass, parent)
	p.Transparency = 0.6
	p.Reflectance = 0.15
	p.CanQuery = false
	p.CastShadow = false
	return p
end

-- Tilted slab from a low point to a high point; the top surface touches both points.
function MapKit:Ramp(low: Vector3, high: Vector3, width: number, color, material, parent)
	local length = (high - low).Magnitude
	local cf = CFrame.lookAt((low + high) / 2, high) * CFrame.new(0, -0.5, 0)
	return self:Part(Vector3.new(width, 1, length), cf, color or P.Concrete, material or M.Concrete, parent)
end

function MapKit:Light(part: BasePart, kind: string?, color: Color3?, range: number?, brightness: number?, face)
	local l = Instance.new(kind or "PointLight")
	l.Color = color or Color3.new(1, 0.95, 0.85)
	l.Range = range or 16
	l.Brightness = brightness or 1.5
	if face and l:IsA("SpotLight") then
		l.Face = face
		l.Angle = 100
	end
	l.Shadows = false
	l.Parent = part
	return l
end

-- GAMEPLAY MARKERS ---------------------------------------------------------------
function MapKit:Spawn(pos: Vector3, lookAt: Vector3?, team: string?)
	local s = Instance.new("Part")
	s.Name = "Spawn"
	s.Anchored = true
	s.CanCollide = false
	s.CanQuery = false
	s.CanTouch = false
	s.Transparency = 1
	s.Size = Vector3.new(2, 1, 2)
	local target = lookAt or Vector3.new(0, pos.Y, 0)
	if (Vector3.new(target.X, pos.Y, target.Z) - pos).Magnitude < 0.1 then
		target = pos + Vector3.new(0, 0, -1)
	end
	s.CFrame = CFrame.lookAt(pos, Vector3.new(target.X, pos.Y, target.Z))
	if team then
		s:SetAttribute("Team", team)
	end
	s.Parent = self.Spawns
	return s
end

function MapKit:VehicleSpot(cf: CFrame, style: string?, color: Color3?)
	local s = Instance.new("Part")
	s.Name = "VehicleSpot"
	s.Anchored = true
	s.CanCollide = false
	s.CanQuery = false
	s.CanTouch = false
	s.Transparency = 1
	s.Size = Vector3.new(1, 1, 1)
	s.CFrame = cf
	s:SetAttribute("Style", style or "Sedan")
	if color then
		s:SetAttribute("Color", color)
	end
	s.Parent = self.VehicleSpots
	return s
end

function MapKit:HealthPack(pos: Vector3)
	local hp = self:Part(Vector3.new(2.5, 2.5, 2.5), CFrame.new(pos + Vector3.new(0, 1.5, 0)), rgb(70, 230, 120), M.Neon, self.Props)
	hp.Name = "HealthPack"
	hp.CanCollide = false
	hp:SetAttribute("HealthPack", true)
	self:Light(hp, "PointLight", rgb(70, 230, 120), 12, 1.5)
	self:Part(Vector3.new(4, 0.4, 4), CFrame.new(pos + Vector3.new(0, 0.2, 0)), P.MetalDark, M.DiamondPlate, self.Geo)
	return hp
end

function MapKit:JumpPad(pos: Vector3, power: number?)
	local pad = self:Cylinder(0.6, 8, CFrame.new(pos + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)), rgb(170, 90, 255), M.Neon, self.Geo)
	pad.Name = "JumpPad"
	pad:SetAttribute("JumpPad", power or 115)
	self:Light(pad, "PointLight", rgb(170, 90, 255), 16, 3)
	return pad
end

-- Invisible walls around the playable area.
function MapKit:Boundary(halfX: number, halfZ: number, height: number?)
	local h = height or 120
	-- walls overlap at the corners so there's no seam to squeeze through
	for _, s in { { halfX, 0, 2, halfZ * 2 + 6 }, { -halfX, 0, 2, halfZ * 2 + 6 }, { 0, halfZ, halfX * 2 + 6, 2 }, { 0, -halfZ, halfX * 2 + 6, 2 } } do
		local w = self:Part(Vector3.new(s[3], h, s[4]), CFrame.new(s[1], h / 2 - 10, s[2]), Color3.new(), M.SmoothPlastic, self.Geo)
		w.Name = "Boundary"
		w.Transparency = 1
		w.CanQuery = false
		w.CastShadow = false
	end
end

-- TERRAIN -------------------------------------------------------------------------
function MapKit:Fill(material, cf: CFrame, size: Vector3)
	self.Terrain:FillBlock(cf, size, material)
end

function MapKit:FillBall(material, center: Vector3, radius: number)
	self.Terrain:FillBall(center, radius, material)
end

function MapKit:Water(cf: CFrame, size: Vector3)
	self.Terrain:FillBlock(cf, size, M.Water)
end

-- WALLS & BUILDINGS -----------------------------------------------------------------
-- Builds a wall running along local +X or +Z from `start`, with openings
-- { At = distance along wall (center), Width, Bottom, Top, Glass = bool }.
function MapKit:Wall(origin: CFrame, start: Vector3, axis: string, length: number, height: number, thick: number, openings, color, material, parent, trim)
	local function place(a0, a1, y0, y1, glass)
		local len, h = a1 - a0, y1 - y0
		if len < 0.1 or h < 0.1 then
			return
		end
		local mid = (a0 + a1) / 2
		local t = glass and 0.3 or thick
		local pos, size
		if axis == "X" then
			pos = start + Vector3.new(mid, (y0 + y1) / 2, 0)
			size = Vector3.new(len, h, t)
		else
			pos = start + Vector3.new(0, (y0 + y1) / 2, mid)
			size = Vector3.new(t, h, len)
		end
		if glass then
			self:Glass(size, origin * CFrame.new(pos), parent)
			-- some windows glow warm from inside (lit rooms at dusk / night)
			if trim and y0 > 1 and self.Rng:NextNumber() < (self.LitWindows or 0.3) then
				local inward = -trim.Outward * (thick / 2 + 0.05)
				local glowPos = axis == "X" and pos + Vector3.new(0, 0, inward) or pos + Vector3.new(inward, 0, 0)
				local glowSize = axis == "X" and Vector3.new(len - 0.4, h - 0.4, 0.1) or Vector3.new(0.1, h - 0.4, len - 0.4)
				local warm = ({ rgb(255, 214, 150), rgb(255, 236, 200), rgb(255, 196, 120), rgb(220, 235, 255) })[self.Rng:NextInteger(1, 4)]
				local glow = self:Neon(glowSize, origin * CFrame.new(glowPos), warm, parent)
				glow.Transparency = 0.45
				glow.Name = "LitWindow"
			end
			-- window mullions: a cross of thin frame bars over the pane
			if trim and len > 2.5 and h > 2.5 then
				local mc = trim.Color:Lerp(Color3.new(), 0.35)
				local d = 0.42
				if axis == "X" then
					self:Deco(Vector3.new(0.14, h, d), origin * CFrame.new(pos), mc, M.Metal, parent).CastShadow = false
					self:Deco(Vector3.new(len, 0.14, d), origin * CFrame.new(pos + Vector3.new(0, h * 0.12, 0)), mc, M.Metal, parent).CastShadow = false
				else
					self:Deco(Vector3.new(d, h, 0.14), origin * CFrame.new(pos), mc, M.Metal, parent).CastShadow = false
					self:Deco(Vector3.new(d, 0.14, len), origin * CFrame.new(pos + Vector3.new(0, h * 0.12, 0)), mc, M.Metal, parent).CastShadow = false
				end
			end
		else
			self:Part(size, origin * CFrame.new(pos), color, material, parent)
		end
	end
	-- window sill + head trim sticking out of the wall face
	local function frame(a0, a1, y, depth, h)
		if not trim then
			return
		end
		local mid = (a0 + a1) / 2
		local out = trim.Outward * (thick / 2 + depth / 2)
		local pos, size
		if axis == "X" then
			pos = start + Vector3.new(mid, y, out)
			size = Vector3.new(a1 - a0 + 0.6, h, depth)
		else
			pos = start + Vector3.new(out, y, mid)
			size = Vector3.new(depth, h, a1 - a0 + 0.6)
		end
		local p = self:Part(size, origin * CFrame.new(pos), trim.Color, M.Concrete, parent)
		p.CanQuery = false
	end
	table.sort(openings, function(a, b)
		return a.At < b.At
	end)
	local cursor = 0
	for _, o in openings do
		local l, r = o.At - o.Width / 2, o.At + o.Width / 2
		place(cursor, l, 0, height)
		place(l, r, 0, o.Bottom)
		place(l, r, o.Top, height)
		if o.Glass then
			place(l, r, o.Bottom, o.Top, true)
		end
		if o.Frame then
			frame(l, r, o.Bottom - 0.15, 0.7, 0.3) -- sill
			frame(l, r, o.Top + 0.2, 0.35, 0.4) -- head
			if trim and o.Bottom > 2 and self.Rng:NextNumber() < (self.FlowerBoxes or 0.14) then
				local mid = (l + r) / 2
				local out = trim.Outward * (thick / 2 + 0.55)
				local y = o.Bottom - 0.75
				local bpos = axis == "X" and start + Vector3.new(mid, y, out) or start + Vector3.new(out, y, mid)
				local bsize = axis == "X" and Vector3.new(o.Width - 0.4, 0.8, 0.9) or Vector3.new(0.9, 0.8, o.Width - 0.4)
				self:Deco(bsize, origin * CFrame.new(bpos), rgb(110, 70, 50), M.Wood, parent)
				for k = -1, 1 do
					local fp = axis == "X" and bpos + Vector3.new(k * (o.Width / 3.4), 0.6, 0) or bpos + Vector3.new(0, 0.6, k * (o.Width / 3.4))
					local leaf = self:Ball(0.9, (origin * CFrame.new(fp)).Position, P.Leaf, M.LeafyGrass, parent)
					leaf.CanCollide, leaf.CanQuery, leaf.CastShadow = false, false, false
					local flower = self:Ball(0.45, (origin * CFrame.new(fp + Vector3.new(0, 0.4, 0))).Position, ({ rgb(240, 70, 90), rgb(255, 200, 60), rgb(250, 250, 250), rgb(190, 90, 230) })[self.Rng:NextInteger(1, 4)], M.SmoothPlastic, parent)
					flower.CanCollide, flower.CanQuery, flower.CastShadow = false, false, false
				end
			end
		end
		cursor = r
	end
	place(cursor, length, 0, height)
end

-- Horizontal slab (top surface at local y) with an optional rectangular hole.
function MapKit:Slab(origin: CFrame, y: number, w: number, d: number, thick: number, hole, color, material, parent)
	local function rect(x0, x1, z0, z1)
		if x1 - x0 > 0.1 and z1 - z0 > 0.1 then
			self:Part(Vector3.new(x1 - x0, thick, z1 - z0), origin * CFrame.new((x0 + x1) / 2, y - thick / 2, (z0 + z1) / 2), color, material, parent)
		end
	end
	local hw, hd = w / 2, d / 2
	if not hole then
		rect(-hw, hw, -hd, hd)
		return
	end
	rect(-hw, hw, -hd, hole.Z0)
	rect(-hw, hw, hole.Z1, hd)
	rect(-hw, hole.X0, hole.Z0, hole.Z1)
	rect(hole.X1, hw, hole.Z0, hole.Z1)
end

-- Windows along a wall. `openChance` = share of windows left open (no glass)
-- so players can climb in and out.
local function windowOpenings(length: number, floorH: number, spacing: number, door, rng, openChance: number, sill: number?)
	local list = {}
	local count = math.max(0, math.floor((length - 4) / spacing))
	local startAt = (length - (count - 1) * spacing) / 2
	local bottom = sill or 3
	for i = 0, count - 1 do
		local at = startAt + i * spacing
		if not door or math.abs(at - door) > 6 then
			local open = rng:NextNumber() < (openChance or 0)
			table.insert(list, { At = at, Width = 4, Bottom = bottom, Top = floorH - 2.5, Glass = not open, Frame = true })
		end
	end
	if door then
		table.insert(list, { At = door, Width = 6, Bottom = 0, Top = 8.5, Glass = false })
	end
	return list
end

local SIDES = {
	Front = { N = Vector3.new(0, 0, -1), T = Vector3.new(1, 0, 0), Rot = CFrame.identity },
	Back = { N = Vector3.new(0, 0, 1), T = Vector3.new(1, 0, 0), Rot = CFrame.identity },
	Left = { N = Vector3.new(-1, 0, 0), T = Vector3.new(0, 0, 1), Rot = CFrame.Angles(0, math.rad(90), 0) },
	Right = { N = Vector3.new(1, 0, 0), T = Vector3.new(0, 0, 1), Rot = CFrame.Angles(0, math.rad(90), 0) },
}

--[[ Enterable multi-storey building.
spec = {
	Origin = CFrame (ground center), W, D, Floors, FloorH (12),
	Color, Trim, Material, Floor, Name, Awning,
	Doors = { Front = true, Back = true, Left = false, Right = false },
	Roof = "Flat" | "Gable", RoofAccess = true, Props = true,
	OpenWindows = 0..1   share of windows left open (climb in/out)
	OpenSides = { Right = true }   every window on these sides is open
	Storefront = Color3  big shop windows + sign band on the ground floor front
	FireEscape = "Right" | "Left" | "Back"   balconies + ladder to the roof
	Ladder = "Right" | ...   plain roof ladder
	Balconies = true   small balconies on the front
	AC = true   wall air-conditioner units
}
Front is the local -Z face. ]]
function MapKit:Building(spec)
	local o = spec.Origin
	local W, D = spec.W, spec.D
	local floors = spec.Floors or 2
	local H = spec.FloorH or 12
	local t = 1
	local color = spec.Color or P.Brick
	local mat = spec.Material or M.Brick
	local trim = spec.Trim or P.Concrete
	local floorColor = spec.Floor or rgb(120, 112, 100)
	local doors = spec.Doors or { Front = true }
	local rng = self.Rng
	local model = Instance.new("Model")
	model.Name = spec.Name or "Building"
	model.Parent = self.Geo
	local openSides = spec.OpenSides or {}
	if spec.FireEscape then
		openSides[spec.FireEscape] = true
	end

	-- stairwell strip along the left wall
	local sx0, sx1 = -W / 2 + t, -W / 2 + t + 5
	local run = math.min(H * 1.7, D - 10)
	local sz0 = -D / 2 + 4
	local sz1 = sz0 + run
	local hole = { X0 = sx0, X1 = sx1, Z0 = sz0 - 0.5, Z1 = sz1 }

	local function sidePos(side, along, out, y)
		local s = SIDES[side]
		local half = (side == "Front" or side == "Back") and D / 2 or W / 2
		return o * CFrame.new(s.N * (half + out) + s.T * along + Vector3.new(0, y, 0)) * s.Rot
	end

	for f = 0, floors - 1 do
		local y = f * H
		if f == 0 then
			self:Part(Vector3.new(W, 0.4, D), o * CFrame.new(0, 0.2, 0), floorColor, M.Concrete, model)
		else
			self:Slab(o, y, W, D, 1, hole, floorColor, M.Concrete, model)
		end
		local base = y + (f == 0 and 0.4 or 0)
		local wallH = H - (f == 0 and 0.4 or 0)
		local function openings(side, len)
			local door = (f == 0 and doors[side]) and len / 2 or nil
			if f == 0 and side == "Front" and spec.Storefront then
				-- shop windows either side of the door
				local paneW = len / 2 - 5
				return {
					{ At = paneW / 2 + 1, Width = paneW, Bottom = 1.2, Top = 8.5, Glass = true },
					{ At = len - paneW / 2 - 1, Width = paneW, Bottom = 1.2, Top = 8.5, Glass = true },
					{ At = len / 2, Width = 6, Bottom = 0, Top = 8.5, Glass = false },
				}
			end
			local chance = openSides[side] and 1 or (spec.OpenWindows or 0)
			return windowOpenings(len, wallH, 8, door, rng, chance, f == 0 and 2.6 or 3)
		end
		self:Wall(o, Vector3.new(-W / 2, base, -D / 2 + t / 2), "X", W, wallH, t, openings("Front", W), color, mat, model, { Outward = -1, Color = trim })
		self:Wall(o, Vector3.new(-W / 2, base, D / 2 - t / 2), "X", W, wallH, t, openings("Back", W), color, mat, model, { Outward = 1, Color = trim })
		self:Wall(o, Vector3.new(-W / 2 + t / 2, base, -D / 2 + t), "Z", D - 2 * t, wallH, t, openings("Left", D - 2 * t), color, mat, model, { Outward = -1, Color = trim })
		self:Wall(o, Vector3.new(W / 2 - t / 2, base, -D / 2 + t), "Z", D - 2 * t, wallH, t, openings("Right", D - 2 * t), color, mat, model, { Outward = 1, Color = trim })
		if f > 0 then
			for _, s in { { 0, -D / 2 - 0.2, W + 0.8, 0.8 }, { 0, D / 2 + 0.2, W + 0.8, 0.8 }, { -W / 2 - 0.2, 0, 0.8, D }, { W / 2 + 0.2, 0, 0.8, D } } do
				self:Part(Vector3.new(s[3], 0.7, s[4]), o * CFrame.new(s[1], y, s[2]), trim, M.Concrete, model)
			end
		end
		if f < floors - 1 or spec.RoofAccess ~= false then
			local cx = (sx0 + sx1) / 2
			local low = (o * CFrame.new(cx, y + (f == 0 and 0.4 or 0), sz0)).Position
			local high = (o * CFrame.new(cx, y + H, sz1)).Position
			self:Ramp(low, high, 5, rgb(90, 90, 96), M.DiamondPlate, model)
			self:Part(Vector3.new(0.3, 3, run), o * CFrame.new(sx1 + 0.2, y + H + 1.5, (sz0 + sz1) / 2), P.MetalDark, M.Metal, model)
		end
		-- ceiling light fixture so interiors aren't pitch black
		if spec.InteriorLights ~= false then
			local fx = o * CFrame.new(W * 0.12, y + H - 0.35, 0)
			local fixture = self:Neon(Vector3.new(4, 0.2, 1.2), fx, rgb(255, 240, 215), model)
			self:Deco(Vector3.new(4.4, 0.25, 1.6), fx * CFrame.new(0, 0.2, 0), P.MetalDark, M.Metal, model)
			self:Light(fixture, "PointLight", rgb(255, 228, 190), math.max(W, D) * 0.75, 0.9)
		end
		if spec.Props ~= false then
			for _ = 1, math.floor(W * D / 300) do
				local px = rng:NextNumber(-W / 2 + 9, W / 2 - 4)
				local pz = rng:NextNumber(-D / 2 + 4, D / 2 - 4)
				local roll = rng:NextNumber()
				if roll < 0.35 then
					self:Part(Vector3.new(6, 0.4, 3), o * CFrame.new(px, base + 3, pz), P.WoodLight, M.Wood, model)
					self:Part(Vector3.new(5.6, 2.8, 0.3), o * CFrame.new(px, base + 1.4, pz + 1.3), P.WoodDark, M.Wood, model)
				elseif roll < 0.6 then
					-- couch
					self:Part(Vector3.new(6, 1.6, 2.6), o * CFrame.new(px, base + 0.8, pz), rgb(90, 70, 60), M.Fabric, model)
					self:Part(Vector3.new(6, 2.4, 0.8), o * CFrame.new(px, base + 1.6, pz + 1.3), rgb(90, 70, 60), M.Fabric, model)
				elseif roll < 0.8 then
					-- shelf
					self:Part(Vector3.new(5, 6, 1.4), o * CFrame.new(px, base + 3, pz), P.WoodDark, M.Wood, model)
				else
					self:Part(Vector3.new(3.5, 3.5, 3.5), o * CFrame.new(px, base + 1.75, pz) * CFrame.Angles(0, rng:NextNumber(0, 1.5), 0), rgb(170, 128, 70), M.WoodPlanks, model)
				end
			end
		end
	end

	local top = floors * H
	-- plinth + corner pilasters
	for _, s in { { 0, -D / 2 - 0.15, W + 0.5, 0.5 }, { 0, D / 2 + 0.15, W + 0.5, 0.5 }, { -W / 2 - 0.15, 0, 0.5, D + 0.5 }, { W / 2 + 0.15, 0, 0.5, D + 0.5 } } do
		self:Part(Vector3.new(s[3], 1.4, s[4]), o * CFrame.new(s[1], 0.7, s[2]), trim:Lerp(Color3.new(), 0.25), M.Concrete, model)
	end
	if spec.Pilasters ~= false then
		for _, cx in { -W / 2, W / 2 } do
			for _, cz in { -D / 2, D / 2 } do
				self:Part(Vector3.new(1.4, top, 1.4), o * CFrame.new(cx, top / 2, cz), trim, M.Concrete, model)
			end
		end
	end

	if spec.Roof == "Gable" then
		local rh = math.min(W, D) * 0.35
		self:Part(Vector3.new(W + 1, 0.6, D + 1), o * CFrame.new(0, top + 0.3, 0), trim, M.Wood, model)
		self:Wedge(Vector3.new(W + 2, rh, D / 2 + 1), o * CFrame.new(0, top + 0.6 + rh / 2, -D / 4 - 0.25), spec.RoofColor or P.WoodDark, M.WoodPlanks, model)
		self:Wedge(Vector3.new(W + 2, rh, D / 2 + 1), o * CFrame.new(0, top + 0.6 + rh / 2, D / 4 + 0.25) * CFrame.Angles(0, math.rad(180), 0), spec.RoofColor or P.WoodDark, M.WoodPlanks, model)
		self:Part(Vector3.new(2, rh * 0.8, 2), o * CFrame.new(W / 4, top + rh * 0.6, D / 4), P.Brick, M.Brick, model) -- chimney
	else
		local roofHole = spec.RoofAccess ~= false and hole or nil
		self:Slab(o, top, W, D, 1, roofHole, P.ConcreteDark, M.Concrete, model)
		-- parapet + cornice
		for _, s in { { 0, -D / 2 + 0.4, W, 0.8 }, { 0, D / 2 - 0.4, W, 0.8 }, { -W / 2 + 0.4, 0, 0.8, D }, { W / 2 - 0.4, 0, 0.8, D } } do
			self:Part(Vector3.new(s[3], 3, s[4]), o * CFrame.new(s[1], top + 1.5, s[2]), trim, M.Concrete, model)
		end
		for _, s in { { 0, -D / 2 - 0.3, W + 2, 1.4 }, { 0, D / 2 + 0.3, W + 2, 1.4 }, { -W / 2 - 0.3, 0, 1.4, D + 2 }, { W / 2 + 0.3, 0, 1.4, D + 2 } } do
			self:Part(Vector3.new(s[3], 1.1, s[4]), o * CFrame.new(s[1], top - 0.2, s[2]), trim, M.Concrete, model)
		end
		-- stair bulkhead (door faces +Z where the ramp arrives)
		if roofHole then
			local bh = 8
			local bx0, bx1 = -W / 2 + 0.8, sx1 + 1
			local bz0, bz1 = hole.Z0 - 1, hole.Z1
			self:Part(Vector3.new(bx1 - bx0, bh, 0.8), o * CFrame.new((bx0 + bx1) / 2, top + bh / 2, bz0), trim, M.Concrete, model)
			self:Part(Vector3.new(0.8, bh, bz1 - bz0), o * CFrame.new(bx1, top + bh / 2, (bz0 + bz1) / 2), trim, M.Concrete, model)
			self:Part(Vector3.new(0.8, bh - 3, bz1 - bz0), o * CFrame.new(bx0, top + 3 + (bh - 3) / 2, (bz0 + bz1) / 2), trim, M.Concrete, model)
			self:Part(Vector3.new(bx1 - bx0 + 1, 0.6, bz1 - bz0 + 1), o * CFrame.new((bx0 + bx1) / 2, top + bh + 0.3, (bz0 + bz1) / 2), P.MetalDark, M.Metal, model)
			local lamp = self:Neon(Vector3.new(0.6, 0.3, 0.6), o * CFrame.new((bx0 + bx1) / 2, top + bh - 0.6, bz1 + 0.2), rgb(255, 230, 180), model)
			self:Light(lamp, "PointLight", rgb(255, 220, 170), 14, 1.2)
		end
		-- rooftop clutter (cover for roof fights)
		for _ = 1, 3 do
			local px, pz = rng:NextNumber(-W / 2 + 10, W / 2 - 5), rng:NextNumber(-D / 2 + 5, D / 2 - 5)
			self:Part(Vector3.new(5, 3.5, 4), o * CFrame.new(px, top + 1.75, pz), rgb(180, 182, 186), M.Metal, model)
			self:Deco(Vector3.new(3.2, 0.3, 3), o * CFrame.new(px, top + 3.6, pz), P.MetalDark, M.Metal, model)
			for i = -1, 1 do
				self:Deco(Vector3.new(0.1, 2.6, 3.2), o * CFrame.new(px + i * 1.5 + 0.8, top + 1.9, pz), P.MetalDark, M.Metal, model)
			end
		end
		self:Pillar((o * CFrame.new(W / 2 - 3, top, -D / 2 + 3)).Position, 9, 0.3, P.MetalDark, M.Metal, model) -- antenna
		if W > 24 then
			local tank = self:Cylinder(7, 6, o * CFrame.new(W / 2 - 6, top + 6.5, D / 2 - 6) * CFrame.Angles(0, 0, math.rad(90)), P.Wood, M.WoodPlanks, model)
			tank.Name = "WaterTank"
			self:Wedge(Vector3.new(6, 1.5, 3), o * CFrame.new(W / 2 - 6, top + 10.75, D / 2 - 7.5), P.WoodDark, M.WoodPlanks, model)
			self:Wedge(Vector3.new(6, 1.5, 3), o * CFrame.new(W / 2 - 6, top + 10.75, D / 2 - 4.5) * CFrame.Angles(0, math.rad(180), 0), P.WoodDark, M.WoodPlanks, model)
			for _, dx in { -2, 2 } do
				for _, dz in { -2, 2 } do
					self:Part(Vector3.new(0.5, 3, 0.5), o * CFrame.new(W / 2 - 6 + dx, top + 1.5, D / 2 - 6 + dz), P.MetalDark, M.Metal, model)
				end
			end
		end
	end

	-- storefront sign band
	if spec.Storefront then
		local sign = self:Part(Vector3.new(W * 0.85, 1.8, 0.5), o * CFrame.new(0, 10.3, -D / 2 - 0.4), spec.Storefront, M.SmoothPlastic, model)
		sign.Name = "ShopSign"
		self:Light(sign, "SurfaceLight", spec.Storefront:Lerp(Color3.new(1, 1, 1), 0.5), 14, 1.2, Enum.NormalId.Front)
		local shopGlow = self:Neon(Vector3.new(W * 0.7, 0.2, 2), o * CFrame.new(0, 8.6, -D / 2 + 3), rgb(255, 245, 225), model)
		self:Light(shopGlow, "PointLight", rgb(255, 235, 200), 22, 1.4)
		self:Neon(Vector3.new(W * 0.85, 0.2, 0.55), o * CFrame.new(0, 9.35, -D / 2 - 0.4), rgb(255, 240, 210), model)
		for i = -2, 2 do
			self:Neon(Vector3.new(1.2, 0.9, 0.1), o * CFrame.new(i * 2.2, 10.3, -D / 2 - 0.7), rgb(255, 255, 255), model)
		end
	end
	if doors.Front then
		self:Part(Vector3.new(10, 0.4, 4), o * CFrame.new(0, 9.5, -D / 2 - 2), spec.Awning or P.Red, M.Fabric, model)
		for _, x in { -4.8, 4.8 } do
			self:Part(Vector3.new(0.2, 1.2, 4), o * CFrame.new(x, 8.9, -D / 2 - 2), spec.Awning or P.Red, M.Fabric, model)
		end
	end

	-- fire escape: balcony on every floor + ladder all the way to the roof
	if spec.FireEscape then
		local side = spec.FireEscape
		local along = (side == "Front" or side == "Back") and W * 0.15 or D * 0.15
		for f = 1, floors - 1 do
			local y = f * H
			self:Part(Vector3.new(11, 0.3, 3.6), sidePos(side, along, 1.8, y + 0.15), P.MetalDark, M.DiamondPlate, model)
			self:Part(Vector3.new(11, 3, 0.2), sidePos(side, along, 3.5, y + 1.65), P.MetalDark, M.Metal, model).Transparency = 0.3
			self:Part(Vector3.new(0.2, 3, 3.6), sidePos(side, along - 5.4, 1.8, y + 1.65), P.MetalDark, M.Metal, model)
		end
		local lad = self:Ladder(sidePos(side, along + 6.5, 1.0, 0).Position, top + 3.5, nil)
		lad.Parent = model
	elseif spec.Ladder then
		local lad = self:Ladder(sidePos(spec.Ladder, 0, 1.0, 0).Position, top + 3.5, nil)
		lad.Parent = model
	end
	-- balconies on the front
	if spec.Balconies then
		for f = 1, floors - 1 do
			for i = -1, 1, 2 do
				local x = i * W * 0.25
				self:Part(Vector3.new(6, 0.4, 3), o * CFrame.new(x, f * H + 0.2, -D / 2 - 1.5), trim, M.Concrete, model)
				self:Part(Vector3.new(6, 2.6, 0.25), o * CFrame.new(x, f * H + 1.7, -D / 2 - 2.9), P.MetalDark, M.Metal, model)
			end
		end
	end
	-- drainpipes down two corners (with brackets)
	for _, c in { { W / 2 + 0.55, D / 2 - 1.2 }, { -W / 2 - 0.55, D / 2 - 1.2 } } do
		local pipe = self:Cylinder(top + 0.5, 0.45, o * CFrame.new(c[1], top / 2, c[2]) * CFrame.Angles(0, 0, math.rad(90)), P.MetalDark, M.Metal, model)
		pipe.CanCollide, pipe.CanQuery = false, false
		for y = H * 0.5, top, H do
			self:Deco(Vector3.new(0.7, 0.18, 0.6), o * CFrame.new(c[1] - math.sign(c[1]) * 0.25, y, c[2]), P.MetalDark, M.Metal, model)
		end
		self:Deco(Vector3.new(0.6, 0.3, 1.0), o * CFrame.new(c[1], 0.4, c[2] - 0.4), P.MetalDark, M.Metal, model)
	end
	-- door frames around every ground-floor doorway
	for side, on in doors do
		if on and SIDES[side] and not (side == "Front" and spec.Storefront) then
			for _, a in { -3.25, 3.25 } do
				self:Deco(Vector3.new(0.5, 8.9, 0.5), sidePos(side, a, 0.3, 4.65), trim:Lerp(Color3.new(), 0.2), M.Concrete, model)
			end
			self:Deco(Vector3.new(7, 0.6, 0.6), sidePos(side, 0, 0.3, 9.1), trim:Lerp(Color3.new(), 0.2), M.Concrete, model)
			local lamp = self:Neon(Vector3.new(0.5, 0.35, 0.3), sidePos(side, 0, 0.75, 9.8), rgb(255, 225, 170), model)
			self:Light(lamp, "PointLight", rgb(255, 210, 150), 12, 0.9)
		end
	end
	-- rooftop gear + the odd lit billboard (flat roofs only)
	if spec.Roof ~= "Gable" then
		local dishPos = (o * CFrame.new(-W / 4, top, D / 4)).Position
		self:Pillar(dishPos, 2.2, 0.3, P.MetalDark, M.Metal, model)
		local dish = self:Cylinder(0.3, 2.6, CFrame.new(dishPos + Vector3.new(0, 2.6, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6), math.rad(60)), rgb(220, 222, 226), M.SmoothPlastic, model)
		dish.CanQuery = false
		for i = 1, 2 do
			local v = (o * CFrame.new(W / 4 - i * 3, top, -D / 4)).Position
			self:Pillar(v, 1.6, 1.1, rgb(170, 172, 176), M.Metal, model)
			self:Cylinder(0.3, 1.5, CFrame.new(v + Vector3.new(0, 1.75, 0)) * CFrame.Angles(0, 0, math.rad(90)), P.MetalDark, M.Metal, model)
		end
		if W >= 20 and rng:NextNumber() < (self.Billboards or 0.25) then
			local bc = o * CFrame.new(0, top + 9, D / 2 - 2)
			for _, x in { -5, 5 } do
				self:Part(Vector3.new(0.5, 9, 0.5), o * CFrame.new(x, top + 4.5, D / 2 - 2), P.MetalDark, M.Metal, model)
			end
			self:Part(Vector3.new(14, 6, 0.5), bc, P.MetalDark, M.Metal, model)
			local adColor = ({ rgb(255, 80, 60), rgb(0, 190, 255), rgb(255, 200, 30), rgb(120, 230, 90), rgb(230, 90, 220) })[rng:NextInteger(1, 5)]
			local panel = self:Deco(Vector3.new(13, 5, 0.1), bc * CFrame.new(0, 0, -0.3), adColor, M.SmoothPlastic, model)
			self:Light(panel, "SurfaceLight", adColor:Lerp(Color3.new(1, 1, 1), 0.4), 18, 1.4, Enum.NormalId.Front)
			self:Neon(Vector3.new(9, 0.8, 0.12), bc * CFrame.new(-1, 0.9, -0.36), Color3.new(1, 1, 1))
			self:Neon(Vector3.new(6, 0.5, 0.12), bc * CFrame.new(-2.4, -0.6, -0.36), adColor:Lerp(Color3.new(1, 1, 1), 0.6))
			self:Neon(Vector3.new(14.2, 0.2, 0.2), bc * CFrame.new(0, -3.1, -0.4), rgb(255, 245, 220))
		end
	end
	-- wall AC units
	if spec.AC ~= false then
		for _ = 1, floors do
			local side = ({ "Back", "Left", "Right" })[rng:NextInteger(1, 3)]
			local len = (side == "Back") and W or D
			local y = rng:NextInteger(1, floors) * H - H * 0.35
			self:Part(Vector3.new(2.6, 1.8, 1.4), sidePos(side, rng:NextNumber(-len / 2 + 4, len / 2 - 4), 0.7, y), rgb(200, 202, 205), M.Metal, model)
		end
	end
	return model
end

-- Skyscraper used for skylines / map edges: podium, banded glass shaft, crown.
function MapKit:Tower(origin: CFrame, W: number, D: number, height: number, color, material, glassColor)
	local model = Instance.new("Model")
	model.Name = "Tower"
	model.Parent = self.Geo
	local c = color or P.ConcreteDark
	-- podium with a glass shop band
	self:Part(Vector3.new(W + 2, 10, D + 2), origin * CFrame.new(0, 5, 0), c:Lerp(Color3.new(), 0.15), material or M.Concrete, model)
	local shop = self:Deco(Vector3.new(W + 2.2, 5, D + 2.2), origin * CFrame.new(0, 4, 0), rgb(40, 60, 80), M.Glass, model)
	shop.Reflectance = 0.3
	self:Part(Vector3.new(W, height - 10, D), origin * CFrame.new(0, 10 + (height - 10) / 2, 0), c, material or M.Concrete, model)
	local band = glassColor or rgb(70, 110, 140)
	for y = 14, height - 4, 9 do
		local g = self:Deco(Vector3.new(W + 0.3, 5, D + 0.3), origin * CFrame.new(0, y, 0), band, M.Glass, model)
		g.Reflectance = 0.25
		-- random lit offices on each face
		for _, face in { { 0, 1, W }, { 0, -1, W }, { 1, 0, D }, { -1, 0, D } } do
			local cols = math.max(1, math.floor(face[3] / 5))
			for k = 0, cols - 1 do
				if self.Rng:NextNumber() < (self.LitWindows or 0.3) * 0.9 then
					local along = -face[3] / 2 + (k + 0.5) * face[3] / cols
					local out = (face[1] ~= 0 and W or D) / 2 + 0.2
					local cf = face[1] ~= 0 and CFrame.new(face[1] * out, y, along) or CFrame.new(along, y, face[2] * out)
					local size = face[1] ~= 0 and Vector3.new(0.1, 4.2, face[3] / cols - 0.8) or Vector3.new(face[3] / cols - 0.8, 4.2, 0.1)
					local lit = self:Neon(size, origin * cf, rgb(255, 222, 160), model)
					lit.Transparency = 0.35
				end
			end
		end
	end
	-- vertical mullions
	for i = -2, 2 do
		for _, s in { 1, -1 } do
			self:Deco(Vector3.new(0.6, height - 10, 0.5), origin * CFrame.new(i * W / 5, 10 + (height - 10) / 2, s * (D / 2 + 0.2)), c, material or M.Concrete, model)
			self:Deco(Vector3.new(0.5, height - 10, 0.6), origin * CFrame.new(s * (W / 2 + 0.2), 10 + (height - 10) / 2, i * D / 5), c, material or M.Concrete, model)
		end
	end
	-- crown
	self:Part(Vector3.new(W + 1, 1.5, D + 1), origin * CFrame.new(0, height + 0.75, 0), c:Lerp(Color3.new(1, 1, 1), 0.2), M.Concrete, model)
	self:Part(Vector3.new(W - 4, 5, D - 4), origin * CFrame.new(0, height + 4, 0), P.MetalDark, M.Metal, model)
	if height > 60 then
		self:Deco(Vector3.new(0.6, 18, 0.6), origin * CFrame.new(W / 4, height + 15, D / 4), P.Metal, M.Metal, model)
		local blink = self:Neon(Vector3.new(1, 1, 1), origin * CFrame.new(W / 4, height + 24.5, D / 4), P.Red, model)
		self:Light(blink, "PointLight", P.Red, 20, 2)
	end
	return model
end

-- ROADS -----------------------------------------------------------------------------
-- Road along X ("X") or Z ("Z") centered at `center`. Lane markings skip `skip` intersections.
function MapKit:Road(axis: string, center: Vector3, length: number, width: number, skip, noSurface: boolean?)
	local along = axis == "X" and Vector3.xAxis or Vector3.zAxis
	local across = axis == "X" and Vector3.zAxis or Vector3.xAxis
	local size = axis == "X" and Vector3.new(length, 0.3, width) or Vector3.new(width, 0.3, length)
	local markY = noSurface and 0.03 or 0.32
	if not noSurface then
		self:Part(size, CFrame.new(center + Vector3.new(0, 0.15, 0)), P.Asphalt, M.Asphalt, self.Geo)
	end
	local function inIntersection(d)
		for _, s in skip or {} do
			if math.abs(d - s) < width / 2 + 3 then
				return true
			end
		end
		return false
	end
	local start = (axis == "X" and center.X or center.Z) - length / 2
	local base = center - along * (axis == "X" and center.X or center.Z)
	for d = start + 3, start + length - 3, 12 do
		if not inIntersection(d + 3) then
			local pos = base + along * (d + 3) + Vector3.new(0, markY, 0)
			local s = axis == "X" and Vector3.new(6, 0.05, 0.4) or Vector3.new(0.4, 0.05, 6)
			self:Deco(s, CFrame.new(pos), P.Yellow, M.SmoothPlastic, self.Props)
		end
	end
	-- surface wear: puddles, cracks, oil stains and curb drains
	if not self.NoRoadDetail then
		for d = start + 8, start + length - 8, 14 do
			if not inIntersection(d) then
				local lateral = self.Rng:NextNumber(-width / 2 + 2, width / 2 - 2)
				local pos = base + along * (d + self.Rng:NextNumber(-3, 3)) + across * lateral
				local roll = self.Rng:NextNumber()
				if roll < 0.28 then
					local puddle = self:Deco(Vector3.new(0.04, self.Rng:NextNumber(3, 6), self.Rng:NextNumber(2.5, 5)), CFrame.new(pos + Vector3.new(0, markY - 0.01, 0)) * CFrame.Angles(0, self.Rng:NextNumber(0, 3), math.rad(90)), rgb(40, 46, 56), M.Glass, self.Props)
					puddle.Shape = Enum.PartType.Cylinder
					puddle.Reflectance = 0.45
					puddle.Transparency = 0.15
					puddle.CastShadow = false
					puddle.Name = "Puddle"
				elseif roll < 0.62 then
					for k = 0, 2 do
						local c = self:Deco(Vector3.new(self.Rng:NextNumber(1.5, 3.2), 0.03, 0.12), CFrame.new(pos + Vector3.new(k * 1.1, markY - 0.015, k * 0.7)) * CFrame.Angles(0, self.Rng:NextNumber(0, 3), 0), rgb(26, 27, 30), M.SmoothPlastic, self.Props)
						c.CastShadow = false
					end
				elseif roll < 0.82 then
					local stain = self:Deco(Vector3.new(0.03, self.Rng:NextNumber(2, 3.5), self.Rng:NextNumber(2, 3.5)), CFrame.new(pos + Vector3.new(0, markY - 0.015, 0)) * CFrame.Angles(0, 0, math.rad(90)), rgb(30, 31, 34), M.SmoothPlastic, self.Props)
					stain.Shape = Enum.PartType.Cylinder
					stain.Transparency = 0.25
					stain.CastShadow = false
				else
					local drain = base + along * d + across * (width / 2 - 0.9) * (self.Rng:NextNumber() < 0.5 and 1 or -1)
					local g = self:Deco(axis == "X" and Vector3.new(2.4, 0.05, 1.2) or Vector3.new(1.2, 0.05, 2.4), CFrame.new(drain + Vector3.new(0, markY, 0)), rgb(30, 30, 32), M.DiamondPlate, self.Props)
					g.CastShadow = false
				end
			end
		end
	end
	-- white edge lines (split around intersections)
	local segStart = start
	local cuts = {}
	for _, s in skip or {} do
		table.insert(cuts, s)
	end
	table.sort(cuts)
	table.insert(cuts, start + length + width)
	for _, cut in cuts do
		local segEnd = math.min(cut - width / 2 - 2, start + length)
		if segEnd - segStart > 2 then
			for _, side in { -1, 1 } do
				local mid = (segStart + segEnd) / 2
				local pos = base + along * mid + across * side * (width / 2 - 1.2) + Vector3.new(0, markY, 0)
				local s = axis == "X" and Vector3.new(segEnd - segStart, 0.05, 0.35) or Vector3.new(0.35, 0.05, segEnd - segStart)
				self:Deco(s, CFrame.new(pos), P.White, M.SmoothPlastic, self.Props)
			end
		end
		segStart = cut + width / 2 + 2
	end
end

-- Zebra crossing across a road at `pos`; stripes run along `axis` of travel.
function MapKit:Crosswalk(pos: Vector3, axis: string, width: number)
	for i = -width / 2 + 2, width / 2 - 2, 2.5 do
		local p = axis == "X" and Vector3.new(0, 0, i) or Vector3.new(i, 0, 0)
		local s = axis == "X" and Vector3.new(6, 0.05, 1.2) or Vector3.new(1.2, 0.05, 6)
		self:Deco(s, CFrame.new(pos + p + Vector3.new(0, 0.03, 0)), P.White, M.SmoothPlastic, self.Props)
	end
end

-- Raised sidewalk block (curb) covering a city block.
function MapKit:Sidewalk(center: Vector3, sx: number, sz: number)
	self.Surfaces = self.Surfaces or {}
	table.insert(self.Surfaces, { center.X - sx / 2, center.X + sx / 2, center.Z - sz / 2, center.Z + sz / 2, center.Y + 0.8 })
	self:Part(Vector3.new(sx, 0.8, sz), CFrame.new(center + Vector3.new(0, 0.4, 0)), P.Sidewalk, M.Concrete, self.Geo)
	self:Part(Vector3.new(sx + 0.6, 0.6, sz + 0.6), CFrame.new(center + Vector3.new(0, 0.3, 0)), P.ConcreteDark, M.Concrete, self.Geo)
	-- curb stones around the edge + paving seams near the curb
	local topY = center.Y + 0.81
	for _, e in { { 0, -sz / 2 + 0.5, sx, 1 }, { 0, sz / 2 - 0.5, sx, 1 }, { -sx / 2 + 0.5, 0, 1, sz }, { sx / 2 - 0.5, 0, 1, sz } } do
		self:Deco(Vector3.new(e[3], 0.04, e[4]), CFrame.new(center.X + e[1], topY, center.Z + e[2]), P.Sidewalk:Lerp(Color3.new(1, 1, 1), 0.25), M.Concrete).CastShadow = false
	end
	local seam = P.Sidewalk:Lerp(Color3.new(), 0.18)
	for x = -sx / 2 + 6, sx / 2 - 6, 6 do
		for _, zEdge in { -sz / 2 + 3.5, sz / 2 - 3.5 } do
			self:Deco(Vector3.new(0.12, 0.03, 5), CFrame.new(center.X + x, topY, center.Z + zEdge), seam, M.SmoothPlastic).CastShadow = false
		end
	end
	for z = -sz / 2 + 6, sz / 2 - 6, 6 do
		for _, xEdge in { -sx / 2 + 3.5, sx / 2 - 3.5 } do
			self:Deco(Vector3.new(5, 0.03, 0.12), CFrame.new(center.X + xEdge, topY, center.Z + z), seam, M.SmoothPlastic).CastShadow = false
		end
	end
	-- a little litter: paper scraps and leaves
	for _ = 1, math.floor(sx * sz / 900) do
		local lp = Vector3.new(center.X + self.Rng:NextNumber(-sx / 2 + 1, sx / 2 - 1), topY + 0.01, center.Z + self.Rng:NextNumber(-sz / 2 + 1, sz / 2 - 1))
		local bit = self:Deco(Vector3.new(0.5, 0.02, 0.4), CFrame.new(lp) * CFrame.Angles(0, self.Rng:NextNumber(0, 6), 0), self.Rng:NextNumber() < 0.5 and rgb(235, 232, 220) or rgb(150, 110, 60), M.SmoothPlastic)
		bit.CastShadow = false
	end
end

-- PROPS -----------------------------------------------------------------------------
function MapKit:StreetLight(pos: Vector3, facing: Vector3)
	local model = Instance.new("Model")
	model.Name = "StreetLight"
	model.Parent = self.Props
	-- tapered pole on a round footing
	self:Pillar(pos, 0.8, 1.6, P.MetalDark, M.Metal, model)
	self:Pillar(pos, 9, 0.75, P.MetalDark, M.Metal, model)
	self:Pillar(pos + Vector3.new(0, 9, 0), 7, 0.55, P.MetalDark, M.Metal, model)
	self:Ball(0.8, pos + Vector3.new(0, 16, 0), P.MetalDark, M.Metal, model)
	local dir = Vector3.new(facing.X, 0, facing.Z).Unit
	-- curved arm: three short segments bending out over the road
	local p0 = pos + Vector3.new(0, 15.6, 0)
	local pts = { p0, p0 + dir * 1.4 + Vector3.new(0, 1.0, 0), p0 + dir * 3.0 + Vector3.new(0, 1.4, 0), p0 + dir * 4.8 + Vector3.new(0, 1.2, 0) }
	for i = 1, #pts - 1 do
		local a, b = pts[i], pts[i + 1]
		local seg = self:Cylinder((b - a).Magnitude + 0.3, 0.35, CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.rad(90), 0), P.MetalDark, M.Metal, model)
		seg.CanQuery = false
	end
	-- cobra-head lamp housing
	local head = pts[#pts] + dir * 0.6
	local housing = self:Part(Vector3.new(1.5, 0.6, 2.6), CFrame.lookAt(head, head + dir), P.MetalDark, M.Metal, model)
	housing.CanQuery = false
	local lamp = self:Neon(Vector3.new(1.1, 0.15, 2.1), CFrame.lookAt(head - Vector3.new(0, 0.35, 0), head - Vector3.new(0, 0.35, 0) + dir), rgb(255, 228, 170), model)
	self:Light(lamp, "SpotLight", rgb(255, 222, 170), 46, 3, Enum.NormalId.Bottom)
	self:Light(lamp, "PointLight", rgb(255, 214, 160), 14, 0.8)
end

function MapKit:TrafficLight(pos: Vector3, facing: Vector3)
	local model = Instance.new("Model")
	model.Name = "TrafficLight"
	model.Parent = self.Props
	self:Pillar(pos, 13, 0.5, P.MetalDark, M.Metal, model)
	local dir = Vector3.new(facing.X, 0, facing.Z).Unit
	local box = pos + Vector3.new(0, 11.5, 0) + dir * 0.6
	self:Part(Vector3.new(1.2, 3.6, 1.2), CFrame.lookAt(box, box + dir), rgb(30, 30, 30), M.Metal, model)
	for i, c in { rgb(255, 50, 50), rgb(255, 190, 0), rgb(40, 230, 90) } do
		self:Neon(Vector3.new(0.7, 0.7, 0.2), CFrame.lookAt(box + dir * 0.65 + Vector3.new(0, 1.15 - (i - 1) * 1.15, 0), box + dir * 2), i == 3 and c or c:Lerp(Color3.new(), 0.7), model)
	end
end

function MapKit:Tree(pos: Vector3, scale: number?, kind: string?)
	local s = scale or 1
	local rng = self.Rng
	local model = Instance.new("Model")
	model.Name = "Tree"
	model.Parent = self.Props
	kind = kind or "Oak"
	if kind == "Pine" then
		local h = 9 * s
		self:Pillar(pos - Vector3.new(0, 1, 0), h + 1, 1.3 * s, P.Trunk, M.Wood, model)
		local layers = { 9, 7.2, 5.4, 3.4 }
		for i, d in layers do
			local disc = self:Cylinder(2.6 * s, d * s, CFrame.new(pos + Vector3.new(0, 3.5 * s + i * 2.6 * s, 0)) * CFrame.Angles(0, rng:NextNumber(0, 3), math.rad(90)), i % 2 == 0 and P.Pine or P.LeafDark, M.LeafyGrass, model)
			disc.CanCollide = false
			disc.CanQuery = false
		end
	elseif kind == "Palm" then
		local lean = rng:NextNumber(-0.25, 0.25)
		local top = pos
		for i = 1, 4 do
			local seg = top + Vector3.new(lean * 2, 3 * s, 0)
			self:Part(Vector3.new(1.1 * s, 3.2 * s, 1.1 * s), CFrame.lookAt((top + seg) / 2, seg) * CFrame.Angles(math.rad(90), 0, 0), P.WoodLight, M.Wood, model)
			top = seg
			lean *= 1.3
			if i == 4 then
				break
			end
		end
		for i = 1, 6 do
			local a = i / 6 * math.pi * 2
			local leafDir = Vector3.new(math.cos(a), -0.35, math.sin(a))
			local leaf = self:Deco(Vector3.new(1.8 * s, 0.25, 6 * s), CFrame.lookAt(top + leafDir * 3 * s, top + leafDir * 6 * s), P.Leaf, M.LeafyGrass, model)
			leaf.Parent = model
		end
	else
		local trunkH = 6 * s
		self:Pillar(pos - Vector3.new(0, 1, 0), trunkH + 1, 1.4 * s, P.Trunk, M.Wood, model)
		-- root flare + a branch fork so the trunk isn't a plain stick
		for k = 1, 4 do
			local a = k / 4 * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
			local dir = Vector3.new(math.cos(a), 0, math.sin(a))
			local root = self:Cylinder(2 * s, 0.7 * s, CFrame.lookAt(pos + dir * 0.7 * s + Vector3.new(0, 0.25, 0), pos + dir * 2 * s - Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, math.rad(90), 0), P.Trunk:Lerp(Color3.new(), 0.1), M.Wood, model)
			root.CanCollide, root.CanQuery = false, false
		end
		for _, side in { -1, 1 } do
			local b0 = pos + Vector3.new(0, trunkH * 0.7, 0)
			local b1 = b0 + Vector3.new(side * 2 * s, 2.2 * s, rng:NextNumber(-1, 1) * s)
			local branch = self:Cylinder((b1 - b0).Magnitude, 0.55 * s, CFrame.lookAt((b0 + b1) / 2, b1) * CFrame.Angles(0, math.rad(90), 0), P.Trunk, M.Wood, model)
			branch.CanCollide, branch.CanQuery = false, false
		end
		-- fuller, rounder canopy: a big core plus smaller clumps around it
		local crown = pos + Vector3.new(0, trunkH + 2 * s, 0)
		local core = self:Ball(8 * s, crown, P.Leaf, M.LeafyGrass, model)
		core.CanCollide = false
		core.CanQuery = false
		for k = 1, 5 do
			local ang = k / 5 * math.pi * 2 + rng:NextNumber(-0.4, 0.4)
			local clump = self:Ball(rng:NextNumber(4, 5.5) * s, crown + Vector3.new(math.cos(ang) * 3.4, rng:NextNumber(-1.2, 1.6), math.sin(ang) * 3.4) * s, rng:NextNumber() < 0.5 and P.Leaf:Lerp(P.LeafDark, 0.3) or P.LeafDark, M.LeafyGrass, model)
			clump.CanCollide = false
			clump.CanQuery = false
		end
		for _ = 1, 2 do
			local off = Vector3.new(rng:NextNumber(-2, 2), rng:NextNumber(0, 2.5), rng:NextNumber(-2, 2)) * s
			local leaf = self:Ball(rng:NextNumber(6, 8.5) * s, pos + Vector3.new(0, trunkH + 2 * s, 0) + off, rng:NextNumber() < 0.5 and P.Leaf or P.LeafDark, M.LeafyGrass, model)
			leaf.CanCollide = false
			leaf.CanQuery = false
		end
	end
	return model
end

function MapKit:Bush(pos: Vector3, scale: number?)
	local s = scale or 1
	for i = 1, 2 do
		local b = self:Ball((3 + i) * s, pos + Vector3.new(i * 0.8 * s, s, 0), P.LeafDark, M.LeafyGrass, self.Props)
		b.CanCollide = false
	end
end

function MapKit:Rock(pos: Vector3, scale: number?)
	local s = scale or 1
	local rng = self.Rng
	for _ = 1, 2 do
		local size = Vector3.new(rng:NextNumber(3, 6), rng:NextNumber(2.5, 4.5), rng:NextNumber(3, 6)) * s
		local cf = CFrame.new(pos + Vector3.new(rng:NextNumber(-1, 1), 0.8 * s, rng:NextNumber(-1, 1))) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 3), rng:NextNumber(-0.3, 0.3))
		self:Part(size, cf, P.Rock:Lerp(rgb(90, 88, 84), rng:NextNumber()), M.Slate, self.Geo)
		-- moss cap on top
		local moss = self:Deco(Vector3.new(size.X * 0.85, 0.25, size.Z * 0.85), cf * CFrame.new(0, size.Y / 2, 0), rgb(70, 110, 55), M.Grass)
		moss.CastShadow = false
	end
	for _ = 1, 3 do
		local pebble = self:Part(Vector3.one * rng:NextNumber(0.6, 1.2) * s, CFrame.new(pos + Vector3.new(rng:NextNumber(-4, 4), 0.3, rng:NextNumber(-4, 4)) * Vector3.new(s, 1, s)) * CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), 0), P.Rock, M.Slate, self.Props)
		pebble.CanCollide, pebble.CanQuery = false, false
	end
end

function MapKit:Bench(cf: CFrame)
	self:Part(Vector3.new(6, 0.4, 1.8), cf * CFrame.new(0, 1.8, 0), P.WoodLight, M.Wood, self.Props)
	self:Part(Vector3.new(6, 1.6, 0.3), cf * CFrame.new(0, 2.8, 0.85), P.WoodLight, M.Wood, self.Props)
	for _, x in { -2.6, 2.6 } do
		self:Part(Vector3.new(0.3, 1.8, 1.6), cf * CFrame.new(x, 0.9, 0), P.MetalDark, M.Metal, self.Props)
	end
end

function MapKit:Dumpster(cf: CFrame)
	self:Part(Vector3.new(7, 4.5, 4), cf * CFrame.new(0, 2.25, 0), rgb(40, 100, 60), M.Metal, self.Geo)
	self:Part(Vector3.new(7.2, 0.3, 4.2), cf * CFrame.new(0, 4.6, 0) * CFrame.Angles(math.rad(-8), 0, 0), rgb(30, 30, 30), M.Plastic, self.Geo)
end

-- Concrete jersey barrier (great low cover)
function MapKit:Barrier(cf: CFrame)
	self:Part(Vector3.new(8, 1, 2.4), cf * CFrame.new(0, 0.5, 0), P.Concrete, M.Concrete, self.Geo)
	self:Part(Vector3.new(8, 2.6, 1.2), cf * CFrame.new(0, 2.3, 0), P.Concrete, M.Concrete, self.Geo)
	self:Deco(Vector3.new(8.05, 0.4, 1.25), cf * CFrame.new(0, 2.8, 0), rgb(220, 70, 40), M.SmoothPlastic)
end

function MapKit:Crate(pos: Vector3, size: number?, rot: number?)
	local s = size or 4
	return self:Part(Vector3.new(s, s, s), CFrame.new(pos + Vector3.new(0, s / 2, 0)) * CFrame.Angles(0, rot or 0, 0), rgb(176, 128, 66), M.WoodPlanks, self.Geo)
end

local CONTAINER_COLORS = { rgb(180, 60, 40), rgb(40, 90, 160), rgb(220, 150, 30), rgb(50, 130, 80), rgb(130, 130, 136), rgb(150, 50, 110) }
function MapKit:Container(cf: CFrame, color: Color3?, open: boolean?)
	local c = color or CONTAINER_COLORS[self.Rng:NextInteger(1, #CONTAINER_COLORS)]
	local model = Instance.new("Model")
	model.Name = "Container"
	model.Parent = self.Geo
	local W, H, L = 8, 8.5, 20
	if open then
		self:Part(Vector3.new(W, 0.4, L), cf * CFrame.new(0, 0.2, 0), c, M.CorrodedMetal, model)
		self:Part(Vector3.new(W, 0.4, L), cf * CFrame.new(0, H - 0.2, 0), c, M.CorrodedMetal, model)
		self:Part(Vector3.new(0.3, H, L), cf * CFrame.new(-W / 2 + 0.15, H / 2, 0), c, M.CorrodedMetal, model)
		self:Part(Vector3.new(0.3, H, L), cf * CFrame.new(W / 2 - 0.15, H / 2, 0), c, M.CorrodedMetal, model)
		self:Part(Vector3.new(W, H, 0.3), cf * CFrame.new(0, H / 2, L / 2 - 0.15), c, M.CorrodedMetal, model)
	else
		self:Part(Vector3.new(W, H, L), cf * CFrame.new(0, H / 2, 0), c, M.CorrodedMetal, model)
	end
	for _, z in { -L / 2 + 0.2, L / 2 - 0.2 } do
		self:Deco(Vector3.new(W + 0.1, H + 0.1, 0.4), cf * CFrame.new(0, H / 2, z), c:Lerp(Color3.new(), 0.3), M.Metal, model)
	end
	-- corrugated side ribs, rust streaks and locking bars on the doors
	local rib = c:Lerp(Color3.new(), 0.18)
	for z = -L / 2 + 1.6, L / 2 - 1.6, 2.4 do
		for _, x in { -W / 2 - 0.08, W / 2 + 0.08 } do
			self:Deco(Vector3.new(0.16, H - 0.6, 0.7), cf * CFrame.new(x, H / 2, z), rib, M.CorrodedMetal, model).CastShadow = false
		end
	end
	for _ = 1, 2 do
		local x = (self.Rng:NextNumber() < 0.5 and -1 or 1) * (W / 2 + 0.17)
		self:Deco(Vector3.new(0.05, self.Rng:NextNumber(2, 5), self.Rng:NextNumber(0.6, 1.4)), cf * CFrame.new(x, H - 2.5, self.Rng:NextNumber(-L / 2 + 2, L / 2 - 2)), rgb(120, 70, 40), M.CorrodedMetal, model).CastShadow = false
	end
	for i = -1.5, 1.5 do
		local bar = self:Cylinder(H - 0.8, 0.18, cf * CFrame.new(i * 1.7, H / 2, L / 2 + 0.05) * CFrame.Angles(0, 0, math.rad(90)), rgb(60, 62, 66), M.Metal, model)
		bar.CanCollide, bar.CanQuery, bar.CastShadow = false, false, false
	end
	return model
end

function MapKit:Fence(a: Vector3, b: Vector3, height: number?, color: Color3?)
	local h = height or 4
	local dir = b - a
	local len = dir.Magnitude
	local cf = CFrame.lookAt((a + b) / 2, b)
	for d = 0, len, 6 do
		self:Part(Vector3.new(0.4, h, 0.4), CFrame.new(a + dir.Unit * d + Vector3.new(0, h / 2, 0)), color or P.WoodDark, M.Wood, self.Geo)
	end
	for _, y in { h * 0.4, h * 0.85 } do
		self:Part(Vector3.new(0.25, 0.4, len), cf * CFrame.new(0, y, 0), color or P.Wood, M.Wood, self.Geo)
	end
end

function MapKit:Tent(cf: CFrame, color: Color3?)
	local c = color or rgb(60, 110, 70)
	self:Wedge(Vector3.new(6, 4, 3), cf * CFrame.new(0, 2, -1.5), c, M.Fabric, self.Props)
	self:Wedge(Vector3.new(6, 4, 3), cf * CFrame.new(0, 2, 1.5) * CFrame.Angles(0, math.rad(180), 0), c, M.Fabric, self.Props)
end

function MapKit:Campfire(pos: Vector3)
	for i = 1, 4 do
		local a = i / 4 * math.pi
		self:Deco(Vector3.new(0.5, 0.5, 3), CFrame.new(pos + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, a, 0), P.WoodDark, M.Wood)
	end
	local core = self:Neon(Vector3.new(1, 0.6, 1), CFrame.new(pos + Vector3.new(0, 0.5, 0)), rgb(255, 120, 30))
	local fire = Instance.new("Fire")
	fire.Size = 4
	fire.Heat = 6
	fire.Parent = core
	self:Light(core, "PointLight", rgb(255, 140, 60), 22, 2.5)
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2
		self:Part(Vector3.new(1, 0.8, 1), CFrame.new(pos + Vector3.new(math.cos(a) * 2, 0.4, math.sin(a) * 2)), P.Rock, M.Slate, self.Geo)
	end
end

-- Wooden watchtower with a climbable truss ladder.
function MapKit:Watchtower(pos: Vector3, height: number?)
	local h = height or 22
	local model = Instance.new("Model")
	model.Name = "Watchtower"
	model.Parent = self.Geo
	for _, dx in { -4, 4 } do
		for _, dz in { -4, 4 } do
			self:Part(Vector3.new(1, h, 1), CFrame.new(pos + Vector3.new(dx, h / 2, dz)), P.WoodDark, M.Wood, model)
		end
	end
	self:Part(Vector3.new(11, 0.8, 11), CFrame.new(pos + Vector3.new(0, h, 0)), P.Wood, M.WoodPlanks, model)
	for _, s in { { 0, -5.3, 11, 0.4 }, { 0, 5.3, 11, 0.4 }, { -5.3, 0, 0.4, 11 }, { 5.3, 0, 0.4, 11 } } do
		self:Part(Vector3.new(s[3], 3, s[4]), CFrame.new(pos + Vector3.new(s[1], h + 1.9, s[2])), P.Wood, M.WoodPlanks, model)
	end
	self:Wedge(Vector3.new(12, 3, 6), CFrame.new(pos + Vector3.new(0, h + 8.5, -3)), P.WoodDark, M.WoodPlanks, model)
	self:Wedge(Vector3.new(12, 3, 6), CFrame.new(pos + Vector3.new(0, h + 8.5, 3)) * CFrame.Angles(0, math.rad(180), 0), P.WoodDark, M.WoodPlanks, model)
	for _, dx in { -4, 4 } do
		for _, dz in { -4, 4 } do
			self:Part(Vector3.new(0.5, 7, 0.5), CFrame.new(pos + Vector3.new(dx, h + 3.5, dz)), P.WoodDark, M.Wood, model)
		end
	end
	local ladder = self:Part(Vector3.new(2, h, 2), CFrame.new(pos + Vector3.new(0, h / 2, -5.6)), P.MetalDark, M.Metal, model, "TrussPart")
	ladder.Name = "Ladder"
	-- the ladder pokes through the railing; leave a gap there
	return model
end

-- Wall / post lantern with a warm flicker-free glow.
function MapKit:Lantern(cf: CFrame, parent)
	local cage = self:Deco(Vector3.new(0.9, 1.3, 0.9), cf, P.MetalDark, M.Metal, parent)
	cage.Transparency = 0.2
	local bulb = self:Neon(Vector3.new(0.55, 0.8, 0.55), cf, rgb(255, 190, 110), parent)
	self:Deco(Vector3.new(1.2, 0.25, 1.2), cf * CFrame.new(0, 0.75, 0), P.MetalDark, M.Metal, parent)
	self:Light(bulb, "PointLight", rgb(255, 180, 100), 18, 1.3)
	return bulb
end

-- Stadium-style floodlight head aimed at `target`.
function MapKit:Floodlight(pos: Vector3, target: Vector3, parent)
	local cf = CFrame.lookAt(pos, target)
	self:Deco(Vector3.new(3.2, 2, 0.8), cf, P.MetalDark, M.Metal, parent)
	local face = self:Neon(Vector3.new(2.8, 1.6, 0.1), cf * CFrame.new(0, 0, -0.45), rgb(240, 245, 255), parent)
	self:Light(face, "SpotLight", rgb(235, 240, 255), 60, 3, Enum.NormalId.Front)
	return face
end

-- Gantry crane straddling a container yard.
function MapKit:Crane(cf: CFrame, span: number, height: number)
	local model = Instance.new("Model")
	model.Name = "Crane"
	model.Parent = self.Geo
	local yellow = rgb(240, 180, 30)
	for _, x in { -span / 2, span / 2 } do
		for _, z in { -8, 8 } do
			self:Part(Vector3.new(2, height, 2), cf * CFrame.new(x, height / 2, z), yellow, M.Metal, model)
		end
		self:Part(Vector3.new(2.4, 2, 18), cf * CFrame.new(x, 1, 0), P.MetalDark, M.Metal, model)
	end
	for _, z in { -8, 8 } do
		self:Part(Vector3.new(span + 2, 2.5, 2), cf * CFrame.new(0, height, z), yellow, M.Metal, model)
	end
	self:Part(Vector3.new(8, 5, 18), cf * CFrame.new(span * 0.15, height + 3.5, 0), yellow, M.Metal, model)
	self:Deco(Vector3.new(0.3, height * 0.45, 0.3), cf * CFrame.new(span * 0.15, height * 0.75, 0), P.MetalDark, M.Metal, model)
	self:Part(Vector3.new(8, 1, 20), cf * CFrame.new(span * 0.15, height * 0.52, 0), P.MetalDark, M.Metal, model)
	-- floodlights under the girders light the yard below
	for _, x in { -span / 2 + 3, span / 2 - 3 } do
		local p = (cf * CFrame.new(x, height - 2.2, 0)).Position
		self:Floodlight(p, p + Vector3.new(-x * 0.6, -height, 0), model)
	end
	local warn = self:Neon(Vector3.new(0.8, 0.8, 0.8), cf * CFrame.new(span * 0.15, height + 6.4, 0), P.Red, model)
	self:Light(warn, "PointLight", P.Red, 14, 1.5)
	return model
end

-- Cargo ship you can board via a gangway.
function MapKit:Ship(cf: CFrame, length: number, gangwayAt: number?)
	local model = Instance.new("Model")
	model.Name = "Ship"
	model.Parent = self.Geo
	local W = 30
	local hullH = 16
	local hull = rgb(150, 36, 36)
	local deckY = 12
	self:Part(Vector3.new(W, hullH, length), cf * CFrame.new(0, deckY - hullH / 2, 0), hull, M.Metal, model)
	self:Part(Vector3.new(W + 0.2, 1.2, length + 0.2), cf * CFrame.new(0, deckY - hullH + 3, 0), rgb(30, 30, 34), M.Metal, model)
	self:Wedge(Vector3.new(W, hullH, 20), cf * CFrame.new(0, deckY - hullH / 2, -length / 2 - 10), hull, M.Metal, model)
	self:Part(Vector3.new(W - 1, 0.6, length + 6), cf * CFrame.new(0, deckY + 0.3, -3), rgb(80, 90, 80), M.DiamondPlate, model)
	-- railings (with a gap for the gangway on the +X side)
	for _, x in { -W / 2 + 0.3, W / 2 - 0.3 } do
		local segments = { { -length / 2, length / 2 } }
		if gangwayAt and x > 0 then
			segments = { { -length / 2, gangwayAt - 4 }, { gangwayAt + 4, length / 2 } }
		end
		for _, seg in segments do
			self:Part(Vector3.new(0.4, 3, seg[2] - seg[1]), cf * CFrame.new(x, deckY + 2, (seg[1] + seg[2]) / 2), P.White, M.Metal, model)
		end
	end
	-- bridge tower at the stern
	local tower = cf * CFrame.new(0, deckY, length / 2 - 10)
	self:Building({ Origin = tower, W = 22, D = 14, Floors = 2, FloorH = 10, Color = P.White, Material = M.Metal, Trim = rgb(40, 40, 46), Doors = { Front = true }, Props = false, Awning = rgb(40, 40, 46) })
	-- containers on deck
	for i = 0, math.floor((length - 40) / 22) - 1 do
		for _, x in { -5, 5 } do
			self:Container(cf * CFrame.new(x, deckY + 0.6, -length / 2 + 14 + i * 22), nil, i % 2 == 1 and x > 0)
		end
	end
	return model
end

-- Wooden dock/pier on posts, deck top at `deckY`.
function MapKit:Pier(a: Vector3, b: Vector3, width: number, deckY: number)
	local dir = b - a
	local cf = CFrame.lookAt((a + b) / 2, b)
	local len = dir.Magnitude
	self:Part(Vector3.new(width, 0.8, len), CFrame.new(cf.Position.X, deckY - 0.4, cf.Position.Z) * cf.Rotation, P.WoodLight, M.WoodPlanks, self.Geo)
	for d = 0, len, 10 do
		for _, side in { -1, 1 } do
			local p = a + dir.Unit * d + cf.RightVector * side * (width / 2 - 0.5)
			self:Pillar(Vector3.new(p.X, deckY - 14, p.Z), 14, 1.2, P.WoodDark, M.Wood)
		end
	end
	-- plank seams, bollards, tyre fenders and rope coils
	for d = 1, len - 1, 2 do
		local p = a + dir.Unit * d
		self:Deco(Vector3.new(width - 0.2, 0.03, 0.08), CFrame.new(p.X, deckY + 0.01, p.Z) * cf.Rotation, P.WoodDark, M.Wood).CastShadow = false
	end
	for d = 6, len - 4, 14 do
		for _, side in { -1, 1 } do
			local p = a + dir.Unit * d + cf.RightVector * side * (width / 2 - 0.8)
			self:Pillar(Vector3.new(p.X, deckY, p.Z), 1.4, 0.9, rgb(40, 42, 46), M.Metal)
			self:Ball(1.1, Vector3.new(p.X, deckY + 1.45, p.Z), rgb(40, 42, 46), M.Metal).CanQuery = false
			local f = a + dir.Unit * (d + 4) + cf.RightVector * side * (width / 2 + 0.5)
			local tyre = self:Cylinder(0.8, 2.2, CFrame.new(f.X, deckY - 1.2, f.Z) * cf.Rotation * CFrame.Angles(0, math.rad(90), 0), rgb(25, 25, 27), M.Rubber)
			tyre.CanCollide, tyre.CanQuery = false, false
		end
		local rp = a + dir.Unit * (d + 2)
		local coil = self:Cylinder(0.35, 1.6, CFrame.new(rp.X, deckY + 0.18, rp.Z) * CFrame.Angles(0, 0, math.rad(90)), rgb(200, 180, 130), M.Fabric)
		coil.CanCollide, coil.CanQuery = false, false
	end
end

-- BATTLE ROYALE PIECES -----------------------------------------------------------------

-- Flat ground (top surface at `top`) covering x0..x1 / z0..z1 with rectangular holes
-- cut out (tunnel entrances). holes = { { X0, X1, Z0, Z1 }, ... }
function MapKit:Ground(top: number, x0: number, x1: number, z0: number, z1: number, thickness: number, holes, color, material)
	local rects = { { x0, x1, z0, z1 } }
	for _, h in holes or {} do
		local out = {}
		for _, r in rects do
			if h.X1 <= r[1] or h.X0 >= r[2] or h.Z1 <= r[3] or h.Z0 >= r[4] then
				table.insert(out, r)
			else
				if h.X0 > r[1] then
					table.insert(out, { r[1], h.X0, r[3], r[4] })
				end
				if h.X1 < r[2] then
					table.insert(out, { h.X1, r[2], r[3], r[4] })
				end
				local mx0, mx1 = math.max(r[1], h.X0), math.min(r[2], h.X1)
				if h.Z0 > r[3] then
					table.insert(out, { mx0, mx1, r[3], h.Z0 })
				end
				if h.Z1 < r[4] then
					table.insert(out, { mx0, mx1, h.Z1, r[4] })
				end
			end
		end
		rects = out
	end
	for _, r in rects do
		if r[2] - r[1] > 0.1 and r[4] - r[3] > 0.1 then
			self:Part(Vector3.new(r[2] - r[1], thickness, r[4] - r[3]), CFrame.new((r[1] + r[2]) / 2, top - thickness / 2, (r[3] + r[4]) / 2), color, material)
		end
	end
end

-- Climbable ladder (TrussPart) standing at `base` going up `height` studs.
function MapKit:Ladder(base: Vector3, height: number, _normal)
	local h = math.max(2, math.floor(height / 2 + 0.5) * 2)
	local truss = self:Part(Vector3.new(2, h, 2), CFrame.new(base + Vector3.new(0, h / 2, 0)), rgb(70, 74, 80), M.Metal, self.Geo, "TrussPart")
	truss.Name = "Ladder"
	return truss
end

--[[ Underground tunnel with stair entrances. Returns the ground holes for the entrances.
spec = { Axis = "Z"|"X", Cross = number, From, To, Floor = -14, Width = 14, Height = 9,
	Entrances = { { At = number, Dir = 1 | -1 }, ... }, Style = "Subway" | "Sewer" | "Mine", Terrain = bool } ]]
function MapKit:Tunnel(spec)
	local axisZ = spec.Axis ~= "X"
	local c = spec.Cross or 0
	local floorY = spec.Floor or -14
	local W = spec.Width or 14
	local H = spec.Height or 9
	local style = spec.Style or "Subway"
	local model = Instance.new("Model")
	model.Name = style .. "Tunnel"
	model.Parent = self.Geo
	local function at(along, across, y)
		return axisZ and Vector3.new(c + across, y, along) or Vector3.new(along, y, c + across)
	end
	local function size(lenAlong, h, lenAcross)
		return axisZ and Vector3.new(lenAcross, h, lenAlong) or Vector3.new(lenAlong, h, lenAcross)
	end
	local wallColor, wallMat, floorColor, floorMat
	if style == "Mine" then
		wallColor, wallMat, floorColor, floorMat = rgb(96, 74, 52), M.Ground, rgb(80, 64, 48), M.Ground
	elseif style == "Sewer" then
		wallColor, wallMat, floorColor, floorMat = rgb(92, 96, 92), M.Concrete, rgb(70, 74, 72), M.Concrete
	else
		wallColor, wallMat, floorColor, floorMat = rgb(214, 216, 210), M.SmoothPlastic, rgb(120, 120, 124), M.Concrete
	end
	local a0, a1 = math.min(spec.From, spec.To), math.max(spec.From, spec.To)
	local len = a1 - a0
	local mid = (a0 + a1) / 2
	local depth = -floorY
	local run = depth * 1.45
	if spec.Terrain then
		self:Fill(M.Air, CFrame.new(at(mid, 0, floorY + H / 2)), size(len + 4, H + 2, W + 2))
	end
	-- floor, walls, end caps
	self:Part(size(len + 2, 1, W + 2), CFrame.new(at(mid, 0, floorY - 0.5)), floorColor, floorMat, model)
	for _, s in { -1, 1 } do
		self:Part(size(len + 2, H + 1, 1), CFrame.new(at(mid, s * (W / 2 + 0.5), floorY + (H + 1) / 2)), wallColor, wallMat, model)
	end
	for _, e in { a0 - 1, a1 + 1 } do
		self:Part(size(1, H + 1, W + 2), CFrame.new(at(e, 0, floorY + (H + 1) / 2)), wallColor, wallMat, model)
	end
	-- ceiling with gaps over the entrance ramps
	local gaps = {}
	for _, e in spec.Entrances or {} do
		local g0, g1 = e.At, e.At + e.Dir * run
		table.insert(gaps, { math.min(g0, g1) - 0.5, math.max(g0, g1) + 0.5 })
	end
	table.sort(gaps, function(x, y)
		return x[1] < y[1]
	end)
	local cursor = a0 - 1
	local ceilY = floorY + H + 0.5
	local function ceiling(z0, z1)
		if z1 - z0 > 0.1 then
			self:Part(size(z1 - z0, 1, W + 2), CFrame.new(at((z0 + z1) / 2, 0, ceilY)), wallColor:Lerp(Color3.new(), 0.2), wallMat, model)
		end
	end
	for _, g in gaps do
		ceiling(cursor, g[1])
		cursor = g[2]
	end
	ceiling(cursor, a1 + 1)

	-- style dressing + lights
	for d = a0 + 6, a1 - 6, 16 do
		local lamp = self:Neon(size(4, 0.3, 1), CFrame.new(at(d, 0, ceilY - 0.65)), style == "Mine" and rgb(255, 190, 110) or rgb(235, 245, 255), model)
		self:Light(lamp, "PointLight", style == "Mine" and rgb(255, 180, 100) or rgb(220, 235, 255), 26, 1.4)
	end
	if style == "Subway" then
		for _, s in { -1, 1 } do
			self:Deco(size(len, 1, 0.1), CFrame.new(at(mid, s * (W / 2 - 0.05), floorY + 3.5)), rgb(30, 110, 60), M.SmoothPlastic, model)
			self:Deco(size(len, 0.15, 0.3), CFrame.new(at(mid, s * 1.6, floorY + 0.08)), rgb(150, 150, 156), M.Metal, model)
		end
		for d = a0 + 4, a1 - 4, 3 do
			self:Deco(size(0.6, 0.12, 4.4), CFrame.new(at(d, 0, floorY + 0.03)), rgb(80, 62, 48), M.Wood, model)
		end
		for d = a0 + 20, a1 - 20, 32 do
			for _, s in { -1, 1 } do
				self:Part(size(1.4, H, 1.4), CFrame.new(at(d, s * (W / 2 - 2), floorY + H / 2)), rgb(60, 110, 70), M.Metal, model)
			end
		end
	elseif style == "Sewer" then
		local water = self:Deco(size(len, 0.2, 3.5), CFrame.new(at(mid, 0, floorY + 0.12)), rgb(60, 90, 70), M.Glass, model)
		water.Transparency = 0.2
		for _, s in { -1, 1 } do
			local pipe = self:Cylinder(len, 1.2, CFrame.new(at(mid, s * (W / 2 - 0.8), floorY + H - 1.5)) * (axisZ and CFrame.Angles(0, math.rad(90), 0) or CFrame.identity), rgb(110, 80, 60), M.CorrodedMetal, model)
			pipe.CanCollide = false
		end
	else -- Mine
		for d = a0 + 4, a1 - 4, 8 do
			for _, s in { -1, 1 } do
				self:Part(size(1, H, 1), CFrame.new(at(d, s * (W / 2 - 0.6), floorY + H / 2)), P.WoodDark, M.Wood, model)
			end
			self:Part(size(1, 1, W), CFrame.new(at(d, 0, floorY + H - 0.5)), P.WoodDark, M.Wood, model)
		end
		for _, s in { -1, 1 } do
			self:Deco(size(len, 0.15, 0.3), CFrame.new(at(mid, s * 1.4, floorY + 0.08)), rgb(110, 100, 90), M.Metal, model)
		end
	end
	-- cover inside: crates / barrels every so often
	local rng = self.Rng
	for d = a0 + 12, a1 - 12, 26 do
		local side = rng:NextNumber() < 0.5 and -1 or 1
		self:Part(Vector3.new(3.5, 3.5, 3.5), CFrame.new(at(d, side * (W / 2 - 2.5), floorY + 1.75)), rgb(150, 112, 60), M.WoodPlanks, model)
	end

	-- entrances: ramp down from the surface, enclosed shaft, railings on top
	local holes = {}
	for _, e in spec.Entrances or {} do
		local top = at(e.At, 0, 0)
		local bottom = at(e.At + e.Dir * run, 0, floorY)
		self:Ramp(bottom, top, 6, rgb(110, 110, 114), M.DiamondPlate, model)
		local z0, z1 = math.min(e.At, e.At + e.Dir * run), math.max(e.At, e.At + e.Dir * run)
		for _, s in { -1, 1 } do
			self:Part(size(z1 - z0, depth, 0.8), CFrame.new(at((z0 + z1) / 2, s * 3.4, floorY + depth / 2)), wallColor, wallMat, model)
			-- surface railing
			self:Part(size(z1 - z0, 3.2, 0.3), CFrame.new(at((z0 + z1) / 2, s * 3.6, 1.6)), rgb(40, 110, 60), M.Metal, model)
		end
		self:Part(size(0.8, depth, 7.6), CFrame.new(at(e.At - e.Dir * 0.4, 0, floorY + depth / 2)), wallColor, wallMat, model)
		self:Part(size(0.3, 3.2, 7.4), CFrame.new(at(e.At + e.Dir * run, 0, 1.6)), rgb(40, 110, 60), M.Metal, model)
		if style == "Subway" then
			for _, s in { -1, 1 } do
				local post = at(e.At, s * 3.6, 0)
				self:Pillar(post, 6, 0.3, rgb(40, 110, 60), M.Metal, model)
				local globe = self:Ball(1, post + Vector3.new(0, 6.4, 0), rgb(120, 255, 140), M.Neon, model)
				globe.CanCollide = false
			end
		end
		if spec.Terrain then
			local mz = (z0 + z1) / 2
			self:Fill(M.Air, CFrame.new(at(mz, 0, floorY / 2 + 2)), size(z1 - z0 + 1, depth + 6, 7))
		end
		local p0, p1 = at(z0, -3.2, 0), at(z1, 3.2, 0)
		table.insert(holes, { X0 = math.min(p0.X, p1.X), X1 = math.max(p0.X, p1.X), Z0 = math.min(p0.Z, p1.Z), Z1 = math.max(p0.Z, p1.Z) })
	end
	return holes
end

-- Stacked sandbag wall (great cover). rows = 3 is chest height, 4 is full cover.
function MapKit:Sandbags(cf: CFrame, length: number, rows: number?)
	local r = rows or 3
	local tan = rgb(168, 146, 102)
	for row = 0, r - 1 do
		local offset = (row % 2) * 1.1
		for x = -length / 2 + 1.1 + offset, length / 2 - 1.1, 2.2 do
			local bag = self:Part(Vector3.new(2.2, 1.05, 1.4), cf * CFrame.new(x, 0.52 + row * 1.0, 0) * CFrame.Angles(0, self.Rng:NextNumber(-0.08, 0.08), 0), tan:Lerp(rgb(130, 112, 80), self.Rng:NextNumber()), M.Fabric)
			bag.Name = "Sandbag"
		end
	end
end

-- Dense bush you can hide inside (no collision, bullets go through).
function MapKit:HideBush(pos: Vector3, scale: number?)
	local s = scale or 1
	local rng = self.Rng
	for i = 1, 4 do
		local b = self:Ball(rng:NextNumber(5, 7) * s, pos + Vector3.new(rng:NextNumber(-2, 2) * s, (2 + i * 0.4) * s, rng:NextNumber(-2, 2) * s), i % 2 == 0 and P.LeafDark or P.Leaf, M.LeafyGrass, self.Props)
		b.CanCollide = false
		b.CanQuery = false
		b.Name = "HideBush"
	end
end

-- STREET FURNITURE ---------------------------------------------------------------------
function MapKit:Hydrant(pos: Vector3)
	self:Pillar(pos, 2.2, 0.8, rgb(200, 40, 30), M.Metal, self.Props)
	self:Ball(0.9, pos + Vector3.new(0, 2.3, 0), rgb(200, 40, 30), M.Metal, self.Props)
	self:Cylinder(1.2, 0.35, CFrame.new(pos + Vector3.new(0, 1.5, 0)), rgb(220, 200, 60), M.Metal, self.Props)
end

function MapKit:TrashCan(pos: Vector3)
	self:Pillar(pos, 3, 1.8, rgb(40, 70, 50), M.Metal, self.Props)
	self:Cylinder(0.3, 2, CFrame.new(pos + Vector3.new(0, 3.1, 0)) * CFrame.Angles(0, 0, math.rad(90)), rgb(30, 50, 36), M.Metal, self.Props)
end

function MapKit:Manhole(pos: Vector3)
	local m = self:Cylinder(0.06, 3, CFrame.new(pos + Vector3.new(0, 0.03, 0)) * CFrame.Angles(0, 0, math.rad(90)), rgb(50, 50, 52), M.DiamondPlate, self.Props)
	m.CanCollide = false
end

function MapKit:Cone(pos: Vector3)
	self:Part(Vector3.new(1.4, 0.2, 1.4), CFrame.new(pos + Vector3.new(0, 0.1, 0)), rgb(30, 30, 30), M.Plastic, self.Props)
	self:Pillar(pos + Vector3.new(0, 0.2, 0), 1.8, 0.7, rgb(255, 120, 20), M.Plastic, self.Props)
	self:Cylinder(0.3, 0.75, CFrame.new(pos + Vector3.new(0, 1.2, 0)) * CFrame.Angles(0, 0, math.rad(90)), rgb(240, 240, 240), M.Plastic, self.Props)
end

function MapKit:Planter(pos: Vector3)
	self:Part(Vector3.new(5, 2, 5), CFrame.new(pos + Vector3.new(0, 1, 0)), P.ConcreteDark, M.Concrete, self.Geo)
	self:Bush(pos + Vector3.new(0, 1.6, 0), 0.8)
end

function MapKit:BusStop(cf: CFrame)
	self:Part(Vector3.new(10, 0.3, 4), cf * CFrame.new(0, 8, 0), P.MetalDark, M.Metal, self.Props)
	for _, x in { -4.8, 4.8 } do
		self:Part(Vector3.new(0.3, 8, 0.3), cf * CFrame.new(x, 4, 1.6), P.MetalDark, M.Metal, self.Props)
	end
	self:Glass(Vector3.new(10, 6.5, 0.2), cf * CFrame.new(0, 4.5, 1.8))
	local ad = self:Neon(Vector3.new(0.2, 5, 3), cf * CFrame.new(4.9, 4.2, 0), rgb(255, 200, 80), self.Props)
	ad.Name = "BusAd"
	self:Bench(cf * CFrame.new(0, 0, 0.8))
end

function MapKit:NewsBox(cf: CFrame)
	self:Part(Vector3.new(1.8, 3, 1.6), cf * CFrame.new(0, 1.5, 0), rgb(30, 80, 160), M.Metal, self.Props)
	self:Glass(Vector3.new(1.4, 0.9, 0.1), cf * CFrame.new(0, 2.3, -0.82))
end

function MapKit:StreetSign(pos: Vector3, rot: number?)
	self:Pillar(pos, 10, 0.3, P.MetalDark, M.Metal, self.Props)
	self:Part(Vector3.new(4, 0.9, 0.1), CFrame.new(pos + Vector3.new(0, 9.2, 0)) * CFrame.Angles(0, rot or 0, 0), rgb(20, 110, 60), M.SmoothPlastic, self.Props)
	self:Part(Vector3.new(0.1, 0.9, 4), CFrame.new(pos + Vector3.new(0, 8.2, 0)) * CFrame.Angles(0, rot or 0, 0), rgb(20, 110, 60), M.SmoothPlastic, self.Props)
end

function MapKit:PowerBox(cf: CFrame)
	self:Part(Vector3.new(3, 4, 1.8), cf * CFrame.new(0, 2, 0), rgb(120, 126, 110), M.Metal, self.Geo)
	self:Deco(Vector3.new(2.6, 0.5, 0.1), cf * CFrame.new(0, 3.2, -0.92), rgb(240, 200, 30), M.SmoothPlastic)
end

-- Team spawn base at one end of the map: spawn markers behind a line of cover.
function MapKit:SpawnBase(center: Vector3, toward: Vector3, team: string, width: number?)
	local w = width or 60
	local dir = Vector3.new(toward.X - center.X, 0, toward.Z - center.Z).Unit
	local right = Vector3.new(-dir.Z, 0, dir.X)
	local color = ({ A = rgb(40, 120, 255), B = rgb(255, 60, 60), C = rgb(60, 220, 110) })[team] or rgb(255, 198, 26)
	for i = -4, 4 do
		if i ~= 0 then -- the middle is kept free (tunnel entrances / roads)
			self:Spawn(center + right * (i * w / 9) + Vector3.new(0, 3, 0), center + dir * 100, team)
		end
	end
	-- cover line in front of the spawn
	local front = center + dir * 14
	for i = -2, 2 do
		if i ~= 0 then
			local cf = CFrame.lookAt(front + right * (i * w / 5), front + right * (i * w / 5) + dir)
			self:Sandbags(cf, w / 6, 3)
		end
	end
	-- team flag
	local pole = center - dir * 6
	self:Pillar(pole, 16, 0.5, P.MetalDark, M.Metal, self.Props)
	local flag = self:Part(Vector3.new(0.2, 3.5, 5.5), CFrame.lookAt(pole + Vector3.new(0, 14, 0) + right * 2.9, pole + Vector3.new(0, 14, 0) + right * 3.9), color, M.Fabric, self.Props)
	flag.CanCollide = false
	local glow = self:Neon(Vector3.new(1.2, 0.08, w * 0.9), CFrame.lookAt(center + Vector3.new(0, 0.06, 0) + dir * 4, center + Vector3.new(0, 0.06, 0) + dir * 4 + right), color, self.Props)
	glow.Name = "SpawnLine"
end

-- Free-for-all spawn points scattered around the map. Points closer than
-- `minGap` studs to an earlier point are dropped so nobody spawns on top of someone.
function MapKit:FFASpawns(points, minGap: number?)
	local gap = minGap or 36
	local kept = {}
	for _, p in points do
		local ok = true
		for _, q in kept do
			if (Vector3.new(p.X - q.X, 0, p.Z - q.Z)).Magnitude < gap then
				ok = false
				break
			end
		end
		if ok then
			table.insert(kept, p)
			self:Spawn(Vector3.new(p.X, (p.Y ~= 0 and p.Y or 3), p.Z), Vector3.new(0, 3, 0), "FFA")
		end
	end
end

--[[ Big terrain mountains all around the map (outside the invisible boundary walls,
so they look real but can't be reached). Also lays a grass plain out to the horizon.
opts = { Margin = 40, SkipSide = "N" (water side, +Z), GroundY = -0.5 } ]]
function MapKit:Mountains(halfX: number, halfZ: number, opts)
	opts = opts or {}
	local rng = self.Rng
	local margin = opts.Margin or 40
	local gy = opts.GroundY or -0.5
	local ext = 650
	local inX, inZ = halfX + 12, halfZ + 12
	-- grass plains from just outside the map to the horizon
	local plains = {
		S = { CFrame.new(0, gy - 4, -inZ - ext / 2), Vector3.new((inX + ext) * 2, 8, ext) },
		N = { CFrame.new(0, gy - 4, inZ + ext / 2), Vector3.new((inX + ext) * 2, 8, ext) },
		W = { CFrame.new(-inX - ext / 2, gy - 4, 0), Vector3.new(ext, 8, inZ * 2) },
		E = { CFrame.new(inX + ext / 2, gy - 4, 0), Vector3.new(ext, 8, inZ * 2) },
	}
	for side, pl in plains do
		if side ~= opts.SkipSide then
			self:Fill(M.Grass, pl[1], pl[2])
		end
	end
	-- two rows of peaks per side; snow caps on the tall ones
	local function peak(center: Vector3, r: number)
		self:FillBall(M.Rock, center, r)
		self:FillBall(M.Grass, center + Vector3.new(0, -r * 0.22, 0), r * 1.0) -- green lower slopes, rocky peaks
		if r > 95 then
			self:FillBall(M.Snow, center + Vector3.new(0, r * 0.62, 0), r * 0.32)
		end
	end
	local sides = {
		{ "S", Vector3.new(1, 0, 0), Vector3.new(0, 0, -1), halfX, halfZ },
		{ "N", Vector3.new(1, 0, 0), Vector3.new(0, 0, 1), halfX, halfZ },
		{ "W", Vector3.new(0, 0, 1), Vector3.new(-1, 0, 0), halfZ, halfX },
		{ "E", Vector3.new(0, 0, 1), Vector3.new(1, 0, 0), halfZ, halfX },
	}
	for _, sd in sides do
		if sd[1] ~= opts.SkipSide then
			local along, out, len, edge = sd[2], sd[3], sd[4], sd[5]
			for row = 1, 2 do
				local spacing = row == 1 and 80 or 120
				for d = -len - 120, len + 120, spacing do
					local r = row == 1 and rng:NextNumber(60, 95) or rng:NextNumber(95, 140)
					local dist = edge + margin + r * 0.95 + (row - 1) * 70
					local center = along * (d + rng:NextNumber(-20, 20)) + out * dist + Vector3.new(0, -r * 0.35, 0)
					peak(center, r)
				end
			end
		end
	end
end

-- COVER -------------------------------------------------------------------------------
-- Height of the terrain under (x, z); 0 when there's nothing to hit (or outside Roblox).
function MapKit:GroundY(x: number, z: number): (number, boolean)
	-- raised surfaces (sidewalk blocks) built by this kit
	local best = nil
	for _, r in self.Surfaces or {} do
		if x >= r[1] and x <= r[2] and z >= r[3] and z <= r[4] then
			best = math.max(best or -math.huge, r[5])
		end
	end
	if best then
		return best, false
	end
	local ok, result = pcall(function()
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = { workspace.Terrain }
		return workspace:Raycast(Vector3.new(x, 60, z), Vector3.new(0, -90, 0), params)
	end)
	if ok and result then
		return result.Position.Y, result.Material == Enum.Material.Water
	end
	return 0, false
end

-- Decorative ground cover: grass tufts, wildflowers, ferns, stumps and mushrooms.
-- Nothing here collides or blocks bullets; it just makes the ground feel alive.
function MapKit:Scatter(x0: number, x1: number, z0: number, z1: number, count: number, avoid)
	local rng = self.Rng
	local grass = { rgb(76, 140, 60), rgb(96, 158, 66), rgb(60, 118, 52) }
	local petals = { rgb(250, 240, 120), rgb(255, 255, 255), rgb(200, 120, 255), rgb(255, 120, 150), rgb(120, 170, 255) }
	local placed = 0
	for _ = 1, count * 3 do
		if placed >= count then
			break
		end
		local x, z = rng:NextNumber(x0, x1), rng:NextNumber(z0, z1)
		local blocked = avoid and avoid(x, z)
		local y, water = self:GroundY(x, z)
		if not blocked and not water then
			placed += 1
			local base = CFrame.new(x, y, z) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0)
			local roll = rng:NextNumber()
			if roll < 0.5 then
				for k = 1, 4 do
					local blade = self:Deco(Vector3.new(0.15, rng:NextNumber(0.9, 1.6), 0.5), base * CFrame.new(rng:NextNumber(-0.5, 0.5), 0.5, rng:NextNumber(-0.5, 0.5)) * CFrame.Angles(rng:NextNumber(-0.35, 0.35), k, rng:NextNumber(-0.35, 0.35)), grass[rng:NextInteger(1, 3)], M.Grass)
					blade.CastShadow = false
				end
			elseif roll < 0.75 then
				local col = petals[rng:NextInteger(1, #petals)]
				for _ = 1, 3 do
					local off = Vector3.new(rng:NextNumber(-0.8, 0.8), 0, rng:NextNumber(-0.8, 0.8))
					local h = rng:NextNumber(0.8, 1.4)
					self:Deco(Vector3.new(0.08, h, 0.08), base * CFrame.new(off + Vector3.new(0, h / 2, 0)), rgb(70, 120, 50), M.Grass).CastShadow = false
					local bloom = self:Ball(0.42, (base * CFrame.new(off + Vector3.new(0, h, 0))).Position, col, M.SmoothPlastic, self.Props)
					bloom.CanCollide, bloom.CanQuery, bloom.CastShadow = false, false, false
				end
			elseif roll < 0.9 then
				for k = 1, 6 do
					local frond = self:Deco(Vector3.new(0.6, 0.08, 2.2), base * CFrame.Angles(0, k * 1.05, 0) * CFrame.new(0, 0.55, -1) * CFrame.Angles(math.rad(25), 0, 0), rgb(56, 120, 50), M.LeafyGrass)
					frond.CastShadow = false
				end
			elseif roll < 0.96 then
				local stump = self:Cylinder(1.2, 1.8, base * CFrame.new(0, 0.6, 0) * CFrame.Angles(0, 0, math.rad(90)), P.Trunk, M.Wood, self.Props)
				stump.CanQuery = false
				self:Deco(Vector3.new(0.05, 1.7, 1.7), base * CFrame.new(0, 1.21, 0) * CFrame.Angles(0, 0, math.rad(90)), P.WoodLight, M.Wood).Shape = Enum.PartType.Cylinder
			else
				for k = 1, 3 do
					local m0 = base * CFrame.new(k * 0.5 - 1, 0, rng:NextNumber(-0.4, 0.4))
					self:Deco(Vector3.new(0.15, 0.4, 0.15), m0 * CFrame.new(0, 0.2, 0), rgb(235, 225, 205), M.SmoothPlastic).CastShadow = false
					local cap = self:Ball(0.5, (m0 * CFrame.new(0, 0.42, 0)).Position, rgb(200, 60, 40), M.SmoothPlastic, self.Props)
					cap.CanCollide, cap.CanQuery, cap.CastShadow = false, false, false
					cap.Size = Vector3.new(0.5, 0.3, 0.5)
				end
			end
		end
	end
end

function MapKit:Barrel(pos: Vector3, color: Color3?, tipped: boolean?)
	local c = color or rgb(40, 90, 160)
	local cf = tipped and (CFrame.new(pos + Vector3.new(0, 1.3, 0)) * CFrame.Angles(0, self.Rng:NextNumber(0, 3), 0)) or (CFrame.new(pos + Vector3.new(0, 1.9, 0)) * CFrame.Angles(0, 0, math.rad(90)))
	local b = self:Cylinder(3.8, 2.6, cf, c, M.Metal)
	b.Name = "Barrel"
	for _, off in { -1.1, 1.1 } do
		self:Deco(Vector3.new(0.25, 2.72, 2.72), cf * CFrame.new(off, 0, 0), c:Lerp(Color3.new(), 0.35), M.Metal).Shape = Enum.PartType.Cylinder
	end
	return b
end

function MapKit:Pallet(cf: CFrame, height: number?)
	for layer = 0, (height or 1) - 1 do
		local y = layer * 0.7
		for i = -1, 1 do
			self:Part(Vector3.new(4.6, 0.35, 0.6), cf * CFrame.new(0, y + 0.18, i * 1.8), P.WoodLight, M.WoodPlanks)
		end
		for i = -2, 2 do
			self:Deco(Vector3.new(0.8, 0.12, 4.4), cf * CFrame.new(i * 1.05, y + 0.42, 0), P.WoodLight:Lerp(P.Wood, 0.3), M.WoodPlanks)
		end
	end
end

-- Burnt-out car shell: solid, waist-high-plus cover.
function MapKit:Wreck(cf: CFrame, color: Color3?)
	local body = (color or rgb(90, 70, 60)):Lerp(rgb(40, 34, 30), 0.45)
	local model = Instance.new("Model")
	model.Name = "Wreck"
	model.Parent = self.Geo
	self:Part(Vector3.new(6.2, 2.2, 13), cf * CFrame.new(0, 1.9, 0), body, M.CorrodedMetal, model)
	-- rounded bumpers
	for _, z in { -6.5, 6.5 } do
		self:Cylinder(6.2, 1.6, cf * CFrame.new(0, 1.6, z), body:Lerp(Color3.new(), 0.2), M.CorrodedMetal, model)
	end
	-- crushed cabin with broken-out windows
	self:Part(Vector3.new(5.6, 1.6, 6), cf * CFrame.new(0, 3.75, 0.6) * CFrame.Angles(math.rad(4), 0, math.rad(3)), body, M.CorrodedMetal, model)
	self:Deco(Vector3.new(5.7, 0.9, 6.1), cf * CFrame.new(0, 3.8, 0.6) * CFrame.Angles(math.rad(4), 0, math.rad(3)), rgb(20, 20, 22), M.SmoothPlastic, model)
	for _, x in { -2.9, 2.9 } do
		for _, z in { -4.2, 4.2 } do
			local w = self:Cylinder(1.1, 2.4, cf * CFrame.new(x, 1.0, z), rgb(28, 28, 30), M.Slate, model)
			w.CanQuery = false
		end
	end
	local smoke = self:Deco(Vector3.new(1, 1, 1), cf * CFrame.new(0, 4.6, -3), body, M.CorrodedMetal, model)
	smoke.Transparency = 1
	local pe = Instance.new("Smoke")
	pe.Color = rgb(60, 60, 60)
	pe.Opacity = 0.08
	pe.RiseVelocity = 3
	pe.Size = 4
	pe.Parent = smoke
	return model
end

function MapKit:LogPile(cf: CFrame)
	for row = 0, 2 do
		for i = 0, 2 - row do
			local log = self:Cylinder(9, 1.5, cf * CFrame.new(0, 0.75 + row * 1.25, (i - (2 - row) / 2) * 1.55) * CFrame.Angles(0, self.Rng:NextNumber(-0.05, 0.05), 0), P.Trunk:Lerp(P.WoodLight, self.Rng:NextNumber(0, 0.3)), M.Wood)
			log.Name = "Log"
		end
	end
end

function MapKit:FallenTree(cf: CFrame)
	local trunk = self:Cylinder(16, 2, cf * CFrame.new(0, 1, 0) * CFrame.Angles(0, 0, math.rad(4)), P.Trunk, M.Wood)
	trunk.Name = "FallenTree"
	self:Cylinder(2.2, 2.6, cf * CFrame.new(-8, 1.3, 0), P.Trunk:Lerp(Color3.new(), 0.2), M.Wood) -- root end
	for i = 1, 3 do
		local leaf = self:Ball(self.Rng:NextNumber(4, 6), (cf * CFrame.new(6 + i, 1.8, self.Rng:NextNumber(-1.5, 1.5))).Position, P.LeafDark, M.LeafyGrass)
		leaf.CanCollide = false
	end
end

-- Low concrete wall chunk with exposed rebar (broken edge).
function MapKit:BrokenWall(cf: CFrame, length: number, color: Color3?)
	local c = color or P.ConcreteDark
	self:Part(Vector3.new(length, 4.6, 1.4), cf * CFrame.new(0, 2.3, 0), c, M.Concrete)
	self:Part(Vector3.new(length * 0.35, 1.6, 1.4), cf * CFrame.new(length * 0.2, 5.4, 0) * CFrame.Angles(0, 0, math.rad(-6)), c, M.Concrete)
	for i = 0, 2 do
		self:Deco(Vector3.new(0.15, 1.6, 0.15), cf * CFrame.new(-length / 2 + 0.4 + i * 0.5, 5.2, 0) * CFrame.Angles(0, 0, math.rad(-12 + i * 10)), rgb(90, 60, 45), M.CorrodedMetal)
	end
	for _ = 1, 3 do
		local rubble = self:Part(Vector3.one * self.Rng:NextNumber(0.8, 1.6), cf * CFrame.new(self.Rng:NextNumber(-length / 2, length / 2), 0.4, self.Rng:NextNumber(1.2, 2.6)) * CFrame.Angles(self.Rng:NextNumber(0, 3), self.Rng:NextNumber(0, 3), 0), c, M.Concrete)
		rubble.CanQuery = false
	end
end

local COVER_STYLES = {
	City = { "BarrierL", "Wreck", "Crates", "Sandbags", "Planter", "BrokenWall" },
	Harbor = { "Crates", "Barrels", "Pallets", "Sandbags", "BarrierL", "Wreck" },
	Forest = { "Logs", "Rocks", "FallenTree", "Sandbags", "Crates" },
	Arena = { "NeonWall", "NeonPillar", "NeonCrates" },
}

-- One cover cluster at `pos` (a little set piece you can hide behind / peek around).
function MapKit:CoverCluster(pos: Vector3, theme: string, style: string?)
	local rng = self.Rng
	local styles = COVER_STYLES[theme] or COVER_STYLES.City
	style = style or styles[rng:NextInteger(1, #styles)]
	local groundY = self:GroundY(pos.X, pos.Z)
	local y = math.max(pos.Y, groundY)
	local base = CFrame.new(pos.X, y, pos.Z) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
	if style == "BarrierL" then
		self:Barrier(base * CFrame.new(-2, 0, 0))
		self:Barrier(base * CFrame.new(3.4, 0, 4.4) * CFrame.Angles(0, math.rad(90), 0))
		self:Cone((base * CFrame.new(-7.5, 0, 2)).Position)
	elseif style == "Wreck" then
		self:Wreck(base * CFrame.Angles(0, 0, math.rad(rng:NextNumber(-3, 3))))
	elseif style == "Crates" then
		self:Crate((base * CFrame.new(0, 0, 0)).Position, 5, rng:NextNumber(0, 0.3))
		self:Crate((base * CFrame.new(5.2, 0, 0.4)).Position, 4.5, rng:NextNumber(0, 0.3))
		self:Crate((base * CFrame.new(2.4, 5, 0.2)).Position, 4, rng:NextNumber(0, 0.6))
		self:Pallet(base * CFrame.new(-5, 0, 3), 2)
	elseif style == "Sandbags" then
		self:Sandbags(base, 10, 3)
		self:Sandbags(base * CFrame.new(5.6, 0, 3.6) * CFrame.Angles(0, math.rad(-60), 0), 6, 3)
		self:Sandbags(base * CFrame.new(-5.6, 0, 3.6) * CFrame.Angles(0, math.rad(60), 0), 6, 3)
	elseif style == "Planter" then
		local planter = self:Part(Vector3.new(12, 3.2, 4), base * CFrame.new(0, 1.6, 0), P.Concrete, M.Concrete)
		planter.Name = "BigPlanter"
		self:Deco(Vector3.new(11.4, 0.4, 3.4), base * CFrame.new(0, 3.1, 0), rgb(70, 50, 36), M.Ground)
		for i = -1, 1 do
			local b = self:Ball(3.4, (base * CFrame.new(i * 3.6, 4.2, 0)).Position, P.LeafDark, M.LeafyGrass)
			b.CanCollide = false
		end
		self:Bench(base * CFrame.new(0, 0, 4.2) * CFrame.Angles(0, math.rad(180), 0))
	elseif style == "BrokenWall" then
		self:BrokenWall(base, 11)
	elseif style == "Barrels" then
		local colors = { rgb(40, 90, 160), rgb(200, 70, 40), rgb(230, 170, 30), rgb(60, 120, 70) }
		for i = 0, 3 do
			self:Barrel((base * CFrame.new((i % 2) * 2.9 - 1.4, 0, math.floor(i / 2) * 2.9 - 1.4)).Position, colors[rng:NextInteger(1, 4)])
		end
		self:Barrel((base * CFrame.new(4.6, 0, 1)).Position, colors[rng:NextInteger(1, 4)], true)
		self:Pallet(base * CFrame.new(-4.8, 0, 0), 3)
	elseif style == "Pallets" then
		self:Pallet(base, 5)
		self:Pallet(base * CFrame.new(5.2, 0, 0.6) * CFrame.Angles(0, 0.2, 0), 3)
		self:Crate((base * CFrame.new(-4.6, 0, 1)).Position, 4)
	elseif style == "Logs" then
		self:LogPile(base)
		self:Rock((base * CFrame.new(6, 0, 3)).Position, 0.8)
	elseif style == "Rocks" then
		self:Rock(base.Position, 1.6)
		self:Rock((base * CFrame.new(5, 0, 2)).Position, 1.1)
		self:Bush((base * CFrame.new(-4, 0, 3)).Position, 1)
	elseif style == "FallenTree" then
		self:FallenTree(base)
	elseif style == "NeonWall" or style == "NeonPillar" or style == "NeonCrates" then
		local trim = rng:NextNumber() < 0.5 and P.NeonWarm or P.Neon
		if style == "NeonWall" then
			self:Part(Vector3.new(12, 4.5, 1.5), base * CFrame.new(0, 2.25, 0), P.MetalDark, M.Metal)
			self:Neon(Vector3.new(12.1, 0.25, 1.6), base * CFrame.new(0, 4.5, 0), trim)
			self:Part(Vector3.new(1.5, 4.5, 6), base * CFrame.new(6.75, 2.25, 2.25), P.MetalDark, M.Metal)
			self:Neon(Vector3.new(1.6, 0.25, 6.1), base * CFrame.new(6.75, 4.5, 2.25), trim)
		elseif style == "NeonPillar" then
			self:Pillar(base.Position, 10, 4, P.Metal, M.Metal)
			self:Neon(Vector3.new(0.3, 4.1, 4.1), CFrame.new(base.Position + Vector3.new(0, 10, 0)) * CFrame.Angles(0, 0, math.rad(90)), trim).Shape = Enum.PartType.Cylinder
			self:Part(Vector3.new(8, 3, 1.4), base * CFrame.new(0, 1.5, 3.2), P.MetalDark, M.Metal)
		else
			for i, off in { Vector3.new(0, 0, 0), Vector3.new(4.6, 0, 0.5), Vector3.new(2.2, 4, 0.2) } do
				local sz = i == 3 and 3.6 or 4.4
				local cf = base * CFrame.new(off + Vector3.new(0, sz / 2, 0))
				self:Part(Vector3.one * sz, cf, P.Metal, M.DiamondPlate)
				self:Neon(Vector3.new(sz + 0.05, 0.2, sz + 0.05), cf * CFrame.new(0, sz / 2 - 0.4, 0), trim)
			end
		end
	end
end

-- Scatter cover clusters over a list of { x, z } open spots.
function MapKit:CoverField(spots, theme: string)
	for _, p in spots do
		self:CoverCluster(Vector3.new(p[1], 0, p[2]), theme)
	end
end

-- Roadside cover along a straight road: alternating clusters near the curbs that
-- leave the driving lanes open.
function MapKit:RoadCover(axis: string, center: number, from: number, to: number, step: number, curb: number, _theme: string, skip)
	local side = 1
	for a = from, to, step do
		local blocked = false
		for _, s in skip or {} do
			if math.abs(a - s) < 16 then
				blocked = true
			end
		end
		if not blocked then
			local pos = axis == "X" and Vector3.new(a, 0, center + side * curb) or Vector3.new(center + side * curb, 0, a)
			local rot = axis == "X" and 0 or 90
			local cf = CFrame.new(pos) * CFrame.Angles(0, math.rad(rot + self.Rng:NextNumber(-12, 12)), 0)
			local roll = self.Rng:NextNumber()
			if roll < 0.4 then
				self:Wreck(cf * CFrame.Angles(0, math.rad(90), 0))
			elseif roll < 0.75 then
				self:Barrier(cf)
				self:Barrier(cf * CFrame.new(8.2, 0, 0.6) * CFrame.Angles(0, math.rad(14), 0))
			else
				self:Sandbags(cf, 8, 3)
			end
			side = -side
		end
	end
end

return MapKit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Timberline</string>
            <string name="Source"><![CDATA[-- TIMBERLINE: forest valley with a river, bridges, cabins, watchtowers and jeeps.
local MapKit = require(script.Parent.MapKit)
local M = Enum.Material
local P = MapKit.Palette
local rgb = Color3.fromRGB

local Map = {
	Id = "Timberline",
	Name = "TIMBERLINE",
	Desc = "Forest valley split by a river. Snipe from the towers.",
	Icon = "🌲",
	Lighting = {
		ClockTime = 16.4, Brightness = 2.6,
		Ambient = rgb(80, 90, 80), OutdoorAmbient = rgb(130, 140, 130),
		Atmosphere = { Density = 0.35, Haze = 1.4, Color = rgb(200, 225, 210), Decay = rgb(90, 120, 110) },
		Tint = rgb(245, 255, 240), Saturation = 0.2, Contrast = 0.2, SunRays = 0.22, WaterColor = rgb(30, 100, 95),
	},
}

local HALF = 160

local function riverX(z: number): number
	return 38 * math.sin(z / 70)
end

function Map.Build()
	local kit = MapKit.new(21)
	local rng = kit.Rng

	-- ground + hills
	kit:Fill(M.Grass, CFrame.new(0, -8, 0), Vector3.new(HALF * 2 + 60, 16, HALF * 2 + 60))
	local avoid = {} -- circles {x, z, r} kept flat & free of trees

	local structures = {
		{ "Cabin", -100, -60 }, { "Cabin", -128, 60 }, { "Cabin", 98, -62 }, { "Cabin", 128, 58 },
		{ "Tower", -60, 105 }, { "Tower", 42, -60 }, { "Tower", 140, -8 },
		{ "Camp", -80, -12 }, { "Lumber", 75, -108 },
	}
	for _, s in structures do
		table.insert(avoid, { s[2], s[3], s[1] == "Lumber" and 30 or 24 })
	end
	-- keep tunnel entrances and both spawn bases clear
	for _, tx in { -112, 112 } do
		for _, tz in { -108, -20, 20, 108 } do
			table.insert(avoid, { tx, tz, 16 })
		end
	end
	table.insert(avoid, { -90, -135, 40 })
	table.insert(avoid, { 90, 135, 40 })

	local function blocked(x: number, z: number, pad: number): boolean
		if math.abs(x - riverX(z)) < 24 + pad then
			return true
		end
		if math.abs(z) < 12 + pad then
			return true -- road
		end
		for _, a in avoid do
			if (Vector3.new(x - a[1], 0, z - a[2])).Magnitude < a[3] + pad then
				return true
			end
		end
		return false
	end

	for _ = 1, 14 do
		local x, z = rng:NextNumber(-170, 170), rng:NextNumber(-170, 170)
		local r = rng:NextNumber(22, 38)
		if not blocked(x, z, r * 0.6) then
			kit:FillBall(M.Grass, Vector3.new(x, -r * 0.78, z), r)
			table.insert(avoid, { x, z, r * 0.7 })
		end
	end
	-- mountains around the edge form a natural wall
	for i = 0, 35 do
		local a = i / 36 * math.pi * 2
		local r = rng:NextNumber(45, 60)
		local d = HALF + 45
		kit:FillBall(i % 3 == 0 and M.Rock or M.Grass, Vector3.new(math.cos(a) * d, -10, math.sin(a) * d), r)
	end

	-- river
	for z = -HALF - 30, HALF + 30, 8 do
		local x = riverX(z)
		kit:Fill(M.Sand, CFrame.new(x, -1.5, z), Vector3.new(40, 3, 10))
		kit:Fill(M.Mud, CFrame.new(x, -8, z), Vector3.new(30, 2, 10))
		kit:Fill(M.Air, CFrame.new(x, -3.5, z), Vector3.new(30, 7, 10))
		kit:Water(CFrame.new(x, -4, z), Vector3.new(28, 6, 10))
	end

	-- dirt road east-west with a bridge
	kit:Fill(M.Ground, CFrame.new(0, -1, 0), Vector3.new(HALF * 2 + 40, 2.4, 16))
	local bx = riverX(0)
	kit:Part(Vector3.new(44, 1, 16), CFrame.new(bx, 1.2, 0), P.WoodLight, M.WoodPlanks)
	kit:Ramp(Vector3.new(bx - 34, 0, 0), Vector3.new(bx - 22, 1.7, 0), 16, P.WoodLight, M.WoodPlanks)
	kit:Ramp(Vector3.new(bx + 34, 0, 0), Vector3.new(bx + 22, 1.7, 0), 16, P.WoodLight, M.WoodPlanks)
	for _, side in { -1, 1 } do
		kit:Part(Vector3.new(44, 3, 0.6), CFrame.new(bx, 3.2, side * 7.7), P.WoodDark, M.Wood)
		for x = -20, 20, 10 do
			kit:Pillar(Vector3.new(bx + x, -8, side * 7.5), 9.2, 1.4, P.WoodDark, M.Wood)
		end
	end
	-- footbridges
	for _, z in { -110, 110 } do
		local x = riverX(z)
		kit:Part(Vector3.new(40, 0.8, 6), CFrame.new(x, 1, z), P.Wood, M.WoodPlanks)
		for _, side in { -1, 1 } do
			kit:Part(Vector3.new(40, 2.5, 0.4), CFrame.new(x, 2.6, z + side * 2.9), P.WoodDark, M.Wood)
		end
	end

	-- cabins, watchtowers, camp, lumber yard
	for _, s in structures do
		local kind, x, z = s[1], s[2], s[3]
		if kind == "Cabin" then
			kit:Fill(M.Ground, CFrame.new(x, -0.6, z), Vector3.new(30, 1.2, 26))
			local cabinCf = CFrame.new(x, 0, z) * CFrame.Angles(0, math.rad(rng:NextInteger(0, 3) * 90), 0)
			kit:Building({
				Name = "Cabin", Origin = cabinCf,
				W = 24, D = 18, Floors = 1, FloorH = 11, Color = P.Wood, Material = M.WoodPlanks, Trim = P.WoodDark,
				Floor = P.WoodLight, Roof = "Gable", RoofColor = rgb(70, 50, 40), RoofAccess = false,
				Doors = { Front = true, Back = true }, Awning = P.WoodDark, OpenWindows = 0.6, Pilasters = false, AC = false,
			})
			for _, side in { -1, 1 } do
				kit:Lantern(cabinCf * CFrame.new(4.2, 7.6, side * 9.7))
			end
			kit:HealthPack(Vector3.new(x + 15, 0, z))
			for i = 1, 3 do
				kit:Cylinder(4, 1.4, CFrame.new(x - 15, 0.7 + (i - 1) * 1.2, z - 4 + i * 1.5) * CFrame.Angles(0, math.rad(90), 0), P.Trunk, M.Wood)
			end
		elseif kind == "Tower" then
			kit:Watchtower(Vector3.new(x, 0, z), 24)
		elseif kind == "Camp" then
			kit:Campfire(Vector3.new(x, 0, z))
			for i = 1, 3 do
				local a = i / 3 * math.pi * 2
				kit:Tent(CFrame.new(x + math.cos(a) * 12, 0, z + math.sin(a) * 12) * CFrame.Angles(0, -a, 0), ({ rgb(60, 110, 70), rgb(180, 90, 40), rgb(50, 80, 140) })[i])
				kit:Cylinder(5, 1.2, CFrame.new(x + math.cos(a + 1) * 5, 0.6, z + math.sin(a + 1) * 5) * CFrame.Angles(0, -a, 0), P.Trunk, M.Wood)
			end
		elseif kind == "Lumber" then
			kit:Fill(M.Ground, CFrame.new(x, -0.6, z), Vector3.new(50, 1.2, 44))
			-- open sawmill shed
			for _, px in { -14, 0, 14 } do
				for _, pz in { -9, 9 } do
					kit:Part(Vector3.new(1.2, 12, 1.2), CFrame.new(x + px, 6, z + pz), P.WoodDark, M.Wood)
				end
			end
			kit:Wedge(Vector3.new(32, 4, 10), CFrame.new(x, 14, z - 5), rgb(110, 110, 116), M.CorrodedMetal)
			kit:Wedge(Vector3.new(32, 4, 10), CFrame.new(x, 14, z + 5) * CFrame.Angles(0, math.rad(180), 0), rgb(110, 110, 116), M.CorrodedMetal)
			kit:Part(Vector3.new(20, 3, 3), CFrame.new(x, 1.5, z), P.MetalDark, M.Metal)
			-- log piles (good cover)
			for _, pile in { { -20, 18 }, { 18, 18 }, { -22, -18 } } do
				for row = 0, 2 do
					for i = 0, 3 - row do
						kit:Cylinder(14, 2, CFrame.new(x + pile[1], 1 + row * 1.8, z + pile[2] - 3 + i * 2 + row) * CFrame.Angles(0, 0, 0), P.Trunk, M.Wood)
					end
				end
			end
		end
	end

	-- forest
	local placed = 0
	for _ = 1, 600 do
		if placed >= 170 then
			break
		end
		local x, z = rng:NextNumber(-HALF + 10, HALF - 10), rng:NextNumber(-HALF + 10, HALF - 10)
		if not blocked(x, z, 4) then
			local pine = rng:NextNumber() < 0.6
			kit:Tree(Vector3.new(x, 0, z), rng:NextNumber(0.9, 1.6), pine and "Pine" or "Oak")
			placed += 1
		end
	end
	for _ = 1, 45 do
		local x, z = rng:NextNumber(-180, 180), rng:NextNumber(-180, 180)
		if not blocked(x, z, 1) then
			if rng:NextNumber() < 0.5 then
				kit:Bush(Vector3.new(x, 0, z), rng:NextNumber(0.8, 1.3))
			else
				kit:Rock(Vector3.new(x, 0, z), rng:NextNumber(0.8, 1.6))
			end
		end
	end
	-- reeds & rocks along the river
	for z = -180, 180, 24 do
		kit:Rock(Vector3.new(riverX(z) + (z % 48 == 0 and 17 or -17), -0.5, z), 0.9)
	end

	-- vehicles
	kit:VehicleSpot(CFrame.new(-150, 1, 5) * CFrame.Angles(0, math.rad(-90), 0), "Jeep", rgb(80, 100, 60))
	kit:VehicleSpot(CFrame.new(150, 1, -5) * CFrame.Angles(0, math.rad(90), 0), "Jeep", rgb(140, 120, 80))
	kit:VehicleSpot(CFrame.new(120, 1, 120) * CFrame.Angles(0, math.rad(180), 0), "Truck", rgb(160, 60, 40))
	kit:VehicleSpot(CFrame.new(-80, 1, -8) * CFrame.Angles(0, math.rad(-90), 0), "Jeep", rgb(60, 80, 100))

	-- MINE TUNNELS on both sides of the river (spawn to spawn)
	for _, tx in { -112, 112 } do
		kit:Tunnel({
			Axis = "Z", Cross = tx, From = -122, To = 122, Floor = -14, Width = 14, Height = 9, Style = "Mine", Terrain = true,
			Entrances = { { At = -118, Dir = 1 }, { At = -10, Dir = -1 }, { At = 10, Dir = 1 }, { At = 118, Dir = -1 } },
		})
	end

	-- cover: sandbags at both ends of every bridge, log walls, hiding bushes
	for _, z in { -110, 0, 110 } do
		local x = riverX(z)
		for _, side in { -1, 1 } do
			kit:Sandbags(CFrame.new(x + side * 26, 0, z + 9) * CFrame.Angles(0, math.rad(90), 0), 8, 3)
		end
	end
	for _ = 1, 10 do
		local x, z = rng:NextNumber(-140, 140), rng:NextNumber(-120, 120)
		if not blocked(x, z, 4) then
			for row = 0, 1 do
				kit:Cylinder(10, 1.6, CFrame.new(x, 0.8 + row * 1.5, z) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), P.Trunk, M.Wood)
			end
		end
	end
	for _ = 1, 40 do
		local x, z = rng:NextNumber(-145, 145), rng:NextNumber(-140, 140)
		if not blocked(x, z, 2) then
			kit:HideBush(Vector3.new(x, 0, z), rng:NextNumber(0.9, 1.2))
		end
	end
	kit:Ladder(Vector3.new(75 + 16.5, 0, -108), 16)

	-- TEAM SPAWNS at both ends (clear of the river)
	kit:SpawnBase(Vector3.new(-90, 0, -135), Vector3.new(-60, 0, 0), "A", 70)
	kit:SpawnBase(Vector3.new(90, 0, 135), Vector3.new(60, 0, 0), "B", 70)
	-- TRIPLE TEAM base (east) + FREE FOR ALL spawns spread through the forest
	kit:SpawnBase(Vector3.new(140, 0, -55), Vector3.new(0, 0, 0), "C", 55)
	local ffa = {}
	for i = 0, 15 do
		local a = i / 16 * math.pi * 2
		for _, r in { 105, 75, 130 } do
			local x, z = math.cos(a) * r, math.sin(a) * r
			if not blocked(x, z, 3) then
				table.insert(ffa, Vector3.new(x, 0, z))
				break
			end
		end
	end
	kit:FFASpawns(ffa, 30)
	-- MORE COVER: log piles, rocks, fallen trees and sandbag nests in the clearings
	kit:CoverField({ { 135, 27 }, { -87, -103 }, { -131, -25 }, { -71, -39 }, { -51, 87 }, { -129, 25 }, { -67, 123 }, { -115, 83 }, { 83, 111 }, { 59, -53 }, { -113, -85 }, { -97, -35 }, { 39, 21 }, { 71, -129 }, { 109, -85 }, { 5, -45 }, { -7, -141 }, { 73, -89 }, { 71, 19 }, { 103, 89 }, { 115, -43 }, { 45, -77 }, { -61, 19 } }, "Forest")
	-- ground cover everywhere that isn't river, road or a structure
	kit:Scatter(-HALF + 6, HALF - 6, -HALF + 6, HALF - 6, 520, function(x, z)
		return blocked(x, z, 0)
	end)
	kit:Mountains(HALF + 18, HALF + 18, { Margin = 95, GroundY = -0.5 })
	kit:Boundary(HALF, HALF, 260)
	return kit
end

return Map
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[-- Game passes + developer products (Robux store).
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Monetization = require(Shared.Monetization)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local AchievementService = require(script.Parent.AchievementService)

local MonetizationService = {}
MonetizationService.OnPassesChanged = nil :: ((Player) -> ())?

function MonetizationService.Has(player: Player, passKey: string): boolean
	return player:GetAttribute("Pass_" .. passKey) == true
end

function MonetizationService.RefreshPasses(player: Player)
	for passKey, pass in Monetization.GamePasses do
		local owned = false
		if Config.StudioGrantAllPasses and RunService:IsStudio() then
			owned = true
		elseif pass.Id and pass.Id > 0 then
			local ok, result = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
			owned = ok and result == true
		end
		player:SetAttribute("Pass_" .. passKey, owned)
	end
	if MonetizationService.OnPassesChanged then
		MonetizationService.OnPassesChanged(player)
	end
end

local function grantProduct(player: Player, productKey: string, product)
	local data = DataService.Get(player)
	if not data then
		return false
	end
	if product.Cash then
		DataService.AddCash(player, product.Cash, false, "PURCHASE")
	end
	if product.BoostMinutes then
		data.BoostUntil = math.max(os.time(), data.BoostUntil) + product.BoostMinutes * 60
		player:SetAttribute("BoostUntil", data.BoostUntil)
	end
	if product.Token then
		data.Tokens[product.Token] = (data.Tokens[product.Token] or 0) + 1
	end
	Remotes.Notify:FireClient(player, "Message", { Text = "PURCHASED: " .. string.upper(product.Name), Color = Config.Colors.Robux })
	AchievementService.Add(player, "RobuxPurchases", 1)
	DataService.Sync(player)
	return true
end

MarketplaceService.ProcessReceipt = function(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = DataService.Get(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- Never grant the same receipt twice
	for _, id in data.Receipts do
		if id == info.PurchaseId then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end
	local productKey, product = Monetization.FindProductById(info.ProductId)
	if not productKey then
		warn("[Monetization] Unknown product id " .. tostring(info.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok = pcall(grantProduct, player, productKey, product)
	if not ok then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(data.Receipts, info.PurchaseId)
	while #data.Receipts > 50 do
		table.remove(data.Receipts, 1)
	end
	DataService.Save(player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
	if not purchased then
		return
	end
	local passKey, pass = Monetization.FindPassById(passId)
	if not passKey then
		return
	end
	player:SetAttribute("Pass_" .. passKey, true)
	Remotes.Notify:FireClient(player, "Message", { Text = pass.Icon .. " " .. string.upper(pass.Name) .. " UNLOCKED!", Color = pass.Color })
	AchievementService.Add(player, "RobuxPurchases", 1)
	if passKey == "Railgun" then
		local data = DataService.Get(player)
		if data then
			data.Owned.Railgun = true
			DataService.Sync(player)
		end
	end
	if MonetizationService.OnPassesChanged then
		MonetizationService.OnPassesChanged(player)
	end
end)

return MonetizationService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">RoundService</string>
          <string name="Source"><![CDATA[-- Match loop: VOTE (map + mode) -> WARMUP -> LIVE MATCH -> RESULTS -> repeat.
-- State is replicated through attributes on ReplicatedStorage:
--   MatchState ("Voting" | "Intermission" | "Active" | "Results"), MatchEnd (server time),
--   Leader / LeaderScore.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)
local AchievementService = require(script.Parent.AchievementService)
local TeamService = require(script.Parent.TeamService)

local RoundService = {}
RoundService.State = "Intermission"
RoundService.FirstBlood = false
RoundService.ForcedWinner = nil
-- Injected by Main:
RoundService.GetHolders = function()
	return {}
end
RoundService.OnEntityDied = function(_entity) end
RoundService.RespawnAll = function() end
RoundService.Map = nil -- MapService (injected)

local function setState(state: string, duration: number)
	RoundService.State = state
	ReplicatedStorage:SetAttribute("MatchState", state)
	ReplicatedStorage:SetAttribute("MatchEnd", workspace:GetServerTimeNow() + duration)
end

local function timeLeft(): number
	return (ReplicatedStorage:GetAttribute("MatchEnd") or 0) - workspace:GetServerTimeNow()
end

function RoundService.IsCounting(): boolean
	return RoundService.State == "Active"
end

function RoundService.TakeFirstBlood(): boolean
	if RoundService.State == "Active" and not RoundService.FirstBlood then
		RoundService.FirstBlood = true
		return true
	end
	return false
end

function RoundService.OnDeath(entity)
	RoundService.OnEntityDied(entity)
end

local function killsToWin(): number
	return TeamService.ModeDef().KillsToWin
end

function RoundService.OnKill(killer)
	if RoundService.State ~= "Active" then
		return
	end
	if TeamService.IsTeamMode() then
		if killer.Team and TeamService.Score(killer.Team) >= killsToWin() then
			RoundService.EndMatch(killer)
		end
	elseif (killer.Holder:GetAttribute("Kills") or 0) >= killsToWin() then
		RoundService.EndMatch(killer)
	end
end

local function ranking()
	local list = {}
	for _, h in RoundService.GetHolders() do
		local holder = h.Holder
		table.insert(list, {
			Name = h.Name,
			IsBot = h.IsBot,
			Player = h.Player,
			VIP = holder:GetAttribute("Pass_VIP") == true,
			Team = holder:GetAttribute("Team"),
			Kills = holder:GetAttribute("Kills") or 0,
			Deaths = holder:GetAttribute("Deaths") or 0,
			Score = holder:GetAttribute("Score") or 0,
		})
	end
	table.sort(list, function(a, b)
		if a.Score ~= b.Score then
			return a.Score > b.Score
		end
		return a.Kills > b.Kills
	end)
	return list
end

function RoundService.EndMatch(winnerEntity)
	if RoundService.State ~= "Active" then
		return
	end
	RoundService.ForcedWinner = winnerEntity
	setState("Results", Config.ResultsLength)
	local mapId = ReplicatedStorage:GetAttribute("MapId") or "Arena"

	local list = ranking()
	if winnerEntity then
		for i, row in list do
			if row.Name == winnerEntity.Name then
				table.remove(list, i)
				table.insert(list, 1, row)
				break
			end
		end
	end

	local publicRows = {}
	for i, row in list do
		publicRows[i] = { Name = row.Name, IsBot = row.IsBot, VIP = row.VIP, Kills = row.Kills, Deaths = row.Deaths, Score = row.Score, Team = row.Team }
	end

	local teamMode = TeamService.IsTeamMode()
	local winnerTeam = nil
	if teamMode then
		winnerTeam = (winnerEntity and winnerEntity.Team) or TeamService.Leader()
	end
	local scores = {}
	for _, team in TeamService.TeamList() do
		scores[team] = TeamService.Score(team)
	end

	for place, row in list do
		local player = row.Player
		if player and player.Parent then
			AchievementService.Add(player, "Matches", 1)
			DataService.AddXP(player, Config.MatchPlayXP)
			local won = (teamMode and winnerTeam ~= nil and row.Team == winnerTeam) or (not teamMode and place == 1)
			if won then
				AchievementService.Add(player, "Wins", 1)
				AchievementService.Add(player, "Wins_" .. mapId, 1)
				DataService.AddCash(player, Config.WinCash, true, "VICTORY")
				DataService.AddXP(player, Config.WinXP)
			end
			if place <= 3 then
				AchievementService.Add(player, "Top3", 1)
				DataService.AddCash(player, Config.Top3Cash, true, "TOP 3")
			end
			Remotes.MatchResults:FireClient(player, {
				Rows = publicRows,
				Winner = list[1] and list[1].Name or "Nobody",
				Place = place,
				Mode = TeamService.Mode,
				WinnerTeam = winnerTeam,
				MyTeam = row.Team,
				Won = won,
				Scores = scores,
				Nuke = winnerEntity ~= nil and RoundService.NukeEnding == true,
				Cash = player:GetAttribute("MatchCash") or 0,
				XP = player:GetAttribute("MatchXP") or 0,
				Kills = row.Kills,
				Deaths = row.Deaths,
				Score = row.Score,
			})
			task.spawn(DataService.Save, player)
		end
	end
end

local function resetMatchStats()
	TeamService.ResetScores()
	for _, h in RoundService.GetHolders() do
		for _, attr in { "Kills", "Deaths", "Score", "Streak" } do
			h.Holder:SetAttribute(attr, 0)
		end
		if h.Player then
			h.Player:SetAttribute("MatchCash", 0)
			h.Player:SetAttribute("MatchXP", 0)
		end
	end
end

local function updateLeader()
	local list = ranking()
	local top = list[1]
	ReplicatedStorage:SetAttribute("Leader", top and top.Name or "")
	ReplicatedStorage:SetAttribute("LeaderScore", top and top.Kills or 0)
	ReplicatedStorage:SetAttribute("KillsToWin", killsToWin())
end

function RoundService.Start()
	local function runVote()
		if not RoundService.Map then
			return
		end
		RoundService.Map.StartVote()
		setState("Voting", Config.VoteLength)
		while timeLeft() > 0 do
			task.wait(0.25)
		end
		local nextMap, nextMode = RoundService.Map.EndVote()
		if nextMode and nextMode ~= TeamService.Mode then
			TeamService.SetMode(nextMode)
		end
		if nextMap ~= ReplicatedStorage:GetAttribute("MapId") then
			RoundService.Map.Load(nextMap)
		end
		updateLeader()
		RoundService.RespawnAll()
	end

	task.spawn(function()
		task.wait(1)
		runVote()
		while true do
			-- WARMUP (kills still earn XP, cash & achievements, but not match score)
			resetMatchStats()
			setState("Intermission", Config.IntermissionLength)
			while timeLeft() > 0 do
				task.wait(0.25)
			end

			-- LIVE MATCH
			resetMatchStats()
			RoundService.FirstBlood = false
			RoundService.ForcedWinner = nil
			RoundService.NukeEnding = false
			setState("Active", Config.MatchLength)
			local mode = TeamService.ModeDef()
			local goal = TeamService.IsTeamMode() and ("First team to " .. mode.KillsToWin .. " kills wins") or ("First to " .. mode.KillsToWin .. " kills wins")
			Remotes.Notify:FireAllClients("Announce", { Text = mode.Name, Sub = goal, Color = Config.Colors.Accent, Icon = "⚔️" })
			RoundService.RespawnAll()
			while RoundService.State == "Active" and timeLeft() > 0 do
				updateLeader()
				task.wait(0.25)
			end
			if RoundService.State == "Active" then
				RoundService.EndMatch(nil)
			end

			-- RESULTS, then everyone votes on the next map + mode
			while timeLeft() > 0 do
				task.wait(0.25)
			end
			runVote()
		end
	end)
end

return RoundService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">TeamService</string>
          <string name="Source"><![CDATA[-- Game modes + teams.
--   FFA  : everyone for themselves, spawns all over the map
--   TDM  : ALPHA vs BRAVO, spawns at opposite ends
--   TTDM : ALPHA vs BRAVO vs CHARLIE
-- Team of each fighter lives in entity.Team (nil in FFA) and is mirrored to the
-- "Team" attribute on the Player / bot holder / bot character for clients.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Teams = game:GetService("Teams")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local TeamService = {}
TeamService.Mode = Config.ModeOrder[1]
TeamService.Fighters = {} -- set of every entity (players and bots)

-- Roblox Team objects so overhead names get team colors
local teamObjects = {}
for _, id in { "A", "B", "C" } do
	local info = Config.Teams[id]
	local t = Teams:FindFirstChild(info.Name) or Instance.new("Team")
	t.Name = info.Name
	t.TeamColor = BrickColor.new(info.Brick)
	t.AutoAssignable = false
	t.Parent = Teams
	teamObjects[id] = t
end

function TeamService.ModeDef()
	return Config.Modes[TeamService.Mode]
end

function TeamService.TeamList()
	return TeamService.ModeDef().Teams
end

function TeamService.IsTeamMode(): boolean
	return #TeamService.TeamList() > 0
end

-- true when a and b should be able to hurt each other
function TeamService.Enemies(a, b): boolean
	if a == nil or b == nil then
		return true -- environment / unknown attacker
	end
	if a == b then
		return false
	end
	return a.Team == nil or a.Team ~= b.Team
end

local function apply(entity, team)
	entity.Team = team
	entity.Holder:SetAttribute("Team", team)
	if entity.Character then
		entity.Character:SetAttribute("Team", team)
	end
	local player = entity.Player
	if player then
		player:SetAttribute("Team", team)
		if team then
			player.Neutral = false
			player.Team = teamObjects[team]
		else
			player.Team = nil
			player.Neutral = true
		end
	end
end

function TeamService.Count(team: string): number
	local n = 0
	for entity in TeamService.Fighters do
		if entity.Team == team then
			n += 1
		end
	end
	return n
end

function TeamService.Smallest(): string?
	local best, bestCount = nil, math.huge
	for _, team in TeamService.TeamList() do
		local c = TeamService.Count(team)
		if c < bestCount then
			best, bestCount = team, c
		end
	end
	return best
end

function TeamService.Largest(): string?
	local best, bestCount = nil, -1
	for _, team in TeamService.TeamList() do
		local c = TeamService.Count(team)
		if c > bestCount then
			best, bestCount = team, c
		end
	end
	return best
end

function TeamService.Register(entity)
	TeamService.Fighters[entity] = true
	apply(entity, nil)
	apply(entity, TeamService.Smallest())
end

function TeamService.Unregister(entity)
	TeamService.Fighters[entity] = nil
end

-- Re-deal every fighter onto balanced teams (players first, then bots).
function TeamService.Rebalance()
	local players, bots = {}, {}
	for entity in TeamService.Fighters do
		apply(entity, nil)
		table.insert(entity.Player and players or bots, entity)
	end
	for _, list in { players, bots } do
		for i = #list, 2, -1 do
			local j = math.random(1, i)
			list[i], list[j] = list[j], list[i]
		end
		for _, entity in list do
			apply(entity, TeamService.Smallest())
		end
	end
end

function TeamService.SetMode(mode: string)
	if not Config.Modes[mode] then
		return
	end
	TeamService.Mode = mode
	ReplicatedStorage:SetAttribute("Mode", mode)
	TeamService.Rebalance()
	TeamService.ResetScores()
end

function TeamService.ResetScores()
	for _, id in { "A", "B", "C" } do
		ReplicatedStorage:SetAttribute("Score_" .. id, 0)
	end
end

function TeamService.AddScore(team: string?, amount: number)
	if team then
		ReplicatedStorage:SetAttribute("Score_" .. team, (ReplicatedStorage:GetAttribute("Score_" .. team) or 0) + amount)
	end
end

function TeamService.Score(team: string): number
	return ReplicatedStorage:GetAttribute("Score_" .. team) or 0
end

-- Winning team by score (nil on a draw or in FFA)
function TeamService.Leader(): string?
	local best, bestScore, tie = nil, -1, false
	for _, team in TeamService.TeamList() do
		local s = TeamService.Score(team)
		if s > bestScore then
			best, bestScore, tie = team, s, false
		elseif s == bestScore then
			tie = true
		end
	end
	return (not tie) and best or nil
end

Players.PlayerRemoving:Connect(function(player)
	for entity in TeamService.Fighters do
		if entity.Player == player then
			TeamService.Fighters[entity] = nil
		end
	end
end)

ReplicatedStorage:SetAttribute("Mode", TeamService.Mode)
TeamService.ResetScores()

return TeamService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">VehicleService</string>
          <string name="Source"><![CDATA[-- Cars: spawning per map, network ownership for the driver, roadkills,
-- shooting/blowing up cars, and respawning wrecks.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CarBuilder = require(Shared.CarBuilder)
local Remotes = require(Shared.Remotes)
local Combat = require(script.Parent.CombatService)
local AchievementService = require(script.Parent.AchievementService)
local TeamService = require(script.Parent.TeamService)

local VehicleService = {}
VehicleService.Cars = {} -- [Model] = record

local folder = Instance.new("Folder")
folder.Name = "Vehicles"
folder.Parent = workspace

local RESPAWN = 25
local generation = 0

local function occupants(car: Model)
	local list = {}
	for _, seat in car:GetChildren() do
		if (seat:IsA("Seat") or seat:IsA("VehicleSeat")) and seat.Occupant then
			local entity = Combat.Entities[seat.Occupant.Parent]
			if entity then
				table.insert(list, entity)
			end
		end
	end
	return list
end

local function driverEntity(car: Model)
	local seat = car:FindFirstChild("DriverSeat")
	local occ = seat and seat.Occupant
	return occ and Combat.Entities[occ.Parent] or nil
end

local spawnCar

local function explode(car: Model, attacker)
	local record = VehicleService.Cars[car]
	if not record or record.Dead then
		return
	end
	record.Dead = true
	local chassis = car.PrimaryPart
	local pos = chassis and chassis.Position or car:GetPivot().Position
	for _, entity in occupants(car) do
		Combat.Damage(attacker, entity, 9999, { Weapon = "Car", WeaponName = "CAR EXPLOSION", Kind = "Vehicle", Explosive = true, Position = pos })
	end
	Combat.AreaDamage(attacker, pos, 20, 110, { Weapon = "Car", WeaponName = "CAR EXPLOSION", Kind = "Vehicle", Explosive = true })
	if attacker and attacker.Player then
		AchievementService.Add(attacker.Player, "CarsDestroyed", 1)
		Remotes.Notify:FireClient(attacker.Player, "Medal", { Medals = { { Text = "VEHICLE DESTROYED", Bonus = 100 } } })
	end
	-- burnt wreck
	for _, p in car:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = true
			if p.Transparency < 1 then
				p.Color = p.Color:Lerp(Color3.fromRGB(25, 22, 20), 0.85)
				p.Material = Enum.Material.CorrodedMetal
			end
		elseif p:IsA("Light") then
			p.Enabled = false
		elseif p:IsA("ProximityPrompt") then
			p.Enabled = false
		end
	end
	if chassis then
		local fire = Instance.new("Fire")
		fire.Size = 9
		fire.Heat = 12
		fire.Parent = chassis
		local smoke = Instance.new("Smoke")
		smoke.Size = 6
		smoke.Opacity = 0.4
		smoke.RiseVelocity = 8
		smoke.Parent = chassis
	end
	local gen = generation
	task.delay(10, function()
		car:Destroy()
	end)
	task.delay(RESPAWN, function()
		if gen == generation and record.Spot.Parent then
			spawnCar(record.Spot)
		end
	end)
end

function VehicleService.DamageCar(car: Model, attacker, amount: number)
	local record = VehicleService.Cars[car]
	if not record or record.Dead then
		return
	end
	-- don't let drivers wreck their own ride
	if attacker and table.find(occupants(car), attacker) then
		return
	end
	local hp = (car:GetAttribute("Health") or 0) - amount
	car:SetAttribute("Health", hp)
	if attacker and attacker.Player then
		Remotes.HitConfirm:FireClient(attacker.Player, { Damage = amount, Headshot = false, Killed = hp <= 0, Position = car:GetPivot().Position + Vector3.new(0, 3, 0), Vehicle = true })
	end
	if hp <= 0 then
		explode(car, attacker)
	end
end

function VehicleService.CarFromPart(part: Instance?)
	local model = part and part:FindFirstAncestorOfClass("Model")
	while model and model.Parent ~= folder do
		model = model:FindFirstAncestorOfClass("Model")
	end
	return model
end

function VehicleService.AreaDamage(attacker, position: Vector3, radius: number, maxDamage: number)
	for car, record in VehicleService.Cars do
		if not record.Dead and car.PrimaryPart then
			local d = (car.PrimaryPart.Position - position).Magnitude
			if d <= radius + 4 then
				VehicleService.DamageCar(car, attacker, maxDamage * 2 * (1 - math.min(1, d / (radius + 4)) * 0.6))
			end
		end
	end
end

local function setupDriving(car: Model)
	local seat = car:FindFirstChild("DriverSeat") :: VehicleSeat
	local chassis = car.PrimaryPart
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Drive"
	prompt.ObjectText = car.Name
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = seat
	prompt.Triggered:Connect(function(player)
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum and hum.Health > 0 and not seat.Occupant then
			seat:Sit(hum)
		end
	end)
	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		local hum = seat.Occupant
		local player = hum and Players:GetPlayerFromCharacter(hum.Parent)
		prompt.Enabled = hum == nil
		if player then
			pcall(chassis.SetNetworkOwner, chassis, player)
			car:SetAttribute("Driver", player.Name)
			AchievementService.Add(player, "Drives", 1)
		else
			pcall(chassis.SetNetworkOwner, chassis, nil)
			car:SetAttribute("Driver", nil)
		end
	end)

	-- roadkill
	local lastHit = {}
	local function onTouched(hit: BasePart)
		local record = VehicleService.Cars[car]
		if not record or record.Dead then
			return
		end
		local speed = chassis.AssemblyLinearVelocity.Magnitude
		if speed < 28 then
			return
		end
		local model = hit:FindFirstAncestorOfClass("Model")
		local victim = model and Combat.Entities[model]
		if not victim or not Combat.IsAlive(victim) then
			return
		end
		if victim.Humanoid.SeatPart and victim.Humanoid.SeatPart:IsDescendantOf(car) then
			return
		end
		if os.clock() - (lastHit[victim] or 0) < 1 then
			return
		end
		local driver = driverEntity(car)
		if driver and not TeamService.Enemies(driver, victim) then
			return -- don't run over teammates
		end
		lastHit[victim] = os.clock()
		local killed = Combat.Damage(driver, victim, 60 + speed * 1.6, { Weapon = "Car", WeaponName = "ROADKILL", Kind = "Roadkill", Position = victim.Root.Position, Distance = 0 })
		if killed and driver and driver.Player then
			AchievementService.Add(driver.Player, "Roadkills", 1)
		end
	end
	for _, name in { "Body", "Chassis", "BumperF", "BumperR" } do
		local p = car:FindFirstChild(name)
		if p then
			p.Touched:Connect(onTouched)
		end
	end
end

spawnCar = function(spot: BasePart)
	local parked = spot:GetAttribute("Parked") == true
	local car = CarBuilder.Build(spot:GetAttribute("Style") or "Sedan", spot:GetAttribute("Color"), parked)
	car:PivotTo(spot.CFrame + Vector3.new(0, 0.3, 0))
	if parked then
		car:SetAttribute("Parked", true)
		local seat = car:FindFirstChild("DriverSeat")
		if seat then
			seat.Disabled = true
		end
		local p = car:FindFirstChild("PassengerSeat")
		if p then
			p.Disabled = true
		end
	end
	car.Parent = folder
	VehicleService.Cars[car] = { Spot = spot, Dead = false }
	car.AncestryChanged:Connect(function(_, parent)
		if not parent then
			VehicleService.Cars[car] = nil
		end
	end)
	if not parked then
		setupDriving(car)
	end
	return car
end

function VehicleService.OnMapLoaded(map: Instance)
	generation += 1
	folder:ClearAllChildren()
	VehicleService.Cars = {}
	local spots = map:FindFirstChild("VehicleSpots")
	if spots then
		for _, spot in spots:GetChildren() do
			spawnCar(spot)
		end
	end
end

-- Parked/unoccupied cars slow down instead of sliding forever
local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc += dt
	if acc < 0.1 then
		return
	end
	acc = 0
	for car, record in VehicleService.Cars do
		local chassis = car.PrimaryPart
		if chassis and not record.Dead and not chassis.Anchored and not car:GetAttribute("Driver") then
			local v = chassis.AssemblyLinearVelocity
			chassis.AssemblyLinearVelocity = Vector3.new(v.X * 0.7, v.Y, v.Z * 0.7)
			chassis.AssemblyAngularVelocity *= 0.7
		end
	end
end)

return VehicleService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="30">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterCharacterScripts" referent="31">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="Script" referent="32">
        <Properties>
          <string name="Name">Health</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Replaces Roblox's default Health regen script. Regen is handled by
-- CombatService so it can pause after taking damage.
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="33">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="34">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="35">
          <Properties>
            <string name="Name">ClientMain</string>
            <string name="Source"><![CDATA[-- Client entry point: builds the UI, starts the controllers and routes
-- server messages to the right place.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local TextChatService = game:GetService("TextChatService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.ClientState)
local UIKit = require(script.Parent.UIKit)
local Effects = require(script.Parent.Effects)
local HUD = require(script.Parent.HUD)
local Menus = require(script.Parent.Menus)
local VoteScreen = require(script.Parent.VoteScreen)
local OfferToast = require(script.Parent.OfferToast)
local PassSpotlight = require(script.Parent.PassSpotlight)
local Movement = require(script.Parent.MovementController)
local Weapons = require(script.Parent.WeaponController)
local Vehicle = require(script.Parent.VehicleController)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- hide default Roblox UI we replace
task.spawn(function()
	for _ = 1, 20 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
		end)
		if ok then
			break
		end
		task.wait(0.5)
	end
end)

-- UI + controllers --------------------------------------------------------------
HUD.Init(playerGui)
Menus.Init(playerGui)
VoteScreen.Init(playerGui)
OfferToast.Init(playerGui)
OfferToast.BuyPass = Menus.BuyPass
OfferToast.BuyProduct = Menus.BuyProduct
ClientState.OnDryFire = OfferToast.OnDryFire
PassSpotlight.Init(playerGui)
PassSpotlight.BuyPass = Menus.BuyPass
Weapons.HUD = HUD
Menus.Notify = HUD.Message
HUD.OpenMenu = function(name)
	if name == "Scoreboard" then
		Menus.ShowScoreboard(true)
		task.delay(4, function()
			Menus.ShowScoreboard(false)
		end)
	else
		Menus.Open(name)
	end
end
Movement.Init()
Weapons.Init()
Vehicle.Init()
ClientState.Changed.Event:Connect(function()
	Effects.ShakeScale = ClientState.Settings.Shake or 1
end)

Menus.OnDeploy = function()
	ClientState.Deployed = true
	HUD.SetVisible(true)
	Remotes.Deploy:FireServer()
end
Menus.ShowMain()

task.spawn(function()
	Remotes.GetData:InvokeServer()
end)

-- CHARACTER / CAMERA ----------------------------------------------------------------
local camera = workspace.CurrentCamera

local function onCharacter(char: Model)
	local humanoid = char:WaitForChild("Humanoid")
	ClientState.Dead = false
	HUD.HideDeath()
	camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Custom
	camera.CameraSubject = humanoid
	player.CameraMode = Enum.CameraMode.LockFirstPerson
	player.CameraMinZoomDistance = 0.5
	humanoid.Died:Connect(function()
		ClientState.Dead = true
		task.delay(1.5, OfferToast.OnDeath)
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMinZoomDistance = 8
		task.delay(0.1, function()
			player.CameraMinZoomDistance = 0.5
		end)
	end)
end
if player.Character then
	task.spawn(onCharacter, player.Character)
end
player.CharacterAdded:Connect(onCharacter)

-- Menu backdrop: slow orbit over the arena until you hit PLAY.
local orbit = 0
RunService.RenderStepped:Connect(function(dt)
	camera = workspace.CurrentCamera
	if not ClientState.Deployed then
		orbit += dt * 0.06
		camera.CameraType = Enum.CameraType.Scriptable
		local pos = Vector3.new(math.cos(orbit) * 140, 60, math.sin(orbit) * 140)
		camera.CFrame = CFrame.lookAt(pos, Vector3.new(0, 8, 0))
		camera.FieldOfView = 70
	end
	local freeMouse = ClientState.MenuOpen or ClientState.VoteOpen or ClientState.SpotlightOpen or ClientState.Dead or not ClientState.Deployed
	UserInputService.MouseIconEnabled = freeMouse
end)

-- SELF REVIVE (hold F while downed) ---------------------------------------------------
local Config = require(Shared.Config)
local holdingRevive = false
local holdStart = 0
local function startRevive()
	if player:GetAttribute("Downed") and not player:GetAttribute("SelfReviveUsed") then
		holdingRevive = true
		holdStart = os.clock()
	end
end
local function stopRevive()
	holdingRevive = false
	HUD.SelfReviveProgress = 0
end
RunService.RenderStepped:Connect(function()
	if not holdingRevive then
		return
	end
	if not player:GetAttribute("Downed") then
		stopRevive()
		return
	end
	local progress = (os.clock() - holdStart) / Config.SelfReviveTime
	HUD.SelfReviveProgress = progress
	if progress >= 1 then
		holdingRevive = false
		Remotes.SelfRevive:FireServer()
	end
end)
UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and (input.KeyCode == Enum.KeyCode.F or input.KeyCode == Enum.KeyCode.ButtonY) then
		startRevive()
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.F or input.KeyCode == Enum.KeyCode.ButtonY then
		stopRevive()
	end
end)
if UserInputService.TouchEnabled then
	local ContextActionService = game:GetService("ContextActionService")
	player:GetAttributeChangedSignal("Downed"):Connect(function()
		if player:GetAttribute("Downed") then
			ContextActionService:BindAction("NS_SelfRevive", function(_, state)
				if state == Enum.UserInputState.Begin then
					startRevive()
				elseif state == Enum.UserInputState.End then
					stopRevive()
				end
				return Enum.ContextActionResult.Sink
			end, true)
			ContextActionService:SetTitle("NS_SelfRevive", "REVIVE")
			ContextActionService:SetPosition("NS_SelfRevive", UDim2.new(1, -170, 1, -210))
		else
			ContextActionService:UnbindAction("NS_SelfRevive")
		end
	end)
end

-- HOTKEYS ---------------------------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	local k = input.KeyCode
	if k == Enum.KeyCode.B then
		Menus.Toggle("Armory")
	elseif k == Enum.KeyCode.N then
		Menus.Toggle("Store")
	elseif k == Enum.KeyCode.J then
		Menus.Toggle("Achievements")
	elseif k == Enum.KeyCode.P then
		Menus.Toggle("Settings")
	elseif k == Enum.KeyCode.Tab then
		Menus.ShowScoreboard(true)
	elseif k == Enum.KeyCode.ButtonSelect then
		Menus.ShowScoreboard(true)
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.Tab or input.KeyCode == Enum.KeyCode.ButtonSelect then
		Menus.ShowScoreboard(false)
	end
end)

-- SERVER MESSAGES ---------------------------------------------------------------------------
Remotes.Notify.OnClientEvent:Connect(function(kind, payload)
	if kind == "Kill" then
		HUD.Kill(payload)
	elseif kind == "Downed" then
		HUD.Announce({ Text = "KNOCKED DOWN", Sub = "by " .. tostring(payload.By), Color = Color3.fromRGB(255, 80, 60), Icon = "⬇" })
	elseif kind == "Revived" then
		HUD.Message(payload.By and ("REVIVED BY " .. string.upper(payload.By)) or "SELF-REVIVED", Color3.fromRGB(80, 230, 120))
		HUD.SelfReviveProgress = 0
	elseif kind == "KOStreak" then
		HUD.KOStreak()
		Effects.Shake(1.2)
	elseif kind == "Medal" then
		HUD.Medals(payload.Medals)
	elseif kind == "Achievement" then
		HUD.Achievement(payload)
	elseif kind == "LevelUp" then
		HUD.LevelUp(payload.Level, payload.Reward)
	elseif kind == "Cash" then
		HUD.Cash(payload.Amount, payload.Reason)
	elseif kind == "Announce" then
		HUD.Announce(payload)
	elseif kind == "Message" then
		HUD.Message(payload.Text, payload.Color)
		if payload.Upsell then
			OfferToast.OnCantAfford()
		end
	end
end)

Remotes.KillFeed.OnClientEvent:Connect(HUD.Feed)

Remotes.KillInfo.OnClientEvent:Connect(function(info)
	HUD.Death(info)
	-- killcam: watch the player who got you
	local killerChar = info.KillerCharacter
	local hum = killerChar and killerChar:FindFirstChildOfClass("Humanoid")
	if hum then
		task.delay(0.6, function()
			if ClientState.Dead then
				workspace.CurrentCamera.CameraSubject = hum
			end
		end)
	end
end)

Remotes.Damaged.OnClientEvent:Connect(function(from, amount)
	HUD.Damaged(from, amount)
	OfferToast.LastDamaged = os.clock()
	PassSpotlight.LastDamaged = os.clock()
	Effects.Shake(math.clamp(amount / 40, 0.2, 1.5))
	if amount >= 20 then
		UIKit.Sound("Hurt", 0.55 + math.random() * 0.1)
	end
end)

Remotes.Killstreak.OnClientEvent:Connect(function(kind, duration)
	if kind == "UAV" then
		Effects.UAV(duration)
		HUD.Status("📡 UAV ACTIVE", duration)
	elseif kind == "Overdrive" then
		HUD.Status("⚡ OVERDRIVE", duration)
	elseif kind == "InfiniteAmmo" then
		Weapons.RefillReserve()
	end
end)

Remotes.Effect.OnClientEvent:Connect(function(kind, a, b, c)
	if kind == "Shot" then
		Effects.RemoteShot(a, b, c)
	elseif kind == "Launch" then
		Effects.Launch(a, b)
	elseif kind == "Explosion" then
		Effects.Explosion(a, b)
	elseif kind == "Zap" then
		Effects.Zap(a, b, Color3.fromRGB(80, 255, 120))
	elseif kind == "Void" then
		Effects.Void(a, b)
	elseif kind == "Slam" then
		Effects.Shockwave(a, b)
	elseif kind == "Knife" then
		if a and a ~= player.Character and a:FindFirstChild("Head") then
			Effects.Sound3D("Knife", a.Head.Position)
		end
	elseif kind == "AirstrikeIncoming" then
		for _, pos in a do
			Effects.Sound3D("Empty", pos, 0.4)
		end
	elseif kind == "NukeIncoming" then
		HUD.Nuke(a, b)
	elseif kind == "NukeDetonate" then
		HUD.WhiteFlash()
		Effects.Shake(8)
	elseif kind == "RefillAmmo" then
		Weapons.RefillReserve()
	end
end)

Remotes.MatchResults.OnClientEvent:Connect(Menus.ShowResults)

-- VIP chat tag
pcall(function()
	TextChatService.OnIncomingMessage = function(message)
		local props = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		local p = source and Players:GetPlayerByUserId(source.UserId)
		if p and p:GetAttribute("Pass_VIP") then
			props.PrefixText = "<font color='#FFCD3C'>[👑 VIP]</font> " .. message.PrefixText
		end
		return props
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">ClientState</string>
            <string name="Source"><![CDATA[-- Shared client-side state that every controller / UI module can read.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local player = Players.LocalPlayer

local State = {
	Data = nil, -- synced profile (Owned, Loadout, Stats, Achievements, Daily...)
	MenuOpen = false, -- any full-screen menu is open (blocks shooting)
	VoteOpen = false, -- pre-match vote screen is up
	SpotlightOpen = false, -- featured pass card is up
	OnDryFire = nil, -- hook: called when the trigger is pulled on an empty mag
	Deployed = false, -- pressed PLAY
	Dead = false,
	Driving = false,
	Settings = { FOV = 72, Shake = 1, AdsSens = 0.7, Crosshair = "White" },
	Changed = Instance.new("BindableEvent"),
}

State.CrosshairColors = {
	White = Color3.new(1, 1, 1), Green = Color3.fromRGB(70, 255, 120), Cyan = Color3.fromRGB(0, 230, 255),
	Red = Color3.fromRGB(255, 70, 80), Yellow = Color3.fromRGB(255, 220, 40),
}

function State.HasPass(key: string): boolean
	return player:GetAttribute("Pass_" .. key) == true
end

-- Team of any character (players or bots); nil in free-for-all
function State.TeamOf(char: Instance?)
	if not char then
		return nil
	end
	local p = Players:GetPlayerFromCharacter(char)
	if p then
		return p:GetAttribute("Team")
	end
	return char:GetAttribute("Team")
end

-- true when this character is on my team (never in FFA)
function State.IsAlly(char: Instance?): boolean
	local mine = player:GetAttribute("Team")
	return mine ~= nil and char ~= player.Character and State.TeamOf(char) == mine
end

function State.Overdrive(): boolean
	return (player:GetAttribute("OverdriveUntil") or 0) > workspace:GetServerTimeNow()
end

Remotes.DataSync.OnClientEvent:Connect(function(data)
	State.Data = data
	if data.Settings then
		for k, v in data.Settings do
			State.Settings[k] = v
		end
	end
	State.Changed:Fire()
end)

player.AttributeChanged:Connect(function(name)
	if string.sub(name, 1, 5) == "Pass_" or name == "Level" or name == "Cash" then
		State.Changed:Fire()
	end
end)

return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[-- Client-side visual effects: tracers, muzzle flashes, explosions, shake, UAV.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Sounds = require(Shared.Sounds)
local Weapons = require(Shared.Weapons)
local Config = require(Shared.Config)

local player = Players.LocalPlayer
local Effects = {}
local uavUntil = 0
Effects.LastFired = setmetatable({}, { __mode = "k" }) -- [character] = os.clock() of their last shot (minimap)

local function folder()
	return workspace:FindFirstChild("Effects") or workspace
end

local function fxPart(size: Vector3, cf: CFrame, color: Color3, transparency: number?)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Size = size
	p.CFrame = cf
	p.Transparency = transparency or 0
	p.Parent = folder()
	return p
end

function Effects.Sound3D(name: string, position: Vector3, pitch: number?)
	local info = Sounds[name]
	if not info then
		return
	end
	local att = Instance.new("Attachment")
	att.WorldPosition = position
	att.Parent = workspace.Terrain
	local s = Instance.new("Sound")
	s.SoundId = info.Id
	s.Volume = info.Volume
	s.PlaybackSpeed = pitch or 1
	s.RollOffMaxDistance = 300
	s.Parent = att
	s:Play()
	Debris:AddItem(att, 3)
end

function Effects.Tracer(from: Vector3, to: Vector3, color: Color3?, width: number?)
	local dist = (to - from).Magnitude
	if dist < 0.5 then
		return
	end
	local w = width or 0.08
	local p = fxPart(Vector3.new(w, w, dist), CFrame.lookAt((from + to) / 2, to), color or Color3.fromRGB(255, 230, 150), 0.1)
	TweenService:Create(p, TweenInfo.new(0.12), { Transparency = 1, Size = Vector3.new(w * 0.2, w * 0.2, dist) }):Play()
	Debris:AddItem(p, 0.15)
end

function Effects.Impact(position: Vector3, color: Color3?)
	local p = fxPart(Vector3.new(0.4, 0.4, 0.4), CFrame.new(position), color or Color3.fromRGB(255, 220, 140), 0)
	TweenService:Create(p, TweenInfo.new(0.2), { Transparency = 1, Size = Vector3.new(1.1, 1.1, 1.1) }):Play()
	Debris:AddItem(p, 0.25)
end

function Effects.Flash(position: Vector3, color: Color3?)
	local p = fxPart(Vector3.new(0.5, 0.5, 0.5), CFrame.new(position), color or Color3.fromRGB(255, 200, 90), 0.2)
	p.Shape = Enum.PartType.Ball
	local light = Instance.new("PointLight")
	light.Color = color or Color3.fromRGB(255, 190, 90)
	light.Range = 10
	light.Brightness = 4
	light.Parent = p
	Debris:AddItem(p, 0.05)
end

-- CAMERA SHAKE -----------------------------------------------------------------
local shake = 0
Effects.ShakeScale = 1 -- from settings (0 = off)
function Effects.Shake(amount: number)
	shake = math.max(shake, amount * Effects.ShakeScale)
end

function Effects.StepShake(dt: number): CFrame
	if shake <= 0.001 then
		shake = 0
		return CFrame.identity
	end
	local s = shake
	shake = math.max(0, shake - dt * 3)
	local t = os.clock() * 40
	return CFrame.Angles(math.noise(t, 1) * s * 0.05, math.noise(t, 2) * s * 0.05, math.noise(t, 3) * s * 0.03)
end

local function shakeFrom(position: Vector3, strength: number, range: number)
	local cam = workspace.CurrentCamera
	local d = (cam.CFrame.Position - position).Magnitude
	if d < range then
		Effects.Shake(strength * (1 - d / range))
	end
end

function Effects.Explosion(position: Vector3, radius: number)
	local e = Instance.new("Explosion")
	e.Position = position
	e.BlastRadius = radius
	e.BlastPressure = 0
	e.DestroyJointRadiusPercent = 0
	e.Parent = workspace
	local ball = fxPart(Vector3.one * 2, CFrame.new(position), Color3.fromRGB(255, 150, 50), 0.1)
	ball.Shape = Enum.PartType.Ball
	TweenService:Create(ball, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { Size = Vector3.one * radius * 1.6, Transparency = 1 }):Play()
	Debris:AddItem(ball, 0.4)
	shakeFrom(position, 3, radius * 4)
end

-- Sci-fi impacts
function Effects.Zap(position: Vector3, radius: number, color: Color3)
	local ball = fxPart(Vector3.one, CFrame.new(position), color, 0)
	ball.Shape = Enum.PartType.Ball
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = radius * 3
	light.Brightness = 5
	light.Parent = ball
	TweenService:Create(ball, TweenInfo.new(0.25, Enum.EasingStyle.Quad), { Size = Vector3.one * radius * 2, Transparency = 1 }):Play()
	Debris:AddItem(ball, 0.3)
	Effects.Sound3D("ShotHeavy", position, 1.3)
	shakeFrom(position, 1, radius * 4)
end

function Effects.Void(position: Vector3, radius: number)
	local purple = Color3.fromRGB(170, 70, 255)
	-- implode then burst
	local core = fxPart(Vector3.one * radius * 1.6, CFrame.new(position), Color3.fromRGB(20, 0, 40), 0.2)
	core.Shape = Enum.PartType.Ball
	core.Material = Enum.Material.Glass
	TweenService:Create(core, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = Vector3.one * 0.5 }):Play()
	local ring = fxPart(Vector3.new(0.4, 2, 2), CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)), purple, 0.1)
	ring.Shape = Enum.PartType.Cylinder
	task.delay(0.35, function()
		TweenService:Create(ring, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { Size = Vector3.new(0.2, radius * 2.4, radius * 2.4), Transparency = 1 }):Play()
		Effects.Zap(position, radius * 0.7, purple)
		shakeFrom(position, 3, radius * 4)
	end)
	Debris:AddItem(core, 0.4)
	Debris:AddItem(ring, 0.9)
end

function Effects.Shockwave(position: Vector3, radius: number)
	local ring = fxPart(Vector3.new(0.4, 2, 2), CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)), Config.Colors.Accent2, 0.1)
	ring.Shape = Enum.PartType.Cylinder
	TweenService:Create(ring, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { Size = Vector3.new(0.2, radius * 2, radius * 2), Transparency = 1 }):Play()
	Debris:AddItem(ring, 0.45)
	Effects.Sound3D("Slam", position)
	shakeFrom(position, 2.5, radius * 3)
end

-- Another player's/bot's shot (our own shots are drawn instantly by WeaponController).
function Effects.RemoteShot(character: Model?, weaponId: string, ends)
	if not character or character == player.Character then
		return
	end
	Effects.LastFired[character] = os.clock()
	local def = Weapons.Get(weaponId)
	local tool = character:FindFirstChildOfClass("Tool")
	local handle = tool and tool:FindFirstChild("Handle")
	local muzzle = handle and handle:FindFirstChild("Muzzle")
	local from
	if muzzle then
		from = muzzle.WorldPosition
	else
		local head = character:FindFirstChild("Head")
		if not head then
			return
		end
		from = head.Position
	end
	local color = def and def.Look.Neon and def.Look.Accent or nil
	for _, to in ends do
		Effects.Tracer(from, to, color, def and def.Look.Neon and 0.25 or 0.08)
		Effects.Impact(to)
	end
	Effects.Flash(from)
	Effects.Sound3D(def and def.Class == "Sniper" and "ShotHeavy" or "Shot", from, 0.9 + math.random() * 0.2)
end

-- Target reaction: briefly flash the character you hit (white, gold for headshots).
function Effects.HitFlash(position: Vector3?, headshot: boolean?)
	if not position then
		return
	end
	local best, bestDist = nil, 6
	local candidates = {}
	for _, p in Players:GetPlayers() do
		if p ~= player and p.Character then
			table.insert(candidates, p.Character)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, b in bots:GetChildren() do
			table.insert(candidates, b)
		end
	end
	for _, char in candidates do
		local root = char:FindFirstChild("HumanoidRootPart")
		if root then
			local d = (root.Position - position).Magnitude
			if d < bestDist then
				best, bestDist = char, d
			end
		end
	end
	if not best then
		return
	end
	local h = Instance.new("Highlight")
	h.FillColor = headshot and Config.Colors.Gold or Color3.new(1, 1, 1)
	h.FillTransparency = 0.35
	h.OutlineTransparency = 1
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Adornee = best
	h.Parent = folder()
	TweenService:Create(h, TweenInfo.new(0.15), { FillTransparency = 1 }):Play()
	Debris:AddItem(h, 0.2)
end

-- Rocket / grenade-launcher launch from someone else
function Effects.Launch(character: Model?, weaponId: string)
	if not character or character == player.Character then
		return
	end
	Effects.LastFired[character] = os.clock()
	local def = Weapons.Get(weaponId)
	local tool = character:FindFirstChildOfClass("Tool")
	local handle = tool and tool:FindFirstChild("Handle")
	local muzzle = handle and handle:FindFirstChild("Muzzle")
	local pos = muzzle and muzzle.WorldPosition or (character:FindFirstChild("Head") and character.Head.Position)
	if pos then
		Effects.Flash(pos, def and def.Look.Accent)
		Effects.Sound3D("ShotHeavy", pos, 0.7)
	end
end

function Effects.UAVActive(): boolean
	return os.clock() < uavUntil
end

-- UAV: highlight every enemy through walls.
local highlights = {}
local function clearHighlights()
	for _, h in highlights do
		h:Destroy()
	end
	highlights = {}
end

function Effects.UAV(duration: number)
	uavUntil = os.clock() + duration
	task.spawn(function()
		while os.clock() < uavUntil do
			clearHighlights()
			local targets = {}
			for _, p in Players:GetPlayers() do
				if p ~= player and p.Character then
					table.insert(targets, p.Character)
				end
			end
			local bots = workspace:FindFirstChild("Bots")
			if bots then
				for _, b in bots:GetChildren() do
					table.insert(targets, b)
				end
			end
			local myTeam = player:GetAttribute("Team")
			for _, char in targets do
				local p = Players:GetPlayerFromCharacter(char)
				local team = p and p:GetAttribute("Team") or char:GetAttribute("Team")
				if myTeam and team == myTeam then
					continue -- UAV only shows enemies
				end
				local h = Instance.new("Highlight")
				h.FillColor = Config.Colors.Red
				h.FillTransparency = 0.6
				h.OutlineColor = Color3.new(1, 1, 1)
				h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				h.Adornee = char
				h.Parent = folder()
				table.insert(highlights, h)
			end
			task.wait(1)
		end
		clearHighlights()
	end)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[-- In-game HUD in the style of the big shooters:
-- score bar + timer (top), killfeed (top-right), health (bottom-left),
-- ammo (bottom-right), abilities + XP (bottom-center), crosshair, hitmarkers,
-- medals, kill popups, achievement toasts, death/killcam card.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local MarketplaceService = game:GetService("MarketplaceService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Monetization = require(Shared.Monetization)
local UIKit = require(script.Parent.UIKit)
local ClientState = require(script.Parent.ClientState)
local Movement = require(script.Parent.MovementController)

local player = Players.LocalPlayer
local T = UIKit.Theme
local new, Label = UIKit.new, UIKit.Label

local HUD = {}
HUD.OpenMenu = nil -- injected: function(name)

local gui
local refs = {}

local function shadowText(props)
	local l = Label(props)
	UIKit.TextStroke(0.5).Parent = l
	return l
end

-- TOP BAR ----------------------------------------------------------------------
local function buildTopBar()
	local bar = new("Frame", {
		Name = "TopBar", Size = UDim2.fromOffset(420, 62), Position = UDim2.new(0.5, 0, 0, 8),
		AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1, Parent = gui,
	})
	local function box(x, w, color, name)
		local f = UIKit.Panel({ Name = name, Size = UDim2.fromOffset(w, 62), Position = UDim2.fromOffset(x, 0), BackgroundColor3 = color, BackgroundTransparency = 0.2, Parent = bar })
		return f
	end
	local you = box(0, 104, Color3.fromRGB(0, 90, 130), "You")
	refs.YouBox = you
	refs.YouLine = new("Frame", { Size = UDim2.new(1, 0, 0, 3), Position = UDim2.new(0, 0, 1, -3), BackgroundColor3 = T.Accent2, BorderSizePixel = 0, Parent = you })
	refs.YouTitle = Label({ Text = "YOU", Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 6), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 12, TextColor3 = T.Accent2, Font = T.Black, Parent = you })
	refs.YouKills = Label({ Text = "0", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 22), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 30, Font = T.Black, Parent = you })

	local mid = box(110, 200, T.Panel, "Timer")
	refs.Timer = Label({ Text = "5:00", Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 4), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 32, Font = T.Black, Parent = mid })
	refs.Mode = Label({ Text = Config.ModeName .. " · FIRST TO " .. Config.KillsToWin, Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 40), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 11, TextColor3 = T.Sub, Font = T.Bold, Parent = mid })

	local lead = box(316, 104, Color3.fromRGB(130, 20, 30), "Leader")
	refs.LeadBox = lead
	refs.LeadLine = new("Frame", { Size = UDim2.new(1, 0, 0, 3), Position = UDim2.new(0, 0, 1, -3), BackgroundColor3 = T.Red, BorderSizePixel = 0, Parent = lead })
	refs.LeaderName = Label({ Text = "LEADER", Size = UDim2.new(1, -8, 0, 16), Position = UDim2.fromOffset(4, 6), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 12, TextColor3 = Color3.fromRGB(255, 140, 140), Font = T.Black, TextTruncate = Enum.TextTruncate.AtEnd, Parent = lead })
	refs.LeaderKills = Label({ Text = "0", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 22), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 30, Font = T.Black, Parent = lead })
	-- third team (triple team deathmatch)
	local extra = box(426, 90, Color3.fromRGB(20, 110, 40), "Extra")
	refs.ExtraBox = extra
	refs.ExtraLine = new("Frame", { Size = UDim2.new(1, 0, 0, 3), Position = UDim2.new(0, 0, 1, -3), BackgroundColor3 = T.Green, BorderSizePixel = 0, Parent = extra })
	refs.ExtraName = Label({ Text = "", Size = UDim2.new(1, -8, 0, 16), Position = UDim2.fromOffset(4, 6), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 12, Font = T.Black, Parent = extra })
	refs.ExtraKills = Label({ Text = "0", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 22), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 30, Font = T.Black, Parent = extra })
	extra.Visible = false
	refs.TopBar = bar

	refs.Banner = shadowText({
		Text = "", Size = UDim2.fromOffset(500, 22), Position = UDim2.new(0.5, 0, 0, 76), AnchorPoint = Vector2.new(0.5, 0),
		TextXAlignment = Enum.TextXAlignment.Center, TextSize = 16, Font = T.Black, TextColor3 = T.Accent, Parent = gui,
	})
	refs.Status = shadowText({
		Text = "", Size = UDim2.fromOffset(500, 20), Position = UDim2.new(0.5, 0, 0, 98), AnchorPoint = Vector2.new(0.5, 0),
		TextXAlignment = Enum.TextXAlignment.Center, TextSize = 14, Font = T.Black, TextColor3 = T.Accent2, Parent = gui,
	})
end

-- PROFILE (top-left) -------------------------------------------------------------
local function buildProfile()
	local f = new("Frame", { Name = "Profile", Size = UDim2.fromOffset(260, 80), Position = UDim2.fromOffset(16, 192), BackgroundTransparency = 1, Parent = gui })
	local badge = UIKit.Panel({ Size = UDim2.fromOffset(46, 46), BackgroundColor3 = T.Accent, BackgroundTransparency = 0, Parent = f })
	Label({ Text = "LVL", Size = UDim2.new(1, 0, 0, 12), Position = UDim2.fromOffset(0, 5), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 10, Font = T.Black, TextColor3 = Color3.new(0, 0, 0), Parent = badge })
	refs.Level = Label({ Text = "1", Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 16), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 22, Font = T.Black, TextColor3 = Color3.new(0, 0, 0), Parent = badge })
	refs.Name = shadowText({ Text = player.DisplayName, Size = UDim2.fromOffset(200, 18), Position = UDim2.fromOffset(54, 2), TextSize = 15, Font = T.Black, Parent = f })
	refs.Cash = shadowText({ Text = "$0", Size = UDim2.fromOffset(200, 22), Position = UDim2.fromOffset(54, 22), TextSize = 20, Font = T.Black, TextColor3 = T.Green, Parent = f })
	refs.CashPop = shadowText({ Text = "", Size = UDim2.fromOffset(200, 18), Position = UDim2.fromOffset(54, 46), TextSize = 15, Font = T.Black, TextColor3 = T.Green, TextTransparency = 1, Parent = f })
	refs.Boosts = new("Frame", { Size = UDim2.fromOffset(260, 20), Position = UDim2.fromOffset(0, 54), BackgroundTransparency = 1, Parent = f }, { UIKit.List(4, true) })
end

local function pill(parent, text, color)
	local p = UIKit.Panel({ Size = UDim2.fromOffset(0, 18), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = color, BackgroundTransparency = 0.1, Parent = parent })
	new("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), Parent = p })
	Label({ Text = text, Size = UDim2.fromOffset(0, 18), AutomaticSize = Enum.AutomaticSize.X, TextSize = 11, Font = T.Black, TextColor3 = Color3.new(0, 0, 0), Parent = p })
	return p
end

-- SIDE MENU (left) ---------------------------------------------------------------
local function buildSideMenu()
	local f = new("Frame", { Name = "Side", Size = UDim2.fromOffset(150, 240), Position = UDim2.new(0, 16, 0.62, 0), AnchorPoint = Vector2.new(0, 0.5), BackgroundTransparency = 1, Parent = gui }, { UIKit.List(6) })
	local items = {
		{ "Armory", "🔫 ARMORY", "B", T.Panel2 },
		{ "Store", "💎 STORE", "N", T.Robux },
		{ "Achievements", "🏆 TROPHIES", "J", T.Panel2 },
		{ "Scoreboard", "📋 SCORES", "TAB", T.Panel2 },
		{ "Settings", "⚙️ SETTINGS", "P", T.Panel2 },
	}
	for i, item in items do
		local b = UIKit.Button({ Text = "", Size = UDim2.fromOffset(150, 34), Color = item[4], LayoutOrder = i, Parent = f }, function()
			if HUD.OpenMenu then
				HUD.OpenMenu(item[1])
			end
		end)
		b.BackgroundTransparency = 0.15
		Label({ Text = item[2], Size = UDim2.new(1, -44, 1, 0), Position = UDim2.fromOffset(10, 0), TextSize = 13, Font = T.Black, Parent = b })
		local key = UIKit.Panel({ Size = UDim2.fromOffset(30, 20), Position = UDim2.new(1, -36, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.5, Parent = b })
		Label({ Text = item[3], Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 10, Font = T.Black, TextColor3 = T.Sub, Parent = key })
	end
	refs.Side = f
end

-- KILLFEED -----------------------------------------------------------------------
local function buildKillfeed()
	refs.Feed = new("Frame", {
		Name = "Killfeed", Size = UDim2.fromOffset(400, 200), Position = UDim2.new(1, -16, 0, 12), AnchorPoint = Vector2.new(1, 0),
		BackgroundTransparency = 1, Parent = gui,
	}, { UIKit.List(4, false, Enum.HorizontalAlignment.Right) })
end

local feedOrder = 0
function HUD.Feed(entry)
	feedOrder += 1
	local me = player.Name
	local function hex(c: Color3)
		return string.format("#%02X%02X%02X", math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255))
	end
	local function colorName(name, vip, team)
		if not name then
			return ""
		end
		local color = "#FFFFFF"
		if team and Config.Teams[team] then
			color = hex(Config.Teams[team].Color)
		end
		if name == me then
			color = "#FFC61A"
		elseif vip and not team then
			color = "#FFD34A"
		end
		local prefix = vip and "👑 " or ""
		return string.format('<font color="%s">%s%s</font>', color, prefix, name)
	end
	local text
	if entry.Knock then
		text = string.format('%s  <font color="#9AA2B4">[%s]</font>  <font color="#FF9A3C">⬇ KNOCKED</font>  %s', colorName(entry.Killer, entry.KillerVIP, entry.KillerTeam), entry.Weapon, colorName(entry.Victim, entry.VictimVIP, entry.VictimTeam))
	elseif entry.Killer then
		text = string.format('%s  <font color="#9AA2B4">[%s]</font>%s  %s', colorName(entry.Killer, entry.KillerVIP, entry.KillerTeam), entry.Weapon, entry.Headshot and " 💀" or "", colorName(entry.Victim, entry.VictimVIP, entry.VictimTeam))
	else
		text = string.format('%s  <font color="#9AA2B4">[%s]</font>', colorName(entry.Victim, entry.VictimVIP, entry.VictimTeam), entry.Weapon)
	end
	local involved = entry.Killer == me or entry.Victim == me
	local row = UIKit.Panel({
		Size = UDim2.fromOffset(0, 26), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = -feedOrder,
		BackgroundColor3 = involved and Color3.fromRGB(90, 70, 10) or Color3.new(0, 0, 0), BackgroundTransparency = 0.45, Parent = refs.Feed,
	})
	new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = row })
	Label({ Text = text, RichText = true, Size = UDim2.fromOffset(0, 26), AutomaticSize = Enum.AutomaticSize.X, TextSize = 14, Font = T.Bold, Parent = row })
	local rows = {}
	for _, c in refs.Feed:GetChildren() do
		if c:IsA("Frame") then
			table.insert(rows, c)
		end
	end
	table.sort(rows, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for i = 7, #rows do
		rows[i]:Destroy()
	end
	task.delay(6, function()
		if row.Parent then
			UIKit.Tween(row, 0.4, { BackgroundTransparency = 1 })
			for _, d in row:GetDescendants() do
				if d:IsA("TextLabel") then
					UIKit.Tween(d, 0.4, { TextTransparency = 1 })
				end
			end
			task.wait(0.45)
			row:Destroy()
		end
	end)
end

-- HEALTH (bottom-left) -------------------------------------------------------------
local function buildHealth()
	local f = new("Frame", { Name = "Health", Size = UDim2.fromOffset(300, 84), Position = UDim2.new(0, 16, 1, -16), AnchorPoint = Vector2.new(0, 1), BackgroundTransparency = 1, Parent = gui })
	-- backing plate that fades out to the right + accent edge
	local plate = new("Frame", { Name = "Plate", Size = UDim2.new(1, 24, 1, 12), Position = UDim2.fromOffset(-10, -6), BackgroundColor3 = Color3.fromRGB(6, 9, 14), BorderSizePixel = 0, ZIndex = 0, Parent = f })
	new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(0.7, 0.75), NumberSequenceKeypoint.new(1, 1) }), Parent = plate })
	UIKit.Corner(6).Parent = plate
	new("Frame", { Size = UDim2.new(0, 3, 1, -16), Position = UDim2.fromOffset(0, 8), BackgroundColor3 = T.Green, BorderSizePixel = 0, Parent = plate })
	refs.HP = shadowText({ Text = "100", Size = UDim2.fromOffset(90, 44), Position = UDim2.fromOffset(0, 0), TextSize = 44, Font = T.Black, Parent = f })
	Label({ Text = "HEALTH", Size = UDim2.fromOffset(100, 14), Position = UDim2.fromOffset(94, 6), TextSize = 11, Font = T.Black, TextColor3 = T.Sub, Parent = f })
	local bar, fill = UIKit.Bar({ Size = UDim2.fromOffset(190, 12), Position = UDim2.fromOffset(94, 24), Color = T.Green, Parent = f })
	refs.HPFill = fill
	refs.HPBar = bar
	-- white "damage trail" that drains after the real bar, plus 25% segment ticks
	refs.HPTrail = new("Frame", { Name = "Trail", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.35, BorderSizePixel = 0, ZIndex = fill.ZIndex, Parent = bar })
	fill.ZIndex += 1
	for i = 1, 3 do
		new("Frame", { Size = UDim2.new(0, 2, 1, 0), Position = UDim2.fromScale(i / 4, 0), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.3, BorderSizePixel = 0, ZIndex = fill.ZIndex + 1, Parent = bar })
	end
	refs.Streak = shadowText({ Text = "", RichText = true, Size = UDim2.fromOffset(300, 18), Position = UDim2.fromOffset(0, 50), TextSize = 13, Font = T.Black, TextColor3 = T.Text, Parent = f })
	refs.StreakPips = new("Frame", { Size = UDim2.fromOffset(300, 8), Position = UDim2.fromOffset(0, 72), BackgroundTransparency = 1, Parent = f }, { UIKit.List(3, true) })
end

-- AMMO (bottom-right) ------------------------------------------------------------
local function buildAmmo()
	local f = new("Frame", { Name = "Ammo", Size = UDim2.fromOffset(300, 110), Position = UDim2.new(1, -16, 1, -16), AnchorPoint = Vector2.new(1, 1), BackgroundTransparency = 1, Parent = gui })
	local plate = new("Frame", { Name = "Plate", Size = UDim2.new(1, 24, 1, 12), Position = UDim2.new(1, 10, 0, -6), AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = Color3.fromRGB(6, 9, 14), BorderSizePixel = 0, ZIndex = 0, Parent = f })
	new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.75), NumberSequenceKeypoint.new(1, 0.3) }), Parent = plate })
	UIKit.Corner(6).Parent = plate
	new("Frame", { Size = UDim2.new(0, 3, 1, -16), Position = UDim2.new(1, -3, 0, 8), BackgroundColor3 = T.Accent, BorderSizePixel = 0, Parent = plate })
	refs.WeaponName = shadowText({ Text = "", Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 0), TextXAlignment = Enum.TextXAlignment.Right, TextSize = 15, Font = T.Black, TextColor3 = T.Accent, Parent = f })
	refs.Reserve = shadowText({ Text = "/ 0", Size = UDim2.fromOffset(90, 30), Position = UDim2.new(1, -90, 0, 32), TextSize = 22, Font = T.Black, TextColor3 = T.Sub, Parent = f })
	refs.Mag = shadowText({ Text = "0", Size = UDim2.fromOffset(140, 56), Position = UDim2.new(1, -236, 0, 16), TextXAlignment = Enum.TextXAlignment.Right, TextSize = 56, Font = T.Black, Parent = f })
	local _, magFill = UIKit.Bar({ Size = UDim2.fromOffset(230, 4), Position = UDim2.new(1, -230, 0, 74), Color = T.Text, Parent = f })
	refs.MagFill = magFill
	refs.Equip = new("Frame", { Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 84), BackgroundTransparency = 1, Parent = f }, {
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local function chip(order, text)
		local c = UIKit.Panel({ Size = UDim2.fromOffset(0, 22), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, LayoutOrder = order, Parent = refs.Equip })
		new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = c })
		return Label({ Text = text, RichText = true, Size = UDim2.fromOffset(0, 22), AutomaticSize = Enum.AutomaticSize.X, TextSize = 12, Font = T.Black, Parent = c })
	end
	refs.TokenAir = chip(1, "")
	refs.TokenNuke = chip(2, "")
	refs.Nades = chip(3, "💣 x2 <font color='#9AA2B4'>[G]</font>")
	chip(4, "🔪 <font color='#9AA2B4'>[V]</font>")
end

function HUD.SetAmmo(mag: number, reserve: number, name: string, reloading: boolean, magSize: number, unlimited: boolean?)
	if not refs.Mag then
		return
	end
	refs.WeaponName.Text = name
	refs.Reserve.Text = unlimited and "/ ∞" or ("/ " .. reserve)
	if unlimited then
		refs.Mag.Text = "∞"
		refs.Mag.TextColor3 = T.Accent
		refs.MagFill.Size = UDim2.fromScale(1, 1)
		return
	end
	if reloading then
		refs.Mag.Text = "···"
		refs.Mag.TextColor3 = T.Accent
	else
		refs.Mag.Text = tostring(mag)
		refs.Mag.TextColor3 = (mag / math.max(1, magSize) <= 0.25) and T.Red or T.Text
	end
	refs.MagFill.Size = UDim2.fromScale(math.clamp(mag / math.max(1, magSize), 0, 1), 1)
end

-- ABILITIES + XP (bottom-center) ---------------------------------------------------
local function buildAbilities()
	local f = new("Frame", { Name = "Abilities", Size = UDim2.fromOffset(240, 60), Position = UDim2.new(0.5, 0, 1, -30), AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 1, Parent = gui }, {
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	refs.Abilities = {}
	for i, a in { { "Dash", "💨", "Q" }, { "Slide", "🛝", "C" }, { "Slam", "☄️", "C AIR" } } do
		local box = UIKit.Panel({ Size = UDim2.fromOffset(64, 56), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, LayoutOrder = i, Parent = f })
		box.ClipsDescendants = true
		local cd = new("Frame", { Name = "Cooldown", Size = UDim2.fromScale(1, 0), Position = UDim2.fromScale(0, 1), AnchorPoint = Vector2.new(0, 1), BackgroundColor3 = T.Accent, BackgroundTransparency = 0.6, BorderSizePixel = 0, Parent = box })
		Label({ Text = a[2], Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 4), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 24, Parent = box })
		Label({ Text = a[3], Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 1, -18), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 11, Font = T.Black, TextColor3 = T.Sub, Parent = box })
		refs.Abilities[a[1]] = cd
	end
	local xp = new("Frame", { Name = "XP", Size = UDim2.fromOffset(460, 20), Position = UDim2.new(0.5, 0, 1, -6), AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 1, Parent = gui })
	local _, xpFill = UIKit.Bar({ Size = UDim2.new(1, 0, 0, 5), Position = UDim2.new(0, 0, 1, -5), Color = T.Accent2, Parent = xp })
	refs.XPFill = xpFill
	refs.XPText = Label({ Text = "", Size = UDim2.new(1, 0, 0, 14), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 11, Font = T.Black, TextColor3 = T.Sub, Parent = xp })
end

-- CROSSHAIR / HITMARKER / SCOPE ----------------------------------------------------
local function buildCrosshair()
	local c = new("Frame", { Name = "Crosshair", Size = UDim2.fromOffset(2, 2), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Parent = gui })
	refs.Cross = c
	refs.CrossBars = {}
	for i, spec in { { 2, 10, 0, -1 }, { 2, 10, 0, 1 }, { 10, 2, -1, 0 }, { 10, 2, 1, 0 } } do
		local bar = new("Frame", { Size = UDim2.fromOffset(spec[1], spec[2]), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = c }, {
			new("UIStroke", { Thickness = 1, Transparency = 0.5 }),
		})
		refs.CrossBars[i] = { bar, spec[3], spec[4] }
	end
	new("Frame", { Size = UDim2.fromOffset(2, 2), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = c })

	local hm = new("Frame", { Name = "Hitmarker", Size = UDim2.fromOffset(34, 34), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Parent = gui })
	refs.HitBars = {}
	for _, d in { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } } do
		local bar = new("Frame", {
			Size = UDim2.fromOffset(3, 11), Position = UDim2.new(0.5, d[1] * 10, 0.5, d[2] * 10), AnchorPoint = Vector2.new(0.5, 0.5),
			Rotation = d[1] * d[2] > 0 and -45 or 45, BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, Parent = hm,
		})
		table.insert(refs.HitBars, bar)
	end
	refs.HitScale = new("UIScale", { Parent = hm })

	-- sniper scope: a circle with a huge black stroke around it
	local scope = new("Frame", { Name = "Scope", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = gui })
	local ring = new("Frame", {
		Size = UDim2.fromScale(0.9, 0.9), SizeConstraint = Enum.SizeConstraint.RelativeYY, Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Parent = scope,
	})
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = ring })
	new("UIStroke", { Thickness = 1200, Color = Color3.new(0, 0, 0), Parent = ring })
	new("Frame", { Size = UDim2.new(1, 0, 0, 1), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Parent = ring })
	new("Frame", { Size = UDim2.new(0, 1, 1, 0), Position = UDim2.fromScale(0.5, 0), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Parent = ring })
	new("Frame", { Size = UDim2.fromOffset(4, 4), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = T.Red, BorderSizePixel = 0, Parent = ring })
	refs.Scope = scope
end

function HUD.SetCrosshair(px: number, visible: boolean)
	if not refs.Cross then
		return
	end
	refs.Cross.Visible = visible
	local color = ClientState.CrosshairColors[ClientState.Settings.Crosshair] or Color3.new(1, 1, 1)
	if refs.CrossColor ~= color then
		refs.CrossColor = color
		for _, b in refs.CrossBars do
			b[1].BackgroundColor3 = color
		end
	end
	local gap = math.clamp(px, 4, 120) + 4
	for _, b in refs.CrossBars do
		b[1].Position = UDim2.new(0.5, b[2] * gap, 0.5, b[3] * gap)
	end
end

function HUD.SetScope(on: boolean)
	if refs.Scope then
		refs.Scope.Visible = on
	end
end

local hitToken = 0
function HUD.Hitmarker(headshot: boolean, killed: boolean)
	hitToken += 1
	local token = hitToken
	local color = killed and T.Red or (headshot and T.Accent or Color3.new(1, 1, 1))
	for _, b in refs.HitBars do
		b.BackgroundColor3 = color
		b.BackgroundTransparency = 0
	end
	refs.HitScale.Scale = killed and 1.6 or 1.2
	UIKit.Tween(refs.HitScale, 0.15, { Scale = 1 })
	task.delay(killed and 0.35 or 0.15, function()
		if token == hitToken then
			for _, b in refs.HitBars do
				UIKit.Tween(b, 0.15, { BackgroundTransparency = 1 })
			end
		end
	end)
end

function HUD.DamageNumber(position: Vector3?, damage: number, headshot: boolean)
	if not position then
		return
	end
	local att = Instance.new("Attachment")
	att.WorldPosition = position + Vector3.new(math.random() - 0.5, 1 + math.random(), math.random() - 0.5)
	att.Parent = workspace.Terrain
	local bb = new("BillboardGui", { Size = UDim2.fromOffset(80, 30), AlwaysOnTop = true, LightInfluence = 0, Adornee = att, Parent = att })
	local l = Label({
		Text = tostring(math.floor(damage)), Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = headshot and 26 or 20, Font = T.Black, TextColor3 = headshot and T.Accent or Color3.new(1, 1, 1), Parent = bb,
	})
	UIKit.TextStroke(0.2).Parent = l
	UIKit.Tween(bb, 0.7, { StudsOffset = Vector3.new(0, 2, 0) })
	task.delay(0.4, function()
		UIKit.Tween(l, 0.3, { TextTransparency = 1 })
	end)
	task.delay(0.75, function()
		att:Destroy()
	end)
end

-- CENTER MESSAGES ------------------------------------------------------------------
local function buildCenter()
	refs.KillPop = new("Frame", { Name = "KillPop", Size = UDim2.fromOffset(500, 120), Position = UDim2.fromScale(0.5, 0.6), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1, Parent = gui })
	refs.KillTitle = shadowText({ Text = "", Size = UDim2.new(1, 0, 0, 16), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 14, Font = T.Black, TextColor3 = T.Red, Parent = refs.KillPop })
	refs.KillName = shadowText({ Text = "", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 16), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 28, Font = T.Black, Parent = refs.KillPop })
	refs.KillScore = shadowText({ Text = "", Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 46), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 20, Font = T.Black, TextColor3 = T.Accent, Parent = refs.KillPop })
	refs.KillScale = new("UIScale", { Parent = refs.KillPop })
	refs.MedalRow = new("Frame", { Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 74), BackgroundTransparency = 1, Parent = refs.KillPop }, {
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	refs.Announce = new("Frame", { Name = "Announce", Size = UDim2.fromOffset(700, 90), Position = UDim2.fromScale(0.5, 0.2), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1, Visible = false, Parent = gui })
	refs.AnnounceText = shadowText({ Text = "", Size = UDim2.new(1, 0, 0, 44), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 40, Font = T.Black, Parent = refs.Announce })
	refs.AnnounceSub = shadowText({ Text = "", Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 48), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 16, Font = T.Bold, TextColor3 = T.Sub, Parent = refs.Announce })
	refs.AnnounceScale = new("UIScale", { Parent = refs.Announce })

	refs.Message = shadowText({ Text = "", Size = UDim2.fromOffset(600, 24), Position = UDim2.fromScale(0.5, 0.78), AnchorPoint = Vector2.new(0.5, 0), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 18, Font = T.Black, TextTransparency = 1, Parent = gui })

	refs.Nuke = shadowText({ Text = "", Size = UDim2.fromOffset(600, 120), Position = UDim2.fromScale(0.5, 0.35), AnchorPoint = Vector2.new(0.5, 0.5), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 110, Font = T.Black, TextColor3 = T.Red, Parent = gui })

	refs.White = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 50, Parent = gui })

	-- damage vignette (4 gradient edges)
	refs.Vignette = {}
	for _, e in { { UDim2.new(1, 0, 0.25, 0), UDim2.new(), 90 }, { UDim2.new(1, 0, 0.25, 0), UDim2.fromScale(0, 0.75), -90 }, { UDim2.new(0.2, 0, 1, 0), UDim2.new(), 0 }, { UDim2.new(0.2, 0, 1, 0), UDim2.fromScale(0.8, 0), 180 } } do
		local f = new("Frame", { Size = e[1], Position = e[2], BackgroundColor3 = T.Red, BackgroundTransparency = 1, BorderSizePixel = 0, Parent = gui })
		new("UIGradient", { Rotation = e[3], Transparency = NumberSequence.new(0, 1), Parent = f })
		table.insert(refs.Vignette, f)
	end
end

local killToken = 0
local medalToken = 0
function HUD.Medals(medals)
	for _, c in refs.MedalRow:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	for i, m in medals do
		task.delay((i - 1) * 0.12, function()
			local tag = UIKit.Panel({ Size = UDim2.fromOffset(0, 26), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35, LayoutOrder = i, Parent = refs.MedalRow })
			UIKit.Stroke(T.Accent, 1.5, 0.2).Parent = tag
			new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = tag })
			Label({ Text = m.Text .. (m.Bonus and m.Bonus > 0 and ("  <font color='#FFC61A'>+" .. m.Bonus .. "</font>") or ""), RichText = true, Size = UDim2.fromOffset(0, 26), AutomaticSize = Enum.AutomaticSize.X, TextSize = 13, Font = T.Black, Parent = tag })
			local sc = new("UIScale", { Scale = 1.8, Parent = tag })
			UIKit.Tween(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
		end)
	end
	medalToken += 1
	local token = medalToken
	task.delay(3, function()
		if token == medalToken then
			for _, c in refs.MedalRow:GetChildren() do
				if c:IsA("Frame") then
					c:Destroy()
				end
			end
		end
	end)
end

function HUD.Kill(info)
	killToken += 1
	local token = killToken
	refs.KillTitle.Text = info.Headshot and "💀 HEADSHOT ELIMINATION" or "ELIMINATED"
	refs.KillName.Text = string.upper(info.Victim)
	refs.KillScore.Text = "+" .. info.Score
	for _, l in { refs.KillTitle, refs.KillName, refs.KillScore } do
		l.TextTransparency = 0
	end
	refs.KillScale.Scale = 1.4
	UIKit.Tween(refs.KillScale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
	HUD.Medals(info.Medals or {})
	task.delay(2.2, function()
		if token == killToken then
			for _, l in { refs.KillTitle, refs.KillName, refs.KillScore } do
				UIKit.Tween(l, 0.3, { TextTransparency = 1 })
			end
		end
	end)
end

local announceToken = 0
function HUD.Announce(info)
	announceToken += 1
	local token = announceToken
	refs.Announce.Visible = true
	refs.AnnounceText.Text = (info.Icon and info.Icon .. "  " or "") .. info.Text
	refs.AnnounceText.TextColor3 = info.Color or T.Accent
	refs.AnnounceSub.Text = info.Sub or ""
	refs.AnnounceScale.Scale = 0.6
	UIKit.Tween(refs.AnnounceScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	UIKit.Sound("Unlock", 0.6)
	task.delay(3, function()
		if token == announceToken then
			refs.Announce.Visible = false
		end
	end)
end

local msgToken = 0
function HUD.Message(text: string, color: Color3?)
	msgToken += 1
	local token = msgToken
	refs.Message.Text = text
	refs.Message.TextColor3 = color or T.Text
	refs.Message.TextTransparency = 0
	task.delay(2.2, function()
		if token == msgToken then
			UIKit.Tween(refs.Message, 0.3, { TextTransparency = 1 })
		end
	end)
end

function HUD.Cash(amount: number, reason: string?)
	refs.CashPop.Text = "+$" .. Util.Comma(amount) .. (reason and ("  " .. reason) or "")
	refs.CashPop.TextTransparency = 0
	refs.CashPop.Position = UDim2.fromOffset(54, 46)
	UIKit.Tween(refs.CashPop, 1.5, { TextTransparency = 1, Position = UDim2.fromOffset(54, 36) })
end

-- ACHIEVEMENT TOASTS (queued) -----------------------------------------------------
local toastQueue = {}
local toastBusy = false
local function showNextToast()
	if toastBusy or #toastQueue == 0 then
		return
	end
	toastBusy = true
	local info = table.remove(toastQueue, 1)
	local toast = UIKit.Panel({
		Size = UDim2.fromOffset(380, 70), Position = UDim2.new(0.5, 0, 0, -80), AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = T.Panel, BackgroundTransparency = 0.05, ZIndex = 20, Parent = gui,
	})
	UIKit.Stroke(info.Color or T.Gold, 2, 0).Parent = toast
	UIKit.Gradient(Color3.fromRGB(60, 50, 20), T.Panel, 0).Parent = toast
	Label({ Text = info.Icon or "🏆", Size = UDim2.fromOffset(60, 70), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 34, ZIndex = 21, Parent = toast })
	Label({ Text = info.Title, Size = UDim2.new(1, -150, 0, 14), Position = UDim2.fromOffset(62, 10), TextSize = 11, Font = T.Black, TextColor3 = info.Color or T.Gold, ZIndex = 21, Parent = toast })
	Label({ Text = info.Name, Size = UDim2.new(1, -150, 0, 22), Position = UDim2.fromOffset(62, 24), TextSize = 19, Font = T.Black, ZIndex = 21, TextTruncate = Enum.TextTruncate.AtEnd, Parent = toast })
	Label({ Text = info.Desc or "", Size = UDim2.new(1, -150, 0, 14), Position = UDim2.fromOffset(62, 47), TextSize = 11, Font = T.Medium, TextColor3 = T.Sub, ZIndex = 21, TextTruncate = Enum.TextTruncate.AtEnd, Parent = toast })
	Label({ Text = info.Right or "", Size = UDim2.fromOffset(80, 70), Position = UDim2.new(1, -88, 0, 0), TextXAlignment = Enum.TextXAlignment.Right, TextSize = 18, Font = T.Black, TextColor3 = T.Green, ZIndex = 21, Parent = toast })
	UIKit.Sound("Unlock", 1.2)
	UIKit.Tween(toast, 0.4, { Position = UDim2.new(0.5, 0, 0, 124) }, Enum.EasingStyle.Back)
	task.delay(3.2, function()
		UIKit.Tween(toast, 0.3, { Position = UDim2.new(0.5, 0, 0, -80) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.wait(0.35)
		toast:Destroy()
		toastBusy = false
		showNextToast()
	end)
end

function HUD.Toast(info)
	table.insert(toastQueue, info)
	showNextToast()
end

function HUD.Achievement(info)
	HUD.Toast({ Title = "ACHIEVEMENT UNLOCKED", Name = info.Name, Desc = info.Desc, Icon = info.Icon, Right = "+$" .. Util.Comma(info.Reward) })
end

function HUD.LevelUp(level: number, reward: number)
	HUD.Toast({ Title = "LEVEL UP", Name = "YOU REACHED LEVEL " .. level, Desc = "New weapons may be unlocked in the Armory", Icon = "⭐", Right = "+$" .. Util.Comma(reward), Color = T.Accent2 })
end

-- DAMAGE / DEATH ---------------------------------------------------------------------
local hurtFlash = 0
function HUD.Damaged(from: Vector3?, amount: number)
	hurtFlash = math.min(1, hurtFlash + amount / 40)
	if HUD.Extras then
		HUD.Extras.DamageFrom(from)
	end
end

local function buildDeath()
	local d = UIKit.Panel({ Name = "Death", Size = UDim2.fromOffset(420, 150), Position = UDim2.new(0.5, 0, 1, -120), AnchorPoint = Vector2.new(0.5, 1), BackgroundColor3 = T.Panel, BackgroundTransparency = 0.1, Visible = false, Parent = gui })
	UIKit.Stroke(T.Red, 2, 0.1).Parent = d
	refs.DeathTitle = Label({ Text = "ELIMINATED BY", Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 10), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 12, Font = T.Black, TextColor3 = T.Sub, Parent = d })
	refs.DeathKiller = Label({ Text = "", Size = UDim2.new(1, 0, 0, 32), Position = UDim2.fromOffset(0, 26), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 28, Font = T.Black, TextColor3 = T.Red, Parent = d })
	refs.DeathInfo = Label({ Text = "", Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 60), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 13, Font = T.Bold, TextColor3 = T.Text, Parent = d })
	refs.DeathTimer = Label({ Text = "", Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 80), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 14, Font = T.Black, TextColor3 = T.Accent, Parent = d })
	local pass = Monetization.GamePasses.InstantRespawn
	refs.DeathUpsell = UIKit.Button({ Text = "⏩ INSTANT RESPAWN  ·  R$ " .. pass.Price, Size = UDim2.fromOffset(300, 32), Position = UDim2.new(0.5, 0, 1, -40), AnchorPoint = Vector2.new(0.5, 0), Color = T.Robux, TextSize = 14, Parent = d }, function()
		if pass.Id > 0 then
			MarketplaceService:PromptGamePassPurchase(player, pass.Id)
		else
			HUD.Message("Set the InstantRespawn pass Id in Monetization.lua", T.Red)
		end
	end)
	refs.Death = d
end

function HUD.Death(info)
	refs.Death.Visible = true
	if info.Killer then
		refs.DeathTitle.Text = "ELIMINATED BY"
		refs.DeathKiller.Text = string.upper(info.Killer)
		refs.DeathInfo.Text = string.format("%s%s  ·  %d studs  ·  %d/%d HP left", info.Weapon, info.Headshot and " (HEADSHOT)" or "", info.Distance or 0, info.KillerHealth or 0, info.KillerMax or 100)
	else
		refs.DeathTitle.Text = "YOU DIED"
		refs.DeathKiller.Text = "WASTED"
		refs.DeathInfo.Text = info.Weapon or ""
	end
	refs.DeathUpsell.Visible = not ClientState.HasPass("InstantRespawn")
end

local function buildDowned()
	local d = UIKit.Panel({ Name = "Downed", Size = UDim2.fromOffset(440, 120), Position = UDim2.new(0.5, 0, 0.62, 0), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = Color3.fromRGB(40, 8, 8), BackgroundTransparency = 0.15, Visible = false, ZIndex = 25, Parent = gui })
	UIKit.Stroke(T.Red, 2, 0).Parent = d
	Label({ Text = "⬇ YOU'RE DOWN", Size = UDim2.new(1, 0, 0, 32), Position = UDim2.fromOffset(0, 8), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 28, Font = T.Black, TextColor3 = T.Red, ZIndex = 26, Parent = d })
	refs.DownBleed = Label({ Text = "", Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 42), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 14, Font = T.Black, ZIndex = 26, Parent = d })
	refs.DownHint = Label({ Text = "", Size = UDim2.new(1, -20, 0, 16), Position = UDim2.fromOffset(10, 64), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 12, Font = T.Bold, TextColor3 = T.Sub, ZIndex = 26, Parent = d })
	local bar, fill = UIKit.Bar({ Size = UDim2.new(1, -40, 0, 10), Position = UDim2.new(0, 20, 0, 92), Color = T.Green, Value = 0, Parent = d })
	bar.ZIndex = 26
	fill.ZIndex = 27
	refs.DownBar = bar
	refs.DownFill = fill
	refs.Down = d
end

function HUD.HideDeath()
	if refs.Death then
		refs.Death.Visible = false
	end
end

-- K.O STREAK 🔥 (5 kills without dying) -------------------------------------------------
function HUD.KOStreak()
	local holder = new("Frame", { Name = "KOStreak", Size = UDim2.fromOffset(720, 150), Position = UDim2.fromScale(0.5, 0.3), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 30, Parent = gui })
	local band = new("Frame", { Size = UDim2.new(1, 0, 0, 96), Position = UDim2.fromScale(0.5, 0.45), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(255, 90, 20), BorderSizePixel = 0, ZIndex = 30, Parent = holder })
	new("UIGradient", {
		Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 40, 20)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 170, 30)), ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 40, 20)) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.25), NumberSequenceKeypoint.new(0.8, 0.25), NumberSequenceKeypoint.new(1, 1) }),
		Parent = band,
	})
	local title = Label({ Text = "🔥 K.O STREAK 🔥", Size = UDim2.new(1, 0, 0, 80), Position = UDim2.fromScale(0.5, 0.45), AnchorPoint = Vector2.new(0.5, 0.5), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 72, Font = T.Black, TextColor3 = Color3.new(1, 1, 1), ZIndex = 31, Parent = holder })
	new("UIStroke", { Color = Color3.fromRGB(120, 20, 0), Thickness = 4, Parent = title })
	local sub = Label({ Text = "5 KILLS WITHOUT DYING  ·  INFINITE AMMO AT 15", Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0.5, 0, 0.45, 56), AnchorPoint = Vector2.new(0.5, 0), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 16, Font = T.Black, TextColor3 = Color3.fromRGB(255, 230, 180), ZIndex = 31, Parent = holder })
	UIKit.TextStroke(0.2).Parent = sub
	local scale = new("UIScale", { Scale = 2.6, Parent = holder })
	holder.Rotation = -8
	UIKit.Tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	UIKit.Tween(holder, 0.35, { Rotation = 0 }, Enum.EasingStyle.Back)
	UIKit.Sound("Unlock", 0.7)
	UIKit.Sound("Kill", 0.6)
	hurtFlash = 0
	-- flicker like flames
	task.spawn(function()
		local start = os.clock()
		while holder.Parent and os.clock() - start < 2.6 do
			local f = 0.5 + 0.5 * math.sin((os.clock() - start) * 18)
			title.TextColor3 = Color3.new(1, 1, 1):Lerp(Color3.fromRGB(255, 220, 120), f)
			task.wait(0.03)
		end
	end)
	task.delay(2.6, function()
		UIKit.Tween(scale, 0.3, { Scale = 0.6 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		UIKit.Tween(band, 0.3, { BackgroundTransparency = 1 })
		UIKit.Tween(title, 0.3, { TextTransparency = 1 })
		UIKit.Tween(sub, 0.3, { TextTransparency = 1 })
		task.wait(0.35)
		holder:Destroy()
	end)
end

-- NUKE ------------------------------------------------------------------------------
function HUD.Nuke(seconds: number, owner: string)
	HUD.Announce({ Text = "TACTICAL NUKE INCOMING", Sub = "Dropped by " .. owner, Color = T.Red, Icon = "☢️" })
	task.spawn(function()
		for i = seconds, 1, -1 do
			refs.Nuke.Text = tostring(i)
			refs.Nuke.TextTransparency = 0
			UIKit.Tween(refs.Nuke, 0.9, { TextTransparency = 0.6 })
			UIKit.Sound("Empty", 0.5)
			task.wait(1)
		end
		refs.Nuke.Text = ""
	end)
end

function HUD.WhiteFlash()
	refs.White.BackgroundTransparency = 0
	UIKit.Tween(refs.White, 2.5, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
end

local statusUntil, statusText = 0, ""
function HUD.Status(text: string, duration: number)
	statusText = text
	statusUntil = os.clock() + duration
end

-- PER FRAME --------------------------------------------------------------------------
local function streakText(streak: number)
	local reduce = ClientState.HasPass("RadarPro") and 1 or 0
	for _, ks in Config.Killstreaks do
		local need = ks.Kills - reduce
		if streak < need then
			return string.format("STREAK <font color='#FFC61A'>%d</font>  ·  NEXT: %s %s <font color='#9AA2B4'>(%d)</font>", streak, ks.Icon, ks.Name, need), need
		end
	end
	return string.format("STREAK <font color='#FFC61A'>%d</font>  ·  ALL REWARDS EARNED", streak), streak
end

local lastPipCount = -1
local function update(dt: number)
	local now = workspace:GetServerTimeNow()
	local state = ReplicatedStorage:GetAttribute("MatchState") or "Intermission"
	local left = math.max(0, (ReplicatedStorage:GetAttribute("MatchEnd") or 0) - now)

	refs.Timer.Text = Util.Time(left)
	local modeId = ReplicatedStorage:GetAttribute("Mode") or "TDM"
	local modeDef = Config.Modes[modeId] or Config.Modes.TDM
	local goal = ReplicatedStorage:GetAttribute("KillsToWin") or modeDef.KillsToWin
	refs.Mode.Text = (ReplicatedStorage:GetAttribute("MapName") or "") .. " · " .. modeDef.Short .. " · FIRST TO " .. goal
	refs.Timer.TextColor3 = (state == "Active" and left < 30) and T.Red or T.Text
	if state == "Intermission" then
		refs.Banner.Text = "WARMUP  ·  MATCH STARTS IN " .. math.ceil(left)
	elseif state == "Results" then
		refs.Banner.Text = "MATCH OVER  ·  VOTING IN " .. math.ceil(left)
	elseif state == "Voting" then
		refs.Banner.Text = "VOTING  ·  " .. math.ceil(left)
	else
		refs.Banner.Text = ""
	end
	local myTeam = player:GetAttribute("Team")
	local function paint(boxFrame, line, title, team)
		local c = Config.Teams[team].Color
		boxFrame.BackgroundColor3 = c:Lerp(Color3.new(), 0.55)
		line.BackgroundColor3 = c
		title.TextColor3 = c:Lerp(Color3.new(1, 1, 1), 0.4)
	end
	if #modeDef.Teams == 0 or not myTeam then
		refs.YouTitle.Text = "YOU"
		refs.YouTitle.TextColor3 = T.Accent2
		refs.YouBox.BackgroundColor3 = Color3.fromRGB(0, 90, 130)
		refs.YouLine.BackgroundColor3 = T.Accent2
		refs.YouKills.Text = tostring(player:GetAttribute("Kills") or 0)
		local leader = ReplicatedStorage:GetAttribute("Leader") or ""
		refs.LeaderName.Text = leader ~= "" and string.upper(leader) or "LEADER"
		refs.LeaderName.TextColor3 = Color3.fromRGB(255, 140, 140)
		refs.LeadBox.BackgroundColor3 = Color3.fromRGB(130, 20, 30)
		refs.LeadLine.BackgroundColor3 = T.Red
		refs.LeaderKills.Text = tostring(ReplicatedStorage:GetAttribute("LeaderScore") or 0)
		refs.ExtraBox.Visible = false
	else
		local others = {}
		for _, t in modeDef.Teams do
			if t ~= myTeam then
				table.insert(others, t)
			end
		end
		refs.YouTitle.Text = Config.Teams[myTeam].Name .. " (YOU)"
		refs.YouKills.Text = tostring(ReplicatedStorage:GetAttribute("Score_" .. myTeam) or 0)
		paint(refs.YouBox, refs.YouLine, refs.YouTitle, myTeam)
		local o1 = others[1]
		refs.LeaderName.Text = Config.Teams[o1].Name
		refs.LeaderKills.Text = tostring(ReplicatedStorage:GetAttribute("Score_" .. o1) or 0)
		paint(refs.LeadBox, refs.LeadLine, refs.LeaderName, o1)
		local o2 = others[2]
		refs.ExtraBox.Visible = o2 ~= nil
		if o2 then
			refs.ExtraName.Text = Config.Teams[o2].Name
			refs.ExtraKills.Text = tostring(ReplicatedStorage:GetAttribute("Score_" .. o2) or 0)
			paint(refs.ExtraBox, refs.ExtraLine, refs.ExtraName, o2)
		end
	end
	refs.TopBar.Size = UDim2.fromOffset(refs.ExtraBox.Visible and 516 or 420, 62)

	-- downed overlay
	local downed = player:GetAttribute("Downed") == true
	refs.Down.Visible = downed
	if downed then
		local char = player.Character
		local h = char and char:FindFirstChildOfClass("Humanoid")
		local bleed = h and math.max(0, h.Health / Config.BleedRate) or 0
		refs.DownBleed.Text = string.format("BLEEDING OUT IN %ds", math.ceil(bleed))
		local used = player:GetAttribute("SelfReviveUsed") == true
		local progress = HUD.SelfReviveProgress or 0
		refs.DownFill.Size = UDim2.fromScale(math.clamp(progress, 0, 1), 1)
		refs.DownHint.Text = used and "Self-revive used · wait for a teammate (they hold E)" or ("HOLD [F] TO SELF-REVIVE" .. (myTeam and " · or a teammate can revive you" or ""))
		refs.DownBar.Visible = not used
	end

	-- profile
	refs.Level.Text = tostring(player:GetAttribute("Level") or 1)
	refs.Cash.Text = "$" .. Util.Comma(player:GetAttribute("Cash") or 0)
	local xp, need = player:GetAttribute("XP") or 0, player:GetAttribute("XPNeeded") or 1
	refs.XPFill.Size = UDim2.fromScale(math.clamp(xp / need, 0, 1), 1)
	refs.XPText.Text = string.format("LVL %d  ·  %s / %s XP", player:GetAttribute("Level") or 1, Util.Comma(xp), Util.Comma(need))

	-- boost pills
	local boosts = {}
	if ClientState.HasPass("VIP") then
		table.insert(boosts, { "👑 VIP 2X CASH", T.Gold })
	end
	if ClientState.HasPass("DoubleXP") then
		table.insert(boosts, { "2X XP", T.Accent2 })
	end
	local boostLeft = (player:GetAttribute("BoostUntil") or 0) - os.time()
	if boostLeft > 0 then
		table.insert(boosts, { "🚀 3X XP " .. Util.Time(boostLeft), T.Green })
	end
	local key = ""
	for _, b in boosts do
		key ..= b[1]
	end
	if refs.BoostKey ~= key then
		refs.BoostKey = key
		for _, c in refs.Boosts:GetChildren() do
			if c:IsA("Frame") then
				c:Destroy()
			end
		end
		for _, b in boosts do
			pill(refs.Boosts, b[1], b[2])
		end
	end

	-- health
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		local frac = math.clamp(hum.Health / math.max(1, hum.MaxHealth), 0, 1)
		refs.HP.Text = tostring(math.ceil(hum.Health))
		refs.HPFill.Size = UDim2.fromScale(frac, 1)
		local trail = refs.HPTrail.Size.X.Scale
		refs.HPTrail.Size = UDim2.fromScale(trail > frac and math.max(frac, trail - dt * 0.6) or frac, 1)
		refs.HPFill.BackgroundColor3 = T.Red:Lerp(T.Green, frac)
		refs.HP.TextColor3 = frac < 0.3 and T.Red or T.Text
		local low = frac < 0.35 and hum.Health > 0 and (0.35 - frac) * 1.6 or 0
		hurtFlash = math.max(0, hurtFlash - dt * 1.5)
		local v = math.clamp(math.max(low, hurtFlash), 0, 0.85)
		for _, f in refs.Vignette do
			f.BackgroundTransparency = 1 - v
		end
	end

	-- streak
	local streak = player:GetAttribute("Streak") or 0
	local text, target = streakText(streak)
	refs.Streak.Text = text
	if target ~= lastPipCount then
		lastPipCount = target
		for _, c in refs.StreakPips:GetChildren() do
			if c:IsA("Frame") then
				c:Destroy()
			end
		end
		for i = 1, math.min(target, 25) do
			new("Frame", { Name = "Pip", Size = UDim2.fromOffset(14, 6), BackgroundColor3 = T.Panel3, BorderSizePixel = 0, LayoutOrder = i, Parent = refs.StreakPips })
		end
	end
	for _, c in refs.StreakPips:GetChildren() do
		if c:IsA("Frame") then
			c.BackgroundColor3 = c.LayoutOrder <= streak and T.Accent or T.Panel3
		end
	end

	-- equipment + tokens
	refs.Nades.Text = string.format("💣 x%d <font color='#9AA2B4'>[G]</font>", player:GetAttribute("Grenades") or 0)
	local air, nuke = player:GetAttribute("AirstrikeTokens") or 0, player:GetAttribute("NukeTokens") or 0
	refs.TokenAir.Parent.Visible = air > 0
	refs.TokenAir.Text = string.format("✈️ x%d <font color='#9AA2B4'>[Z]</font>", air)
	refs.TokenNuke.Parent.Visible = nuke > 0
	refs.TokenNuke.Text = string.format("☢️ x%d <font color='#9AA2B4'>[X]</font>", nuke)

	-- ability cooldowns
	local S = Movement.State
	local clock = os.clock()
	local function cd(last, duration)
		return math.clamp(1 - (clock - last) / duration, 0, 1)
	end
	refs.Abilities.Dash.Size = UDim2.fromScale(1, cd(S.LastDash, Movement.DashCooldown()))
	refs.Abilities.Slide.Size = UDim2.fromScale(1, cd(S.LastSlide, Config.SlideCooldown))
	refs.Abilities.Slam.Size = UDim2.fromScale(1, cd(S.LastSlam, Config.SlamCooldown))

	-- status line (killstreaks)
	if clock < statusUntil then
		refs.Status.Text = string.format("%s  %ds", statusText, math.ceil(statusUntil - clock))
	elseif player:GetAttribute("InfiniteAmmo") then
		refs.Status.Text = "♾️ INFINITE AMMO — NO RELOADS UNTIL YOU DIE"
	elseif ClientState.Overdrive() then
		refs.Status.Text = "⚡ OVERDRIVE ACTIVE"
	else
		refs.Status.Text = ""
	end

	-- death timer
	if refs.Death.Visible then
		local respawn = (player:GetAttribute("RespawnAt") or 0) - now
		refs.DeathTimer.Text = respawn > 0 and string.format("RESPAWNING IN %.1f", respawn) or "RESPAWNING..."
	end
end

-- PUBLIC ----------------------------------------------------------------------------
HUD.Extras = nil
function HUD.SetVisible(visible: boolean)
	if gui then
		gui.Enabled = visible
	end
end

function HUD.Init(playerGui: PlayerGui)
	gui = new("ScreenGui", { Name = "HUD", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Enabled = false, Parent = playerGui })
	buildCenter()
	buildTopBar()
	buildProfile()
	buildSideMenu()
	buildKillfeed()
	buildHealth()
	buildAmmo()
	buildAbilities()
	buildCrosshair()
	buildDeath()
	buildDowned()
	HUD.Gui = gui
	HUD.Extras = require(script.Parent.HUDExtras)
	HUD.Extras.Init(gui)
	RunService.RenderStepped:Connect(update)
end

return HUD
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">HUDExtras</string>
            <string name="Source"><![CDATA[-- Extra HUD widgets: minimap radar, damage direction arrows, aimed-target info,
-- vehicle speedometer and the minigun spin meter.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local UIKit = require(script.Parent.UIKit)
local ClientState = require(script.Parent.ClientState)
local Effects = require(script.Parent.Effects)
local Vehicle = require(script.Parent.VehicleController)
local Weapons = require(script.Parent.WeaponController)

local player = Players.LocalPlayer
local T = UIKit.Theme
local new, Label = UIKit.new, UIKit.Label

local Extras = {}
local refs = {}
local RADAR_RANGE = 160
local RADAR_SIZE = 170

-- every other fighter (allies included; check ClientState.IsAlly)
local function enemies()
	local list = {}
	for _, p in Players:GetPlayers() do
		if p ~= player and p.Character then
			table.insert(list, p.Character)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, b in bots:GetChildren() do
			table.insert(list, b)
		end
	end
	return list
end

-- MINIMAP --------------------------------------------------------------------------
local function buildRadar(gui)
	local frame = UIKit.Panel({ Name = "Radar", Size = UDim2.fromOffset(RADAR_SIZE, RADAR_SIZE), Position = UDim2.fromOffset(16, 12), BackgroundColor3 = Color3.fromRGB(8, 12, 16), BackgroundTransparency = 0.3, Parent = gui })
	frame.ClipsDescendants = true
	UIKit.Stroke(Color3.new(1, 1, 1), 1.5, 0.75).Parent = frame
	for i = 1, 3 do
		local ring = new("Frame", { Size = UDim2.fromScale(i / 3, i / 3), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Parent = frame })
		new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = ring })
		new("UIStroke", { Color = T.Accent2, Transparency = 0.8, Parent = ring })
	end
	new("Frame", { Size = UDim2.new(1, 0, 0, 1), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = T.Accent2, BackgroundTransparency = 0.85, BorderSizePixel = 0, Parent = frame })
	new("Frame", { Size = UDim2.new(0, 1, 1, 0), Position = UDim2.fromScale(0.5, 0), BackgroundColor3 = T.Accent2, BackgroundTransparency = 0.85, BorderSizePixel = 0, Parent = frame })
	-- view cone + you
	local me = Label({ Text = "▲", Size = UDim2.fromOffset(16, 16), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 14, Font = T.Black, TextColor3 = T.Accent, ZIndex = 5, Parent = frame })
	refs.RadarMe = me
	refs.North = Label({ Text = "N", Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 11, Font = T.Black, TextColor3 = T.Sub, ZIndex = 5, Parent = frame })
	refs.MapName = Label({ Text = "", Size = UDim2.new(1, -8, 0, 14), Position = UDim2.new(0, 4, 1, -16), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 10, Font = T.Black, TextColor3 = T.Sub, ZIndex = 5, Parent = frame })
	refs.Radar = frame
	refs.Dots = {}
end

local function dot(i: number)
	local d = refs.Dots[i]
	if not d then
		d = new("Frame", { Size = UDim2.fromOffset(7, 7), AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, ZIndex = 4, Parent = refs.Radar })
		new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = d })
		refs.Dots[i] = d
	end
	d.Visible = true
	return d
end

local function updateRadar()
	local cam = workspace.CurrentCamera
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local origin = root and root.Position or cam.CFrame.Position
	local look = cam.CFrame.LookVector
	local yaw = math.atan2(-look.X, -look.Z)
	local cosY, sinY = math.cos(yaw), math.sin(yaw)
	local function toRadar(pos: Vector3)
		local dx, dz = pos.X - origin.X, pos.Z - origin.Z
		-- rotate so camera forward is "up"
		local rx = dx * cosY - dz * sinY
		local rz = dx * sinY + dz * cosY
		local s = (RADAR_SIZE / 2) / RADAR_RANGE
		return rx * s, rz * s, math.sqrt(dx * dx + dz * dz)
	end
	local n = 0
	local now = os.clock()
	local uav = Effects.UAVActive()
	for _, enemy in enemies() do
		local r = enemy:FindFirstChild("HumanoidRootPart")
		local hum = enemy:FindFirstChildOfClass("Humanoid")
		local ally = ClientState.IsAlly(enemy)
		if r and hum and hum.Health > 0 and (ally or uav or now - (Effects.LastFired[enemy] or -10) < 2.5) then
			local x, y, dist = toRadar(r.Position)
			if dist < RADAR_RANGE then
				n += 1
				local d = dot(n)
				d.BackgroundColor3 = ally and Color3.fromRGB(70, 160, 255) or T.Red
				d.Size = UDim2.fromOffset(8, 8)
				d.Position = UDim2.new(0.5, x, 0.5, y)
			end
		end
	end
	-- health packs + vehicles
	local map = workspace:FindFirstChild("Map")
	local props = map and map:FindFirstChild("Props")
	if props then
		for _, p in props:GetChildren() do
			if p:IsA("BasePart") and p:GetAttribute("HealthPack") then
				local x, y, dist = toRadar(p.Position)
				if dist < RADAR_RANGE then
					n += 1
					local d = dot(n)
					d.BackgroundColor3 = T.Green
					d.Size = UDim2.fromOffset(6, 6)
					d.Position = UDim2.new(0.5, x, 0.5, y)
				end
			end
		end
	end
	local vehicles = workspace:FindFirstChild("Vehicles")
	if vehicles then
		for _, car in vehicles:GetChildren() do
			if car.PrimaryPart and not car:GetAttribute("Parked") then
				local x, y, dist = toRadar(car.PrimaryPart.Position)
				if dist < RADAR_RANGE then
					n += 1
					local d = dot(n)
					d.BackgroundColor3 = Color3.new(1, 1, 1)
					d.Size = UDim2.fromOffset(6, 9)
					d.Position = UDim2.new(0.5, x, 0.5, y)
				end
			end
		end
	end
	for i = n + 1, #refs.Dots do
		refs.Dots[i].Visible = false
	end
	-- north marker on the rim
	local nx, ny = sinY, -cosY
	refs.North.Position = UDim2.new(0.5, nx * (RADAR_SIZE / 2 - 10), 0.5, ny * (RADAR_SIZE / 2 - 10))
	refs.MapName.Text = (ReplicatedStorage:GetAttribute("MapName") or "") .. (uav and "  ·  📡 UAV" or "")
end

-- DAMAGE ARROWS ------------------------------------------------------------------------
function Extras.DamageFrom(from: Vector3?)
	if not from or not refs.Arrows then
		return
	end
	local cam = workspace.CurrentCamera
	local dir = from - cam.CFrame.Position
	local look = cam.CFrame.LookVector
	local angle = math.atan2(dir.X, dir.Z) - math.atan2(look.X, look.Z)
	local deg = -math.deg(angle)
	local holder = new("Frame", { Size = UDim2.fromOffset(240, 240), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Rotation = deg, Parent = refs.Arrows })
	local arrow = Label({ Text = "▲", Size = UDim2.fromOffset(40, 30), Position = UDim2.new(0.5, 0, 0, 0), AnchorPoint = Vector2.new(0.5, 0), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 34, Font = T.Black, TextColor3 = T.Red, Parent = holder })
	UIKit.TextStroke(0.3).Parent = arrow
	UIKit.Tween(arrow, 1.3, { TextTransparency = 1 })
	task.delay(1.35, function()
		holder:Destroy()
	end)
end

-- TARGET INFO ------------------------------------------------------------------------------
local function buildTarget(gui)
	local f = new("Frame", { Name = "Target", Size = UDim2.fromOffset(200, 34), Position = UDim2.new(0.5, 0, 0.5, -70), AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 1, Visible = false, Parent = gui })
	refs.TargetName = Label({ Text = "", Size = UDim2.new(1, 0, 0, 18), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 14, Font = T.Black, TextColor3 = T.Red, Parent = f })
	UIKit.TextStroke(0.3).Parent = refs.TargetName
	local bar, fill = UIKit.Bar({ Size = UDim2.fromOffset(110, 5), Position = UDim2.new(0.5, 0, 0, 22), AnchorPoint = Vector2.new(0.5, 0), Color = T.Red, Parent = f })
	refs.TargetBar = bar
	refs.TargetFill = fill
	refs.Target = f
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local function updateTarget()
	local cam = workspace.CurrentCamera
	rayParams.FilterDescendantsInstances = { player.Character, cam, workspace:FindFirstChild("Effects") }
	local result = workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * 400, rayParams)
	local model = result and result.Instance:FindFirstAncestorOfClass("Model")
	local hum = model and model:FindFirstChildOfClass("Humanoid")
	if not hum and model and model.Parent and model.Parent:IsA("Model") then
		model = model.Parent
		hum = model:FindFirstChildOfClass("Humanoid")
	end
	if hum and hum.Health > 0 and ClientState.Deployed and not ClientState.Dead then
		local isBot = model:GetAttribute("BotName") ~= nil
		local ally = ClientState.IsAlly(model)
		refs.TargetName.Text = (ally and "ALLY · " or "") .. string.upper(model.Name) .. (isBot and "  [BOT]" or "")
		refs.TargetName.TextColor3 = ally and Color3.fromRGB(90, 170, 255) or T.Red
		refs.TargetFill.BackgroundColor3 = ally and Color3.fromRGB(90, 170, 255) or T.Red
		refs.TargetFill.Size = UDim2.fromScale(math.clamp(hum.Health / hum.MaxHealth, 0, 1), 1)
		refs.Target.Visible = true
	else
		refs.Target.Visible = false
	end
end

-- VEHICLE HUD + MINIGUN --------------------------------------------------------------------
local function buildVehicle(gui)
	local f = UIKit.Panel({ Name = "VehicleHUD", Size = UDim2.fromOffset(300, 74), Position = UDim2.new(0.5, 0, 1, -40), AnchorPoint = Vector2.new(0.5, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.4, Visible = false, Parent = gui })
	refs.Speed = Label({ Text = "0", Size = UDim2.fromOffset(110, 44), Position = UDim2.fromOffset(12, 6), TextXAlignment = Enum.TextXAlignment.Right, TextSize = 42, Font = T.Black, Parent = f })
	Label({ Text = "MPH", Size = UDim2.fromOffset(40, 16), Position = UDim2.fromOffset(126, 28), TextSize = 12, Font = T.Black, TextColor3 = T.Sub, Parent = f })
	refs.CarName = Label({ Text = "", Size = UDim2.fromOffset(120, 16), Position = UDim2.fromOffset(170, 10), TextSize = 12, Font = T.Black, TextColor3 = T.Accent, Parent = f })
	local _, fill = UIKit.Bar({ Size = UDim2.fromOffset(116, 8), Position = UDim2.fromOffset(170, 32), Color = T.Green, Parent = f })
	refs.CarHealth = fill
	Label({ Text = "W/S drive · A/D steer · SHIFT boost · CTRL drift · SPACE exit", Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 1, -18), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 10, Font = T.Bold, TextColor3 = T.Sub, Parent = f })
	refs.Vehicle = f

	local spinBar, spinFill = UIKit.Bar({ Size = UDim2.fromOffset(80, 4), Position = UDim2.new(0.5, 0, 0.5, 34), AnchorPoint = Vector2.new(0.5, 0), Color = T.Accent, Parent = gui })
	refs.SpinBar = spinBar
	refs.SpinFill = spinFill
end

local function updateVehicle()
	local car = Vehicle.Car
	refs.Vehicle.Visible = car ~= nil
	local abilities = refs.Gui:FindFirstChild("Abilities")
	if abilities then
		abilities.Visible = car == nil
	end
	if car then
		refs.Speed.Text = tostring(math.floor(Vehicle.Speed * 0.6))
		if Vehicle.Boosting then
			refs.CarName.Text = "🚀 DRIFT BOOST"
		elseif Vehicle.Drifting then
			refs.CarName.Text = string.format("🌀 DRIFT %.1fs", Vehicle.DriftTime)
		else
			refs.CarName.Text = string.upper(car.Name)
		end
		local hp, max = car:GetAttribute("Health") or 0, car:GetAttribute("MaxHealth") or 1
		refs.CarHealth.Size = UDim2.fromScale(math.clamp(hp / max, 0, 1), 1)
		refs.CarHealth.BackgroundColor3 = T.Red:Lerp(T.Green, math.clamp(hp / max, 0, 1))
	end
	local def = Weapons.CurrentDef()
	local spin = Weapons.Spin()
	refs.SpinBar.Visible = def ~= nil and def.SpinUp ~= nil and spin > 0 and spin < 1
	refs.SpinFill.Size = UDim2.fromScale(spin, 1)
end

-- TEAMMATE MARKERS + REVIVE PROMPTS ---------------------------------------------------------
local markers = {} -- [character] = BillboardGui
local function updateTeammates()
	local seen = {}
	for _, char in enemies() do
		local ally = ClientState.IsAlly(char)
		local downed = char:GetAttribute("Downed") == true
		local head = char:FindFirstChild("Head")
		local hum = char:FindFirstChildOfClass("Humanoid")
		-- only teammates may see / use a downed player's revive prompt
		local root = char:FindFirstChild("HumanoidRootPart")
		local prompt = root and root:FindFirstChild("RevivePrompt")
		if prompt then
			prompt.Enabled = ally and downed and not ClientState.Dead and player:GetAttribute("Downed") ~= true
		end
		if ally and head and hum and hum.Health > 0 then
			seen[char] = true
			local bb = markers[char]
			if not bb then
				bb = new("BillboardGui", { Size = UDim2.fromOffset(160, 40), StudsOffset = Vector3.new(0, 2.6, 0), AlwaysOnTop = true, LightInfluence = 0, MaxDistance = 600, Adornee = head, Parent = player:FindFirstChildOfClass("PlayerGui") })
				local l = Label({ Name = "NameLabel", Text = "", Size = UDim2.fromScale(1, 0.5), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 13, Font = T.Black, TextColor3 = Color3.fromRGB(110, 180, 255), Parent = bb })
				UIKit.TextStroke(0.3).Parent = l
				local r = Label({ Name = "ReviveLabel", Text = "✚ REVIVE", Size = UDim2.fromScale(1, 0.5), Position = UDim2.fromScale(0, 0.5), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 15, Font = T.Black, TextColor3 = Color3.fromRGB(255, 120, 60), Parent = bb })
				UIKit.TextStroke(0.2).Parent = r
				markers[char] = bb
			end
			bb.Adornee = head
			bb:FindFirstChild("NameLabel").Text = "▼ " .. char.Name
			bb:FindFirstChild("ReviveLabel").Visible = downed
		end
	end
	for char, bb in markers do
		if not seen[char] then
			bb:Destroy()
			markers[char] = nil
		end
	end
end

function Extras.Init(gui: ScreenGui)
	refs.Gui = gui
	buildRadar(gui)
	buildTarget(gui)
	buildVehicle(gui)
	refs.Arrows = new("Frame", { Name = "DamageArrows", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })
	local acc = 0
	RunService.RenderStepped:Connect(function(dt)
		acc += dt
		updateVehicle()
		if acc >= 1 / 15 then
			acc = 0
			updateRadar()
			updateTarget()
			updateTeammates()
		end
	end)
end

return Extras
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Menus</string>
            <string name="Source"><![CDATA[-- Full-screen menus: Main Menu, Armory, Store (Robux), Achievements,
-- Scoreboard (hold TAB), Match Results and Daily Rewards.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Weapons = require(Shared.Weapons)
local Achievements = require(Shared.Achievements)
local Monetization = require(Shared.Monetization)
local GunBuilder = require(Shared.GunBuilder)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)
local UIKit = require(script.Parent.UIKit)
local ClientState = require(script.Parent.ClientState)
local Effects = require(script.Parent.Effects)

local player = Players.LocalPlayer
local T = UIKit.Theme
local new, Label = UIKit.new, UIKit.Label

local Menus = {}
Menus.OnDeploy = nil -- injected
Menus.Notify = function(_text, _color) end -- injected (HUD.Message)

local gui
local renderSettings
local windows = {}
local openName = nil
local mainMenu, scoreboard, results

-- PURCHASES ----------------------------------------------------------------------
function Menus.BuyPass(key: string)
	local pass = Monetization.GamePasses[key]
	if not pass then
		return
	end
	if pass.Id and pass.Id > 0 then
		MarketplaceService:PromptGamePassPurchase(player, pass.Id)
	else
		Menus.Notify("Developer: set the '" .. key .. "' game pass Id in Monetization.lua", T.Red)
	end
end

function Menus.BuyProduct(key: string)
	local product = Monetization.Products[key]
	if not product then
		return
	end
	if product.Id and product.Id > 0 then
		MarketplaceService:PromptProductPurchase(player, product.Id)
	else
		Menus.Notify("Developer: set the '" .. key .. "' product Id in Monetization.lua", T.Red)
	end
end

-- WINDOW FRAME ---------------------------------------------------------------------
local function window(name: string, title: string, tabs)
	local overlay = new("TextButton", {
		Name = name, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35,
		Text = "", AutoButtonColor = false, Modal = true, Visible = false, ZIndex = 5, Parent = gui,
	})
	local panel = UIKit.Panel({
		Size = UDim2.fromScale(0.92, 0.86), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = T.Bg, BackgroundTransparency = 0.03, ZIndex = 5, Parent = overlay,
	})
	new("UISizeConstraint", { MaxSize = Vector2.new(980, 620), Parent = panel })
	UIKit.Stroke(Color3.new(1, 1, 1), 1, 0.9).Parent = panel
	Label({ Text = title, Size = UDim2.new(1, -200, 0, 40), Position = UDim2.fromOffset(24, 14), TextSize = 30, Font = T.Black, ZIndex = 6, Parent = panel })
	new("Frame", { Size = UDim2.fromOffset(60, 4), Position = UDim2.fromOffset(24, 56), BackgroundColor3 = T.Accent, BorderSizePixel = 0, ZIndex = 6, Parent = panel })
	local right = new("Frame", { Size = UDim2.fromOffset(400, 40), Position = UDim2.new(1, -64, 0, 14), AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, ZIndex = 6, Parent = panel }, {
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local close = UIKit.Button({ Text = "✕", Size = UDim2.fromOffset(40, 40), Position = UDim2.new(1, -14, 0, 14), AnchorPoint = Vector2.new(1, 0), Color = T.Panel3, TextSize = 18, Parent = panel }, function()
		Menus.Close()
	end)
	close.ZIndex = 6

	local tabBar = new("Frame", { Size = UDim2.new(1, -48, 0, 34), Position = UDim2.fromOffset(24, 70), BackgroundTransparency = 1, ZIndex = 6, Parent = panel }, { UIKit.List(6, true) })
	local content = new("Frame", { Name = "Content", Size = UDim2.new(1, -48, 1, -124), Position = UDim2.fromOffset(24, 112), BackgroundTransparency = 1, ZIndex = 6, Parent = panel })

	local w = { Name = name, Overlay = overlay, Panel = panel, Content = content, Right = right, Tab = tabs and tabs[1] or nil, TabButtons = {} }
	if tabs then
		for i, tab in tabs do
			local b = UIKit.Button({ Text = string.upper(tab), Size = UDim2.fromOffset(0, 34), Color = T.Panel2, TextSize = 13, LayoutOrder = i, Parent = tabBar }, function()
				w.Tab = tab
				if w.Render then
					w.Render()
				end
			end)
			b.AutomaticSize = Enum.AutomaticSize.X
			new("UIPadding", { PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16), Parent = b })
			b.ZIndex = 6
			w.TabButtons[tab] = b
		end
	end
	function w.SyncTabs()
		for tab, b in w.TabButtons do
			UIKit.SetButtonColor(b, tab == w.Tab and T.Accent or T.Panel2)
		end
	end
	windows[name] = w
	return w
end

local function clear(frame: Instance)
	for _, c in frame:GetChildren() do
		c:Destroy()
	end
end

local function scroller(parent: Instance, cell: UDim2?)
	local s = new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 6,
		ScrollBarImageColor3 = T.Accent, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 6, Parent = parent,
	})
	if cell then
		new("UIGridLayout", { CellSize = cell, CellPadding = UDim2.fromOffset(12, 12), SortOrder = Enum.SortOrder.LayoutOrder, Parent = s })
	else
		UIKit.List(8).Parent = s
	end
	new("UIPadding", { PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 2), PaddingLeft = UDim.new(0, 2), Parent = s })
	return s
end

local function cashChip(parent)
	local chip = UIKit.Panel({ Size = UDim2.fromOffset(0, 36), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = T.Panel2, LayoutOrder = 1, Parent = parent })
	new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), Parent = chip })
	Label({ Text = "$" .. Util.Comma(player:GetAttribute("Cash") or 0), Size = UDim2.fromOffset(0, 36), AutomaticSize = Enum.AutomaticSize.X, TextSize = 18, Font = T.Black, TextColor3 = T.Green, ZIndex = 7, Parent = chip })
	chip.ZIndex = 6
	local more = UIKit.Button({ Text = "+ GET CASH", Size = UDim2.fromOffset(120, 36), Color = T.Robux, TextSize = 13, LayoutOrder = 2, Parent = parent }, function()
		Menus.Open("Store", "Cash & Boosts")
	end)
	more.ZIndex = 6
end

-- ARMORY ---------------------------------------------------------------------------
local function gunPreview(parent, id: string)
	local def = Weapons.Get(id)
	local vpf = new("ViewportFrame", {
		Size = UDim2.new(1, -16, 0, 74), Position = UDim2.fromOffset(8, 44), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.6,
		Ambient = Color3.fromRGB(170, 170, 180), LightColor = Color3.new(1, 1, 1), LightDirection = Vector3.new(-1, -1, -0.5), ZIndex = 7, Parent = parent,
	})
	UIKit.Corner(6).Parent = vpf
	local model = GunBuilder.Build(id, ClientState.HasPass("GoldenArsenal"))
	model.Parent = vpf
	local cam = Instance.new("Camera")
	cam.FieldOfView = 30
	local L = def.Look.Length + def.Look.Barrel
	cam.CFrame = CFrame.lookAt(Vector3.new(L * 2.3 + 1.5, 0.6, -0.4), Vector3.new(0, 0, -0.4))
	cam.Parent = vpf
	vpf.CurrentCamera = cam
end

local function statBar(parent, y, name, value)
	Label({ Text = name, Size = UDim2.fromOffset(70, 12), Position = UDim2.fromOffset(10, y), TextSize = 10, Font = T.Black, TextColor3 = T.Sub, ZIndex = 7, Parent = parent })
	local bar = UIKit.Bar({ Size = UDim2.new(1, -96, 0, 6), Position = UDim2.fromOffset(84, y + 3), Value = math.clamp(value, 0.04, 1), Color = T.Accent, Parent = parent })
	bar.ZIndex = 7
	bar.Fill.ZIndex = 7
end

local function renderArmory(w)
	w.SyncTabs()
	clear(w.Content)
	clear(w.Right)
	cashChip(w.Right)
	local data = ClientState.Data
	if not data then
		return
	end
	local slot = w.Tab
	local list = scroller(w.Content, UDim2.fromOffset(220, 232))
	local level = player:GetAttribute("Level") or 1
	local cash = player:GetAttribute("Cash") or 0
	for order, id in Weapons.Order do
		local def = Weapons.Get(id)
		if def.Slot == slot then
			local owned = data.Owned[id] or (def.Pass and ClientState.HasPass(def.Pass))
			local equipped = data.Loadout[slot] == id
			local card = UIKit.Panel({ BackgroundColor3 = equipped and Color3.fromRGB(50, 44, 20) or T.Panel, BackgroundTransparency = 0, LayoutOrder = order, ZIndex = 6, Parent = list })
			UIKit.Stroke(equipped and T.Accent or (def.Pass and T.Robux or Color3.new(1, 1, 1)), equipped and 2 or 1, equipped and 0 or 0.85).Parent = card
			Label({ Text = def.Name, Size = UDim2.new(1, -16, 0, 18), Position = UDim2.fromOffset(10, 8), TextSize = 14, Font = T.Black, ZIndex = 7, TextTruncate = Enum.TextTruncate.AtEnd, Parent = card })
			Label({ Text = string.upper(def.Class) .. (def.Pass and "  ·  💎 EXCLUSIVE" or (def.Model and ("  ·  " .. string.upper(def.Model)) or "")), Size = UDim2.new(1, -16, 0, 14), Position = UDim2.fromOffset(10, 26), TextSize = 10, Font = T.Bold, TextColor3 = def.Pass and T.Robux or T.Sub, ZIndex = 7, Parent = card })
			gunPreview(card, id)
			local dps = def.Damage * (def.Pellets or 1) * def.FireRate * (def.Burst or 1)
			statBar(card, 126, "DAMAGE", def.Damage * (def.Pellets or 1) / 130)
			statBar(card, 140, "FIRE RATE", def.FireRate * (def.Burst or 1) / 15)
			statBar(card, 154, "DPS", dps / 400)
			statBar(card, 168, "RANGE", def.FalloffStart / 400)
			statBar(card, 182, "MOBILITY", (def.Speed - 0.7) / 0.45)

			local text, color, action
			if equipped then
				text, color = "EQUIPPED", T.Panel3
			elseif owned then
				text, color = "EQUIP", T.Accent
				action = function()
					Remotes.SetLoadout:FireServer(slot, id)
				end
			elseif def.Pass then
				text, color = "💎 R$ " .. Monetization.GamePasses[def.Pass].Price, T.Robux
				action = function()
					Menus.BuyPass(def.Pass)
				end
			elseif level < def.Level then
				text, color = "🔒 LEVEL " .. def.Level, T.Panel3
				action = function()
					Menus.Notify("Reach level " .. def.Level .. " — get 2x XP in the Store to level faster!", T.Accent)
				end
			else
				local afford = cash >= def.Price
				text, color = "BUY  $" .. Util.Comma(def.Price), afford and T.Green or T.Panel3
				action = function()
					if afford then
						Remotes.BuyWeapon:FireServer(id)
					else
						Menus.Open("Store", "Cash & Boosts")
					end
				end
			end
			local b = UIKit.Button({ Text = text, Size = UDim2.new(1, -20, 0, 30), Position = UDim2.new(0, 10, 1, -38), Color = color, TextSize = 13, Parent = card }, action)
			b.ZIndex = 7
		end
	end
end

-- STORE ------------------------------------------------------------------------------
local function storeCard(list, order, icon, name, lines, price, color, owned, highlight, onBuy)
	local card = UIKit.Panel({ BackgroundColor3 = T.Panel, BackgroundTransparency = 0, LayoutOrder = order, ZIndex = 6, Parent = list })
	UIKit.Stroke(color, highlight and 2 or 1, highlight and 0 or 0.5).Parent = card
	UIKit.Gradient(color:Lerp(T.Panel, 0.72), T.Panel, 90).Parent = card
	if highlight then
		local tag = UIKit.Panel({ Size = UDim2.fromOffset(96, 20), Position = UDim2.new(1, -8, 0, 8), AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = T.Accent, BackgroundTransparency = 0, ZIndex = 8, Parent = card })
		Label({ Text = highlight, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 10, Font = T.Black, TextColor3 = Color3.new(0, 0, 0), ZIndex = 9, Parent = tag })
	end
	Label({ Text = icon, Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromOffset(0, 12), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 42, ZIndex = 7, Parent = card })
	Label({ Text = string.upper(name), Size = UDim2.new(1, -16, 0, 20), Position = UDim2.fromOffset(8, 66), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 15, Font = T.Black, ZIndex = 7, TextTruncate = Enum.TextTruncate.AtEnd, Parent = card })
	Label({
		Text = "• " .. table.concat(lines, "\n• "), Size = UDim2.new(1, -20, 0, 70), Position = UDim2.fromOffset(10, 90),
		TextSize = 11, Font = T.Medium, TextColor3 = T.Sub, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 7, Parent = card,
	})
	local b = UIKit.Button({
		Text = owned and "OWNED ✓" or ("R$ " .. price), Size = UDim2.new(1, -20, 0, 34), Position = UDim2.new(0, 10, 1, -42),
		Color = owned and T.Panel3 or T.Robux, TextSize = 15, Parent = card,
	}, (not owned) and onBuy or nil)
	b.ZIndex = 7
end

local function renderStore(w)
	w.SyncTabs()
	clear(w.Content)
	clear(w.Right)
	cashChip(w.Right)
	local list = scroller(w.Content, UDim2.fromOffset(210, 236))
	if w.Tab == "Game Passes" then
		for i, key in Monetization.PassOrder do
			local pass = Monetization.GamePasses[key]
			local highlight = (key == "VIP" and "MOST POPULAR") or (key == "GoldenArsenal" and "MORE DAMAGE") or (key == "Railgun" and "EXCLUSIVE") or nil
			storeCard(list, i, pass.Icon, pass.Name, pass.Perks, pass.Price, pass.Color, ClientState.HasPass(key), highlight, function()
				Menus.BuyPass(key)
			end)
		end
	else
		for i, key in Monetization.ProductOrder do
			local p = Monetization.Products[key]
			local highlight = (key == "Cash2" and "POPULAR") or (key == "Cash3" and "BEST VALUE") or nil
			storeCard(list, i, p.Icon, p.Name, { p.Desc }, p.Price, key == "Nuke" and T.Red or T.Robux, false, highlight, function()
				Menus.BuyProduct(key)
			end)
		end
	end
end

-- ACHIEVEMENTS ---------------------------------------------------------------------
local function renderAchievements(w)
	w.SyncTabs()
	clear(w.Content)
	clear(w.Right)
	local data = ClientState.Data
	if not data then
		return
	end
	local unlocked = 0
	for _ in data.Achievements do
		unlocked += 1
	end
	local total = #Achievements.List
	local chip = UIKit.Panel({ Size = UDim2.fromOffset(240, 36), BackgroundColor3 = T.Panel2, Parent = w.Right })
	chip.ZIndex = 6
	Label({ Text = string.format("🏆 %d / %d UNLOCKED", unlocked, total), Size = UDim2.new(1, -16, 0, 20), Position = UDim2.fromOffset(10, 3), TextSize = 13, Font = T.Black, TextColor3 = T.Gold, ZIndex = 7, Parent = chip })
	local bar = UIKit.Bar({ Size = UDim2.new(1, -20, 0, 5), Position = UDim2.fromOffset(10, 25), Value = unlocked / total, Color = T.Gold, Parent = chip })
	bar.ZIndex = 7
	bar.Fill.ZIndex = 7

	local list = scroller(w.Content)
	local rows = {}
	for i, a in Achievements.List do
		if w.Tab == "All" or a.Category == w.Tab then
			table.insert(rows, { a = a, i = i, done = data.Achievements[a.Id] ~= nil })
		end
	end
	-- closest-to-complete first, finished ones last
	table.sort(rows, function(x, y)
		if x.done ~= y.done then
			return not x.done
		end
		local px = math.min(1, (data.Stats[x.a.Stat] or 0) / x.a.Goal)
		local py = math.min(1, (data.Stats[y.a.Stat] or 0) / y.a.Goal)
		if px ~= py then
			return px > py
		end
		return x.i < y.i
	end)
	for order, r in rows do
		local a = r.a
		local value = math.min(data.Stats[a.Stat] or 0, a.Goal)
		local row = UIKit.Panel({ Size = UDim2.new(1, 0, 0, 62), BackgroundColor3 = r.done and Color3.fromRGB(52, 44, 16) or T.Panel, BackgroundTransparency = 0, LayoutOrder = order, ZIndex = 6, Parent = list })
		if r.done then
			UIKit.Stroke(T.Gold, 1, 0.4).Parent = row
		end
		local iconBox = UIKit.Panel({ Size = UDim2.fromOffset(46, 46), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = r.done and T.Gold or T.Panel3, BackgroundTransparency = r.done and 0.2 or 0, ZIndex = 7, Parent = row })
		Label({ Text = a.Icon, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 24, ZIndex = 8, TextTransparency = r.done and 0 or 0.4, Parent = iconBox })
		Label({ Text = a.Name .. (r.done and "  ✓" or ""), Size = UDim2.new(0.5, 0, 0, 20), Position = UDim2.fromOffset(64, 9), TextSize = 15, Font = T.Black, TextColor3 = r.done and T.Gold or T.Text, ZIndex = 7, Parent = row })
		Label({ Text = a.Desc, Size = UDim2.new(0.55, 0, 0, 16), Position = UDim2.fromOffset(64, 30), TextSize = 12, Font = T.Medium, TextColor3 = T.Sub, ZIndex = 7, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
		local pb = UIKit.Bar({ Size = UDim2.new(0.28, 0, 0, 8), Position = UDim2.new(0.62, 0, 0, 16), Value = value / a.Goal, Color = r.done and T.Gold or T.Accent2, Parent = row })
		pb.ZIndex = 7
		pb.Fill.ZIndex = 7
		Label({ Text = Util.Comma(value) .. " / " .. Util.Comma(a.Goal), Size = UDim2.new(0.28, 0, 0, 14), Position = UDim2.new(0.62, 0, 0, 30), TextSize = 11, Font = T.Bold, TextColor3 = T.Sub, ZIndex = 7, Parent = row })
		Label({ Text = "$" .. Util.Comma(a.Reward), Size = UDim2.fromOffset(80, 62), Position = UDim2.new(1, -90, 0, 0), TextXAlignment = Enum.TextXAlignment.Right, TextSize = 15, Font = T.Black, TextColor3 = r.done and T.Sub or T.Green, ZIndex = 7, Parent = row })
	end
end

-- SETTINGS ------------------------------------------------------------------------------
local function saveSettings()
	Effects.ShakeScale = ClientState.Settings.Shake
	Remotes.SaveSettings:FireServer(ClientState.Settings)
end

function renderSettings(w)
	clear(w.Content)
	clear(w.Right)
	local S = ClientState.Settings
	local list = scroller(w.Content)
	local function row(order, title, desc)
		local r = UIKit.Panel({ Size = UDim2.new(1, 0, 0, 64), BackgroundColor3 = T.Panel, BackgroundTransparency = 0, LayoutOrder = order, ZIndex = 6, Parent = list })
		Label({ Text = title, Size = UDim2.new(0.5, 0, 0, 22), Position = UDim2.fromOffset(16, 10), TextSize = 16, Font = T.Black, ZIndex = 7, Parent = r })
		Label({ Text = desc, Size = UDim2.new(0.5, 0, 0, 16), Position = UDim2.fromOffset(16, 34), TextSize = 12, Font = T.Medium, TextColor3 = T.Sub, ZIndex = 7, Parent = r })
		local controls = new("Frame", { Size = UDim2.new(0.5, -16, 1, 0), Position = UDim2.new(0.5, 0, 0, 0), BackgroundTransparency = 1, ZIndex = 7, Parent = r }, {
			new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		})
		return controls
	end
	local function stepper(parent, text, onMinus, onPlus)
		local minus = UIKit.Button({ Text = "−", Size = UDim2.fromOffset(40, 36), Color = T.Panel3, LayoutOrder = 1, Parent = parent }, onMinus)
		minus.ZIndex = 8
		local value = UIKit.Panel({ Size = UDim2.fromOffset(90, 36), BackgroundColor3 = T.Panel2, LayoutOrder = 2, ZIndex = 8, Parent = parent })
		Label({ Text = text, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 16, Font = T.Black, ZIndex = 9, Parent = value })
		local plus = UIKit.Button({ Text = "+", Size = UDim2.fromOffset(40, 36), Color = T.Panel3, LayoutOrder = 3, Parent = parent }, onPlus)
		plus.ZIndex = 8
	end
	local function change(key, value)
		S[key] = value
		saveSettings()
		w.Render()
	end
	stepper(row(1, "FIELD OF VIEW", "Wider view vs. bigger targets"), tostring(S.FOV), function()
		change("FOV", math.max(60, S.FOV - 5))
	end, function()
		change("FOV", math.min(100, S.FOV + 5))
	end)
	stepper(row(2, "AIM SENSITIVITY", "Mouse speed while aiming down sights"), string.format("%.1fx", S.AdsSens), function()
		change("AdsSens", math.max(0.2, math.floor((S.AdsSens - 0.1) * 10 + 0.5) / 10))
	end, function()
		change("AdsSens", math.min(1.5, math.floor((S.AdsSens + 0.1) * 10 + 0.5) / 10))
	end)
	local shakeRow = row(3, "SCREEN SHAKE", "Reduce if explosions make you dizzy")
	for i, opt in { { "OFF", 0 }, { "LOW", 0.5 }, { "FULL", 1 } } do
		local b = UIKit.Button({ Text = opt[1], Size = UDim2.fromOffset(70, 36), Color = math.abs(S.Shake - opt[2]) < 0.01 and T.Accent or T.Panel3, TextSize = 13, LayoutOrder = i, Parent = shakeRow }, function()
			change("Shake", opt[2])
		end)
		b.ZIndex = 8
	end
	local crossRow = row(4, "CROSSHAIR COLOR", "Pick what stands out on every map")
	for i, name in { "White", "Green", "Cyan", "Red", "Yellow" } do
		local b = UIKit.Button({ Text = S.Crosshair == name and "✓" or "", Size = UDim2.fromOffset(36, 36), Color = ClientState.CrosshairColors[name], TextColor = Color3.new(0, 0, 0), TextSize = 16, LayoutOrder = i, Parent = crossRow }, function()
			change("Crosshair", name)
		end)
		b.ZIndex = 8
	end
end

-- OPEN / CLOSE ---------------------------------------------------------------------
function Menus.Open(name: string, tab: string?)
	local w = windows[name]
	if not w then
		return
	end
	for other, ow in windows do
		if other ~= name then
			ow.Overlay.Visible = false
		end
	end
	if tab then
		w.Tab = tab
	end
	openName = name
	ClientState.MenuOpen = true
	w.Overlay.Visible = true
	w.Render()
	local scale = w.Panel:FindFirstChildOfClass("UIScale") or new("UIScale", { Parent = w.Panel })
	scale.Scale = 0.92
	UIKit.Tween(scale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
end

function Menus.Toggle(name: string)
	if openName == name then
		Menus.Close()
	else
		Menus.Open(name)
	end
end

function Menus.Close()
	for _, w in windows do
		w.Overlay.Visible = false
	end
	openName = nil
	ClientState.MenuOpen = mainMenu.Visible or results.Visible
end

function Menus.IsOpen(): boolean
	return openName ~= nil
end

-- SCOREBOARD -------------------------------------------------------------------------
local function buildScoreboard()
	scoreboard = UIKit.Panel({ Name = "Scoreboard", Size = UDim2.fromOffset(620, 560), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = T.Bg, BackgroundTransparency = 0.1, Visible = false, ZIndex = 4, Parent = gui })
	Label({ Name = "Title", Text = Config.ModeName, Size = UDim2.new(1, -32, 0, 30), Position = UDim2.fromOffset(16, 10), TextSize = 22, Font = T.Black, ZIndex = 5, Parent = scoreboard })
	local header = new("Frame", { Size = UDim2.new(1, -32, 0, 20), Position = UDim2.fromOffset(16, 46), BackgroundTransparency = 1, ZIndex = 5, Parent = scoreboard })
	for _, col in { { "#", 0, 30 }, { "PLAYER", 36, 250 }, { "KILLS", 330, 70 }, { "DEATHS", 400, 70 }, { "SCORE", 480, 100 } } do
		Label({ Text = col[1], Size = UDim2.fromOffset(col[3], 20), Position = UDim2.fromOffset(col[2], 0), TextSize = 11, Font = T.Black, TextColor3 = T.Sub, ZIndex = 5, Parent = header })
	end
	new("ScrollingFrame", { Name = "Rows", Size = UDim2.new(1, -32, 1, -80), Position = UDim2.fromOffset(16, 70), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 5, Parent = scoreboard }, { UIKit.List(3) })
end

local function renderScoreboard()
	local rowsFrame = scoreboard.Rows
	for _, c in rowsFrame:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local rows = {}
	for _, p in Players:GetPlayers() do
		local char = p.Character
		table.insert(rows, { Name = p.Name, VIP = p:GetAttribute("Pass_VIP"), Level = p:GetAttribute("Level") or 1, Kills = p:GetAttribute("Kills") or 0, Deaths = p:GetAttribute("Deaths") or 0, Score = p:GetAttribute("Score") or 0, Me = p == player, Team = p:GetAttribute("Team"), Downed = char and char:GetAttribute("Downed") })
	end
	local bots = ReplicatedStorage:FindFirstChild("BotStats")
	if bots then
		for _, b in bots:GetChildren() do
			table.insert(rows, { Name = b.Name, Bot = true, Kills = b:GetAttribute("Kills") or 0, Deaths = b:GetAttribute("Deaths") or 0, Score = b:GetAttribute("Score") or 0, Team = b:GetAttribute("Team") })
		end
	end
	local modeDef = Config.Modes[ReplicatedStorage:GetAttribute("Mode") or "TDM"] or Config.Modes.TDM
	scoreboard.Title.Text = modeDef.Name .. "  ·  " .. (ReplicatedStorage:GetAttribute("MapName") or "")
	-- team modes: my team first, then the others, each sorted by score
	local myTeam = player:GetAttribute("Team")
	local order = {}
	for i, t in modeDef.Teams do
		order[t] = (t == myTeam) and 0 or i
	end
	table.sort(rows, function(a, b)
		local ta, tb = order[a.Team] or 9, order[b.Team] or 9
		if ta ~= tb then
			return ta < tb
		end
		return a.Score > b.Score
	end)
	local layout = 0
	local lastTeam = false
	local place = 0
	for _, r in rows do
		if #modeDef.Teams > 0 and r.Team ~= lastTeam then
			lastTeam = r.Team
			place = 0
			layout += 1
			local info = Config.Teams[r.Team or ""]
			local header = UIKit.Panel({ Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = info and info.Color:Lerp(Color3.new(), 0.45) or T.Panel3, BackgroundTransparency = 0.1, LayoutOrder = layout, ZIndex = 5, Parent = rowsFrame })
			Label({ Text = (info and info.Name or "NO TEAM") .. (r.Team == myTeam and "  (YOUR TEAM)" or "") .. "   " .. tostring(ReplicatedStorage:GetAttribute("Score_" .. tostring(r.Team)) or 0) .. " KILLS", Size = UDim2.new(1, -12, 1, 0), Position = UDim2.fromOffset(8, 0), TextSize = 13, Font = T.Black, ZIndex = 6, Parent = header })
		end
		place += 1
		layout += 1
		local i = place
		local row = UIKit.Panel({ Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = r.Me and Color3.fromRGB(80, 66, 14) or T.Panel2, BackgroundTransparency = 0.2, LayoutOrder = layout, ZIndex = 5, Parent = rowsFrame })
		local nameColor = r.VIP and T.Gold or (r.Bot and T.Sub or T.Text)
		local name = (r.VIP and "👑 " or "") .. r.Name .. (r.Bot and "  [BOT]" or ("  · LVL " .. (r.Level or 1))) .. (r.Downed and "  ⬇" or "")
		for _, col in { { tostring(i), 6, 30, T.Sub }, { name, 36, 290, nameColor }, { tostring(r.Kills), 330, 70, T.Text }, { tostring(r.Deaths), 400, 70, T.Text }, { Util.Comma(r.Score), 480, 100, T.Accent } } do
			Label({ Text = col[1], Size = UDim2.fromOffset(col[3], 26), Position = UDim2.fromOffset(col[2], 0), TextSize = 13, Font = T.Black, TextColor3 = col[4], ZIndex = 6, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
		end
	end
end

function Menus.ShowScoreboard(on: boolean)
	scoreboard.Visible = on
	if on then
		renderScoreboard()
	end
end

-- RESULTS ------------------------------------------------------------------------------
local function buildResults()
	results = new("TextButton", { Name = "Results", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.25, Text = "", AutoButtonColor = false, Modal = true, Visible = false, ZIndex = 8, Parent = gui })
end

function Menus.ShowResults(info)
	clear(results)
	results.Visible = true
	local teamMode = info.Mode ~= nil and Config.Modes[info.Mode] and #Config.Modes[info.Mode].Teams > 0
	local won = info.Won == true or (not teamMode and info.Place == 1)
	local title, color
	if teamMode then
		if info.WinnerTeam == nil then
			title, color = "DRAW", T.Accent2
		elseif won then
			title, color = "VICTORY", T.Gold
		else
			title, color = "DEFEAT", T.Red
		end
	else
		title = won and "VICTORY" or (info.Place <= 3 and ("#" .. info.Place .. " PLACE") or "MATCH OVER")
		color = won and T.Gold or (info.Place <= 3 and T.Accent2 or T.Red)
	end
	local t = Label({ Text = title, Size = UDim2.new(1, 0, 0, 80), Position = UDim2.fromScale(0, 0.08), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 72, Font = T.Black, TextColor3 = color, ZIndex = 9, Parent = results })
	UIKit.TextStroke(0.3).Parent = t
	local sc = new("UIScale", { Scale = 0.5, Parent = t })
	UIKit.Tween(sc, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
	local winnerText = "WINNER: " .. string.upper(info.Winner)
	if teamMode then
		local parts = {}
		for _, t in Config.Modes[info.Mode].Teams do
			table.insert(parts, Config.Teams[t].Name .. " " .. tostring(info.Scores and info.Scores[t] or 0))
		end
		winnerText = (info.WinnerTeam and (Config.Teams[info.WinnerTeam].Name .. " WINS  ·  ") or "") .. table.concat(parts, "  –  ")
	end
	Label({ Text = (info.Nuke and "☢️ TACTICAL NUKE · " or "") .. winnerText, Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0, 0, 0.08, 84), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 20, Font = T.Black, ZIndex = 9, Parent = results })

	-- podium
	local podium = new("Frame", { Size = UDim2.fromOffset(600, 170), Position = UDim2.fromScale(0.5, 0.32), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1, ZIndex = 9, Parent = results })
	local places = { { 2, 0, 120, T.Sub }, { 1, 200, 160, T.Gold }, { 3, 400, 100, Color3.fromRGB(205, 127, 50) } }
	for _, p in places do
		local row = info.Rows[p[1]]
		if row then
			local col = UIKit.Panel({ Size = UDim2.fromOffset(190, p[3]), Position = UDim2.new(0, p[2], 1, 0), AnchorPoint = Vector2.new(0, 1), BackgroundColor3 = p[4], BackgroundTransparency = 0.25, ZIndex = 9, Parent = podium })
			Label({ Text = "#" .. p[1], Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 6), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 30, Font = T.Black, ZIndex = 10, Parent = col })
			Label({ Text = row.Name, Size = UDim2.new(1, -10, 0, 20), Position = UDim2.fromOffset(5, 42), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 16, Font = T.Black, ZIndex = 10, TextTruncate = Enum.TextTruncate.AtEnd, Parent = col })
			Label({ Text = string.format("%d KILLS · %s PTS", row.Kills, Util.Comma(row.Score)), Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 64), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 11, Font = T.Bold, ZIndex = 10, Parent = col })
		end
	end

	-- your summary
	local mine = UIKit.Panel({ Size = UDim2.fromOffset(600, 120), Position = UDim2.fromScale(0.5, 0.55), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = T.Panel, ZIndex = 9, Parent = results })
	local kd = info.Deaths > 0 and (info.Kills / info.Deaths) or info.Kills
	local cells = {
		{ "PLACE", "#" .. info.Place, color }, { "KILLS", tostring(info.Kills), T.Text }, { "K/D", string.format("%.2f", kd), T.Text },
		{ "CASH EARNED", "$" .. Util.Comma(info.Cash), T.Green }, { "XP EARNED", Util.Comma(info.XP), T.Accent2 },
	}
	for i, c in cells do
		Label({ Text = c[1], Size = UDim2.fromOffset(120, 14), Position = UDim2.fromOffset((i - 1) * 120, 20), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 11, Font = T.Black, TextColor3 = T.Sub, ZIndex = 10, Parent = mine })
		Label({ Text = c[2], Size = UDim2.fromOffset(120, 34), Position = UDim2.fromOffset((i - 1) * 120, 38), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 28, Font = T.Black, TextColor3 = c[3], ZIndex = 10, Parent = mine })
	end
	if not ClientState.HasPass("DoubleXP") then
		local b = UIKit.Button({ Text = "⭐ DOUBLE YOUR XP EVERY MATCH  ·  R$ " .. Monetization.GamePasses.DoubleXP.Price, Size = UDim2.fromOffset(380, 30), Position = UDim2.new(0.5, 0, 1, -38), AnchorPoint = Vector2.new(0.5, 0), Color = T.Robux, TextSize = 13, Parent = mine }, function()
			Menus.BuyPass("DoubleXP")
		end)
		b.ZIndex = 10
	end
	ClientState.MenuOpen = true
end

function Menus.HideResults()
	if results.Visible then
		results.Visible = false
		ClientState.MenuOpen = openName ~= nil or mainMenu.Visible
	end
end

-- MAIN MENU + DAILY -------------------------------------------------------------------
local dailyPanel
local function renderDaily()
	clear(dailyPanel)
	local data = ClientState.Data
	if not data then
		return
	end
	local available = data.DailyAvailable
	local streak = data.Daily.Streak or 0
	Label({ Text = available and "🎁 DAILY REWARD READY!" or "🎁 DAILY REWARDS", Size = UDim2.new(1, -20, 0, 20), Position = UDim2.fromOffset(12, 8), TextSize = 14, Font = T.Black, TextColor3 = available and T.Accent or T.Sub, ZIndex = 3, Parent = dailyPanel })
	local row = new("Frame", { Size = UDim2.new(1, -24, 0, 50), Position = UDim2.fromOffset(12, 32), BackgroundTransparency = 1, ZIndex = 3, Parent = dailyPanel }, { UIKit.List(5, true) })
	local days = #Config.DailyRewards
	local cycleDone = streak > 0 and ((streak - 1) % days + 1) or 0
	local nextDay = available and (cycleDone % days) + 1 or nil
	if nextDay == 1 then
		cycleDone = 0
	end
	for i, reward in Config.DailyRewards do
		local claimed = i <= cycleDone
		local box = UIKit.Panel({ Size = UDim2.fromOffset(44, 50), BackgroundColor3 = (i == nextDay) and T.Accent or (claimed and T.Panel3 or T.Panel2), BackgroundTransparency = 0, LayoutOrder = i, ZIndex = 3, Parent = row })
		local textColor = i == nextDay and Color3.new(0, 0, 0) or T.Text
		Label({ Text = "DAY " .. i, Size = UDim2.new(1, 0, 0, 14), Position = UDim2.fromOffset(0, 6), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 9, Font = T.Black, TextColor3 = textColor, ZIndex = 4, Parent = box })
		Label({ Text = claimed and "✓" or ("$" .. reward), Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 22), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 11, Font = T.Black, TextColor3 = textColor, ZIndex = 4, Parent = box })
	end
	if available then
		local b = UIKit.Button({ Text = "CLAIM", Size = UDim2.new(1, -24, 0, 30), Position = UDim2.new(0, 12, 1, -38), TextSize = 14, Parent = dailyPanel }, function()
			Remotes.ClaimDaily:FireServer()
		end)
		b.ZIndex = 3
	end
end

local profileLabels = {}
local function buildMainMenu()
	mainMenu = new("TextButton", { Name = "MainMenu", Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.Bg, BackgroundTransparency = 0.25, Text = "", AutoButtonColor = false, Modal = true, ZIndex = 1, Parent = gui })
	new("UIGradient", { Rotation = 0, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.55, 0.5), NumberSequenceKeypoint.new(1, 1) }), Parent = mainMenu })

	local left = new("Frame", { Size = UDim2.new(0, 420, 1, 0), Position = UDim2.fromOffset(60, 0), BackgroundTransparency = 1, ZIndex = 2, Parent = mainMenu })
	local title = Label({ Text = Config.GameName, Size = UDim2.new(1, 0, 0, 80), Position = UDim2.new(0, 0, 0.16, 0), TextSize = 68, Font = T.Black, ZIndex = 2, Parent = left })
	UIKit.Gradient(T.Accent, Color3.fromRGB(255, 120, 30), 90).Parent = title
	UIKit.TextStroke(0.6).Parent = title
	Label({ Text = "SLIDE. DASH. SLAM. DOMINATE.", Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 4, 0.16, 82), TextSize = 16, Font = T.Black, TextColor3 = T.Accent2, ZIndex = 2, Parent = left })

	local buttons = new("Frame", { Size = UDim2.fromOffset(320, 300), Position = UDim2.new(0, 0, 0.16, 130), BackgroundTransparency = 1, ZIndex = 2, Parent = left }, { UIKit.List(10) })
	local play = UIKit.Button({ Text = "▶  PLAY", Size = UDim2.fromOffset(320, 64), TextSize = 28, LayoutOrder = 1, Parent = buttons }, function()
		Menus.HideMain()
		if Menus.OnDeploy then
			Menus.OnDeploy()
		end
	end)
	play.ZIndex = 2
	for i, item in { { "🔫  ARMORY", "Armory", T.Panel2 }, { "💎  STORE", "Store", T.Robux }, { "🏆  ACHIEVEMENTS", "Achievements", T.Panel2 }, { "⚙️  SETTINGS", "Settings", T.Panel2 } } do
		local b = UIKit.Button({ Text = item[1], Size = UDim2.fromOffset(320, 46), Color = item[3], TextSize = 18, LayoutOrder = i + 1, Parent = buttons }, function()
			Menus.Open(item[2])
		end)
		b.ZIndex = 2
	end

	local controls = Label({
		Text = "WASD move · SHIFT sprint · SPACE double jump · C slide / slam · Q dash · E drive cars\nLMB shoot · RMB aim · R reload · 1/2 swap · V knife · G grenade · Z/X call-ins · TAB scores",
		Size = UDim2.new(1, 0, 0, 40), Position = UDim2.new(0, 0, 1, -70), TextSize = 12, Font = T.Medium, TextColor3 = T.Sub, TextWrapped = true, ZIndex = 2, Parent = left,
	})
	controls.TextYAlignment = Enum.TextYAlignment.Top

	-- right: profile card + daily
	local right = new("Frame", { Size = UDim2.fromOffset(340, 400), Position = UDim2.new(1, -40, 0.16, 0), AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, ZIndex = 2, Parent = mainMenu })
	local card = UIKit.Panel({ Size = UDim2.fromOffset(340, 150), BackgroundColor3 = T.Panel, ZIndex = 2, Parent = right })
	local avatar = new("ImageLabel", { Size = UDim2.fromOffset(80, 80), Position = UDim2.fromOffset(14, 14), BackgroundColor3 = T.Panel3, ZIndex = 3, Parent = card })
	UIKit.Corner(40).Parent = avatar
	task.spawn(function()
		local ok, img = pcall(Players.GetUserThumbnailAsync, Players, player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
		if ok then
			avatar.Image = img
		end
	end)
	Label({ Text = player.DisplayName, Size = UDim2.fromOffset(220, 24), Position = UDim2.fromOffset(106, 18), TextSize = 20, Font = T.Black, ZIndex = 3, TextTruncate = Enum.TextTruncate.AtEnd, Parent = card })
	profileLabels.Level = Label({ Text = "", Size = UDim2.fromOffset(220, 18), Position = UDim2.fromOffset(106, 44), TextSize = 14, Font = T.Black, TextColor3 = T.Accent, ZIndex = 3, Parent = card })
	profileLabels.Cash = Label({ Text = "", Size = UDim2.fromOffset(220, 20), Position = UDim2.fromOffset(106, 64), TextSize = 18, Font = T.Black, TextColor3 = T.Green, ZIndex = 3, Parent = card })
	profileLabels.Stats = Label({ Text = "", Size = UDim2.new(1, -28, 0, 36), Position = UDim2.fromOffset(14, 104), TextSize = 12, Font = T.Bold, TextColor3 = T.Sub, TextWrapped = true, ZIndex = 3, Parent = card })

	dailyPanel = UIKit.Panel({ Size = UDim2.fromOffset(340, 130), Position = UDim2.fromOffset(0, 162), BackgroundColor3 = T.Panel, ZIndex = 2, Parent = right })

	local vip = UIKit.Button({ Text = "", Size = UDim2.fromOffset(340, 64), Position = UDim2.fromOffset(0, 304), Color = Color3.fromRGB(70, 56, 10), Parent = right }, function()
		Menus.Open("Store", "Game Passes")
	end)
	vip.ZIndex = 2
	UIKit.Stroke(T.Gold, 2, 0).Parent = vip
	Label({ Text = "👑 GET VIP", Size = UDim2.new(1, -20, 0, 24), Position = UDim2.fromOffset(12, 8), TextSize = 20, Font = T.Black, TextColor3 = T.Gold, ZIndex = 3, Parent = vip })
	Label({ Text = "2x cash · +10 HP · gold name · VIP tag", Size = UDim2.new(1, -20, 0, 16), Position = UDim2.fromOffset(12, 36), TextSize = 12, Font = T.Bold, ZIndex = 3, Parent = vip })
	profileLabels.VIP = vip
end

local function refreshMain()
	local data = ClientState.Data
	profileLabels.Level.Text = "LEVEL " .. (player:GetAttribute("Level") or 1)
	profileLabels.Cash.Text = "$" .. Util.Comma(player:GetAttribute("Cash") or 0)
	if data then
		local s = data.Stats
		local kills, deaths = s.Kills or 0, s.Deaths or 0
		profileLabels.Stats.Text = string.format("KILLS %s  ·  K/D %.2f  ·  WINS %s  ·  BEST STREAK %s", Util.Comma(kills), deaths > 0 and kills / deaths or kills, Util.Comma(s.Wins or 0), s.BestStreak or 0)
		renderDaily()
	end
	profileLabels.VIP.Visible = not ClientState.HasPass("VIP")
end

function Menus.ShowMain()
	mainMenu.Visible = true
	ClientState.MenuOpen = true
	refreshMain()
end

function Menus.HideMain()
	mainMenu.Visible = false
	ClientState.MenuOpen = openName ~= nil
end

-- INIT ----------------------------------------------------------------------------------
function Menus.Init(playerGui: PlayerGui)
	gui = new("ScreenGui", { Name = "Menus", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 5, Parent = playerGui })

	local armory = window("Armory", "ARMORY", { "Primary", "Secondary" })
	armory.Render = function()
		renderArmory(armory)
	end
	local store = window("Store", "💎 STORE", { "Game Passes", "Cash & Boosts" })
	store.Render = function()
		renderStore(store)
	end
	local tabs = { "All" }
	for _, c in Achievements.Categories do
		table.insert(tabs, c)
	end
	local ach = window("Achievements", "🏆 ACHIEVEMENTS", tabs)
	ach.Render = function()
		renderAchievements(ach)
	end

	local settings = window("Settings", "⚙️ SETTINGS", nil)
	settings.Render = function()
		renderSettings(settings)
	end

	buildScoreboard()
	buildResults()
	buildMainMenu()

	ClientState.Changed.Event:Connect(function()
		if openName and windows[openName] then
			windows[openName].Render()
		end
		if mainMenu.Visible then
			refreshMain()
		end
	end)

	local last = 0
	RunService.Heartbeat:Connect(function()
		if scoreboard.Visible and os.clock() - last > 0.5 then
			last = os.clock()
			renderScoreboard()
		end
		if results.Visible and ReplicatedStorage:GetAttribute("MatchState") ~= "Results" then
			Menus.HideResults()
		end
	end)
end

return Menus
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">MovementController</string>
            <string name="Source"><![CDATA[-- Advanced movement: sprint, slide, dash, double/triple jump, ground slam, jump pads.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local ClientState = require(script.Parent.ClientState)
local Effects = require(script.Parent.Effects)
local UIKit = require(script.Parent.UIKit)

local player = Players.LocalPlayer

local Movement = {}
Movement.State = {
	Sprinting = false,
	Sliding = false,
	Slamming = false,
	Airborne = false,
	LastDash = -100,
	LastSlide = -100,
	LastSlam = -100,
	AirJumps = 0,
	Aiming = false, -- set by WeaponController
	SpeedMult = 1, -- set by WeaponController (weapon mobility)
}
local S = Movement.State

local character, humanoid, root
local sprintHeld = false
local slideDir = Vector3.zero
local slideStart = 0
local dashDir = Vector3.zero
local lastJumpRequest = 0
local leftGround = 0
local lastPad = 0

local function grounded(): boolean
	if not humanoid then
		return false
	end
	return humanoid.FloorMaterial ~= Enum.Material.Air
end

local function speedBonus(): number
	local mult = 1
	if ClientState.HasPass("SpeedDemon") then
		mult *= 1.15
	end
	if ClientState.Overdrive() then
		mult *= 1.25
	end
	return mult
end

function Movement.DashCooldown(): number
	return Config.DashCooldown / (ClientState.HasPass("SpeedDemon") and 2 or 1)
end

function Movement.Recently(name: string, window: number): boolean
	return os.clock() - (S["Last" .. name] or -100) < window
end

local function flatLook(): Vector3
	local cam = workspace.CurrentCamera
	local look = cam.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	return flat.Magnitude > 0.01 and flat.Unit or Vector3.zAxis
end

local function moveDir(): Vector3
	if humanoid and humanoid.MoveDirection.Magnitude > 0.1 then
		return humanoid.MoveDirection.Unit
	end
	return flatLook()
end

local function setCameraDip(y: number)
	if humanoid then
		TweenService:Create(humanoid, TweenInfo.new(0.15), { CameraOffset = Vector3.new(0, y, 0) }):Play()
	end
end

function Movement.Slide()
	if not root or S.Sliding or not grounded() or ClientState.MenuOpen then
		return
	end
	if os.clock() - S.LastSlide < Config.SlideCooldown then
		return
	end
	if humanoid.MoveDirection.Magnitude < 0.1 then
		return
	end
	S.Sliding = true
	S.LastSlide = os.clock()
	slideStart = os.clock()
	slideDir = humanoid.MoveDirection.Unit
	setCameraDip(-1.6)
	UIKit.Sound("Dash", 0.8)
end

local function endSlide()
	if S.Sliding then
		S.Sliding = false
		setCameraDip(0)
	end
end

function Movement.Dash()
	if not root or ClientState.MenuOpen or ClientState.Driving or (humanoid and humanoid.Sit) or player:GetAttribute("Downed") then
		return
	end
	if os.clock() - S.LastDash < Movement.DashCooldown() then
		return
	end
	S.LastDash = os.clock()
	dashDir = moveDir()
	endSlide()
	UIKit.Sound("Dash", 1.1)
	Effects.Shake(0.6)
end

function Movement.Slam()
	if not root or S.Slamming or grounded() then
		return
	end
	if os.clock() - S.LastSlam < Config.SlamCooldown then
		return
	end
	-- must be high enough above the ground
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = { character }
	local result = workspace:Raycast(root.Position, Vector3.new(0, -Config.SlamMinHeight, 0), params)
	if result then
		return
	end
	S.Slamming = true
	S.LastSlam = os.clock()
	root.AssemblyLinearVelocity = Vector3.new(0, -150, 0)
end

-- C / Ctrl: slide on the ground, slam in the air
function Movement.Crouch()
	if ClientState.Driving or (humanoid and humanoid.Sit) or player:GetAttribute("Downed") then
		return
	end
	if grounded() then
		Movement.Slide()
	else
		Movement.Slam()
	end
end

local function airJump()
	if not humanoid or grounded() or ClientState.MenuOpen or humanoid.Sit or player:GetAttribute("Downed") then
		return
	end
	if os.clock() - leftGround < 0.15 then
		return
	end
	local maxJumps = Config.AirJumps + (ClientState.HasPass("TripleJump") and 1 or 0)
	if S.AirJumps >= maxJumps then
		return
	end
	S.AirJumps += 1
	local v = root.AssemblyLinearVelocity
	local dir = humanoid.MoveDirection * 20
	root.AssemblyLinearVelocity = Vector3.new(v.X * 0.6 + dir.X, Config.AirJumpPower, v.Z * 0.6 + dir.Z)
	UIKit.Sound("Jump", 1.2)
	-- little ring effect under your feet
	Effects.Shockwave(root.Position - Vector3.new(0, 3, 0), 3)
end

local function onLanded()
	S.AirJumps = 0
	if S.Slamming then
		S.Slamming = false
		local pos = root.Position - Vector3.new(0, 2.5, 0)
		Remotes.Slam:FireServer(pos)
		Effects.Shockwave(pos, Config.SlamRadius)
		Effects.Shake(4)
	end
end

local function bindCharacter(char: Model)
	character = char
	humanoid = char:WaitForChild("Humanoid")
	root = char:WaitForChild("HumanoidRootPart")
	S.Sliding = false
	S.Slamming = false
	S.AirJumps = 0
	humanoid.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Landed or new == Enum.HumanoidStateType.Running then
			if S.Airborne then
				S.Airborne = false
				onLanded()
			end
		elseif new == Enum.HumanoidStateType.Freefall or new == Enum.HumanoidStateType.Jumping then
			if not S.Airborne then
				S.Airborne = true
				leftGround = os.clock()
			end
		end
	end)
end

local wasDowned = false
local function step(_dt: number)
	if not humanoid or humanoid.Health <= 0 or not root then
		return
	end
	local now = os.clock()

	-- downed: crawl slowly, no jumping or abilities
	local downed = player:GetAttribute("Downed") == true
	if downed ~= wasDowned then
		wasDowned = downed
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, not downed)
		TweenService:Create(humanoid, TweenInfo.new(0.3), { CameraOffset = Vector3.new(0, downed and -2.4 or 0, 0) }):Play()
		if downed then
			S.Sliding = false
		end
	end
	if downed then
		humanoid.WalkSpeed = 5
		S.Sprinting = false
		return
	end

	-- walk speed
	local base = Config.BaseWalkSpeed
	S.Sprinting = sprintHeld and not S.Aiming and humanoid.MoveDirection.Magnitude > 0.1
	if S.Aiming then
		base = Config.AimWalkSpeed
	elseif S.Sprinting then
		base = Config.SprintSpeed
	end
	humanoid.WalkSpeed = base * speedBonus() * (S.SpeedMult or 1)

	-- slide
	if S.Sliding then
		local t = (now - slideStart) / Config.SlideDuration
		if t >= 1 or not grounded() then
			endSlide()
		else
			local speed = Config.SlideSpeed * (1 - t * 0.7) * speedBonus()
			local v = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(slideDir.X * speed, v.Y, slideDir.Z * speed)
		end
	end

	-- dash
	if now - S.LastDash < Config.DashDuration then
		local v = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(dashDir.X * Config.DashSpeed, math.max(v.Y, 2), dashDir.Z * Config.DashSpeed)
	end

	-- jump pads (checked on the client for smooth physics)
	if now - lastPad > 0.5 then
		local params = RaycastParams.new()
		params.FilterDescendantsInstances = { character }
		local result = workspace:Raycast(root.Position, Vector3.new(0, -4, 0), params)
		local power = result and result.Instance:GetAttribute("JumpPad")
		if power then
			lastPad = now
			S.AirJumps = 0
			local v = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(v.X * 1.3, power, v.Z * 1.3)
			UIKit.Sound("Jump", 0.7)
			Effects.Shockwave(result.Position, 5)
			Remotes.JumpPad:FireServer()
		end
	end
end

function Movement.Init()
	if player.Character then
		bindCharacter(player.Character)
	end
	player.CharacterAdded:Connect(bindCharacter)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		local key = input.KeyCode
		if key == Enum.KeyCode.LeftShift then
			sprintHeld = true
		elseif key == Enum.KeyCode.C or key == Enum.KeyCode.LeftControl then
			Movement.Crouch()
		elseif key == Enum.KeyCode.Q then
			Movement.Dash()
		elseif key == Enum.KeyCode.ButtonL3 then
			sprintHeld = not sprintHeld
		elseif key == Enum.KeyCode.ButtonB then
			Movement.Crouch()
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.LeftShift then
			sprintHeld = false
		end
	end)
	UserInputService.JumpRequest:Connect(function()
		local now = os.clock()
		if now - lastJumpRequest < 0.2 then
			return
		end
		lastJumpRequest = now
		airJump()
	end)

	-- mobile buttons
	if UserInputService.TouchEnabled then
		sprintHeld = true -- auto sprint on mobile
		ContextActionService:BindAction("NS_Slide", function(_, inputState)
			if inputState == Enum.UserInputState.Begin then
				Movement.Crouch()
			end
			return Enum.ContextActionResult.Sink
		end, true)
		ContextActionService:SetTitle("NS_Slide", "SLIDE")
		ContextActionService:SetPosition("NS_Slide", UDim2.new(1, -230, 1, -80))
		ContextActionService:BindAction("NS_Dash", function(_, inputState)
			if inputState == Enum.UserInputState.Begin then
				Movement.Dash()
			end
			return Enum.ContextActionResult.Sink
		end, true)
		ContextActionService:SetTitle("NS_Dash", "DASH")
		ContextActionService:SetPosition("NS_Dash", UDim2.new(1, -290, 1, -140))
	end

	RunService.Heartbeat:Connect(step)
end

return Movement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">OfferToast</string>
            <string name="Source"><![CDATA[-- Subtle, contextual Robux offers.
-- A small card slides in at the side of the screen when an upgrade is actually
-- relevant (died a few times, ran dry, couldn't afford a gun), then slides away on
-- its own. Rules that keep it from being annoying:
--   * at most one card every 4 minutes, and 3 per session
--   * never while you're in a fight (took damage in the last 6 seconds) or voting
--   * never for something you already own; no close button needed, it leaves by itself
--   * honest copy: real perks and real prices only, no fake timers or scarcity
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Monetization = require(Shared.Monetization)
local UIKit = require(script.Parent.UIKit)
local ClientState = require(script.Parent.ClientState)

local T = UIKit.Theme
local new, Label = UIKit.new, UIKit.Label

local COOLDOWN = 240
local MAX_PER_SESSION = 3
local SHOW_TIME = 9

local OfferToast = {}
OfferToast.BuyPass = function(_key) end -- injected (Menus.BuyPass)
OfferToast.BuyProduct = function(_key) end -- injected (Menus.BuyProduct)
OfferToast.LastDamaged = 0

local gui, card
local shown = 0
local lastShown = -math.huge
local current = nil
local deathsSince = 0
local dryFires = 0

-- Context lines (why this is relevant *right now*).
local REASONS = {
	Vampire = "Heal 25 HP on every kill and stay in the fight.",
	Juggernaut = "+35 max health to win more of those close fights.",
	ExtendedMags = "+50% magazine size, so fewer reloads mid-fight.",
	FastHands = "35% faster reloads.",
	Cash2 = "5,000 cash for the guns in the Armory.",
}

local function canShow(): boolean
	if shown >= MAX_PER_SESSION or os.clock() - lastShown < COOLDOWN or current then
		return false
	end
	if ReplicatedStorage:GetAttribute("MatchState") == "Voting" then
		return false
	end
	if os.clock() - OfferToast.LastDamaged < 6 then
		return false
	end
	return true
end

local function hide()
	if not card or not current then
		return
	end
	current = nil
	local c = card
	UIKit.Tween(c, 0.35, { Position = UDim2.new(1, 340, 0.6, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
end

local function build(kind: string, key: string)
	local info = kind == "Pass" and Monetization.GamePasses[key] or Monetization.Products[key]
	if not info then
		return
	end
	if card then
		card:Destroy()
	end
	local accent = info.Color or T.Robux
	card = new("Frame", {
		Name = "Offer", Size = UDim2.fromOffset(300, 96), Position = UDim2.new(1, 340, 0.6, 0), AnchorPoint = Vector2.new(1, 0.5),
		BackgroundColor3 = T.Panel, BackgroundTransparency = 0.08, BorderSizePixel = 0, Parent = gui,
	})
	UIKit.Corner(10).Parent = card
	new("UIStroke", { Color = accent, Thickness = 1.5, Transparency = 0.35, Parent = card })
	new("UIGradient", { Rotation = 0, Color = ColorSequence.new(accent:Lerp(T.Panel, 0.75), T.Panel), Parent = card })
	-- icon tile
	local tile = new("Frame", { Size = UDim2.fromOffset(62, 62), Position = UDim2.fromOffset(12, 12), BackgroundColor3 = accent, BorderSizePixel = 0, Parent = card })
	UIKit.Corner(10).Parent = tile
	UIKit.Gradient(accent:Lerp(Color3.new(1, 1, 1), 0.25), accent:Lerp(Color3.new(), 0.35), 90).Parent = tile
	Label({ Text = info.Icon or "💎", Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 32, Font = T.Black, Parent = tile })
	-- text
	Label({ Text = string.upper(info.Name), Size = UDim2.new(1, -96, 0, 18), Position = UDim2.fromOffset(86, 12), TextSize = 14, Font = T.Black, TextTruncate = Enum.TextTruncate.AtEnd, Parent = card })
	Label({
		Text = REASONS[key] or (info.Perks and info.Perks[1]) or info.Desc or "", Size = UDim2.new(1, -96, 0, 30), Position = UDim2.fromOffset(86, 31),
		TextSize = 11, Font = T.Medium, TextColor3 = T.Sub, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Parent = card,
	})
	local buy = UIKit.Button({ Text = "R$ " .. tostring(info.Price), Size = UDim2.fromOffset(82, 24), Position = UDim2.fromOffset(86, 62), Color = T.Robux, TextSize = 13, Radius = 12, Parent = card }, function()
		if kind == "Pass" then
			OfferToast.BuyPass(key)
		else
			OfferToast.BuyProduct(key)
		end
		hide()
	end)
	buy.Name = "Buy"
	-- auto-dismiss bar
	local bar = new("Frame", { Size = UDim2.new(1, -20, 0, 2), Position = UDim2.new(0, 10, 1, -4), BackgroundColor3 = accent, BackgroundTransparency = 0.3, BorderSizePixel = 0, Parent = card })
	UIKit.Tween(bar, SHOW_TIME, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)
	return card
end

-- Show an offer if the rules allow it. kind = "Pass" | "Product".
function OfferToast.Offer(kind: string, key: string, force: boolean?): boolean
	if kind == "Pass" and ClientState.HasPass(key) then
		return false
	end
	if not force and not canShow() then
		return false
	end
	local c = build(kind, key)
	if not c then
		return false
	end
	shown += 1
	lastShown = os.clock()
	local token = {}
	current = token
	UIKit.Tween(c, 0.45, { Position = UDim2.new(1, -16, 0.6, 0) }, Enum.EasingStyle.Back)
	task.delay(SHOW_TIME, function()
		if current == token then
			hide()
		end
	end)
	return true
end

-- CONTEXT HOOKS --------------------------------------------------------------------------
function OfferToast.OnDeath()
	deathsSince += 1
	if deathsSince < 3 then
		return
	end
	-- (the death screen already has its own Instant Respawn button)
	for _, key in { "Juggernaut", "Vampire" } do
		if not ClientState.HasPass(key) then
			if OfferToast.Offer("Pass", key) then
				deathsSince = 0
			end
			return
		end
	end
end

function OfferToast.OnDryFire()
	dryFires += 1
	if dryFires < 6 then
		return
	end
	for _, key in { "ExtendedMags", "FastHands" } do
		if not ClientState.HasPass(key) then
			if OfferToast.Offer("Pass", key) then
				dryFires = 0
			end
			return
		end
	end
end

-- The player just tried to buy something they can't afford: they asked, so this
-- one skips the cooldown (but still only appears once at a time).
function OfferToast.OnCantAfford()
	OfferToast.Offer("Product", "Cash2", true)
end

function OfferToast.Init(playerGui: PlayerGui)
	gui = new("ScreenGui", { Name = "Offers", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 6, Parent = playerGui })
	-- don't pitch anything in the first two minutes of a session
	lastShown = os.clock() - COOLDOWN + 120
end

return OfferToast
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">PassSpotlight</string>
            <string name="Source"><![CDATA[-- Featured pass spotlight: a big, good-looking card for one random game pass the
-- player doesn't own, about every 20 minutes of play.
-- It waits for a calm moment (dead, between matches, or 10s out of combat), never
-- covers the vote screen, and always has a clear "Maybe later" button.
-- Copy is honest: real perks, real price, no fake timers or "limited" claims.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Monetization = require(Shared.Monetization)
local UIKit = require(script.Parent.UIKit)
local ClientState = require(script.Parent.ClientState)

local T = UIKit.Theme
local new, Label = UIKit.new, UIKit.Label
local rgb = Color3.fromRGB

local INTERVAL = 20 * 60

local Spotlight = {}
Spotlight.BuyPass = function(_key) end -- injected (Menus.BuyPass)
Spotlight.LastDamaged = 0 -- set by ClientMain when you take damage

local gui, overlay, card
local nextAt = math.huge
local lastKey = nil

local function calmMoment(): boolean
	local state = ReplicatedStorage:GetAttribute("MatchState")
	if state == "Voting" or ClientState.VoteOpen or ClientState.MenuOpen then
		return false
	end
	if ClientState.Dead or not ClientState.Deployed or state == "Results" or state == "Intermission" then
		return true
	end
	return os.clock() - Spotlight.LastDamaged > 10
end

local function pickPass(): string?
	local pool = {}
	for _, key in Monetization.PassOrder do
		if not ClientState.HasPass(key) and key ~= lastKey then
			table.insert(pool, key)
		end
	end
	if #pool == 0 then
		return nil
	end
	return pool[math.random(1, #pool)]
end

function Spotlight.Hide()
	if not overlay or not overlay.Visible then
		return
	end
	ClientState.SpotlightOpen = false
	local scale = card:FindFirstChildOfClass("UIScale")
	UIKit.Tween(scale, 0.2, { Scale = 0.85 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	UIKit.Tween(overlay, 0.25, { BackgroundTransparency = 1 })
	task.delay(0.25, function()
		overlay.Visible = false
	end)
end

function Spotlight.Show(key: string)
	local pass = Monetization.GamePasses[key]
	if not pass then
		return
	end
	lastKey = key
	if card then
		card:Destroy()
	end
	local accent = pass.Color or T.Accent
	overlay.Visible = true
	overlay.BackgroundTransparency = 1
	UIKit.Tween(overlay, 0.3, { BackgroundTransparency = 0.45 })
	ClientState.SpotlightOpen = true

	card = new("Frame", {
		Name = "Card", Size = UDim2.fromOffset(520, 380), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = rgb(14, 16, 24), BorderSizePixel = 0, ClipsDescendants = true, Parent = overlay,
	})
	UIKit.Corner(16).Parent = card
	new("UIStroke", { Color = accent, Thickness = 2, Transparency = 0.2, Parent = card })
	new("UIGradient", { Rotation = 90, Color = ColorSequence.new(accent:Lerp(rgb(14, 16, 24), 0.55), rgb(10, 12, 18)), Parent = card })
	local scale = new("UIScale", { Scale = 0.8, Parent = card })
	UIKit.Tween(scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)

	-- light sweep across the card
	local sweep = new("Frame", { Size = UDim2.new(0, 90, 2, 0), Position = UDim2.new(-0.3, 0, -0.5, 0), Rotation = 20, BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.88, BorderSizePixel = 0, Parent = card })
	new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) }), Parent = sweep })
	task.spawn(function()
		while sweep.Parent do
			sweep.Position = UDim2.new(-0.3, 0, -0.5, 0)
			UIKit.Tween(sweep, 1.2, { Position = UDim2.new(1.2, 0, -0.5, 0) }, Enum.EasingStyle.Quad)
			task.wait(3.5)
		end
	end)

	local tag = Label({
		Text = "⭐ FEATURED PASS", Size = UDim2.fromOffset(150, 24), Position = UDim2.new(0.5, 0, 0, 18), AnchorPoint = Vector2.new(0.5, 0),
		TextXAlignment = Enum.TextXAlignment.Center, BackgroundTransparency = 0.2, BackgroundColor3 = rgb(0, 0, 0), TextSize = 12, Font = T.Black, TextColor3 = T.Gold, Parent = card,
	})
	UIKit.Corner(12).Parent = tag

	-- icon with a slowly spinning glow ring
	local ring = new("Frame", { Size = UDim2.fromOffset(120, 120), Position = UDim2.new(0.5, 0, 0, 52), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = accent, BorderSizePixel = 0, Parent = card })
	UIKit.Corner(60).Parent = ring
	local ringGrad = new("UIGradient", {
		Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, accent), ColorSequenceKeypoint.new(0.5, Color3.new(1, 1, 1)), ColorSequenceKeypoint.new(1, accent) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.5, 0.6), NumberSequenceKeypoint.new(1, 0.2) }),
		Parent = ring,
	})
	local inner = new("Frame", { Size = UDim2.new(1, -10, 1, -10), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = rgb(18, 20, 30), BorderSizePixel = 0, Parent = ring })
	UIKit.Corner(55).Parent = inner
	UIKit.Gradient(accent:Lerp(rgb(18, 20, 30), 0.4), rgb(18, 20, 30), 90).Parent = inner
	Label({ Text = pass.Icon or "💎", Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 58, Font = T.Black, Parent = inner })
	local spin
	spin = RunService.RenderStepped:Connect(function(dt)
		if not ring.Parent then
			spin:Disconnect()
			return
		end
		ringGrad.Rotation = (ringGrad.Rotation + dt * 60) % 360
	end)

	local title = Label({ Text = string.upper(pass.Name), Size = UDim2.new(1, -40, 0, 34), Position = UDim2.new(0, 20, 0, 182), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 30, Font = T.Black, Parent = card })
	UIKit.TextStroke(0.4).Parent = title
	local perks = new("Frame", { Size = UDim2.new(1, -80, 0, 70), Position = UDim2.new(0, 40, 0, 222), BackgroundTransparency = 1, Parent = card }, { UIKit.List(4) })
	for i, perk in pass.Perks or {} do
		if i > 3 then
			break
		end
		Label({ Text = "✓  " .. perk, Size = UDim2.new(1, 0, 0, 18), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 14, Font = T.Bold, TextColor3 = rgb(225, 230, 240), LayoutOrder = i, Parent = perks })
	end
	local buy = UIKit.Button({ Text = "GET IT  ·  R$ " .. tostring(pass.Price), Size = UDim2.fromOffset(260, 46), Position = UDim2.new(0.5, 0, 1, -76), AnchorPoint = Vector2.new(0.5, 0), Color = T.Robux, TextSize = 18, Radius = 10, Parent = card }, function()
		Spotlight.BuyPass(key)
		Spotlight.Hide()
	end)
	buy.Name = "Buy"
	local later = new("TextButton", {
		Text = "Maybe later", Size = UDim2.fromOffset(160, 22), Position = UDim2.new(0.5, 0, 1, -26), AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1, Font = T.Bold, TextSize = 13, TextColor3 = T.Sub, Parent = card,
	})
	later.Activated:Connect(Spotlight.Hide)
end

function Spotlight.Init(playerGui: PlayerGui)
	gui = new("ScreenGui", { Name = "Spotlight", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 15, Parent = playerGui })
	overlay = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Modal = true, Visible = false, Parent = gui })
	nextAt = os.clock() + INTERVAL
	task.spawn(function()
		while true do
			task.wait(2)
			if os.clock() >= nextAt and not overlay.Visible and calmMoment() then
				local key = pickPass()
				if key then
					Spotlight.Show(key)
				end
				nextAt = os.clock() + INTERVAL
			end
		end
	end)
end

return Spotlight
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">UIKit</string>
            <string name="Source"><![CDATA[-- Tiny UI helper library + the game's visual theme.
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Sounds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Sounds"))

local UIKit = {}

UIKit.Theme = {
	Bg = Color3.fromRGB(10, 12, 18),
	Panel = Color3.fromRGB(20, 23, 32),
	Panel2 = Color3.fromRGB(30, 34, 46),
	Panel3 = Color3.fromRGB(44, 49, 64),
	Text = Color3.fromRGB(255, 255, 255),
	Sub = Color3.fromRGB(150, 158, 176),
	Accent = Color3.fromRGB(255, 198, 26),
	Accent2 = Color3.fromRGB(0, 204, 255),
	Red = Color3.fromRGB(255, 64, 72),
	Green = Color3.fromRGB(70, 230, 120),
	Gold = Color3.fromRGB(255, 205, 60),
	Robux = Color3.fromRGB(0, 178, 110),
	Black = Enum.Font.GothamBlack,
	Bold = Enum.Font.GothamBold,
	Medium = Enum.Font.GothamMedium,
}
local T = UIKit.Theme

-- UIKit.new("Frame", { Size = ..., Parent = ... }, { children })
function UIKit.new(class: string, props, children)
	local inst = Instance.new(class)
	local parent
	for k, v in props or {} do
		if k == "Parent" then
			parent = v
		else
			inst[k] = v
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end
local new = UIKit.new

function UIKit.Corner(radius: number?)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 8) })
end

function UIKit.Stroke(color: Color3?, thickness: number?, transparency: number?)
	return new("UIStroke", {
		Color = color or Color3.new(1, 1, 1),
		Thickness = thickness or 1,
		Transparency = transparency or 0.85,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UIKit.TextStroke(transparency: number?)
	return new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1.5, Transparency = transparency or 0.4 })
end

function UIKit.Padding(all: number)
	local u = UDim.new(0, all)
	return new("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u })
end

function UIKit.List(padding: number?, horizontal: boolean?, align)
	return new("UIListLayout", {
		Padding = UDim.new(0, padding or 6),
		FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
	})
end

function UIKit.Gradient(top: Color3, bottom: Color3, rotation: number?)
	return new("UIGradient", { Color = ColorSequence.new(top, bottom), Rotation = rotation or 90 })
end

function UIKit.Label(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = T.Bold,
		TextColor3 = T.Text,
		TextSize = 16,
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
	}
	for k, v in props do
		defaults[k] = v
	end
	return new("TextLabel", defaults)
end

function UIKit.Panel(props, children)
	local defaults = {
		BackgroundColor3 = T.Panel,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
	}
	for k, v in props do
		defaults[k] = v
	end
	local plain = defaults.Plain
	defaults.Plain = nil
	local f = new("Frame", defaults, children)
	UIKit.Corner(8).Parent = f
	if not plain then
		UIKit.Polish(f)
	end
	return f
end

-- Adds depth to a panel or button: a soft top-lit gradient and a hairline edge.
-- Skipped automatically when the caller adds its own gradient / stroke.
function UIKit.Polish(inst: GuiObject, strength: number?)
	local k = strength or 1
	local grad = new("UIGradient", {
		Name = "AutoShade", Rotation = 90,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
			ColorSequenceKeypoint.new(1, Color3.new(1, 1, 1):Lerp(Color3.fromRGB(150, 155, 170), 0.55 * k)),
		}),
		Parent = inst,
	})
	local stroke = new("UIStroke", { Name = "AutoEdge", Color = Color3.new(1, 1, 1), Transparency = 0.88, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = inst })
	task.defer(function()
		for _, child in inst:GetChildren() do
			if child:IsA("UIGradient") and child ~= grad then
				grad:Destroy()
				break
			end
		end
		for _, child in inst:GetChildren() do
			if child:IsA("UIStroke") and child ~= stroke then
				stroke:Destroy()
				break
			end
		end
	end)
end

function UIKit.Tween(inst: Instance, time: number, goal, style, direction)
	local tween = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out), goal)
	tween:Play()
	return tween
end

function UIKit.Sound(name: string, pitch: number?)
	local info = Sounds[name]
	if not info then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = info.Id
	s.Volume = info.Volume
	s.PlaybackSpeed = pitch or 1
	s.Parent = SoundService
	s:Play()
	s.Ended:Once(function()
		s:Destroy()
	end)
	task.delay(5, function()
		if s.Parent then
			s:Destroy()
		end
	end)
end

-- Big chunky button in the style of popular shooters.
function UIKit.Button(props, onClick)
	local color = props.Color or T.Accent
	local textColor = props.TextColor or (color == T.Accent and Color3.new(0, 0, 0) or T.Text)
	local btn = new("TextButton", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(160, 44),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = props.Text or "",
		Font = props.Font or T.Black,
		TextSize = props.TextSize or 18,
		TextColor3 = textColor,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	UIKit.Corner(props.Radius or 6).Parent = btn
	UIKit.Polish(btn, 0.8)
	local scale = new("UIScale", { Parent = btn })
	btn.MouseEnter:Connect(function()
		UIKit.Tween(scale, 0.12, { Scale = 1.04 })
		UIKit.Tween(btn, 0.12, { BackgroundColor3 = color:Lerp(Color3.new(1, 1, 1), 0.15) })
	end)
	btn.MouseLeave:Connect(function()
		UIKit.Tween(scale, 0.12, { Scale = 1 })
		UIKit.Tween(btn, 0.12, { BackgroundColor3 = color })
	end)
	btn.MouseButton1Down:Connect(function()
		UIKit.Tween(scale, 0.06, { Scale = 0.96 })
	end)
	btn.MouseButton1Up:Connect(function()
		UIKit.Tween(scale, 0.1, { Scale = 1.04 })
	end)
	if onClick then
		btn.Activated:Connect(function()
			UIKit.Sound("Click")
			onClick()
		end)
	end
	return btn
end

function UIKit.SetButtonColor(btn: TextButton, color: Color3, textColor: Color3?)
	btn.BackgroundColor3 = color
	btn.TextColor3 = textColor or (color == T.Accent and Color3.new(0, 0, 0) or T.Text)
end

-- Horizontal progress bar. Returns frame, fill.
function UIKit.Bar(props)
	local frame = new("Frame", {
		Name = props.Name or "Bar",
		Size = props.Size,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = props.Back or Color3.fromRGB(0, 0, 0),
		BackgroundTransparency = props.BackTransparency or 0.5,
		BorderSizePixel = 0,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	UIKit.Corner(props.Radius or 3).Parent = frame
	local fill = new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(props.Value or 1, 1),
		BackgroundColor3 = props.Color or T.Accent,
		BorderSizePixel = 0,
		Parent = frame,
	})
	UIKit.Corner(props.Radius or 3).Parent = fill
	return frame, fill
end

return UIKit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">VehicleController</string>
            <string name="Source"><![CDATA[-- Arcade car handling. The server gives the driver network ownership,
-- so this client drives the car by setting its velocity directly.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local ClientState = require(script.Parent.ClientState)

local player = Players.LocalPlayer

local Vehicle = {}
Vehicle.Car = nil
Vehicle.Speed = 0
Vehicle.OnChanged = nil -- (driving: boolean) -> ()

local seat, chassis
local flippedTime = 0
local boostHeld = false
local handbrake = false

-- handling state
local steerSmooth = 0 -- eased steering input (-1..1)
local yawRate = 0 -- eased turning rate
local gripNow = 7.5 -- sideways grip (lower = more slide)
local driftTime = 0
local boostTimer = 0
local lastSmoke = 0
local rearTires = {}
local taillights = {}

Vehicle.Drifting = false
Vehicle.DriftTime = 0
Vehicle.Boosting = false

local BRAKE_DECEL = 170 -- studs/s² (80 → 0 in about half a second)
local HANDBRAKE_DECEL = 40
local COAST_DECEL = 10

local function cacheParts(car: Model?)
	rearTires, taillights = {}, {}
	if not car or not car.PrimaryPart then
		return
	end
	local root = car.PrimaryPart
	for _, p in car:GetChildren() do
		if p:IsA("BasePart") then
			local localPos = root.CFrame:PointToObjectSpace(p.Position)
			if p.Name == "Tire" and localPos.Z > 0 then
				table.insert(rearTires, p)
			elseif p.Name == "Taillight" then
				table.insert(taillights, p)
			end
		end
	end
end

local function setDriving(car: Model?, vehicleSeat: VehicleSeat?)
	Vehicle.Car = car
	seat = vehicleSeat
	chassis = car and car.PrimaryPart or nil
	ClientState.Driving = car ~= nil
	cacheParts(car)
	steerSmooth, yawRate, gripNow, driftTime, boostTimer = 0, 0, 7.5, 0, 0
	if car then
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMinZoomDistance = 18
		player.CameraMaxZoomDistance = 40
	else
		player.CameraMinZoomDistance = 0.5
		player.CameraMaxZoomDistance = 128
		if ClientState.Deployed and not ClientState.Dead then
			player.CameraMode = Enum.CameraMode.LockFirstPerson
		end
	end
	if Vehicle.OnChanged then
		Vehicle.OnChanged(car ~= nil)
	end
end

local function bindCharacter(char: Model)
	setDriving(nil, nil)
	local humanoid = char:WaitForChild("Humanoid")
	humanoid.Seated:Connect(function(active, seatPart)
		if active and seatPart and seatPart:IsA("VehicleSeat") and seatPart.Parent and seatPart.Parent:GetAttribute("Vehicle") then
			setDriving(seatPart.Parent, seatPart)
		elseif ClientState.Driving then
			setDriving(nil, nil)
		end
	end)
	humanoid.Died:Connect(function()
		if ClientState.Driving then
			setDriving(nil, nil)
		end
	end)
end

local function puff(position: Vector3, braking: boolean)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(1.4, 1.4, 1.4)
	p.CFrame = CFrame.new(position)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	p.Color = braking and Color3.fromRGB(90, 90, 92) or Color3.fromRGB(215, 215, 220)
	p.Transparency = 0.45
	p.Parent = workspace:FindFirstChild("Effects") or workspace
	TweenService:Create(p, TweenInfo.new(0.9, Enum.EasingStyle.Quad), { Size = Vector3.new(5, 5, 5), Transparency = 1, CFrame = CFrame.new(position + Vector3.new(0, 1.5, 0)) }):Play()
	Debris:AddItem(p, 1)
end

local function step(dt: number)
	if not Vehicle.Car or not chassis or not chassis.Parent or not seat then
		Vehicle.Speed = 0
		Vehicle.Drifting = false
		return
	end
	local car = Vehicle.Car
	local baseSpeed = car:GetAttribute("Speed") or 80
	local maxSpeed = baseSpeed * (boostHeld and 1.25 or 1) * (boostTimer > 0 and 1.15 or 1)
	local throttle = seat.ThrottleFloat
	local cf = chassis.CFrame
	local forward = cf.LookVector
	local flatForward = Vector3.new(forward.X, 0, forward.Z)
	flatForward = flatForward.Magnitude > 0.01 and flatForward.Unit or Vector3.zAxis
	local vel = chassis.AssemblyLinearVelocity
	local forwardSpeed = vel:Dot(flatForward)
	local lateral = vel - flatForward * forwardSpeed
	lateral = Vector3.new(lateral.X, 0, lateral.Z)
	local lateralSpeed = lateral.Magnitude
	local speedRatio = math.clamp(math.abs(forwardSpeed) / baseSpeed, 0, 1)

	-- SMOOTH STEERING: ease toward the input, return to center a bit faster
	local steerIn = seat.SteerFloat
	local steerRate = steerIn == 0 and 7 or 4.5
	steerSmooth += (steerIn - steerSmooth) * math.min(1, dt * steerRate)

	-- THROTTLE / BRAKES
	local braking = throttle ~= 0 and math.sign(throttle) ~= math.sign(forwardSpeed) and math.abs(forwardSpeed) > 1
	local target, accel
	if braking then
		target, accel = 0, BRAKE_DECEL
	elseif throttle > 0 then
		target = throttle * maxSpeed
		accel = 46 * (1 - 0.7 * speedRatio * speedRatio) + (boostTimer > 0 and 40 or 0)
	elseif throttle < 0 then
		target, accel = throttle * baseSpeed * 0.4, 30
	else
		target, accel = 0, COAST_DECEL
	end
	if handbrake then
		target = 0
		accel = math.max(accel, HANDBRAKE_DECEL)
	end
	forwardSpeed += math.clamp(target - forwardSpeed, -accel * dt, accel * dt)
	-- park instead of creeping
	if throttle == 0 and math.abs(forwardSpeed) < 1.5 and not handbrake then
		forwardSpeed = 0
	end

	-- DRIFT: Ctrl breaks the rear loose; throttle + steering keeps the slide going
	local drifting = handbrake or (driftTime > 0 and lateralSpeed > 8 and math.abs(steerSmooth) > 0.25 and throttle > 0)
	local gripTarget
	if handbrake then
		gripTarget = 0.9
	elseif drifting then
		gripTarget = 2.2
	elseif braking then
		gripTarget = 11 -- strong, straight-line braking
	else
		gripTarget = 7.5
	end
	-- lose grip quickly, regain it smoothly (no snapping out of a drift)
	gripNow += (gripTarget - gripNow) * math.min(1, dt * (gripTarget > gripNow and 2.5 or 12))
	local keep = math.max(0, 1 - dt * gripNow)
	local lostSideways = lateralSpeed * (1 - keep)
	lateral *= keep
	-- part of the sideways momentum turns into forward speed while drifting
	if drifting and forwardSpeed > 0 then
		forwardSpeed = math.min(maxSpeed, forwardSpeed + lostSideways * 0.35)
	end
	chassis.AssemblyLinearVelocity = flatForward * forwardSpeed + lateral + Vector3.new(0, vel.Y, 0)

	if drifting then
		driftTime += dt
	else
		if driftTime > 0.8 then
			boostTimer = 0.8 -- drift boost on exit
		end
		driftTime = 0
	end
	boostTimer = math.max(0, boostTimer - dt)
	Vehicle.Drifting = drifting and lateralSpeed > 6
	Vehicle.DriftTime = driftTime
	Vehicle.Boosting = boostTimer > 0

	-- TURNING: eased yaw rate, less twitchy at speed, looser while drifting
	local steerFactor = math.clamp(forwardSpeed / 16, -1, 1)
	local yawTarget = -steerSmooth * 1.8 * steerFactor * (1 - 0.4 * speedRatio)
	if drifting then
		yawTarget *= 1.7
	end
	yawRate += (yawTarget - yawRate) * math.min(1, dt * 7)
	local av = chassis.AssemblyAngularVelocity
	chassis.AssemblyAngularVelocity = Vector3.new(av.X * 0.6, yawRate, av.Z * 0.6)

	-- tire smoke when sliding or braking hard; brake lights
	local now = os.clock()
	local smoking = lateralSpeed > 10 or (braking and math.abs(forwardSpeed) > 25)
	if smoking and now - lastSmoke > 0.05 then
		lastSmoke = now
		for _, tire in rearTires do
			puff(tire.Position - Vector3.new(0, tire.Size.Y * 0.35, 0), braking)
		end
	end
	local brakeOn = braking or handbrake
	for _, light in taillights do
		light.Color = brakeOn and Color3.fromRGB(255, 45, 45) or Color3.fromRGB(150, 15, 15)
	end

	-- auto-flip when stuck upside down
	if cf.UpVector.Y < 0.3 then
		flippedTime += dt
		if flippedTime > 1.5 then
			flippedTime = 0
			chassis.CFrame = CFrame.lookAt(cf.Position + Vector3.new(0, 5, 0), cf.Position + Vector3.new(0, 5, 0) + flatForward)
			chassis.AssemblyLinearVelocity = Vector3.zero
		end
	else
		flippedTime = 0
	end
	Vehicle.Speed = math.abs(forwardSpeed)
	local cam = workspace.CurrentCamera
	cam.FieldOfView = cam.FieldOfView + ((70 + speedRatio * 18 + (boostTimer > 0 and 6 or 0)) - cam.FieldOfView) * math.min(1, dt * 4)
end

function Vehicle.Init()
	if player.Character then
		task.spawn(bindCharacter, player.Character)
	end
	player.CharacterAdded:Connect(bindCharacter)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.LeftShift then
			boostHeld = true
		elseif not processed and (input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.ButtonL1) then
			handbrake = true
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.LeftShift then
			boostHeld = false
		elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.ButtonL1 then
			handbrake = false
		end
	end)
	RunService.Heartbeat:Connect(step)
end

return Vehicle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">VoteScreen</string>
            <string name="Source"><![CDATA[-- Pre-match vote screen: 3 rotating map choices + the 3 game modes.
-- Shown to everyone while MatchState == "Voting" (above every other menu).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local ClientState = require(script.Parent.ClientState)

local player = Players.LocalPlayer
local T = UIKit.Theme
local new, Label = UIKit.new, UIKit.Label
local rgb = Color3.fromRGB

local VoteScreen = {}

-- per-map card art (gradient colors)
local THEMES = {
	Downtown = { rgb(255, 150, 60), rgb(60, 40, 110) },
	Harbor = { rgb(40, 170, 220), rgb(20, 40, 80) },
	Timberline = { rgb(90, 200, 90), rgb(20, 60, 40) },
	Arena = { rgb(255, 210, 40), rgb(0, 140, 200) },
}
local MODE_ICONS = { FFA = "💀", TDM = "⚔️", TTDM = "🔺" }

local gui, root, timerLabel, timerBar, mapRow, modeRow, footer
local blur
local cards = {} -- id -> { Kind, Frame, Stroke, Count, Fill, Badge, Lead, Scale }
local builtFor = nil
local myMap, myMode = nil, nil

local function votes(id: string): number
	return ReplicatedStorage:GetAttribute("Votes_" .. id) or 0
end

local function card(parent: Instance, id: string, kind: string, order: number, size: Vector2, top: Color3, bottom: Color3)
	local btn = new("TextButton", {
		Name = id, Size = UDim2.fromOffset(size.X, size.Y), BackgroundColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = false, Text = "", LayoutOrder = order, ClipsDescendants = true, Parent = parent,
	})
	UIKit.Corner(12).Parent = btn
	UIKit.Gradient(top, bottom, 90).Parent = btn
	local stroke = new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2, Transparency = 0.75, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = btn })
	local scale = new("UIScale", { Parent = btn })
	-- glossy shine across the top
	local shine = new("Frame", { Size = UDim2.new(1, 0, 0.45, 0), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.88, BorderSizePixel = 0, Parent = btn })
	new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0, 1), Parent = shine })
	-- dark footer strip for the vote bar
	local bottomStrip = new("Frame", { Size = UDim2.new(1, 0, 0, 34), Position = UDim2.new(0, 0, 1, -34), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, BorderSizePixel = 0, Parent = btn })
	local barBack = new("Frame", { Size = UDim2.new(1, -90, 0, 8), Position = UDim2.new(0, 12, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.8, BorderSizePixel = 0, Parent = bottomStrip })
	UIKit.Corner(4).Parent = barBack
	local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.Accent, BorderSizePixel = 0, Parent = barBack })
	UIKit.Corner(4).Parent = fill
	local count = Label({ Text = "0 VOTES", Size = UDim2.new(0, 70, 1, 0), Position = UDim2.new(1, -10, 0, 0), AnchorPoint = Vector2.new(1, 0), TextXAlignment = Enum.TextXAlignment.Right, TextSize = 13, Font = T.Black, Parent = bottomStrip })
	local badge = Label({
		Text = "✓ YOUR VOTE", Size = UDim2.fromOffset(104, 22), Position = UDim2.new(1, -10, 0, 10), AnchorPoint = Vector2.new(1, 0),
		TextXAlignment = Enum.TextXAlignment.Center, BackgroundTransparency = 0, BackgroundColor3 = T.Accent, TextColor3 = Color3.new(0, 0, 0), TextSize = 11, Font = T.Black, Visible = false, ZIndex = 3, Parent = btn,
	})
	UIKit.Corner(11).Parent = badge
	local lead = Label({
		Text = "🔥 LEADING", Size = UDim2.fromOffset(96, 22), Position = UDim2.fromOffset(10, 10),
		TextXAlignment = Enum.TextXAlignment.Center, BackgroundTransparency = 0.2, BackgroundColor3 = rgb(230, 60, 50), TextSize = 11, Font = T.Black, Visible = false, ZIndex = 3, Parent = btn,
	})
	UIKit.Corner(11).Parent = lead

	btn.MouseEnter:Connect(function()
		UIKit.Tween(scale, 0.15, { Scale = 1.04 })
	end)
	btn.MouseLeave:Connect(function()
		UIKit.Tween(scale, 0.15, { Scale = 1 })
	end)
	btn.Activated:Connect(function()
		UIKit.Sound("Click")
		if kind == "Map" then
			myMap = id
		else
			myMode = id
		end
		Remotes.Vote:FireServer(id)
		scale.Scale = 0.95
		UIKit.Tween(scale, 0.25, { Scale = 1.04 }, Enum.EasingStyle.Back)
	end)
	cards[id] = { Kind = kind, Frame = btn, Stroke = stroke, Count = count, Fill = fill, Badge = badge, Lead = lead }
	return btn
end

local function section(title: string, sub: string, y: number, height: number)
	local holder = new("Frame", { Size = UDim2.new(1, 0, 0, height + 34), Position = UDim2.fromOffset(0, y), BackgroundTransparency = 1, Parent = root })
	local t = Label({ Text = title, Size = UDim2.new(1, 0, 0, 22), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 18, Font = T.Black, Parent = holder })
	UIKit.TextStroke(0.5).Parent = t
	Label({ Text = sub, Size = UDim2.new(1, 0, 0, 14), Position = UDim2.fromOffset(0, 20), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 11, Font = T.Bold, TextColor3 = T.Sub, Parent = holder })
	local row = new("Frame", { Size = UDim2.new(1, 0, 0, height), Position = UDim2.fromOffset(0, 40), BackgroundTransparency = 1, Parent = holder }, {
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 16), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	return row
end

local function build(options: { string })
	for _, c in cards do
		c.Frame:Destroy()
	end
	cards = {}
	myMap, myMode = nil, nil
	for i, id in options do
		local info = Config.Maps[id] or { Name = id, Icon = "🗺️", Desc = "" }
		local theme = THEMES[id] or { T.Panel3, T.Panel }
		local c = card(mapRow, id, "Map", i, Vector2.new(250, 170), theme[1], theme[2])
		local icon = Label({ Text = info.Icon, Size = UDim2.new(1, 0, 0, 58), Position = UDim2.fromOffset(0, 30), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 54, Font = T.Black, Parent = c })
		icon.TextTransparency = 0.05
		local name = Label({ Text = info.Name, Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(10, 88), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 22, Font = T.Black, Parent = c })
		UIKit.TextStroke(0.4).Parent = name
		Label({ Text = info.Desc, Size = UDim2.new(1, -20, 0, 16), Position = UDim2.fromOffset(10, 114), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 12, Font = T.Bold, TextColor3 = rgb(225, 230, 240), Parent = c })
	end
	for i, id in Config.ModeOrder do
		local m = Config.Modes[id]
		local accent = (#m.Teams > 0) and Config.Teams[m.Teams[1]].Color or rgb(200, 70, 220)
		local c = card(modeRow, id, "Mode", i, Vector2.new(250, 156), accent:Lerp(Color3.new(0, 0, 0), 0.35), rgb(18, 20, 30))
		Label({ Text = MODE_ICONS[id] or "🎯", Size = UDim2.fromOffset(40, 36), Position = UDim2.fromOffset(12, 12), TextSize = 28, Font = T.Black, Parent = c })
		local name = Label({ Text = m.Name, Size = UDim2.new(1, -66, 0, 36), Position = UDim2.fromOffset(56, 10), TextSize = 15, Font = T.Black, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Parent = c })
		UIKit.TextStroke(0.5).Parent = name
		-- team color dots (one per team, or a rainbow ring of 6 for FFA)
		local dots = new("Frame", { Size = UDim2.fromOffset(120, 12), Position = UDim2.fromOffset(56, 50), BackgroundTransparency = 1, Parent = c }, { UIKit.List(4, true) })
		local colors = {}
		if #m.Teams > 0 then
			for _, team in m.Teams do
				table.insert(colors, Config.Teams[team].Color)
			end
		else
			for k = 0, 5 do
				table.insert(colors, Color3.fromHSV(k / 6, 0.7, 1))
			end
		end
		for k, col in colors do
			local d = new("Frame", { Size = UDim2.fromOffset(12, 12), BackgroundColor3 = col, BorderSizePixel = 0, LayoutOrder = k, Parent = dots })
			UIKit.Corner(6).Parent = d
		end
		Label({ Text = m.Desc or "", Size = UDim2.new(1, -24, 0, 28), Position = UDim2.fromOffset(12, 68), TextSize = 11, Font = T.Bold, TextColor3 = rgb(210, 215, 228), TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Parent = c })
		c:FindFirstChild("Frame").Size = UDim2.new(1, 0, 0.35, 0)
		-- badges sit in their own row above the vote bar so they never cover the text
		cards[id].Badge.Position = UDim2.new(1, -10, 1, -60)
		cards[id].Lead.Position = UDim2.new(0, 10, 1, -60)
	end
end

local function refresh()
	local totals = { Map = 0, Mode = 0 }
	local best = { Map = { 0, nil }, Mode = { 0, nil } }
	for id, c in cards do
		local n = votes(id)
		totals[c.Kind] += n
		if n > best[c.Kind][1] then
			best[c.Kind] = { n, id }
		end
	end
	for id, c in cards do
		local n = votes(id)
		local mine = (c.Kind == "Map" and id == myMap) or (c.Kind == "Mode" and id == myMode)
		c.Count.Text = n .. (n == 1 and " VOTE" or " VOTES")
		local share = totals[c.Kind] > 0 and n / totals[c.Kind] or 0
		c.Fill.Size = c.Fill.Size:Lerp(UDim2.fromScale(share, 1), 0.2)
		c.Fill.BackgroundColor3 = mine and T.Accent or Color3.new(1, 1, 1)
		c.Badge.Visible = mine
		c.Lead.Visible = best[c.Kind][2] == id
		c.Stroke.Color = mine and T.Accent or Color3.new(1, 1, 1)
		c.Stroke.Thickness = mine and 4 or 2
		c.Stroke.Transparency = mine and 0 or 0.75
	end
end

function VoteScreen.Init(playerGui: PlayerGui)
	gui = new("ScreenGui", { Name = "Vote", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 20, Enabled = false, Parent = playerGui })
	local bg = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = rgb(6, 8, 14), BackgroundTransparency = 0.12, Text = "", AutoButtonColor = false, Modal = true, Parent = gui })
	new("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(rgb(30, 36, 60), rgb(4, 5, 10)),
		Parent = bg,
	})
	-- diagonal accent stripes
	for k = 0, 2 do
		local stripe = new("Frame", {
			Size = UDim2.new(0, 6, 2, 0), Position = UDim2.new(0.08 + k * 0.03, 0, -0.5, 0), Rotation = 25,
			BackgroundColor3 = T.Accent, BackgroundTransparency = 0.82 + k * 0.05, BorderSizePixel = 0, Parent = bg,
		})
		stripe.ZIndex = 0
	end

	root = new("Frame", { Size = UDim2.fromOffset(820, 570), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Parent = bg })
	local rootScale = new("UIScale", { Parent = root })

	local title = Label({ Text = "VOTE FOR THE NEXT MATCH", Size = UDim2.new(1, 0, 0, 44), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 38, Font = T.Black, Parent = root })
	UIKit.Gradient(T.Accent, rgb(255, 120, 30), 90).Parent = title
	UIKit.TextStroke(0.5).Parent = title
	-- timer pill + shrinking bar
	local pill = UIKit.Panel({ Size = UDim2.fromOffset(150, 34), Position = UDim2.new(0.5, 0, 0, 50), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = rgb(0, 0, 0), BackgroundTransparency = 0.35 })
	pill.Parent = root
	UIKit.Corner(17).Parent = pill
	UIKit.Stroke(T.Accent, 1.5, 0.3).Parent = pill
	timerLabel = Label({ Text = "15", Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 18, Font = T.Black, Parent = pill })
	local barBack = new("Frame", { Size = UDim2.fromOffset(360, 4), Position = UDim2.new(0.5, 0, 0, 92), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.85, BorderSizePixel = 0, Parent = root })
	UIKit.Corner(2).Parent = barBack
	timerBar = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.Accent, BorderSizePixel = 0, Parent = barBack })
	UIKit.Corner(2).Parent = timerBar

	mapRow = section("🗺️  CHOOSE A MAP", "A new set of maps every round", 110, 170)
	modeRow = section("🎮  CHOOSE A MODE", "No mode votes? The game moves on to the next mode", 330, 156)
	footer = Label({ Text = "Click a card to vote · you can change your vote any time", Size = UDim2.new(1, 0, 0, 16), Position = UDim2.new(0, 0, 1, -10), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 12, Font = T.Bold, TextColor3 = T.Sub, Parent = root })

	blur = new("BlurEffect", { Name = "VoteBlur", Size = 0, Parent = Lighting })

	local wasOpen = false
	RunService.Heartbeat:Connect(function()
		local open = ReplicatedStorage:GetAttribute("MatchState") == "Voting"
		local options = ReplicatedStorage:GetAttribute("VoteOptions") or ""
		if open and options ~= "" and options ~= builtFor then
			builtFor = options
			build(string.split(options, ","))
		end
		if open ~= wasOpen then
			wasOpen = open
			gui.Enabled = open
			ClientState.VoteOpen = open
			UIKit.Tween(blur, 0.4, { Size = open and 18 or 0 })
			if open then
				root.Position = UDim2.new(0.5, 0, 0.5, 30)
				UIKit.Tween(root, 0.45, { Position = UDim2.fromScale(0.5, 0.5) }, Enum.EasingStyle.Back)
			else
				builtFor = nil
			end
		end
		if not open then
			return
		end
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
		rootScale.Scale = math.clamp(math.min(vp.X / 880, vp.Y / 600), 0.45, 1.25)
		local left = math.max(0, (ReplicatedStorage:GetAttribute("MatchEnd") or 0) - workspace:GetServerTimeNow())
		timerLabel.Text = "⏱  " .. math.ceil(left) .. "s"
		timerLabel.TextColor3 = left <= 2 and T.Red or T.Text
		timerBar.Size = UDim2.fromScale(math.clamp(left / Config.VoteLength, 0, 1), 1)
		timerBar.BackgroundColor3 = left <= 2 and T.Red or T.Accent
		footer.Text = left <= 1 and "Locking in votes…" or "Click a card to vote · you can change your vote any time"
		refresh()
	end)
	player:GetAttributeChangedSignal("Team"):Connect(refresh)
end

return VoteScreen
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">WeaponController</string>
            <string name="Source"><![CDATA[-- First-person gunplay: viewmodel, ADS, recoil, spread, reloads, knife, grenades.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Weapons = require(Shared.Weapons)
local GunBuilder = require(Shared.GunBuilder)
local Remotes = require(Shared.Remotes)
local ClientState = require(script.Parent.ClientState)
local Effects = require(script.Parent.Effects)
local UIKit = require(script.Parent.UIKit)
local Movement = require(script.Parent.MovementController)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local WC = {}
WC.HUD = nil -- injected

local function baseFov()
	return ClientState.Settings.FOV or 72
end
local spin = 0 -- minigun spin-up progress (0..1)

local current = nil -- { Id, Def, Tool }
local ammo = {} -- [weaponId] = { Mag, Reserve }
local firing = false
local aiming = false
local reloading = false
local reloadStart, reloadEnd, reloadToken = 0, 0, 0
local lastShot = 0
local lastShotVis = -10 -- time of the last visual shot (drives moving parts)
local animParts = {} -- moving parts of the current viewmodel
local animPivots = {}
local gunFlags = {}
local cylAngle, cylTarget, barrelAngle = 0, 0, 0
local function infinite(): boolean
	return player:GetAttribute("InfiniteAmmo") == true
end
local burstBusy = false
local bloom = 0
local aimAlpha = 0
local sprintAlpha = 0
local recoilPitch, recoilYaw = 0, 0
local kick = 0
local bobT = 0
local sway = Vector2.zero
local equipTime = 0
local knifeTime = -10
local throwTime = -10
local viewmodel = nil
local knifeModel = nil
local character, humanoid

local function extended()
	return ClientState.HasPass("ExtendedMags")
end

local function fullAmmo(id: string)
	local def = Weapons.Get(id)
	ammo[id] = { Mag = Weapons.MagSize(def, extended()), Reserve = Weapons.ReserveSize(def, extended()) }
end

function WC.RefillReserve()
	for id, a in ammo do
		a.Reserve = Weapons.ReserveSize(Weapons.Get(id), extended())
	end
end

local function updateHud()
	if not WC.HUD then
		return
	end
	if current then
		local a = ammo[current.Id]
		WC.HUD.SetAmmo(a.Mag, a.Reserve, current.Def.Name, reloading, Weapons.MagSize(current.Def, extended()), infinite())
	else
		WC.HUD.SetAmmo(0, 0, "", false, 1)
	end
end

local function alive(): boolean
	return humanoid ~= nil and humanoid.Health > 0 and ClientState.Deployed
end

local function canAct(): boolean
	return alive() and not ClientState.MenuOpen and not ClientState.VoteOpen and not ClientState.SpotlightOpen and not ClientState.Driving and player:GetAttribute("Downed") ~= true
end

-- VIEWMODEL --------------------------------------------------------------------
local function setVMPart(p: BasePart)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
end

local function arm(parent, name, size, cf, color)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.CFrame = cf
	setVMPart(p)
	p.Parent = parent
	return p
end

local function buildViewmodel(id: string)
	if viewmodel then
		viewmodel:Destroy()
	end
	local def = Weapons.Get(id)
	local model = GunBuilder.Build(id, ClientState.HasPass("GoldenArsenal"))
	local handle = model.PrimaryPart
	local L = def.Look.Length
	local skin = Color3.fromRGB(234, 184, 146)
	local sleeve = Color3.fromRGB(35, 38, 46)
	if character then
		local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
		local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
		skin = hand and hand.Color or skin
		sleeve = torso and torso.Color or sleeve
	end
	local cf = handle.CFrame
	local gripA = handle:FindFirstChild("GripPoint")
	local foreA = handle:FindFirstChild("ForePoint")
	local g = gripA and gripA.Position or Vector3.new(0, -0.45, L * 0.22)
	local f = foreA and foreA.Position or Vector3.new(0, -0.25, -L * 0.3)
	arm(model, "RightHand", Vector3.new(0.38, 0.42, 0.42), cf * CFrame.new(g + Vector3.new(0.04, 0.02, 0)), skin)
	arm(model, "RightSleeve", Vector3.new(0.5, 0.5, 1.9), cf * CFrame.new(g + Vector3.new(0.3, -0.25, 1.05)) * CFrame.Angles(math.rad(14), math.rad(8), 0), sleeve)
	arm(model, "LeftHand", Vector3.new(0.38, 0.38, 0.48), cf * CFrame.new(f + Vector3.new(-0.04, -0.06, 0)), skin)
	arm(model, "LeftSleeve", Vector3.new(0.5, 0.5, 2.1), cf * CFrame.new(f + Vector3.new(-0.55, -0.32, 1.0)) * CFrame.Angles(math.rad(12), math.rad(-28), 0), sleeve)
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			setVMPart(p)
		end
	end
	model.Parent = camera
	viewmodel = model
	-- remember every moving part relative to the receiver
	animParts = {}
	animPivots = {
		Cylinder = model:GetAttribute("CylinderPivot"),
		Barrels = model:GetAttribute("BarrelsPivot"),
		Break = model:GetAttribute("BreakPivot"),
	}
	gunFlags = { Shell = model:GetAttribute("Shell") or "Brass" }
	local hcf = handle.CFrame
	for _, p in model:GetDescendants() do
		local kind = p:IsA("BasePart") and p:GetAttribute("Anim")
		if kind then
			gunFlags[kind] = true
			table.insert(animParts, { Part = p, Kind = kind, Base = hcf:ToObjectSpace(p.CFrame), Color = p.Color })
		end
	end
	cylAngle, cylTarget, barrelAngle = 0, 0, 0
end

local function buildKnife()
	local model = Instance.new("Model")
	model.Name = "Knife"
	local handle = Instance.new("Part")
	handle.Size = Vector3.new(0.18, 0.25, 0.7)
	handle.Color = Color3.fromRGB(25, 25, 28)
	setVMPart(handle)
	handle.Parent = model
	local blade = Instance.new("Part")
	blade.Size = Vector3.new(0.05, 0.25, 1.1)
	blade.Color = Color3.fromRGB(220, 225, 235)
	blade.Material = Enum.Material.Metal
	blade.CFrame = handle.CFrame * CFrame.new(0, 0.02, -0.9)
	setVMPart(blade)
	blade.Parent = model
	model.PrimaryPart = handle
	model.Parent = nil
	return model
end

local function hideToolLocally()
	if current and current.Tool then
		for _, p in current.Tool:GetDescendants() do
			if p:IsA("BasePart") then
				p.LocalTransparencyModifier = 1
			end
		end
	end
end

local function setViewmodelVisible(visible: boolean)
	if viewmodel then
		for _, p in viewmodel:GetDescendants() do
			if p:IsA("BasePart") then
				p.LocalTransparencyModifier = visible and 0 or 1
			end
		end
	end
end

-- EQUIP ------------------------------------------------------------------------
local function equip(tool: Tool)
	local id = tool:GetAttribute("WeaponId")
	local def = id and Weapons.Get(id)
	if not def then
		return
	end
	reloading = false
	reloadToken += 1
	burstBusy = false
	current = { Id = id, Def = def, Tool = tool }
	if not ammo[id] then
		fullAmmo(id)
	end
	equipTime = os.clock()
	Movement.State.SpeedMult = def.Speed
	buildViewmodel(id)
	updateHud()
end

local function unequip()
	current = nil
	firing = false
	if viewmodel then
		viewmodel:Destroy()
		viewmodel = nil
	end
	updateHud()
end

function WC.EquipSlot(slot: string)
	if not canAct() then
		return
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return
	end
	for _, tool in backpack:GetChildren() do
		if tool:IsA("Tool") and tool:GetAttribute("Slot") == slot then
			humanoid:EquipTool(tool)
			return
		end
	end
end

local function cycle()
	if current then
		WC.EquipSlot(current.Def.Slot == "Primary" and "Secondary" or "Primary")
	end
end

-- SHOOTING -------------------------------------------------------------------
local function currentSpread(): number
	if not current then
		return 0
	end
	local def = current.Def
	local s = def.Spread + (def.AdsSpread - def.Spread) * aimAlpha
	if humanoid and humanoid.MoveDirection.Magnitude > 0.1 and not Movement.State.Sliding then
		s *= 1.3
	end
	if Movement.State.Airborne then
		s *= 1.5
	end
	return s + bloom
end

local function spreadDir(cf: CFrame, degrees: number): Vector3
	local r = math.rad(degrees) * math.sqrt(math.random())
	local theta = math.random() * math.pi * 2
	return (cf.Rotation * CFrame.Angles(0, 0, theta) * CFrame.Angles(r, 0, 0)).LookVector
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function muzzlePosition(): Vector3
	if viewmodel and viewmodel.PrimaryPart then
		local m = viewmodel.PrimaryPart:FindFirstChild("Muzzle")
		if m then
			return m.WorldPosition
		end
	end
	return camera.CFrame.Position + camera.CFrame.LookVector * 2
end

local function shotVisual(dir: Vector3)
	if not current then
		return
	end
	local def = current.Def
	if def.Projectile then
		return -- the server simulates and replicates the rocket
	end
	rayParams.FilterDescendantsInstances = { character, camera, workspace:FindFirstChild("Effects") }
	local origin = camera.CFrame.Position
	local result = workspace:Raycast(origin, dir * def.Range, rayParams)
	local hitPos = result and result.Position or origin + dir * def.Range
	local neon = def.Look.Neon
	Effects.Tracer(muzzlePosition(), hitPos, neon and def.Look.Accent or nil, neon and 0.25 or 0.08)
	if result then
		Effects.Impact(hitPos)
	end
end

local function ejectShell(kind: string)
	if not viewmodel or kind == "None" then
		return
	end
	local att = viewmodel.PrimaryPart and viewmodel.PrimaryPart:FindFirstChild("Eject")
	if not att then
		return
	end
	local isShell = kind == "Shell"
	local shell = Instance.new("Part")
	shell.Name = "Casing"
	shell.Size = isShell and Vector3.new(0.14, 0.14, 0.3) or Vector3.new(0.06, 0.06, 0.16)
	shell.Color = isShell and Color3.fromRGB(190, 40, 40) or Color3.fromRGB(205, 165, 75)
	shell.Material = Enum.Material.Metal
	shell.CFrame = att.WorldCFrame * CFrame.Angles(0, math.rad(90), 0)
	shell.CanCollide = false
	shell.CanQuery = false
	shell.CanTouch = false
	shell.CastShadow = false
	shell.Parent = workspace:FindFirstChild("Effects") or workspace
	local cam = camera.CFrame
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local carry = root and root.AssemblyLinearVelocity or Vector3.zero
	shell.AssemblyLinearVelocity = carry + cam.RightVector * (9 + math.random() * 4) + cam.UpVector * (6 + math.random() * 3) - cam.LookVector * 2
	shell.AssemblyAngularVelocity = Vector3.new(math.random(-25, 25), math.random(-25, 25), math.random(-25, 25))
	task.delay(0.12, function()
		if shell.Parent then
			shell.CanCollide = true
		end
	end)
	Debris:AddItem(shell, 2.5)
end

local function kickRecoil(def)
	lastShotVis = os.clock()
	cylTarget += math.pi / 3
	-- spent casings: straight out for semi/auto, after the pump / bolt is cycled otherwise
	if not gunFlags.Break then
		local delay = (gunFlags.Pump or gunFlags.BoltAction) and 0.3 or 0
		local shellKind = gunFlags.Shell
		if delay > 0 then
			task.delay(delay, ejectShell, shellKind)
		else
			ejectShell(shellKind)
		end
	end
	-- slight physical kickback on the big guns
	if (def.Kickback or 0) > 0 and character and not ClientState.Driving then
		local root = character:FindFirstChild("HumanoidRootPart")
		local look = camera.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if root and flat.Magnitude > 0.01 then
			root.AssemblyLinearVelocity += -flat.Unit * def.Kickback * (Movement.State.Airborne and 1.4 or 1)
		end
		Effects.Shake(def.Kickback * 0.07)
	end
	local adsFactor = 1 - aimAlpha * 0.45
	recoilPitch += def.Recoil * adsFactor
	recoilYaw += (math.random() - 0.5) * def.Recoil * 0.6 * adsFactor
	kick = math.min(kick + 0.6 + def.Recoil * 0.08, 2)
	bloom = math.min(bloom + def.Spread * 0.18, def.Spread * 1.2)
	Effects.Flash(muzzlePosition(), def.Look.Neon and def.Look.Accent or nil)
	UIKit.Sound((def.Class == "Sniper" or def.Class == "Exotic") and "ShotHeavy" or "Shot", 0.92 + math.random() * 0.16)
end

function WC.Reload()
	if not current or reloading or not alive() or infinite() then
		return
	end
	if gunFlags.Break then
		task.delay(0.35, ejectShell, "Shell")
		task.delay(0.4, ejectShell, "Shell")
	end
	local def = current.Def
	local a = ammo[current.Id]
	if a.Mag >= Weapons.MagSize(def, extended()) or a.Reserve <= 0 then
		return
	end
	reloading = true
	reloadToken += 1
	local token = reloadToken
	local id = current.Id
	local duration = def.Reload * (ClientState.HasPass("FastHands") and 0.65 or 1)
	reloadStart = os.clock()
	reloadEnd = reloadStart + duration
	Remotes.Reload:FireServer(id)
	UIKit.Sound("Reload")
	updateHud()
	task.delay(duration, function()
		if token ~= reloadToken or not current or current.Id ~= id then
			return
		end
		local need = Weapons.MagSize(def, extended()) - a.Mag
		local take = math.min(need, a.Reserve)
		a.Mag += take
		a.Reserve -= take
		reloading = false
		UIKit.Sound("Reload", 1.3)
		updateHud()
	end)
end

local function tryShoot()
	if not current or not canAct() or reloading or burstBusy then
		return
	end
	local def = current.Def
	local now = os.clock()
	local rate = def.FireRate * (ClientState.Overdrive() and 1.5 or 1)
	if now - lastShot < 1 / rate then
		return
	end
	if now - equipTime < 0.25 then
		return
	end
	if def.SpinUp and spin < 1 then
		return
	end
	local a = ammo[current.Id]
	local unlimited = infinite()
	if a.Mag <= 0 and not unlimited then
		UIKit.Sound("Empty")
		if ClientState.OnDryFire then
			ClientState.OnDryFire()
		end
		WC.Reload()
		return
	end
	lastShot = now

	local flags = {
		Ads = aimAlpha > 0.6,
		Slide = Movement.State.Sliding,
		Air = Movement.State.Airborne,
		Dash = Movement.Recently("Dash", 1),
	}
	local origin = camera.CFrame.Position
	local spread = currentSpread()
	local dirs = {}
	if def.Burst then
		local rounds = unlimited and def.Burst or math.min(def.Burst, a.Mag)
		for i = 1, rounds do
			dirs[i] = spreadDir(camera.CFrame * CFrame.Angles(math.rad(def.Recoil * 0.25 * (i - 1)), 0, 0), spread)
		end
		if not unlimited then
			a.Mag -= rounds
		end
		burstBusy = true
		for i, dir in dirs do
			task.delay((i - 1) * def.BurstDelay, function()
				shotVisual(dir)
				kickRecoil(def)
			end)
		end
		task.delay(rounds * def.BurstDelay, function()
			burstBusy = false
		end)
	else
		for i = 1, def.Pellets or 1 do
			dirs[i] = spreadDir(camera.CFrame, spread)
			shotVisual(dirs[i])
		end
		if not unlimited then
			a.Mag -= 1
		end
		kickRecoil(def)
	end
	Remotes.Fire:FireServer(current.Id, origin, dirs, flags)
	updateHud()
	if a.Mag <= 0 and not unlimited then
		task.delay(0.25, WC.Reload)
	end
end

function WC.Knife()
	if not canAct() or os.clock() - knifeTime < 0.7 then
		return
	end
	knifeTime = os.clock()
	Remotes.Knife:FireServer()
	UIKit.Sound("Knife")
end

function WC.Grenade()
	if not canAct() or (player:GetAttribute("Grenades") or 0) <= 0 or os.clock() - throwTime < 0.8 then
		return
	end
	throwTime = os.clock()
	Remotes.Grenade:FireServer(camera.CFrame.LookVector)
	UIKit.Sound("Dash", 0.6)
end

function WC.Spin(): number
	return spin
end

function WC.CurrentDef()
	return current and current.Def or nil
end

function WC.OnHit(info)
	if not info.Vehicle then
		Effects.HitFlash(info.Position, info.Headshot)
	end
	if WC.HUD then
		WC.HUD.Hitmarker(info.Headshot, info.Killed)
		WC.HUD.DamageNumber(info.Position, info.Damage, info.Headshot)
	end
	if info.Killed then
		UIKit.Sound("Kill", 1.4)
	else
		UIKit.Sound("Hit", info.Headshot and 2.1 or 1.6)
	end
end

-- MOVING PARTS ---------------------------------------------------------------------
local function animateViewmodel(dt: number, now: number)
	if not viewmodel or not current or not viewmodel.PrimaryPart then
		return
	end
	local hcf = viewmodel.PrimaryPart.CFrame
	local a = ammo[current.Id]
	local empty = a ~= nil and a.Mag <= 0 and not infinite()
	local t = now - lastShotVis
	-- fast snap back, slower return (slides, bolts)
	local pulse = t < 0.035 and t / 0.035 or math.max(0, 1 - (t - 0.035) / 0.09)
	-- delayed rack (pump & bolt action)
	local cycle = (t > 0.14 and t < 0.56) and math.sin((t - 0.14) / 0.42 * math.pi) or 0
	local magOut = 0
	if reloading then
		local r = math.clamp((now - reloadStart) / math.max(0.01, reloadEnd - reloadStart), 0, 1)
		magOut = r < 0.25 and r / 0.25 or (r < 0.6 and 1 or math.max(0, 1 - (r - 0.6) / 0.25))
	end
	cylAngle += (cylTarget - cylAngle) * math.min(1, dt * 18)
	if current.Def.SpinUp then
		barrelAngle += dt * spin * 45
	else
		barrelAngle += dt * (1.5 + pulse * 14)
	end
	local glow = math.max(0, 1 - t / 0.18)
	local function around(pivot, rot, base)
		local p = pivot or Vector3.zero
		return hcf * CFrame.new(p) * rot * CFrame.new(-p) * base
	end
	for _, ap in animParts do
		local kind = ap.Kind
		local cf
		if kind == "Slide" then
			cf = hcf * CFrame.new(0, 0, empty and 0.2 or 0.22 * pulse) * ap.Base -- locks back when empty
		elseif kind == "Bolt" then
			cf = hcf * CFrame.new(0, 0, empty and 0.12 or 0.14 * pulse) * ap.Base
		elseif kind == "Recoil" then
			cf = hcf * CFrame.new(0, 0, 0.28 * pulse) * ap.Base
		elseif kind == "Pump" then
			cf = hcf * CFrame.new(0, 0, 0.34 * cycle) * ap.Base
		elseif kind == "BoltAction" then
			cf = hcf * CFrame.new(0, 0.07 * cycle, 0.3 * cycle) * ap.Base
		elseif kind == "Trigger" then
			cf = hcf * CFrame.new(0, 0, (firing or pulse > 0.3) and 0.035 or 0) * ap.Base
		elseif kind == "Hammer" then
			cf = hcf * ap.Base * CFrame.Angles(math.rad(-35) * pulse, 0, 0)
		elseif kind == "Mag" then
			cf = hcf * CFrame.new(0, -1.6 * magOut, 0.15 * magOut) * ap.Base
		elseif kind == "Cylinder" then
			cf = around(animPivots.Cylinder, CFrame.Angles(0, 0, cylAngle), ap.Base)
		elseif kind == "Barrels" then
			cf = around(animPivots.Barrels, CFrame.Angles(0, 0, barrelAngle), ap.Base)
		elseif kind == "Break" then
			cf = around(animPivots.Break, CFrame.Angles(-0.5 * magOut, 0, 0), ap.Base)
		else
			cf = hcf * ap.Base
		end
		ap.Part.CFrame = cf
		if kind == "Payload" and empty then
			ap.Part.LocalTransparencyModifier = 1
		elseif kind == "Glow" then
			ap.Part.Color = ap.Color:Lerp(Color3.new(1, 1, 1), glow * 0.8)
		end
	end
end

-- PER FRAME --------------------------------------------------------------------
local function lerp(a, b, t)
	return a + (b - a) * t
end

local function render(dt: number)
	camera = workspace.CurrentCamera
	local now = os.clock()
	local S = Movement.State
	local isAlive = alive() and not ClientState.Driving
	if current and current.Def.SpinUp then
		local spinning = firing and canAct() and not reloading
		spin = math.clamp(spin + (spinning and dt / current.Def.SpinUp or -dt * 1.5), 0, 1)
	else
		spin = 0
	end
	-- ADS sensitivity
	UserInputService.MouseDeltaSensitivity = aimAlpha > 0.5 and (ClientState.Settings.AdsSens or 0.7) or 1

	-- input-driven state
	if not isAlive or ClientState.MenuOpen then
		firing = false
	end
	local wantAim = aiming and isAlive and not ClientState.MenuOpen and not S.Sprinting
	S.Aiming = wantAim
	aimAlpha = lerp(aimAlpha, wantAim and 1 or 0, math.min(1, dt * 16))
	sprintAlpha = lerp(sprintAlpha, (S.Sprinting and not wantAim and not firing) and 1 or 0, math.min(1, dt * 10))
	bloom = math.max(0, bloom - dt * 6)

	if firing and current and current.Def.Auto then
		tryShoot()
	end

	-- camera recoil + shake (visual kick that recovers)
	recoilPitch = lerp(recoilPitch, 0, math.min(1, dt * 9))
	recoilYaw = lerp(recoilYaw, 0, math.min(1, dt * 9))
	if isAlive then
		camera.CFrame = camera.CFrame * CFrame.Angles(math.rad(recoilPitch), math.rad(recoilYaw), 0) * Effects.StepShake(dt)

		local fov = baseFov()
		if S.Sprinting then
			fov += 8
		end
		if S.Sliding then
			fov += 6
		end
		if Movement.Recently("Dash", 0.25) then
			fov += 14
		end
		if current then
			fov = lerp(fov, current.Def.ZoomFov, aimAlpha)
		end
		camera.FieldOfView = lerp(camera.FieldOfView, fov, math.min(1, dt * 14))
	end

	-- viewmodel
	if viewmodel and current and isAlive then
		local def = current.Def
		local L = def.Look.Length
		local sight = viewmodel.PrimaryPart:FindFirstChild("Sight")
		local hip = CFrame.new(1.0, -1.05, -L / 2 - 1.0)
		local ads = CFrame.new(0, -(sight and sight.Position.Y or 0.4), -L / 2 - 0.45)
		local offset = hip:Lerp(ads, aimAlpha)

		local root = character and character:FindFirstChild("HumanoidRootPart")
		local speed = root and Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude or 0
		if Movement.State.Airborne or S.Sliding then
			speed = 0
		end
		bobT += dt * speed * 0.55
		local bobAmt = (1 - aimAlpha * 0.9) * math.min(speed / 16, 1.5)
		local bob = CFrame.new(math.sin(bobT) * 0.05 * bobAmt, -math.abs(math.cos(bobT)) * 0.06 * bobAmt, 0)

		local delta = UserInputService:GetMouseDelta()
		local target = Vector2.new(math.clamp(-delta.X * 0.003, -0.12, 0.12), math.clamp(-delta.Y * 0.003, -0.12, 0.12))
		sway = sway:Lerp(target * (1 - aimAlpha * 0.7), math.min(1, dt * 10))
		local swayCF = CFrame.Angles(sway.Y, sway.X, sway.X * 0.6)

		kick = lerp(kick, 0, math.min(1, dt * 14))
		local kickCF = CFrame.new(0, 0, kick * 0.18) * CFrame.Angles(math.rad(kick * 4), 0, 0)
		if def.SpinUp and spin > 0 then
			-- minigun rumble while spinning
			kickCF *= CFrame.new((math.random() - 0.5) * 0.02 * spin, (math.random() - 0.5) * 0.02 * spin, 0)
		end

		local reloadCF = CFrame.identity
		if reloading then
			local t = math.clamp((now - reloadStart) / math.max(0.01, reloadEnd - reloadStart), 0, 1)
			local d = math.sin(t * math.pi)
			reloadCF = CFrame.new(0, -0.5 * d, 0) * CFrame.Angles(math.rad(-35) * d, 0, math.rad(25) * d)
		end
		local equipT = math.clamp((now - equipTime) / 0.25, 0, 1)
		local equipCF = CFrame.new(0, -1.2 * (1 - equipT), 0) * CFrame.Angles(math.rad(-40) * (1 - equipT), 0, 0)
		local sprintCF = CFrame.new(-0.3 * sprintAlpha, -0.2 * sprintAlpha, 0) * CFrame.Angles(math.rad(-12) * sprintAlpha, math.rad(40) * sprintAlpha, math.rad(10) * sprintAlpha)
		local slideCF = S.Sliding and CFrame.Angles(0, 0, math.rad(-12)) or CFrame.identity

		-- knife / grenade: drop the gun out of view briefly
		local knifeT = (now - knifeTime) / 0.35
		local throwT = (now - throwTime) / 0.4
		local away = 0
		if knifeT < 1 then
			away = math.sin(knifeT * math.pi)
		elseif throwT < 1 then
			away = math.sin(throwT * math.pi)
		end
		local awayCF = CFrame.new(0, -1.4 * away, 0.3 * away)

		viewmodel:PivotTo(camera.CFrame * offset * bob * swayCF * kickCF * reloadCF * equipCF * sprintCF * slideCF * awayCF)

		local scoped = def.Scoped and aimAlpha > 0.85
		setViewmodelVisible(not scoped)
		animateViewmodel(dt, now)
		if WC.HUD then
			WC.HUD.SetScope(scoped)
			local px = math.tan(math.rad(currentSpread())) / math.tan(math.rad(camera.FieldOfView / 2)) * (camera.ViewportSize.Y / 2)
			WC.HUD.SetCrosshair(px, aimAlpha < 0.5 or def.Pellets ~= nil)
		end

		-- knife swing
		if knifeT < 1 then
			knifeModel = knifeModel or buildKnife()
			knifeModel.Parent = camera
			local swing = -60 + knifeT * 140
			knifeModel:PivotTo(camera.CFrame * CFrame.new(0.6 - knifeT * 1.2, -0.6, -1.6) * CFrame.Angles(math.rad(-20), math.rad(swing), math.rad(-70)))
		elseif knifeModel and knifeModel.Parent then
			knifeModel.Parent = nil
		end
	else
		setViewmodelVisible(false)
		if WC.HUD then
			WC.HUD.SetScope(false)
			WC.HUD.SetCrosshair(0, false)
		end
	end
	hideToolLocally()
end

-- INPUT ------------------------------------------------------------------------
local function onInputBegan(input: InputObject, processed: boolean)
	if processed then
		return
	end
	local t, k = input.UserInputType, input.KeyCode
	if t == Enum.UserInputType.MouseButton1 or k == Enum.KeyCode.ButtonR2 then
		firing = true
		tryShoot()
	elseif t == Enum.UserInputType.MouseButton2 or k == Enum.KeyCode.ButtonL2 then
		aiming = true
	elseif k == Enum.KeyCode.R or k == Enum.KeyCode.ButtonX then
		WC.Reload()
	elseif k == Enum.KeyCode.One then
		WC.EquipSlot("Primary")
	elseif k == Enum.KeyCode.Two then
		WC.EquipSlot("Secondary")
	elseif k == Enum.KeyCode.ButtonY then
		cycle()
	elseif k == Enum.KeyCode.V or k == Enum.KeyCode.F or k == Enum.KeyCode.ButtonR1 then
		WC.Knife()
	elseif k == Enum.KeyCode.G or k == Enum.KeyCode.ButtonL1 then
		WC.Grenade()
	elseif k == Enum.KeyCode.Z then
		Remotes.UseToken:FireServer("Airstrike")
	elseif k == Enum.KeyCode.X then
		Remotes.UseToken:FireServer("Nuke")
	end
end

local function onInputEnded(input: InputObject)
	local t, k = input.UserInputType, input.KeyCode
	if t == Enum.UserInputType.MouseButton1 or k == Enum.KeyCode.ButtonR2 then
		firing = false
	elseif t == Enum.UserInputType.MouseButton2 or k == Enum.KeyCode.ButtonL2 then
		aiming = false
	end
end

local function bindMobile()
	local function bind(name, title, pos, onBegin, onEnd)
		ContextActionService:BindAction(name, function(_, state)
			if state == Enum.UserInputState.Begin then
				onBegin()
			elseif state == Enum.UserInputState.End and onEnd then
				onEnd()
			end
			return Enum.ContextActionResult.Sink
		end, true)
		ContextActionService:SetTitle(name, title)
		ContextActionService:SetPosition(name, pos)
	end
	bind("NS_Fire", "FIRE", UDim2.new(1, -170, 1, -210), function()
		firing = true
		tryShoot()
	end, function()
		firing = false
	end)
	bind("NS_Aim", "AIM", UDim2.new(1, -110, 1, -270), function()
		aiming = not aiming
	end)
	bind("NS_Reload", "RELOAD", UDim2.new(1, -230, 1, -270), WC.Reload)
	bind("NS_Knife", "KNIFE", UDim2.new(1, -290, 1, -210), WC.Knife)
	bind("NS_Nade", "NADE", UDim2.new(1, -350, 1, -150), WC.Grenade)
	bind("NS_Swap", "SWAP", UDim2.new(1, -110, 1, -330), cycle)
end

local function bindCharacter(char: Model)
	character = char
	humanoid = char:WaitForChild("Humanoid")
	ammo = {}
	aiming = false
	firing = false
	unequip()
	char.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			equip(child)
		end
	end)
	char.ChildRemoved:Connect(function(child)
		if current and child == current.Tool then
			unequip()
		end
	end)
	local existing = char:FindFirstChildOfClass("Tool")
	if existing then
		equip(existing)
	end
	humanoid.Died:Connect(function()
		unequip()
		if knifeModel then
			knifeModel.Parent = nil
		end
	end)
end

function WC.Init()
	if player.Character then
		task.spawn(bindCharacter, player.Character)
	end
	player.CharacterAdded:Connect(bindCharacter)
	UserInputService.InputBegan:Connect(onInputBegan)
	UserInputService.InputEnded:Connect(onInputEnded)
	UserInputService.InputChanged:Connect(function(input, processed)
		if not processed and input.UserInputType == Enum.UserInputType.MouseWheel then
			cycle()
		end
	end)
	if UserInputService.TouchEnabled then
		bindMobile()
	end
	Remotes.HitConfirm.OnClientEvent:Connect(WC.OnHit)
	player:GetAttributeChangedSignal("InfiniteAmmo"):Connect(updateHud)
	RunService:BindToRenderStep("NS_Weapons", Enum.RenderPriority.Camera.Value + 1, render)
end

return WC
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>