      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[local Util = {}

function Util.Comma(n: number): string
	local s = tostring(math.floor(n))
	local formatted, k = s, 0
	repeat
		formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
	until k == 0
	return formatted
end

function Util.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

function Util.DeepCopy(t)
	if type(t) ~= "table" then
		return t
	end
	local out = {}
	for k, v in t do
		out[k] = Util.DeepCopy(v)
	end
	return out
end

-- Fills in any keys missing from `data` with defaults (for data migrations).
function Util.Reconcile(data, defaults)
	for k, v in defaults do
		if data[k] == nil then
			data[k] = Util.DeepCopy(v)
		elseif type(v) == "table" and type(data[k]) == "table" then
			Util.Reconcile(data[k], v)
		end
	end
	return data
end

-- Finds the Humanoid that owns a hit part (handles accessories too).
function Util.HumanoidFromPart(part: Instance?)
	local current = part
	while current and current ~= workspace do
		local hum = current:FindFirstChildOfClass("Humanoid")
		if hum then
			return hum, current
		end
		current = current.Parent
	end
	return nil
end

return Util
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Weapons</string>
          <string name="Source"><![CDATA[-- Weapon definitions. Every gun in the game is data-driven from this table.
-- Price = in-game cash, Level = level needed to buy, Pass = Robux game pass needed.
local Weapons = {}

Weapons.Defs = {
	-- PRIMARIES ---------------------------------------------------------
	Striker = {
		Name = "STRIKER AR", Class = "Assault Rifle", Slot = "Primary",
		Model = "M4A1 pattern", Kickback = 0,
		Damage = 24, HeadMult = 1.6, FireRate = 10, Auto = true,
		Mag = 30, Reserve = 150, Reload = 2.0,
		Spread = 2.2, AdsSpread = 0.4, Range = 600, FalloffStart = 120,
		Recoil = 0.9, ZoomFov = 55, Speed = 1.0,
		Price = 0, Level = 1,
		Look = { Body = Color3.fromRGB(45, 48, 56), Accent = Color3.fromRGB(255, 198, 26), Length = 2.6, Barrel = 1.0, Scope = false },
	},
	Viper = {
		Name = "VIPER SMG", Class = "SMG", Slot = "Primary",
		Model = "MP5 pattern", Kickback = 0,
		Damage = 17, HeadMult = 1.4, FireRate = 15, Auto = true,
		Mag = 35, Reserve = 175, Reload = 1.6,
		Spread = 3.0, AdsSpread = 1.0, Range = 300, FalloffStart = 60,
		Recoil = 0.6, ZoomFov = 60, Speed = 1.1,
		Price = 750, Level = 3,
		Look = { Body = Color3.fromRGB(30, 30, 34), Accent = Color3.fromRGB(0, 204, 255), Length = 1.9, Barrel = 0.6, Scope = false },
	},
	Brute = {
		Name = "BRUTE SHOTGUN", Class = "Shotgun", Slot = "Primary",
